	//------------------------------------------------------------
	
	void AppGotInputFocus()
	{
	
	}
	void AppLostInputFocus()
	{
	
	}
	
	//------------------------------------------------------------
	
	tString msBackground;
	array<tString> mvIcons;
	float mfAlpha = 0.0f;
	float mfFrame = 0.0f;
	float mfMiniIconAlpha = 0.0f;
	float mfMapChangeTime = 0.0f;
	bool mbSmallIcon = false;

	float mfShowIconCount = 0.0f;

	//------------------------------------------------------------
}
