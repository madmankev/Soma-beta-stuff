class cScrLoadScreenHandler : iScrUserModule, iScrUserModule_Interface, iScrLoadScreenHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mBaseObj.SetScriptableIsSaved(false);

		cConfigFile@ pConfig = cLux_GetGameConfig();
		
		SetBackground(pConfig.GetString("General", "DefaultLoadingScreen", "backdrop.dds"));
		SetIcon(pConfig.GetString("General", "LoadingIcon", "brain_01.dds"), 
				pConfig.GetInt("General", "LoadingIconFrameNum", 26));
	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool IsActive()
	{
		return mfAlpha > 0.0;
	}

	void SetBackground(const tString&in asTexture)
	{
		msBackground = asTexture;
	}

	void SetIcon(const tString&in asFirstFrame, int alFrameNum)
	{
		mvIcons.resize(0);
		
		int lPos = cString_GetFirstStringPos(asFirstFrame, "01");
		tString sFileExt = cString_GetFileExt(asFirstFrame);
		tString sBaseName = cString_Sub(asFirstFrame, 0, lPos);

		for(int i = 1; i <= alFrameNum; ++i)
		{
			tString sName = sBaseName;

			if(i < 10) sName += "0"+i;
			else	   sName += i;
			

			mvIcons.push_back(cString_SetFileExt(sName, sFileExt));
		}
	}

	void SetUseSmallIcon(bool abX)
	{
		mbSmallIcon = abX;
	}

	void ShowLoadingIcon(float afTime)
	{
		mfShowIconCount = afTime;
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	//MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}

	void OnMapLeave(cLuxMap @apMap)
