	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetHandModel(const tString& in asFile)
	{
		if(msHandModel == asFile) return;
		
		msHandModel = asFile;
		
		DestroyHandModel(cLux_GetCurrentMap());
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
	}
	
	//------------------------------------------------------------
	
	void PlayAnimation(const tString &in asAnim, bool abLoop, bool abFullScaleModel, const tString &in asAttachedProp, bool abDisableWhenOver, float afSpeed, float afRelTimePos, float afFadeTime)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		
		float fFadeTime = afFadeTime;
		if(mbUseFullScaleModel!=abFullScaleModel || pEntity.IsActive()==false)
		{
			fFadeTime=0;
		}
		
		int lAnim = pEntity.PlayAnimation(asAnim,  fFadeTime, abLoop);
		if(lAnim<0)
			return;
		//if(lAnim == mlCurrentAnimation) return;
		mlCurrentAnimation = lAnim;
			
		cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
		cAnimationState@ pAnim = pMeshEntity.GetAnimationState(mlCurrentAnimation);
		
		////////////////////////////////////
		// Set up animation state
		pAnim.SetSpeed(afSpeed);
		if(afRelTimePos<0)
		{
			if(afSpeed<0) 	pAnim.SetRelativeTimePosition(1);
			else			pAnim.SetRelativeTimePosition(0);
		}
		else
		{
			pAnim.SetRelativeTimePosition(afRelTimePos);
		}
		
		////////////////////////////////////
		// Set up properties
		mbUseFullScaleModel = abFullScaleModel;
		SetActive(true);
		mbDisableWhenAnimOver = abDisableWhenOver;
		
		pEntity.GetMeshEntity().SetVisible(mbEntityVisible);
				
		
		/////////////////////////////
		// Attacha  prop
		if(asAttachedProp != "")
		{
			iLuxEntity @pProp = cLux_GetCurrentMap().GetEntityByName(asAttachedProp);
			if(pProp is null)
			{
				Error("Could not find entity '"+asAttachedProp+"' to be attached to player hands");
				return;
			}
			
			iLuxEntity @pPrevProp = null;
			if(m_idCurrentAttachProp!=tID_Invalid) @pPrevProp = cLux_ID_Entity(m_idCurrentAttachProp);
			
			if(pPrevProp !is pProp)
			{
				if(pPrevProp !is null) pPrevProp.RemoveEntityAttachment();
				
				if(pProp.GetMainBody() !is null)
				{
					pProp.GetMainBody().SetCollideCharacter(false);
					pProp.GetMainBody().SetCollide(false);
				}
				
				pProp.AttachToSocket(pEntity, "R_Hand", true, true);
				m_idCurrentAttachProp  = pProp.GetID();
			}
		}
		/////////////////////////////
		// If something is attached, remove it.
		else
		{
			if(m_idCurrentAttachProp!=tID_Invalid)
			{
				iLuxEntity @pAttachProp = cLux_ID_Entity(m_idCurrentAttachProp);
				if(pAttachProp !is null) pAttachProp.RemoveEntityAttachment();
				m_idCurrentAttachProp = tID_Invalid;
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool GetAnimationPlaying()
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		return pEntity.GetAnimationIsPlaying();
	}
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
		if(mbActive == abX) return;
		
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		mbActive = abX;
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		pEntity.SetActive(abX);
		
		if(abX==false)
		{
			pEntity.StopAllAnimations(0);
		}
					
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		mvCurrentHandRotation = cVector3f(pCam.GetPitch(), pCam.GetYaw(), pCam.GetRoll()*0.5);
	}
	
	//------------------------------------------------------------
	
	bool IsActive()
	{
		return mbActive;
	}
	
	//------------------------------------------------------------
	
	void SetUseCustomRotation(bool abX)
	{
		mbUseCustomRotation = abX;	
	}
	
	void SetCustomRotation(const cVector3f& in avRot)
	{
		mvCustomRotation = avRot;
	}
	
	//------------------------------------------------------------
	
	cAnimationState@ GetCurrentAnimationState()
	{
		if(mlCurrentAnimation<0) return null;
		
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		return cLux_ID_Entity(m_idHands).GetMeshEntity().GetAnimationState(mlCurrentAnimation);
	}
	
	//------------------------------------------------------------
	
	cBoneState@ GetBoneState(const tString& in asBone)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		return cLux_ID_Entity(m_idHands).GetMeshEntity().GetBoneStateFromName(asBone);
	}
	
	//------------------------------------------------------------
	
	cNode3D@ GetSocket(const tString& in asSocket)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		return cLux_ID_Entity(m_idHands).GetMeshEntity().GetSocket(asSocket);
	}
		
	//------------------------------------------------------------
	
	void SetUseCustomPosition(bool abX)
	{
		mbUseCustomPosition = abX;	
	}
	
	//------------------------------------------------------------
	
	void SetCustomPosition(const cVector3f& in avPos, bool abUseBasicOffset)
	{
		mvCustomPosition = avPos;
		mbCustomPositionUseBasicOffset = abUseBasicOffset;
	}
	
	//------------------------------------------------------------
	
	void AttachCameraToSocket(	const tString& in asSocketName, float afFadeTime,
								const tString &in asFadeOverCallback,
								bool abDisablePlayer, bool abAutoDetach, float afDetachTime)
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		
		if(pEntity.GetMeshEntity().GetSocket(asSocketName) is null)
		{
			Error("Could not find socket name '"+asSocketName+"' in player hands mesh!");
			return;
		}
		
		msCameraAttachSocket =asSocketName;
		mfCameraAttachFadeTime = afFadeTime;
		mfCameraAttachT=0;
		mbCameraAttachActive=true;
		
		mbCameraAttachDisablePlayer = abDisablePlayer;
		if(abDisablePlayer)
			Player_SetActive(false);
			
		cCamera@ pCam = cLux_GetPlayer().GetCamera();
		mvCameraAttachStartRotation.x = pCam.GetPitch();
		mvCameraAttachStartRotation.y = pCam.GetYaw();
		mvCameraAttachStartRotation.z = pCam.GetRoll();
		
		mbCameraAttachAutoDetach = abAutoDetach;
		mfCameraAttachAutoDetachTime = afDetachTime;
		
		msCameraAttachFadeOverCallback = asFadeOverCallback;
		
		cLux_GetPlayer().GetCharacterBody().SetCameraUpdateActive(false);
	}
	
	//------------------------------------------------------------
	
	void DetachCameraFromSocket(float afFadeTime)
	{
		if(msCameraAttachSocket=="") return;
		
		mfCameraAttachFadeTime = afFadeTime;
		mbCameraAttachActive=false;
		
		//No need to set T, as the detach might happen when the fade is not done
	}
	
	//------------------------------------------------------------
	
	void SetAnimationOverCallback(const tString& in asFunction)
	{
		msAnimationOverCallback = asFunction;
	}
	
	//------------------------------------------------------------
	
	void SetVisible(bool abX)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		mbEntityVisible = abX;
		
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		pEntity.GetMeshEntity().SetVisible(mbEntityVisible);
	}
		
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateHandModelIfNeeded(cLuxMap @apMap)
	{
		if(m_idHands != tID_Invalid) return;
		
		apMap.CreateEntity("PlayerHands",msHandModel, cMatrixf_Identity, cVector3f(1));
		iLuxEntity @pEntity = apMap.GetLatestEntity();
		if(pEntity is null || pEntity.GetName() != "PlayerHands")
		{
			Error("Could not load player hand model!");
		}
		else
		{
			m_idHands = pEntity.GetID();
			pEntity.SetActive(false);
			
			GetMeshDepth();
		}
	}
	
	//------------------------------------------------------------
		
	void DestroyHandModel(cLuxMap @apMap)
	{
		if(m_idHands != tID_Invalid)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idHands);
			apMap.DestroyEntity(pEnt);
			
			m_idHands = tID_Invalid;
		}
	}
	
	//------------------------------------------------------------
			
	void GetMeshDepth()
	{
		//////////
		// Reset incase of failure
		mfMeshDepth = 0;

		/////////////
		// Get mesh
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		if(pEntity is null) return;
		cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
		if(pMeshEntity is null) return;

		cMesh@ pMesh = pMeshEntity.GetMesh();

		/////////////
		// Get the base AABB of the mesh
		cVector3f vMin = 10000;
		cVector3f vMax =-10000;

		for(int i = 0; i < pMesh.GetSubMeshNum(); ++i)
		{
			cSubMesh@ pSubMesh = pMesh.GetSubMesh(i);
			iVertexBuffer@ pVtxBuffer = pSubMesh.GetVertexBuffer();
			vMin = cMath_Vector3Min(vMin, pVtxBuffer.GetAABBMin());
			vMax = cMath_Vector3Max(vMax, pVtxBuffer.GetAABBMax());
		}
		
		mfMeshDepth = vMax.x - vMin.x; //Get depth from x axis
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		
		if(mlCurrentAnimation>=0)		
		{
			iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
			cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
			cAnimationState@ pAnim = pMeshEntity.GetAnimationState(mlCurrentAnimation);
			
			afStartY = cLux_DrawDebugText("Animation: "+pAnim.GetName()+" Rel:"+pAnim.GetRelativeTimePosition(), afStartY);
		}
		else		
			afStartY = cLux_DrawDebugText("Animation: NONE", afStartY);
				
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tID m_idHands = tID_Invalid;
	tString msHandModel = "character/player/hands/hands_human.ent";
	
	//------------------------------------------------------------
	
	bool mbActive=false;
	bool mbDisableWhenAnimOver=false;
	bool mbUseFullScaleModel=false;
	int mlCurrentAnimation=-1;
	
	bool mbUseCustomRotation;
	cVector3f mvCustomRotation;
	
	bool mbEntityVisible=true;
	
	bool mbUseCustomPosition;
	bool mbCustomPositionUseBasicOffset;
	cVector3f mvCustomPosition;
	
	cVector3f mvCurrentHandRotation;
	
	tID m_idCurrentAttachProp = tID_Invalid;
	
	bool mbCameraAttachActive;
	tString msCameraAttachSocket;
	float mfCameraAttachT;
	float mfCameraAttachFadeTime;
	bool mbCameraAttachDisablePlayer;
	bool mbCameraAttachAutoDetach;
	float mfCameraAttachAutoDetachTime;
	cVector3f mvCameraAttachStartRotation;
	tString msCameraAttachFadeOverCallback;
	
	tString msAnimationOverCallback;
	
