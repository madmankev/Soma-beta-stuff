	void SaveUserConfig()
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	void OnMapLeave(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
	}
	
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{
		
	}
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
	}
	
	//------------------------------------------------------------

	void Update(float afTimeStep)
	{	
	}
	
	void VariableUpdate(float afDeltaTime)
	{
		UpdateAddObjects(afDeltaTime);
		UpdateHighLightEffect(afDeltaTime);
	}

	//------------------------------------------------------------
	
	void UpdateHighLightEffect(float afTimeStep)
	{
		mfCheckOnScreenCount -=afTimeStep;
		if(mfCheckOnScreenCount<0) mfCheckOnScreenCount=0;
		
		if(cLux_GetPlayer().GetCharacterBody() is null) return;
		
		cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
		
		for(int i=0; i<mvObjects.size(); ++i)
		{
			cHighlightObject @pObject = @mvObjects[i];
			iLuxEntity @pEntity = cLux_ID_Entity(pObject.m_idEntity);
			if(pEntity is null) continue;
			
			/////////////////////////////
			// Wait a little bit before flashing
			if(pObject.mfPreOnScreenTimeCount < 0.7f)
			{
				/////////////////////////
				// Check if it is still on screen
				if(mfCheckOnScreenCount==0 && pEntity.CheckIsOnScreen(true)==false)
				{
					mvObjects[i] = mvObjects[mvObjects.size()-1];
					mvObjects.pop_back();
					--i;
					continue;
				}
				
				/////////////////////////
				// Check if within distance	
				if(cMath_Vector3DistSqr(vPlayerPos, pEntity.GetPosition()) > gfHightlightEffectMinDistanceSqr)
				{
					pObject.mfPreOnScreenTimeCount =0;
					continue;
				}
				
				pObject.mfPreOnScreenTimeCount += afTimeStep;
				continue;
			}
			
			////////////////////////////////////
			// Update the flash 
			if(pObject.mfFlashCount < 1)
			{
				pObject.mfFlashCount += afTimeStep*1.25f;
				if(pObject.mfFlashCount>=1) pObject.mfFlashCount=1;
				
				float fY = pObject.mfFlashCount;
				float fT =1-cMath_Abs(2*fY-1);
				fT = cMath_Easing(eEasing_CircInOut, fT);
				fY = cMath_Easing(eEasing_QuadInOut, fY);
				
				//fT *= cMath_Easing(eEasing_QuadIn, cMath_Min(pObject.mfLightLevel, 1.0f));
				
				
				cLux_GetEffectHandler().AddGlowObject(pEntity, fT*13, fY);
				
				//Debug:
				//if(pObject.mfFlashCount==1) pObject.mfFlashCount=0;
			}
			////////////////////////////////////
			// Check if we can reset and flash again.
			else
			{
				if(mfCheckOnScreenCount==0 && pEntity.CheckIsOnScreen(true)==false)
				{
					pObject.mfRemoveTimeCount += 0.5f;
					
					if(pObject.mfRemoveTimeCount>5.0f)
					{
						mvObjects[i] = mvObjects[mvObjects.size()-1];
						mvObjects.pop_back();
						--i;
					}
				}
			}
		}
		
		if(mfCheckOnScreenCount==0) mfCheckOnScreenCount =0.5f;
	}
	
	//------------------------------------------------------------
	
	void UpdateAddObjects(float afTimeStep)
	{
		mfUpdateAddObjectsCount+=afTimeStep;
		if(mfUpdateAddObjectsCount<0.5f) return;
		mfUpdateAddObjectsCount=0;

		if(cLux_GetPlayer().GetCharacterBody() is null) return;
		
		////////////////////
		// Setup variables
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		
		float fDist = gfHightlightEffectMinDistance*2;
		
		////////////////////
		// Get all nearby entities
		cVector3f vMin(-fDist,-fDist,-fDist);
		cVector3f vMax(fDist,fDist,fDist);
		
		vMin += pCharBody.GetPosition();
		vMax += pCharBody.GetPosition();
		
		array<iPhysicsBody@> vBodies;
		cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(vMin, vMax, vBodies);
		
		////////////////////
		// Get all entities that need a highlight
		iPhysicsBody @pBody;
		iLuxEntity @pEntity;
		for(int i=0; i<vBodies.size();++i)
		{
			@pBody = vBodies[i];
			if(pBody.IsActive()==false) continue;
			
			@pEntity = cLux_GetBodyEntity(pBody);
			if(pEntity is null) continue;
			
			if(	pEntity.GetClassName() != "cScrPropTool" &&
				pEntity.GetClassName() != "cScrPropDatamine" &&
				pEntity.GetClassName() != "cScrPropReadable" &&
				pEntity.GetClassName() != "cScrAreaDatamine" &&
				pEntity.GetClassName() != "cScrPropHandheldTerminal")
			{
				continue;	
			}
			
			if(pEntity.CheckIsOnScreen(true)==false) continue;
			
			cScript_RunGlobalFunc(pEntity.GetName(), "", "_Global_CanBeHighlighted");
			if(cScript_GetGlobalReturnBool()==false) continue;
			
			tID idEntity = cScript_GetGlobalArgID(0);
			
			iLuxEntity@ pEntity = cLux_ID_Entity(idEntity);
			if(pEntity is null) continue;
			if(pEntity.GetMeshEntity() is null) continue;
			
			if(ObjectExists(idEntity)) continue;
			
			float fLightLevel = cLux_GetLightLevelAtPos(pEntity.GetPosition(), null, 0);
			if(fLightLevel<0.2) continue;
			
			cHighlightObject object;
			object.m_idEntity = idEntity;
			object.mfLightLevel = fLightLevel;
			mvObjects.push_back(object);
		}
	}
	
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
	}
	
