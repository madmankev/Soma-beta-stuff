	//------------------------------------------------------------
	
	void OnDraw(float){}
	void OnPostRender(float){}
	void OnEnterContainer(const tString&in){}
	void OnLeaveContainer(const tString&in){}
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}	
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount){}
	void OnExitPressed(){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool ObjectExists(tID a_idEntity)
	{
		for(int i=0; i<mvObjects.size(); ++i)
		{
			if(mvObjects[i].m_idEntity == a_idEntity) return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfUpdateAddObjectsCount=5;
	float mfCheckOnScreenCount=0;
	
	//------------------------------------------------------------
	
	[nosave] array<cHighlightObject> mvObjects;
	
	//------------------------------------------------------------
	
}