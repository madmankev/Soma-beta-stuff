#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"
#include "helpers/helper_imgui.hps"

//---------------------------------------------------

const float gfMaxTextWidth = 750;
const float gfFontSize = 24;

//---------------------------------------------------

enum eHintType
{
	eHintType_Look,
	eHintType_GetItem,
	eHintType_Movement,
	eHintType_Doors,
	eHintType_UseTool,
	eHintType_Terminal,
	eHintType_LastEnum,	
}

//---------------------------------------------------

class cHint
{
	cHint()
	{
		Clear();
	}
	
	cHint(const tString &in asHeaderCat, const tString &in asHeaderEntry, const tString &in asTextCat, const tString &in asTextEntry, const cColor &in aColor, float afTimeMul=1.5f)
	{
		msHeaderCat = asHeaderCat;
		msHeaderEntry = asHeaderEntry;
		msTextCat = asTextCat;
		msTextEntry = asTextEntry;
		mColor = aColor;
		mfTimeToDisplay = afTimeMul;
		
		msName = BuildHintName(msTextCat, msTextEntry);
		mlID = 0;
	}
	
	void Clear()
	{
		msName = "";
		mlID = -1;
		msHeaderCat = "";
		msHeaderEntry = "";
		msTextCat = "";
		msTextEntry = "";
		mColor = cColor(1,1);
		mfTimeToDisplay = 1.0f;
	}
	
	bool IsEmpty()
	{
		return mlID==-1;
	}
		
	tString msName;
	int mlID;
		
	tString msHeaderCat;
	tString msHeaderEntry;
	tString msTextCat;
	tString msTextEntry;
	cColor mColor;
	float mfTimeToDisplay;
};

///////////////////////////////////////
// Helper hint global funcs
tString BuildHintName(const tString &in asTextCat, const tString &in asTextEntry)
{
	return asTextCat + "." + asTextEntry;
}

//---------------------------------------------------

class cScrHintHandler : iScrUserModule, iScrUserModule_Interface, iScrHintHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		///////////////////////////////
		// Load Graphics
		mFormatParams.mLabelText.mFont = cImGuiFont("default_medium_outline.fnt", cVector2f(gfFontSize));
		mFormatParams.mLabelText.mFontAlign = eFontAlign_Center;
				
		/*mFormatParams.mLabelKeyboardKey.mFont = cImGuiFont("vera.fnt", mFormatParams.mLabelText.mFont.mvSize);
		mFormatParams.mLabelKeyboardKey.mFontAlign = eFontAlign_Center;
		mFormatParams.mLabelKeyboardKey.mColorBase = cColor(0.3f, 1.0f);
		 * */
		
		mFormatParams.mfOutputLineWidth = gfMaxTextWidth;
		mFormatParams.mfIconGamepadHeight = gfFontSize*1.5f;
		mFormatParams.mfIconMouseHeight = gfFontSize*1.25f;
		mFormatParams.mfIconKeyHeight = gfFontSize*1.25f;
		
		mlNumParsedHintIcons = 0;
		
		mfTextAlpha = 0.0f;
		mfDisplayTime = 0.0f;
		mfFadeCurrentTime = 0.0f;
		mfFadeTotalTime = 0.0f;
		
		mbKeepHeaderVisible = false;
	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	//MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		mfTextAlpha = 0.0f;
		mfDisplayTime = 0.0f;
		mfFadeCurrentTime = 0.0f;
		mfFadeTotalTime = 0.0f;
	}
	
	void OnMapLeave(cLuxMap @apMap)
	{
		mfTextAlpha = 0.0f;
		mfDisplayTime = 0.0f;
		mfFadeCurrentTime = 0.0f;
		mfFadeTotalTime = 0.0f;
	}
	
	//------------------------------------------------------------
		
	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer)
	{
	
	}
	void OnLeaveContainer(const tString&in asNewContainer)
	{
	
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		// Check if a string reparse is needed (e.g. after loading a saved game)
		if(mCurrentHint.IsEmpty()==false && mlNumParsedHintIcons!=mvCurrentHintIcons.length())
		{
			ParseAndFormatHint(mCurrentHint);
			// Also Reset hint time
			mfDisplayTime = mCurrentHint.mfTimeToDisplay;
		}
		
		bool bTextWasDisplayed = mbTextDisplayed;
		mbTextDisplayed = mfDisplayTime > 0.0f ? true : false;
	
		if(mfDisplayTime <= -1)
		{
			mbTextDisplayed = true;
		}
		
		// Fade in
		if(bTextWasDisplayed==false && mbTextDisplayed)
		{
			StartTextFade(1.0f, 1.0f);
		}
		// Fade out
		else if(bTextWasDisplayed && mbTextDisplayed==false)
		{
			StartTextFade(0.0f, 1.0f/3);
			mbKeepHeaderVisible = HasNextHint();
		}
				
		if(mbTextDisplayed)
			mfDisplayTime -= afTimeStep;
				
		// Update fading
		if(mbTextFadingStarted)
		{
			if(DoneFading()==false)
				UpdateFade(afTimeStep);
			else
			{
				mbTextFadingStarted = false;
				
				// If faded out, resume with next hint (if any)
				if(mfFadeGoal==0.0f)
				{
					mvCurrentHintLines.resize(0);
					if(mCurrentHint.IsEmpty()==false)
					{
						mCurrentHint.Clear();
						
						if(HasNextHint())
						{
							cHint@ hint = GetNextHint();
							
							StartMessage(hint);
						}
					}
				}
			}
		}
	}
	
	void PostUpdate(float afTimeStep)
	{
	}
	
	void VariableUpdate(float afDeltaTime)
	{
	}
	void Reset()
	{
		mfTextAlpha = 0.0f;
	}
	
	//------------------------------------------------------------
	
	void OnGui(float afFrameTime)
	{
		bool bCanSkipHintText = mfTextAlpha==0 || mvCurrentHintLines.length()==0;
		if(mbKeepHeaderVisible==false && bCanSkipHintText) return;
		
		cColor currentCol = mTextColor;
		currentCol.a *= mfTextAlpha;
		
		////////////////////
		// Draw hint header
		
		ImGui_SetModColorMul(cColor(1,0,0, mbKeepHeaderVisible? 1.0f : mfTextAlpha));
			
		cVector3f vHintPos = ImGui_NrmPos(0.0f, 0.0f, 1.0f);
		vHintPos.y = 25.0f;
				
		cVector2f vHintLineSize(ImGui_NrmSize(1.0f, 0.0f).x, mFormatParams.mLabelText.mFont.mvSize.y);
			
		cLux_GetCurrentImGui().DoLabel(msHeader, mFormatParams.mLabelText, vHintPos, vHintLineSize, 1.0f);
			
		// If only showing header, skip hint text
		if(bCanSkipHintText) return;
		
		float fHeaderHeight = cMath_Max(mfLineHeight*0.75f, gfFontSize*1.1f);
		vHintPos.y += fHeaderHeight;
		
		ImGui_SetModColorMul(cColor(mTextColor.r,mTextColor.g, mTextColor.b, mfTextAlpha));
		
		cLux_DrawScreenText(cLux_GetGameHudImGui(), afFrameTime, mFormatParams.mLabelText, vHintPos, vHintLineSize.x, mfLineHeight,
											mvCurrentHintLines, mvCurrentHintIcons, mvCurrentHintIconsPerLine);
	}
	
	int mlTimes = 0;
	
	void OnDraw(float afFrameTime)
	{
		
	}
	
	void OnPostRender(float afFrameTime)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
	
	}
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
	
	}
	
