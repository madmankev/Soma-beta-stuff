/////////////////////////////////////////
// MAIL APPS
/////////////////////////////////////////

//-------------------------------------------------------

class cGuiMailAppEntry
{
	tString msBody;
	tString msTitle;
	tString msTimestamp;
	tString msSender;
}

enum eMailAppEntryType
{
	eMailAppEntryType_Inbox,
	eMailAppEntryType_Draft,
	eMailAppEntryType_Sent,
}

//-------------------------------------------------------

array<cGuiMailAppEntry> gvDepthGuiMails_Inbox;
array<cGuiMailAppEntry> gvDepthGuiMails_Draft;
array<cGuiMailAppEntry> gvDepthGuiMails_Sent;
void Depth_ImGui_AddMail(const tString &in asTitle, const tString &in asBody, const tString &in asSender, const tString &in asTimestamp, eMailAppEntryType aType)
{
	eMailAppEntryType actualType = aType;
	if (aType == eMailAppEntryType_Draft)
	{
		if (ImGui_GetStateBool(asTitle+"_Sent", false))
			aType = eMailAppEntryType_Sent;
	}
	
	cGuiMailAppEntry mail;
	mail.msTitle = asTitle;
	mail.msBody = asBody;
	mail.msSender = asSender;
	mail.msTimestamp = asTimestamp;
	
	Depth_ImGui_GetMailList(aType).push_back(mail);
	
	if (ImGui_GetStateInt("SelectedMailIndex", -1)==-1)
	{
		ImGui_SetStateInt("SelectedMailIndex", Depth_ImGui_GetMailList(aType).length()-1);
		ImGui_SetStateInt("SelectedMailType", aType);
	}
}

//-------------------------------------------------------

void Depth_ImGui_ClearMails()
{
	gvDepthGuiMails_Inbox.resize(0);
	gvDepthGuiMails_Draft.resize(0);
	gvDepthGuiMails_Sent.resize(0);
}

//-------------------------------------------------------

array<cGuiMailAppEntry>& Depth_ImGui_GetMailList(eMailAppEntryType aType)
{
	
	if (aType == eMailAppEntryType_Inbox)
		return gvDepthGuiMails_Inbox;
	else if (aType == eMailAppEntryType_Draft)
		return gvDepthGuiMails_Draft;
	else
		return gvDepthGuiMails_Sent;
}

