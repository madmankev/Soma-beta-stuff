//-------------------------------------------------------

/////////////////////////////////////////
// PathOS - Helpers
/////////////////////////////////////////

//-------------------------------------------------------

void PathOS_AudioPlayerStopTrack()
{
	if(ImGui_GetStateInt("PathOS_TrackPlaying", ePathOS_AudioNoTrack) == ePathOS_AudioNoTrack) return;
	
	StationGui_StopAudioPlayback(ImGui_GetName(), true);
	ImGui_SetStateInt("PathOS_TrackPlaying", ePathOS_AudioNoTrack);
}

//-------------------------------------------------------

void PathOS_InputScroll(tString &in asAppName, float afOffs, float afOverlap)
{
	if (afOverlap <= 0.0f) return;
	
	float fTime = ImGui_GetStateFloat("TextTime_"+asAppName);
	
	fTime+=0.5;
	
	if (fTime>gStationGuiReaderInputTick)
	{
		fTime-=gStationGuiReaderInputTick;
		
		if ( ImGui_ActionIsDown(eImGuiAction_Down) && (afOffs<afOverlap) )
		{
			afOffs = cMath_Min(afOverlap, afOffs+1.0f);
		}
		else if ( ImGui_ActionIsDown(eImGuiAction_Up) && (afOffs>0.0f) )
		{
			afOffs = cMath_Max(0.0f, afOffs-1.0f);
		}
	}
	
	ImGui_SetStateFloat("TextTime_"+asAppName,fTime);
	ImGui_SetStateFloat("TextOffset_"+asAppName,afOffs);
}

//-------------------------------------------------------

int PathOS_GetActiveApp()
{
	return ImGui_GetStateInt("PathOS_ActiveApp", ePathOS_AppMainMenu);
}

