/////////////////////////////////////////
// STATION MAIL
/////////////////////////////////////////

//-------------------------------------------------------

void StationGui_MailApp(const tString &in asSendMailCallback = "")
{
	tString sCurrentTransCat = ImGui_GetTransCategory();
	
	/////////////
	// Default setup
	cImGuiWindowData windowData = PathOS_CreateDefaultWindowData();
	
	ImGui_SetTransCategory("StationGUI");
	ImGui_DoWindowStart("MailApp_Header", windowData, ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
	
		ImGui_SetTransCategory(sCurrentTransCat);
		
		//////////////////
		// Mail List
		ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.02, 0.03, 1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.825)));
		
			float fLineY = 0;
			const float fListSpacing = 0.075f;
			
			fLineY = StationGui_MailList("MailApp_Inbox", eMailAppEntryType_Inbox, fLineY);
			fLineY += fListSpacing;
			
			fLineY = StationGui_MailList("MailApp_Draft", eMailAppEntryType_Draft, fLineY);
			fLineY += fListSpacing;
			
			fLineY = StationGui_MailList("MailApp_Sent", eMailAppEntryType_Sent, fLineY);
			fLineY += fListSpacing;
		
		ImGui_GroupEnd();
		
		//////////////////
		// Mail Body
		ImGui_GroupBegin(ImGui_NrmPosGroup(0.3925, 0.0, 1), ImGui_NrmSizeGroup(0.58, 1));
		
			StationGui_MailBody(asSendMailCallback);
		
		ImGui_GroupEnd();
		
		//////////////
		//Message reader app icon bottom left
		StationGui_DrawAppIcon("stationV2/ossymbols/ossymbol_mail");
		
		Depth_ImGui_ClearMails();
	
	ImGui_DoWindowEnd();
}
	
//-------------------------------------------------------

float StationGui_MailList(const tString &in asHeader, eMailAppEntryType aType, float afLineY)
{
	array<cGuiMailAppEntry>@ mailList = Depth_ImGui_GetMailList(aType);
	for (uint i = 0; i < mailList.length(); i++)
	{		
		ImGui_AddItemString(mailList[i].msTitle);
	}
			
	tString sCurrentTransCat = ImGui_GetTransCategory();
	
	cImGuiLabelData labelData;
	labelData.mColorBase = gStationGuiColor_Normal;
	labelData.mFont.mColor = cColor_White*5;
	labelData.mFontAlign = eFontAlign_Left;
	labelData.mFont.SetFile("sansation_large_additive.fnt");
	labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.029);
	labelData.mFont.mMaterial = eGuiMaterial_Additive;
	//labelData.mbUseBackgroundGfx = true;
	
	cImGuiLabelData label_right = labelData;
	label_right.mFontAlign = eFontAlign_Right;
	label_right.mbUseBackgroundGfx = false;
	
	cImGuiButtonData button = PathOS_CreateToggleButtonData();
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	ImGui_SetTransCategory("StationGUI");
	ImGui_DoLabelExt(asHeader, labelData, ImGui_NrmPosGroup(cVector3f(0, afLineY, 0.1)), ImGui_NrmSizeGroup(cVector2f(1, 0.048)));
	ImGui_SetTransCategory("");
	ImGui_DoLabelExt("("+mailList.length()+")", label_right, ImGui_NrmPosGroup(cVector3f(0, 0.0+afLineY,1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
	ImGui_SetTransCategory(sCurrentTransCat);
	afLineY += 0.05f;
	
	if (mailList.length() == 0)
		return afLineY;
	
	int lSelectedMailType = ImGui_GetStateInt("SelectedMailType", -1);
	int lSelectedMail = ImGui_GetStateInt("SelectedMailIndex", -1);
	
	float fButtonHeight = 0.1f;
	float fButtonSpace = 0.05f;
	float fListHeight = (fButtonHeight+fButtonSpace)*(mailList.length()-1)+fButtonHeight;
	
	afLineY += 0.006f;
	lSelectedMail = ImGui_DoMultiToggleExt(asHeader+"MailToggle", lSelectedMailType == aType ? lSelectedMail : -1, 1, ImGui_NrmSizeGroup(0, fButtonSpace), button, ImGui_NrmPosGroup(0, afLineY, 1), ImGui_NrmSizeGroup(1, fListHeight));
	afLineY += fListHeight;
	
	if (lSelectedMail != -1)
	{
		ImGui_SetStateInt("SelectedMailType", aType);
		ImGui_SetStateInt("SelectedMailIndex", lSelectedMail);
	}
	
	if (ImGui_PrevUpdated())
	{
		Depth_Audio_Terminal_Forward(ImGui_GetName());
		Depth_ImGui_SetScrollValue("MailBody", 0);
	}
	
	return afLineY;
}

//-------------------------------------------------------

void StationGui_MailBody(const tString &in asSendMailCallback = "")
{	
	tString sCurrentTransCat = ImGui_GetTransCategory();
	
	cImGuiLabelData label = ImGui_GetDefaultLabel();
	label.mFont.SetFile("sansation_large.fnt");
	
	cImGuiTextFrameData textData = PathOS_CreateDefaultTextFrameData();
	textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	int lSelectedMailType = ImGui_GetStateInt("SelectedMailType", -1);
	int lSelectedMail = ImGui_GetStateInt("SelectedMailIndex", -1);
	
	if (lSelectedMail == -1 || lSelectedMailType == -1) return;
	
	array<cGuiMailAppEntry>@ pMailArray = Depth_ImGui_GetMailList(eMailAppEntryType(lSelectedMailType));
	if (lSelectedMail >= int(pMailArray.length()))
		return;
	
	ImGui_GroupBegin(0, ImGui_NrmSizeGroup(1, 0.8625));
		cImGuiGfx gfx_line("stationV2/misc/GUI_line");
		ImGui_DrawLineExt(ImGui_NrmPos2Group(0, 0, true), ImGui_NrmPos2Group(0, 1, true), 1.1, ImGui_NrmSize(0.004).x, gStationGuiColor_Normal, gfx_line);
		ImGui_DrawLineExt(ImGui_NrmPos2Group(0, 0.075, true), ImGui_NrmPos2Group(1, 0.075, true), 1.1, ImGui_NrmSize(0.00375).y, gStationGuiColor_Normal*0.8, gfx_line);
			
		float fLineY = 0;
		
		cGuiMailAppEntry mail = pMailArray[lSelectedMail];

		///////////////////////////////
		// Info
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		ImGui_DoLabelExt(mail.msTitle, label, ImGui_NrmPosGroup(cVector3f(0.0375, fLineY,1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
		fLineY += 0.08;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.03);
		ImGui_DoLabelExt(mail.msTimestamp, label, ImGui_NrmPosGroup(cVector3f(0.0375, fLineY,1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
		fLineY += 0.1;
		
		///////////////////////////////
		// Body
		float fOverlap = 0;
		float fOffs = Depth_ImGui_GetScrollValue("MailBody");
		fOverlap = ImGui_DoTextFrameExt(mail.msBody, ImGui_NrmSizeGroup(cVector2f(0.0375, 0)), 0, fOffs, textData,
									  ImGui_NrmPosGroup(0, fLineY, 1.1), ImGui_NrmSizeGroup(1, 1.0f-fLineY));

		if (fOverlap>0.0f)
		{
			cImGuiSliderData sliderData = PathOS_CreateDefaultSliderData();
			ImGui_SetModUseUIPos(false);
			fOffs = fOverlap-ImGui_DoSliderVerticalExt("TextSlider", fOverlap-fOffs, 0, fOverlap, 0.01f, sliderData, ImGui_NrmPosGroup(cVector3f(0.977, 0.107, 1.1)),  ImGui_NrmSizeGroup(cVector2f(0.025, 0.74)));
			ImGui_SetModUseUIPos(true);
			Depth_ImGui_InputScroll("MailBody", fOffs, fOverlap);
		}
		
	ImGui_GroupEnd();	
	
	///////////////////////////////
	// SEND BUTTON
	if (lSelectedMailType != eMailAppEntryType_Draft)
		return;
		
	ImGui_SetTransCategory("StationGUI");
	
	cImGuiButtonData buttonSend = PathOS_CreateDefaultButtonData();
	buttonSend.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	bool bSent = false;
	ImGui_SetModUISizeVertExpansion(8.69, 0);
	
	if (ImGui_DoButtonExt("buttonsend","MailApp_Send",buttonSend,ImGui_NrmPosGroup(cVector3f(0.725, 0.87, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.115))))
	{
		if (asSendMailCallback == "")
		{
			bSent = true;
		}
		else if (cLux_GetCurrentMap().ScriptPrepare("bool " + asSendMailCallback + "(const tString &in asTitle)") )
		{
			cLux_GetCurrentMap().SetArgString(0, mail.msTitle);
			
			cLux_GetCurrentMap().ScriptExecute();
			
			bSent = cLux_GetCurrentMap().GetReturnBool();
		}
	}
	ImGui_SetModUISizeVertExpansion(0, 0);
	
	///////////////////////////////
	// Email has been sent
	if (bSent)
	{
		ImGui_SetStateBool(mail.msTitle+"_Sent", true);
	}
	
	ImGui_SetTransCategory(sCurrentTransCat);
}
	
