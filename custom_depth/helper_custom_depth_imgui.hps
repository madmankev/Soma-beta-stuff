void OptionMenu_ButtonBackground(cVector2f avPos)
{
	///////////
	// Draw background
	if(ImGui_TimerExists("ButtonClicked"))
	{
		cImGuiGfx gfx("startmenu_button_long_jitter"+(cMath_RandRectl(1, 3)+1)+"", eImGuiGfx_Texture);
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos - cVector2f(22, 0), 0.5), OptionMenu_GetScaledSize(kOptionMenu_ButtonBgSize), cColor(1,1));
	}
	else
	{
		cImGuiGfx gfx("startmenu_button_long", eImGuiGfx_Texture);
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos - cVector2f(22, 0), 0.5), OptionMenu_GetScaledSize(kOptionMenu_ButtonBgSize), kOptionMenu_ButtonBgColor);
	}
}
	
