//-------------------------------------------------------

void StationGui_DrawAppIcon(const tString &in asIcon)
{
	ImGui_DoImageCorrectAspect(cImGuiGfx(asIcon), ImGui_NrmPosGroup(cVector3f(0, 1, 1.1))+ImGui_NrmPos(0.015, -0.1375, 0), ImGui_NrmSize(0.0875, 0.175));
}
	
//-------------------------------------------------------

/**
 * Draws a default back button.
 * 
 * @param abEnabled, if the button should be possible to click. Defaults to true.
 * @param alState, state to set when button is pressed. Defaults to -1.
 * 
 * @return bool, if button was pressed.
 **/
bool StationGui_BackButton(bool abEnabled = true, int alState = -1, bool abSound = true)
{
	tString sPrevTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory("GUI");
	
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/small_corner_slanted_bottomleft");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/small_corner_slanted_topleft");
	}
	else
	{
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/big_corner_slanted_bottomleft");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/big_corner_slanted_topleft");
	}

	button.mFontAlign = eFontAlign_Center;
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	
	cImGuiGfx gfx_button_ornament("station/chinsymbol/big_default_exit");		
	
	if (abEnabled==false) gfx_button_ornament.mColor.a = 0.2;
	ImGui_SetModUseInput(abEnabled);
	ImGui_SetModUISizeHoriExpansion(0, 4.8);
	bool bPressed = ImGui_DoButtonExt("BackButton", "Back", button, ImGui_NrmPosGroup(0.005, 0.9095, 4), ImGui_NrmSizeGroup(0.205, 0.083334));
	ImGui_SetModUISizeHoriExpansion(0, 0);

	ImGui_SetModUseInput(true);
	
	if (bPressed)
	{
		ImGui_SetStateInt("StationGui_ActiveApp", alState);
		if (abSound) Depth_Audio_Terminal_Back(ImGui_GetName());
	}
	
	ImGui_DoImageCorrectAspect(gfx_button_ornament, ImGui_NrmPosGroup(0.145, 0.929, 0.3), ImGui_NrmSizeGroup(0.06));
	
	ImGui_SetTransCategory(sPrevTransCat);
	return bPressed;
}
	
//-------------------------------------------------------

int StationGui_FileList(const tString &in asCaption, const tString &in asFileNamePrefix, int alFileCount, 
						const cVector3f &in avPos = cVector3f_Zero, const cVector2f &in avSize = ImGui_NrmSizeGroup(cVector2f(0.35, 0.875)))
{		
	cImGuiButtonData toggleButton = StationGui_CreateToggleButtonData();
	toggleButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
	
	int lSelectedFile = -1;
	
	ImGui_DoWindowStart(asCaption, PathOS_CreateDefaultWindowData(), avPos, avSize);
	if (alFileCount > 0)
	{
		for (int i = 1; i <= alFileCount; i++)
		{
			ImGui_AddItemString(asFileNamePrefix+"_"+i);
		} 
		lSelectedFile = ImGui_DoMultiToggleExt("FileSelection", -1, 1, ImGui_NrmSizeGroup(cVector2f(0, 0.02)), toggleButton, 
												ImGui_NrmPosGroup(cVector3f(0.05, 0.045, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, cMath_Min(1.f, 0.135*alFileCount))));
		lSelectedFile++;
	}
	ImGui_DoWindowEnd();
	
	return lSelectedFile;
}
	
//-------------------------------------------------------

int StationGui_FileList(const tString &in asCaption, int alFileCount, const cVector3f &in avPos = cVector3f_Zero, const cVector2f &in avSize = ImGui_NrmSizeGroup(cVector2f(0.35, 0.875)))
{		
	cImGuiButtonData toggleButton = PathOS_CreateToggleButtonData();
	toggleButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
	
	int lSelectedFile = -1;
	
	ImGui_DoWindowStart(asCaption, PathOS_CreateDefaultWindowData(), avPos, avSize);
	if (alFileCount > 0)
	{
		lSelectedFile = ImGui_DoMultiToggleExt("FileSelection", -1, 1, ImGui_NrmSizeGroup(cVector2f(0, 0.02)), toggleButton, 
												ImGui_NrmPosGroup(cVector3f(0.05, 0.045, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, cMath_Min(1.f, 0.135*alFileCount))));
		lSelectedFile++;
	}
	ImGui_DoWindowEnd();
	
	return lSelectedFile;
}
	
//-------------------------------------------------------

int StationGui_FileList(int alFileCount, int alDefaultSelection = 0, const cVector3f &in avPos = ImGui_NrmPosGroup(0.02, 0.03, 1), const cVector2f &in avSize = ImGui_NrmSizeGroup(0.35, 0.9))
{
	cImGuiButtonData button = PathOS_CreateToggleButtonData();
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	ImGui_GroupBegin(avPos, avSize);
		float fButtonHeight = 0.1f;
		float fButtonSpace = 0.05f;
		float fListHeight = (fButtonHeight+fButtonSpace)*(alFileCount-1)+fButtonHeight;
		
		int lSelection = ImGui_DoMultiToggleExt(ImGui_GetName()+"_FileList", alDefaultSelection, 1, ImGui_NrmSizeGroup(0, fButtonSpace), button, 
												ImGui_NrmPosGroup(0, 0, 1), ImGui_NrmSizeGroup(0.93, fListHeight));
												
		cImGuiGfx gfx_line("stationV2/misc/GUI_line");
		ImGui_DrawLineExt(ImGui_NrmPos2Group(1, 0, true), ImGui_NrmPos2Group(1, 1, true), 2, ImGui_NrmSize(0.004).x, gStationGuiColor_Normal, gfx_line);
	ImGui_GroupEnd();
	
	return lSelection;
}
	
//-------------------------------------------------------

/////////////////////////////////////////
// ERROR BOXES
/////////////////////////////////////////
	
//-------------------------------------------------------

tString StationGui_GetError()
{
	return Entity_GetVarString(ImGui_GetName(), "StationGui_Error");
}

//-------------------------------------------------------		

void StationGui_SetError(const tString&in asErrorMsg, const tString &in asSoundEffect = "")
{
	tString sEntity = ImGui_GetName();
	Entity_SetVarString(sEntity, "StationGui_Error", asErrorMsg);
	
	if (asErrorMsg != "")
	{
		if (asSoundEffect != "") Sound_CreateAtEntity(sEntity+"_Error", asSoundEffect, sEntity, 0.0f, false, 1.0f);
		else Depth_Audio_Terminal_Error(sEntity);
	}
}
	
//-------------------------------------------------------

/**
 * Draws an error box with an optional OK button that disables the error.
 * 
 * @param abDisplayOKButton, If the OK button should be displayed. Defaults to true.
 **/
bool StationGui_ErrorBoxV2(bool abDisplayOKButton=true)
{
	tString sError = StationGui_GetError();
	if (sError == "") return true;
	
	cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
	dialogBox.mType = abDisplayOKButton ? eGuiDialogBoxType_OK : eGuiDialogBoxType_NoButton;
	
	tString sPrevTransCat = ImGui_GetTransCategory();
	
	ImGui_SetTextOverride(cResources_Translate("GUI", "Error"));
	eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("", sError, dialogBox);
	ImGui_ClearTextOverride();
	
	if (buttonPressed==eGuiDialogCode_OK)
	{
		Depth_Audio_Terminal_Forward(ImGui_GetName());
		StationGui_SetError("");
	}
	
	return buttonPressed==eGuiDialogCode_OK;
}
	
//-------------------------------------------------------

/**
 * Draws an error box with an optional OK button that disables the error.
 * SHOULD USE StationGui_ErrorBoxV2 instead!
 * 
 * @param abDisplayOKButton, If the OK button should be displayed. Defaults to true.
 **/
bool StationGui_ErrorBox(bool abDisplayOKButton=true)
{
	tString sError = StationGui_GetError();
	if (sError == "") return true;
	
	tString sPrevTransCat = ImGui_GetTransCategory();

	bool bOkPressed = false;
	ImGui_SetTransCategory("GUI");
	StationGui_DialogBox_Start("Error", "", cVector2f(0.6, 0.3));
	ImGui_SetTransCategory(sPrevTransCat);
	
	StationGui_DialogBox_Text(sError);
	
	ImGui_SetTransCategory("GUI");
	if (abDisplayOKButton)
	{
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
		if (ImGui_DoButtonExt("ErrorOK", "OK", button, ImGui_NrmPosGroup(cVector3f(0.35, 0.5, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.4))))
		{
			Depth_Audio_Terminal_Forward(ImGui_GetName());
			StationGui_SetError("");
			bOkPressed=true;
		}
	
	}
	StationGui_DialogBox_End();
	
	ImGui_SetTransCategory(sPrevTransCat);
	return bOkPressed;
}
	
//-------------------------------------------------------

/**
 * Simple helper for displaying error messages. Returns true if an error is being displayed.
 * 
 **/
bool StationGui_DrawAndCheckErrorsV2()
{
	if (StationGui_GetError() != "")
	{
		return StationGui_ErrorBoxV2()==false;
	}
	
	return false;
}
	
//-------------------------------------------------------

/**
 * Simple helper for displaying error messages. Returns true if an error is being displayed.
 * 
 **/
bool StationGui_DrawAndCheckErrors()
{
	if (StationGui_GetError() != "")
	{
		return StationGui_ErrorBox()==false;
	}
	
	return false;
}

