/////////////////////////////////////////
// STATION NUMPAD
/////////////////////////////////////////

//-------------------------------------------------------
	
bool StationGui_Numpad(const tString &in asHeader, uint alMaxChars, float afNumpadDisplayRatio = 0.2,
					   const cVector3f &in avPos=ImGui_NrmPos(cVector3f(0.125, 0.1, 1.5)), 
					   const cVector2f &in avSize=ImGui_NrmSizeGroup(cVector2f(0.75, 0.675)))
{
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
	
	tString sTransCat = ImGui_GetTransCategory();
	tString sInput = Entity_GetVarString(ImGui_GetName(), "NumpadInput");
		
	ImGui_GroupBegin(avPos, avSize);	
		ImGui_DoWindowStart(asHeader, PathOS_CreateDefaultWindowData(), 0, ImGui_NrmSizeGroup(cVector2f(1, afNumpadDisplayRatio-0.01f)));
				cImGuiLabelData labelData = ImGui_GetDefaultLabel();
				labelData.mFontAlign = eFontAlign_Center;
				labelData.mFont.mvSize = 20;
				float mfFontSizeMul = ImGui_NrmSizeGroupKeepRatio(0.04).y; // Let font size depend on window height 
				
				ImGui_SetTransCategory("");
				ImGui_DoLabelExt(sInput, labelData, ImGui_NrmPosGroup(cVector3f(0, 0, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)), mfFontSizeMul);
			
		ImGui_DoWindowEnd();	
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.155, afNumpadDisplayRatio+0.01f, 2)), ImGui_NrmSizeGroup(cVector2f(0.585, 0.956-(afNumpadDisplayRatio+0.01f))));
			
			////////////////////////////
			// Number buttons
			sInput += StationGui_NumpadButton(cVector3f(0, 0, 0.1), sInput.length() < alMaxChars, "7", button);
			sInput += StationGui_NumpadButton(cVector3f(0.333, 0, 0.1), sInput.length() < alMaxChars, "8", button);
			sInput += StationGui_NumpadButton(cVector3f(0.666, 0, 0.1), sInput.length() < alMaxChars, "9", button);
			sInput += StationGui_NumpadButton(cVector3f(0, 0.25, 0.1), sInput.length() < alMaxChars, "4", button);
			sInput += StationGui_NumpadButton(cVector3f(0.333, 0.25, 0.1), sInput.length() < alMaxChars, "5", button);
			sInput += StationGui_NumpadButton(cVector3f(0.666, 0.25, 0.1), sInput.length() < alMaxChars, "6", button);
			sInput += StationGui_NumpadButton(cVector3f(0, 0.5, 0.1), sInput.length() < alMaxChars, "1", button);
			sInput += StationGui_NumpadButton(cVector3f(0.333, 0.5, 0.1), sInput.length() < alMaxChars, "2", button);
			sInput += StationGui_NumpadButton(cVector3f(0.666, 0.5, 0.1), sInput.length() < alMaxChars, "3", button);
			sInput += StationGui_NumpadButton(cVector3f(0.333, 0.75, 0.1), sInput.length() < alMaxChars, "0", button);
			
			////////////////////////////
			// Clear button
			ImGui_SetTransCategory("GUI");
			if (ImGui_DoButtonExt("Numpad_Clear", "NumPadClear", button,
				ImGui_NrmPosGroup(cVector3f(0, 0.75, 0.1)), ImGui_NrmSizeGroup(cVector2f(0.32, 0.23))))
			{
				//Sound_CreateAtEntity("TerminalNegative", "Entities_Station/tech/terminal_beeps/terminal_negative", ImGui_GetName(), 0.0f, false, 1.0f);
				Depth_Audio_Terminal_Negative(ImGui_GetName());
				sInput = "";
			}
			Entity_SetVarString(ImGui_GetName(), "NumpadInput", sInput);
			
			////////////////////////////
			// OK button
			ImGui_SetModUseInput(sInput.length() == alMaxChars);
			bool bOKPressed = ImGui_DoButtonExt("Numpad_OK", "OK", button, ImGui_NrmPosGroup(cVector3f(0.666, 0.75, 0.1)), ImGui_NrmSizeGroup(cVector2f(0.32, 0.23)));
			ImGui_SetModUseInput(true);
		ImGui_GroupEnd();
	ImGui_GroupEnd();
	
	ImGui_SetTransCategory(sTransCat);
	return bOKPressed;
}

//-------------------------------------------------------
	
tString StationGui_NumpadButton(const cVector3f &in avPos, bool abAllowOutput, const tString &in asNum, 
								const cImGuiButtonData &in aButton, const tString &in asOutput="", 
								const cVector2f &in avSize=ImGui_NrmSizeGroup(cVector2f(0.32, 0.23)))
{
	tString bReturn = "";
	
	tString sTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory("");
	if (ImGui_DoButtonExt("Numpad_" + asNum, asNum, aButton, ImGui_NrmPosGroup(avPos), avSize))
	{
		//Sound_CreateAtEntity("TerminalForward", "Entities_Station/tech/terminal_beeps/terminal_forward", ImGui_GetName(), 0.0f, false, 1.0f);
		Depth_Audio_Terminal_Forward(ImGui_GetName());
		if (abAllowOutput) bReturn = (asOutput=="") ? asNum : asOutput;
	}
	ImGui_SetTransCategory(sTransCat);
	return bReturn;
}

//-------------------------------------------------------
	
tString StationGui_GetNumpadInput()
{
	return Entity_GetVarString(ImGui_GetName(), "NumpadInput");
}

//-------------------------------------------------------
	
void StationGui_SetNumpadInput(const tString &in asInput)
{
	Entity_SetVarString(ImGui_GetName(), "NumpadInput", asInput);
}
	
