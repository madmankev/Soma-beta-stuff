/////////////////////////////////////////
// AUDIO PLAYER APPS
/////////////////////////////////////////

//-------------------------------------------------------
		 
class cGuiAudioAppEntry
{
	tString msTitle;
	tString msFile;
	tString msCallback;
	bool mbIsVoice;
}

array<cGuiAudioAppEntry> gvAudioAppEntries;

//-------------------------------------------------------

/**
 * Adds a sound file to the audio player app. Do this before calling the Audio Player helper.
 * 
 * @param asTitle, name of the file to appear in the app.
 * @param asFile, the actual sound file to play.
 * 
 **/
void Depth_ImGui_AddAudioFile_Sound(const tString &in asTitle, const tString &in asFile)
{
	cGuiAudioAppEntry file;
	file.msTitle = asTitle;
	file.msFile = asFile;
	file.mbIsVoice = false;
	gvAudioAppEntries.push_back(file);
}

//-------------------------------------------------------

/**
 * Adds a voice subject to the audio player app. Do this before calling the Audio Player helper.
 * 
 * @param asTitle, name of the file to appear in the app.
 * @param asSubject, the voice subject.
 * @param asCallback, voice subject callback.
 * 
 **/
void Depth_ImGui_AddAudioFile_Voice(const tString &in asTitle, const tString &in asSubject, const tString &in asCallback="")
{
	cGuiAudioAppEntry file;
	file.msTitle = asTitle;
	file.msFile = asSubject;
	file.msCallback = asCallback;
	file.mbIsVoice = true;
	gvAudioAppEntries.push_back(file);
}

//-------------------------------------------------------

/**
 * Removes any audio player files that have been added. 
 * The Audio Player app should do this automatically.
 * 
 **/
void Depth_ImGui_ClearAudioFiles()
{
	gvAudioAppEntries.resize(0);
}

//-------------------------------------------------------

bool Depth_ImGui_PlaybackActive()
{
	return ImGui_GetStateBool("FilePlaybackActive", false);
}

//-------------------------------------------------------

/**
 * Stops audio file playback, regardless of whether the file playing is a sound or a voice subject.
 * This can be called from outside of an OnGui function.
 * 
 * @param asTerminal, name of the terminal.
 * 
 **/
void Depth_ImGui_StopAudioFilePlayback(const tString &in asTerminal, bool abUnduckAudio=false)
{	
	Terminal_SetImGuiStateInt(asTerminal, "FilePlaybackActive", 0);
	Terminal_StopImGuiFade(asTerminal, "FilePlayback");
	Terminal_SetImGuiStateFloat(asTerminal, "FilePlayback", 0);

	Terminal_SetUpdateWhenOutOfView(asTerminal, false);
	
	////////////////////////
	// Audio ducking
	if (abUnduckAudio && ImGui_GetStateBool("AudioDucked", false))
	{
		Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_WorldAll);
		Music_FadeVolumeMul(1.0f, 2.0f);
		ImGui_SetStateBool("AudioDucked", false);
	}
					
	if (Sound_Exists(asTerminal+"_AudioPlaybackSound"))
		Sound_Stop(asTerminal+"_AudioPlaybackSound", 0.3);

	tString sScene = Entity_GetVarString(asTerminal, "VoicePlaybackScene");
	if (sScene=="")
		return;

	cLux_AddDebugMessage("Stop scene "+sScene);

	Voice_Stop(sScene);
	Entity_SetVarString(asTerminal, "VoicePlaybackScene", "");
}

//-------------------------------------------------------

/**
 * Checks if the audio file has stopped playing and sets the playback variables accordingly.
 * 
 **/
bool Depth_ImGui_CheckAudioFilePlaybackEnd()
{
	if (Depth_ImGui_PlaybackActive()==false) return false;

	/////////////////////
	// Check voice
	tString sScene = Entity_GetVarString(ImGui_GetName(), "VoicePlaybackScene");
	if (sScene != "" && !Voice_SceneIsActive(sScene))
	{
		Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
		return true;
	}

	/////////////////////
	// Check audio
	if (sScene == "" && !Sound_Exists(ImGui_GetName()+"_AudioPlaybackSound"))
	{
		Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
		return true;
	}

	return false;
}

