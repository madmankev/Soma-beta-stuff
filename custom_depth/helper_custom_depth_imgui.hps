/////////////////////////////////////////
// OSCILLATING SIGNAL VALUES
/////////////////////////////////////////

//-------------------------------------------------------

float Depth_ImGui_GetOscillatingSignalValue(const tString &in asPrefix, int alIndex, eEasing aFadeType=eEasing_Linear, float afMin=0.1f, float afMax=0.9f, float afFreqMul = 1.0f)
{
	tString sFadeVarName = asPrefix + "_signal_" + alIndex;
		
	if(ImGui_IsFading(sFadeVarName)==false || ImGui_FadeOver(sFadeVarName))
	{
		ImGui_FadeStateFloat(sFadeVarName, cMath_RandRectf(afMin, afMax), cMath_RandRectf(0.75f, 1.5f)*afFreqMul, aFadeType); 
	}
		 
	return ImGui_GetStateFloat(sFadeVarName);
}	

//-------------------------------------------------------

/////////////////////////////////////////
// LOADING
/////////////////////////////////////////

//-------------------------------------------------------

/**
 * Draws a Gauge that fills up in a noisy manner over time.
 * 
 * @param asName, Unique identifier for this gauge.
 * @param afLoadTime, approximate time it should take to fill the gauge.
 * @param abResetWhenDone, if values should be reset automatically when the loading is complete. Use this if you stop showing the gauge when complete and want to be able to restart the loading. Use Depth_ImGui_ResetLoadingGauge to reset a gauge manually.
 * @param avPos, position for the top left corner of the gauge.
 * @param avSize, size of the gauge.
 * @param aData, gauge data to use.
 * 
 * @return bool, true if the gauge has been filled up.
 **/
bool Depth_ImGui_LoadingGauge(const tString &in asName, float afLoadTime, bool abResetWhenDone, const cVector3f &in avPos, 
							  const cVector2f &in avSize, const cImGuiGaugeData &in aData)
{
	
	float fLoadValue = Depth_ImGui_Loading(asName, 0, 1.0f, afLoadTime, abResetWhenDone);
	
	////////////////////////////////
	// Draw gauge
	ImGui_DoGauge(aData, fLoadValue, avPos, avSize);
	
	return fLoadValue == 1.0f;
}

//-------------------------------------------------------

/**
 * Checks if there is a loading in progress with the specified name
 * 
 * @param asName, Loading name
 * 
 * @return bool, true if loading is in progress.
 **/
bool Depth_ImGui_LoadingInProgress(const tString &in asName)
{
	return ImGui_GetStateInt(asName+"Initialized", 0) > 0;
}

//-------------------------------------------------------

/**
 * Resets the specified loading gauge to 0.
 * 
 * @param asName, Unique identifier for this gauge.
 * 
 **/
void Depth_ImGui_ResetLoadingGauge(const tString &in asName)
{
	ImGui_SetStateInt(asName+"Initialized", 0);
	ImGui_StopFade(asName+"Counter");
	ImGui_SetStateFloat(asName+"Counter", 0);
}

//-------------------------------------------------------

/**
 * Returns the loading progress with the specified name.
 * 
 * @param asName, Loading name
 * @param afStart, Value that the loading started at, usually 0.
 * @param afGoal, Value that the loading is loading towards. Usually 1.
 * 
 * @return float, loading progress.
 **/
float Depth_ImGui_GetLoadingValue(const tString &in asName, float afStart = 0, float afGoal = 1)
{
	return afStart + ImGui_GetStateFloat(asName+"Counter", 0)*(afGoal-afStart);
}

//-------------------------------------------------------

/**
 * Sets the loading progress of the specified name.
 * 
 * @param asName, Loading name
 * @param afValue, Value to set.
 * @param afStart, Value that the loading started at, usually 0.
 * @param afGoal, Value that the loading is loading towards. Usually 1.
 * 
 * @return float, loading progress.
 **/
void Depth_ImGui_SetLoadingValue(const tString &in asName, float afValue, float afStart = 0, float afGoal = 1)
{
	ImGui_SetStateFloat(asName+"Counter", (afValue-afStart)/(afGoal-afStart));
}

//-------------------------------------------------------

/**
 * Updates the loading of the specified name.
 * 
 * @param asName, Loading name
 * @param afStart, Value that the loading started at, usually 0.
 * @param afGoal, Value that the loading is loading towards. Usually 1.
 * @param afLoadTime, approximate time it should take to finish loading.
 * @param abResetWhenDone, if values should be reset automatically when the loading is complete. Use this if you stop showing the gauge when complete and want to be able to restart the loading. Use Depth_ImGui_ResetLoadingGauge to reset a gauge manually.
 * 
 * @return float, loading progress.
 **/
float Depth_ImGui_Loading(const tString &in asName, float afStart, float afGoal, float afLoadTime, bool abResetWhenDone)
{
	////////////////////////
	// Initialize counter
	if (ImGui_GetStateInt(asName+"Initialized", 0) == 0)
	{
		Map_RemoveTimer(ImGui_GetName()+asName+"LoadTimer");
		
		float fTimerTime = (1.f-ImGui_GetStateFloat(asName+"Counter", 0))*afLoadTime;
		
		Map_AddTimer(ImGui_GetName()+asName+"LoadTimer", fTimerTime, "");
		
		ImGui_SetStateInt(asName+"Initialized", 1);
	}
	
	////////////////////////////////
	// Increase current value
	float fTarget = 1.f-(Map_GetTimerTime(ImGui_GetName()+asName+"LoadTimer")/afLoadTime);
	float fCurrent = ImGui_GetStateFloat(asName+"Counter", 0);
	if (cMath_RandRectl(0, 5)==0 || cMath_Abs(fTarget-fCurrent) > 0.2)
	{
		ImGui_FadeStateFloat(asName+"Counter", fTarget, afLoadTime*0.05f, eEasing_Linear);
	}
	
	bool bDone = fCurrent >= 0.99;
	
	/////////////
	// Reset
	if (bDone && abResetWhenDone)
	{
		ImGui_SetStateInt(asName+"Initialized", 0);
		ImGui_StopFade(asName+"Counter");
		ImGui_SetStateFloat(asName+"Counter", 0);
	}
	
	if (bDone)
		return afGoal;
	
	return afStart + fCurrent*(afGoal-afStart);
}

//-------------------------------------------------------

/////////////////////////////////////////
// INPUT
/////////////////////////////////////////

//-------------------------------------------------------

const float gStationGuiReaderInputTick = 0.1f;

//-------------------------------------------------------

void Depth_ImGui_InputScroll(const tString &in asName, float afScrollVal, float afOverlap)
{
	if (afOverlap <= 0.0f) return;
	
	float fTime = ImGui_GetStateFloat("ScrollTime_"+asName);
	
	fTime+=ImGui_GetTimeStep();
	
	if (fTime>gStationGuiReaderInputTick)
	{
		fTime-=gStationGuiReaderInputTick;
		
		if ( ImGui_ActionIsDown(eImGuiAction_Down) && (afScrollVal<afOverlap) )
		{
			afScrollVal = cMath_Min(afOverlap, afScrollVal+1.0f);
		}
		else if ( ImGui_ActionIsDown(eImGuiAction_Up) && (afScrollVal>0.0f) )
		{
			afScrollVal = cMath_Max(0.0f, afScrollVal-1.0f);
		}
	}
	
	ImGui_SetStateFloat("ScrollTime_"+asName,fTime);
	ImGui_SetStateFloat("ScrollValue_"+asName,afScrollVal);
}

//-------------------------------------------------------

float Depth_ImGui_GetScrollValue(const tString &in asName)
{
	return ImGui_GetStateFloat("ScrollValue_"+asName, 0);
}

//-------------------------------------------------------

void Depth_ImGui_SetScrollValue(const tString &in asName, float afValue)
{
	ImGui_SetStateFloat("ScrollValue_"+asName, afValue);
}

