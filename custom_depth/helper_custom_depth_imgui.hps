////////////////////////////////////////////////////////////
// PathOS - Default widget data creators
////////////////////////////////////////////////////////////

//-------------------------------------------------------

cImGuiButtonData PathOS_CreateDefaultButtonData()
{
	cImGuiButtonData button;
	
	button.mColorBase = gStationGuiColor_Normal;
	button.mbUseInFocusColor = true;
	button.mColorInFocus = gStationGuiColor_Highlight;
	button.mbUseTriggeredColor = true;
	button.mColorTriggered = gStationGuiColor_Warning;
	button.mbUseDisabledColor = true;
	button.mColorDisabled = gStationGuiColor_Disabled;
	button.mbUseBackgroundGfx = false;
	button.mbUseInFocusGfx = false;
	button.mbUseTriggeredGfx = false;
	button.mbUseFrame = true;
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		button.mGfxFrame.mGfxBorderBottom.SetFile("stationV2/button/small_border_bottom");
		button.mGfxFrame.mGfxBorderLeft.SetFile("stationV2/button/small_border_left");
		button.mGfxFrame.mGfxBorderRight.SetFile("stationV2/button/small_border_right");
		button.mGfxFrame.mGfxBorderTop.SetFile("stationV2/button/small_border_top");
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/small_corner_bottomleft");
		button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_slanted_bottomright");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/small_corner_topleft");
		button.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/small_corner_topright");
	}
	
	else
	{
		button.mGfxFrame.mGfxBorderBottom.SetFile("stationV2/button/big_border_bottom");
		button.mGfxFrame.mGfxBorderLeft.SetFile("stationV2/button/big_border_left");
		button.mGfxFrame.mGfxBorderRight.SetFile("stationV2/button/big_border_right");
		button.mGfxFrame.mGfxBorderTop.SetFile("stationV2/button/big_border_top");
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/big_corner_bottomleft");
		button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_slanted_bottomright");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/big_corner_topleft");
		button.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/big_corner_topright");
	}
	
	button.mGfxFrame.mGfxBackground.mColor.a = 0.7f;
	button.mFont.SetFile("sansation_large_additive.fnt");
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0625);
	button.mFont.mMaterial = eGuiMaterial_Additive;
	
	return button;
}

//-------------------------------------------------------

cImGuiButtonData PathOS_CreateToggleButtonData()
{
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	button.mbUseTriggeredAndInFocusColor = true;
	button.mColorTriggeredAndInFocus = gStationGuiColor_FocusedAndSelected;
	return button;
}

