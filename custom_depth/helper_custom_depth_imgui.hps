// PathOS - Shared 
/////////////////////////////////////////

//-------------------------------------------------------

void PathOS_PopUpWindow(const tString&in asCaption, const tString&in asText, float afZ=3.5f)
{
	//////////////////////////////////
	// Setup widget data
	cImGuiWindowData window = PathOS_CreateDefaultWindowData();
	cImGuiTextFrameData textData = PathOS_CreateDefaultTextFrameData();
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	cImGuiGfx gfx_denied_icon("stationV2/ossymbols/ossymbol_denied");
	gfx_denied_icon.mColor = cColor_Red;
	
	textData.mbUseBackgroundGfx = false;
	textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	textData.mFontAlign = eFontAlign_Center;
	textData.mColorText = cColor(0.8, 1);
	
	ImGui_SetTransCategory("");
	
	ImGui_DoWindowStart("", window, ImGui_NrmPos(cVector3f(-0.1, -0.1, afZ)), ImGui_NrmSize(cVector2f(2, 2)));
	ImGui_DoWindowEnd();

	///////////////////////////////////////
	// Show message
	ImGui_DoWindowStart(asCaption, window, ImGui_NrmPos(cVector3f(0.25, 0.25, afZ+1.0)), ImGui_NrmSize(cVector2f(0.5, 0.35)));
	
		afZ+=1.1;
		
		if (asText == "") return;
		ImGui_DoTextFrameExt(asText, ImGui_NrmSizeGroup(cVector2f(0.05, 0)), 0, 0, textData, 
						  ImGui_NrmPosGroup(cVector3f(0.0, 0.1, afZ)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
						  
		ImGui_SetModUseInput(true);

		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.05);
		ImGui_DoButtonExt("ErrorOKButton", cString_To8Char(cResources_Translate("PathOS", "MsgOK")), button, ImGui_NrmPosGroup(cVector3f(0.67, 0.7, afZ)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.25)));
		
		ImGui_SetModUseInput(false);
		
		if(ImGui_PrevPressed()) ImGui_SetStateInt("PathOS_MessageShowErrorWindow", -1);

		ImGui_DrawGfx(gfx_denied_icon, ImGui_NrmPosGroup(cVector3f(0.5, 1.55, afZ)), ImGui_GetRatioCorrectSizeByNrmHeight(gfx_denied_icon, 0.4));
		
	ImGui_DoWindowEnd();
}

int PathOS_DoSubjectList(const tString &in asHeader, const array<tString> &in avSubjectEntries, cImGuiButtonData &in aButton, int alDefaultSelection=-1)
{
	//////////////
	//Conversations label
	cImGuiLabelData labelData;
	labelData.mColorBase = gStationGuiColor_Normal;
	labelData.mFont.mColor = cColor_White*5;
	labelData.mFontAlign = eFontAlign_Center;
	labelData.mFont.SetFile("sansation_large_additive.fnt");
	labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.02);
	labelData.mFont.mMaterial = eGuiMaterial_Additive;
	labelData.mbUseBackgroundGfx = true;
	
	ImGui_SetTransCategory("");
	ImGui_DoLabelExt(asHeader, labelData, ImGui_NrmPosGroup(cVector3f(0.02, 0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.04)), ImGui_NrmSizeKeepRatio(0.002).y);
	for(uint i=0;i<avSubjectEntries.size();i++)
	{
		tString sTopicButton = avSubjectEntries[i];
		if(sTopicButton.length() > 20)
		{
			sTopicButton.resize(20);
			sTopicButton += "...";
		}
		ImGui_AddItemString(sTopicButton);
	}
	int lSelection = ImGui_DoMultiToggleExt("MsgConversations_MessageTopics", alDefaultSelection, 1, ImGui_NrmSizeGroup(cVector2f(0, 0.005)), aButton, 
											 ImGui_NrmPosGroup(cVector3f(0.02, 0.08, 1.2)), ImGui_NrmSizeGroup(cVector2f(0.35, avSubjectEntries.size()*0.12-0.005)));

	//////////////
	//Lines right of button and top of screen below title
	ImGui_DrawLineExt(cVector2f(ImGui_NrmPosGroup(0.415).x, 0), cVector2f(ImGui_NrmPosGroup(0.415).x,ImGui_NrmPosGroup(0.95).y), 1.1, ImGui_NrmSize(0.004).x, gStationGuiColor_Normal,  cImGuiGfx("stationV2/misc/GUI_line"));
	
	return lSelection;
}
	
