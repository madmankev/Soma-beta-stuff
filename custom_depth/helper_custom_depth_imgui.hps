/////////////////////////////////////////
// DIALOG BOXES
/////////////////////////////////////////

//-------------------------------------------------------

enum eGuiDialogBoxType
{
	eGuiDialogBoxType_NoButton,
	eGuiDialogBoxType_OK,
	eGuiDialogBoxType_OKCancel,
}

//-------------------------------------------------------

enum eGuiDialogCode
{
	eGuiDialogCode_None,
	eGuiDialogCode_OK,
	eGuiDialogCode_Cancel,
}

//-------------------------------------------------------

class cGuiDialogBoxSettings
{
	float mfZ = 1.5f; //Z-pos of dialog box
	bool mbEndWindow = true; // If ImGui_DoWindowEnd() should be called at the end of the function.
	cVector2f mvSize; //Size of window
	bool mbUseCustomPos = false; // If the dialog box should be placed somehwere else than at the ceneter of the screen.
	cVector3f mvCustomPos; // Custom pos of the dialog box.
	eGuiDialogBoxType mType = eGuiDialogBoxType_NoButton; // Determines what buttons the dialog box should provide.
	tString msOKButtonText = "OK";
	tString msCancelButtonText = "Cancel";
	
	tString msCustomOKSound = "";
	tString msCustomCancelSound = "";
	
	cImGuiWindowData mWindow;
	cImGuiTextFrameData mTextFrame;
	cImGuiButtonData mButton;
}

//-------------------------------------------------------

eGuiDialogCode Depth_ImGui_DialogBox(const tString&in asCaption, const tString&in asText, const cGuiDialogBoxSettings &in aSettings)
{	
	tString sCurrentTransCat = ImGui_GetTransCategory();
	
	///////////////////////////////////////
	// Show message 
	cVector3f vPos; 
	if (aSettings.mbUseCustomPos)
		vPos = aSettings.mvCustomPos;
	else
	{
		cVector2f vScreenSize = ImGui_GetSize();
		vPos.x = (vScreenSize.x-aSettings.mvSize.x)*0.5;
		vPos.y = (vScreenSize.y-aSettings.mvSize.y)*0.5;
		vPos.z = aSettings.mfZ;
	}
	
	eGuiDialogCode returnCode = eGuiDialogCode_None;
	ImGui_DoWindowStart(asCaption, aSettings.mWindow, vPos,aSettings.mvSize);
		
		ImGui_DoTextFrameExt(asText, 0, 0, 0, aSettings.mTextFrame, 
								 ImGui_NrmPosGroup(0.0, 0.0,1), ImGui_NrmSizeGroup(1));
				
		ImGui_SetTransCategory("GUI");
		ImGui_SetAlignment(eImGuiAlign_CenterCenter); 
		if (aSettings.mType == eGuiDialogBoxType_OK)
		{
			if (ImGui_DoButtonExt("DialogOK", aSettings.msOKButtonText, aSettings.mButton, 
								  ImGui_NrmPosGroup(cVector3f(0.5, 1, 1))-cVector3f(0, aSettings.mButton.mvDefaultSize.y*0.5, 0)))
			{
				returnCode = eGuiDialogCode_OK;
			}
		}
		else if (aSettings.mType == eGuiDialogBoxType_OKCancel)
		{
			if (ImGui_DoButtonExt("DialogOK", aSettings.msOKButtonText, aSettings.mButton, 
								  ImGui_NrmPosGroup(cVector3f(0.25, 1, 1))-cVector3f(0, aSettings.mButton.mvDefaultSize.y*0.5, 0)))
			{
				returnCode = eGuiDialogCode_OK;
			}
			if (ImGui_DoButtonExt("DialogCancel", aSettings.msCancelButtonText, aSettings.mButton, 
								  ImGui_NrmPosGroup(cVector3f(0.75, 1, 1))-cVector3f(0, aSettings.mButton.mvDefaultSize.y*0.5, 0)))
			{
				returnCode = eGuiDialogCode_Cancel;
			}
		}
		ImGui_SetAlignment(eImGuiAlign_LastEnum);
		
	// Only close window if mbEndWindow is true
	if (aSettings.mbEndWindow) ImGui_DoWindowEnd();
	
	ImGui_SetTransCategory(sCurrentTransCat);
	return returnCode;
}

//-------------------------------------------------------

/////////////////////////////////////////
// STATION SPECIFIC
/////////////////////////////////////////

/////////////////////////////////////////
// Colors

//----------------- Primary -------------------------
/// used for stationary things like frames, or inactive elements like buttons.
cColor gStationGuiColor_Normal = cColor(0.227f, 0.51f, 0.557f); // #3a828e
/// for mouseover/hover effects or whenever green is needed.
cColor gStationGuiColor_Highlight = cColor(0.576f, 0.612f, 0.184f); // #939c2f
/// for warning or error screens, active buttons and elements.
cColor gStationGuiColor_Warning = cColor(0.706f, 0.208f, 0.082f); // #b43515

/// For focused AND selected
cColor gStationGuiColor_FocusedAndSelected = cColor(0.9, 0.6, 0.1);

//----------------- Secondary -------------------------
/// for the use with ornamental graphics like the chinese symbols.
cColor gStationGuiColor_Normal2 = cColor(0.396f, 0.698f, 0.745f); // #65b2be
/// for whenever you need yellow.
cColor gStationGuiColor_Highlight2 = cColor(0.655f, 0.592f, 0.176f); // #a7972d
/// for blazing "end of the world" red.
cColor gStationGuiColor_Warning2 = cColor(0.698f, 0.035f, 0.035f); // #b20909

//----------------- Tertiary -------------------------
/// for inactive/disabled stuff.
cColor gStationGuiColor_Disabled = cColor(0.192f, 0.192f, 0.192f); // #313131

//-------------------------------------------------------

void StationGuiBG_Scanlines(float afZ=10.0f, const tString &in asFile="station/scanlines/standard_tileable")
{
	cImGuiGfx gfx(asFile);
	gfx.mColor = cColor(0.008f, 0.238f, 0.23f, 1.0f);
	gfx.mvUVMax = cVector2f(1.0f, 4.0f);
	gfx.mMaterial = eGuiMaterial_Additive;
	
	ImGui_DrawGfx(gfx, cVector3f(0,0,afZ), ImGui_GetSize());
}

//-------------------------------------------------------

void StationGuiBG_Backdrop(float afZ=0.0f, const tString &in asFile="station/background/column")
{
	cImGuiGfx gfx(asFile);
		
	ImGui_DrawGfx(gfx, cVector3f(0,0, afZ), ImGui_GetCurrentGroupSize());
}

//-------------------------------------------------------

void StationGuiBG_BackdropV2(const tString &in asFile="background_logo_pathOS", cVector2f avRelPos=cVector2f(0.1,0.45), float avRelSize=0.5f, float afZ=0.0f)
{
	cImGuiGfx gfx(asFile);
	gfx.mColor.a = 0.35;
	
	cVector2f vSize = ImGui_GetRatioCorrectSizeByNrmWidth(gfx, avRelSize);
	cVector3f vPos = ImGui_NrmPos(cVector3f(avRelPos.x,avRelPos.y,afZ));
	
	ImGui_DrawGfx(gfx, vPos, vSize);
}

//-------------------------------------------------------

void StationGuiBG_FlatColor(float afZ=0.0f, const cColor &in aCol=cColor(0,1))
{
	ImGui_DrawGfx(cImGuiGfx(), cVector3f(0,0,afZ), ImGui_GetCurrentGroupSize(), aCol);	
}

//-------------------------------------------------------

void StationGuiBG_OrnamentTopLeft(const tString &in asFile="station/ornament/corner_topleft", const cVector2f &in avSize=cVector2f(0.25f), eImGuiSizeType aSizeType=eImGuiSizeType_CorrectAspectWidthNormalized, const cColor &in aCol=cColor_White, const cVector2f &in avOffset=cVector2f_Zero, float afZ=0.2f)
{
	cImGuiGfx gfx(asFile);
		
	cVector3f vOffset(avOffset.x, avOffset.y, 0);
	
	ImGui_DrawAlignedGfx(gfx, ImGui_NrmPosGroup(cVector3f(0,0, afZ), true)+vOffset, eImGuiAlign_TopLeft, 
									Depth_ImGui_GetFinalSize(avSize, gfx, aSizeType), aCol);
}

//-------------------------------------------------------

void StationGuiBG_OrnamentTopRight(const tString &in asFile="station/ornament/corner_topright", const cVector2f &in avSize=cVector2f(0.25f), eImGuiSizeType aSizeType=eImGuiSizeType_CorrectAspectWidthNormalized, const cColor &in aCol=cColor(1,0.75f), const cVector2f &in avOffset=cVector2f_Zero, float afZ=0.2f)
{
	cImGuiGfx gfx(asFile);
	
	cVector3f vOffset(-avOffset.x, avOffset.y, 0);
		
	ImGui_DrawAlignedGfx(gfx, ImGui_NrmPosGroup(cVector3f(1,0, afZ), true)+vOffset, eImGuiAlign_TopRight, 
									Depth_ImGui_GetFinalSize(avSize, gfx, aSizeType), aCol);
}

//-------------------------------------------------------

void StationGuiBG_OrnamentBottomRight(const tString &in asFile="station/ornament/corner_bottomright", const cVector2f &in avSize=cVector2f(0.25f), eImGuiSizeType aSizeType=eImGuiSizeType_CorrectAspectWidthNormalized, const cColor &in aCol=cColor(1,0.75f), const cVector2f &in avOffset=cVector2f_Zero, float afZ=0.2f)
{
	cImGuiGfx gfx(asFile);
	
	cVector3f vOffset(-avOffset.x, -avOffset.y, 0);
		
	ImGui_DrawAlignedGfx(gfx, ImGui_NrmPosGroup(cVector3f(1,1, afZ), true)+vOffset, eImGuiAlign_BottomRight, 
									Depth_ImGui_GetFinalSize(avSize, gfx, aSizeType), aCol);
}

//-------------------------------------------------------

void StationGuiBG_OrnamentBottomLeft(const tString &in asFile="station/ornament/corner_bottomleft", const cVector2f &in avSize=cVector2f(0.25f), eImGuiSizeType aSizeType=eImGuiSizeType_CorrectAspectWidthNormalized, const cColor &in aCol=cColor(1,0.75f), const cVector2f &in avOffset=cVector2f_Zero, float afZ=0.2f)
{
	cImGuiGfx gfx(asFile);
	
	cVector3f vOffset(avOffset.x, -avOffset.y, 0);
		
	ImGui_DrawAlignedGfx(gfx, ImGui_NrmPosGroup(cVector3f(0,1, afZ), true)+vOffset, eImGuiAlign_BottomLeft, 
									Depth_ImGui_GetFinalSize(avSize, gfx, aSizeType), aCol);
}

//-------------------------------------------------------

void StationGuiBG_Taskbar(float afZ=0.05f, const tString &in asFile="station/background/taskbar")
{
	cImGuiGfx gfx(asFile);
			
	ImGui_DrawAlignedGfx(gfx, ImGui_NrmPos(cVector3f(0,1, afZ)), eImGuiAlign_BottomLeft, cVector2f(ImGui_GetSize().x, -1));
}

//-------------------------------------------------------

void StationGuiBG_TaskbarV2(const tString &in asStationFile="thirdparty/train/transport_symbol_lambda", const tString &in asBackgroundFile="stationV2/background/taskbar")
{	
	/////////////
	// Default setup
	cImGuiGfx gfx_taskbar(asBackgroundFile);
	
	gfx_taskbar.mColor = gStationGuiColor_Normal2;
	gfx_taskbar.mColor.a = 0.5f;
	
	
	//////////////////////////
	//Draw Taskbar
	ImGui_DrawGfx(
		gfx_taskbar,
		cVector3f(0., ImGui_GetSize().y-ImGui_NrmSize(0.083334).y-ImGui_NrmSize(0.013).y, 3),
		cVector2f(ImGui_GetSize().x,ImGui_NrmSize(0.083334).y+ImGui_NrmSize(0.038).y)
	);

	if (asStationFile != "")
	{
		cImGuiGfx gfx_station_ornament(asStationFile);
		ImGui_DrawGfx(
			gfx_station_ornament,
			cVector3f(ImGui_NrmPos(0.85).x, ImGui_NrmPos(0.808).y, 3.2),
			ImGui_GetRatioCorrectSizeByNrmWidth(gfx_station_ornament, 0.125)
		);
	}
}

//-------------------------------------------------------

////////////////////////////////////////////////////////////
// Default widget data creators
////////////////////////////////////////////////////////////

//-------------------------------------------------------

// Window
cImGuiWindowData StationGui_CreateDefaultWindowData()
{
	cImGuiWindowData window;
	
	window.mColorBase = gStationGuiColor_Normal;
	
	window.mGfxWindowData.mGfxBackground.mColor = cColor(0,0.75);
	
	window.mGfxWindowData.mGfxCornerTopRight.SetFile("station/window/sleek_corner_topright");
	window.mGfxWindowData.mGfxCornerTopLeft.SetFile("station/window/sleek_corner_topleft");
	window.mGfxWindowData.mGfxCornerBottomRight.SetFile("station/window/sleek_corner_bottomright");
	window.mGfxWindowData.mGfxCornerBottomLeft.SetFile("station/window/sleek_corner_bottomleft");
	
	window.mGfxWindowData.mGfxBorderTop.SetFile("station/window/border_hori");
	window.mGfxWindowData.mGfxBorderLeft.SetFile("station/window/border_vert");
	window.mGfxWindowData.mGfxBorderRight.SetFile("station/window/border_vert");
	window.mGfxWindowData.mGfxBorderBottom.SetFile("station/window/border_hori");
	
	window.mGfxLabelData.mGfxCornerBottomRight.SetFile("station/window/title_slantedcorner");
	window.mGfxLabelData.mGfxBackground.mColor = cColor_White;
	
	window.mFontAlign = eFontAlign_Left;
	window.mFont.SetFile("sansation_medium_bold.fnt");
	window.mFont.mvSize = cVector2f(18, 18);
	window.mHeaderType = eImGuiWindowHeader_FitCaption;
	
	window.SetLabelPadding(0.0f, 15.0f, 0.0f, 10.0f);
	
	return window;
}

//-------------------------------------------------------

// Button
cImGuiButtonData StationGui_CreateDefaultButtonData()
{
	cImGuiButtonData button;
	
	button.mColorBase = gStationGuiColor_Normal;
	button.mbUseInFocusColor = true;
	button.mColorInFocus = gStationGuiColor_Highlight;
	button.mbUseTriggeredColor = true;
	button.mColorTriggered = gStationGuiColor_Warning;
	button.mbUseDisabledColor = true;
	button.mColorDisabled = gStationGuiColor_Disabled;
	button.mbUseBackgroundGfx = false;
	button.mbUseInFocusGfx = false;
	button.mbUseTriggeredGfx = false;
	button.mbUseFrame = true;
	button.mGfxFrame.mGfxBorderBottom.SetFile("station/button/big_border_bottom");
	button.mGfxFrame.mGfxBorderLeft.SetFile("station/button/big_border_left");
	button.mGfxFrame.mGfxBorderRight.SetFile("station/button/big_border_right");
	button.mGfxFrame.mGfxBorderTop.SetFile("station/button/big_border_top");
	button.mGfxFrame.mGfxCornerBottomLeft.SetFile("station/button/big_corner_bottomleft");
	button.mGfxFrame.mGfxCornerBottomRight.SetFile("station/button/big_corner_bottomright");
	button.mGfxFrame.mGfxCornerTopLeft.SetFile("station/button/big_corner_topleft");
	button.mGfxFrame.mGfxCornerTopRight.SetFile("station/button/big_corner_topright");
	
	button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
	
	button.mvDefaultSize = ImGui_NrmSizeGroupKeepRatio(cVector2f(0.215, 0.115f));
	
	return button;
}

//-------------------------------------------------------

cImGuiButtonData StationGui_CreateToggleButtonData()
{
	cImGuiButtonData button = StationGui_CreateDefaultButtonData();
	button.mbUseTriggeredAndInFocusColor = true;
	button.mColorTriggeredAndInFocus = gStationGuiColor_FocusedAndSelected;
	return button;
}

//-------------------------------------------------------

// Gauge
cImGuiGaugeData StationGui_CreateDefaultGaugeData()
{
	cImGuiGaugeData gauge;
	gauge.mGfxFrame.mGfxCornerTopRight.SetFile("station/bar/small_framing_upper_right");
	gauge.mGfxFrame.mGfxCornerTopLeft.SetFile("station/bar/small_framing_upper_left");
	gauge.mGfxFrame.mGfxCornerBottomRight.SetFile("station/bar/small_framing_lower_right");
	gauge.mGfxFrame.mGfxCornerBottomLeft.SetFile("station/bar/small_framing_lower_left");
    
	gauge.mGfxFrame.mGfxBorderTop.mColor = cColor(0.0f, 0.0f);
	gauge.mGfxFrame.mGfxBorderLeft.mColor = cColor(0.0f, 0.0f);
	gauge.mGfxFrame.mGfxBorderRight.mColor = cColor(0.0f, 0.0f);
	gauge.mGfxFrame.mGfxBorderBottom.mColor = cColor(0.0f, 0.0f);
	
	gauge.mGfxFrame.mGfxCornerTopLeft.mColor = gStationGuiColor_Normal;
	gauge.mGfxFrame.mGfxCornerTopRight.mColor = gStationGuiColor_Normal;
	gauge.mGfxFrame.mGfxCornerBottomRight.mColor = gStationGuiColor_Normal;
	gauge.mGfxFrame.mGfxCornerBottomLeft.mColor = gStationGuiColor_Normal;
	
	gauge.mGfxFrame.mGfxBackground.mColor = cColor(0,0);
	
	gauge.mGfxBackground.mColor = cColor(1.0f, 1.0f);
	gauge.mvPadding = cVector2f(2,2);
	
	return gauge;
}

//-------------------------------------------------------

////////////////////////////////////////////////////////
// STATION HELPERS
////////////////////////////////////////////////////////

//-------------------------------------------------------

// Window
void StationGui_DoWindowStart(const tString &in asCaption, const cImGuiWindowData &in aWindow, const cVector3f &in avPos, const cVector2f &in avSize, bool abDrawOrnaments)
{
	if(abDrawOrnaments)
	{
		// Draw inside a group so we can take advantage of the NrmPos func
		// and before opening the window cos we dont want the padding to be active
		ImGui_GroupBegin(avPos, avSize);
		
			//Window ornaments
			StationGuiBG_OrnamentTopRight("station/ornament/corner_topright", cVector2f(50), eImGuiSizeType_CorrectAspectWidth, cColor(1,1), cVector2f(2,2), -0.1f);
			StationGuiBG_OrnamentBottomLeft("station/ornament/corner_bottomleft", cVector2f(50), eImGuiSizeType_CorrectAspectWidth, cColor(1,1), cVector2f(2,2), -0.1f);
						
			cColor chinCol = gStationGuiColor_Normal2 * cColor(1.0f,0.6f);
			StationGuiBG_OrnamentTopRight("station/chinsymbol/small_default_exit", cVector2f_MinusOne, eImGuiSizeType_Default, chinCol, cVector2f(5,5), 0.1f);
			StationGuiBG_OrnamentBottomLeft("station/chinsymbol/small_default_help", cVector2f_MinusOne, eImGuiSizeType_Default, chinCol, cVector2f(5,2), 0.1f);
		
		ImGui_GroupEnd();
	}
	
	ImGui_DoWindowStart(asCaption, aWindow, avPos, avSize, false);
	
	// debug: makes the group rect visible
	// ImGui_DrawFrame(aWindow.mGfxWindowData, ImGui_GetCurrentGroupPos()+cVector3f(0,0,1),ImGui_GetCurrentGroupSize(), cColor(2,0,0,1));
}

//-------------------------------------------------------

void StationGui_DoWindowEnd()
{
	ImGui_DoWindowEnd();
}		
	
