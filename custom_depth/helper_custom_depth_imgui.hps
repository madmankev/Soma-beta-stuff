cImGuiWindowData PathOS_CreateDefaultWindowData()
{
	cImGuiWindowData window;
	
	window.mColorBase = gStationGuiColor_Normal;
	
	window.mGfxWindowData.mGfxBackground.mColor = cColor(0,0.75);
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		window.mGfxWindowData.mGfxCornerTopRight.SetFile("stationV2/window/small_corner_topright");
		window.mGfxWindowData.mGfxCornerTopLeft.SetFile("stationV2/window/small_corner_topleft");
		window.mGfxWindowData.mGfxCornerBottomRight.SetFile("stationV2/window/small_corner_bottomright");
		window.mGfxWindowData.mGfxCornerBottomLeft.SetFile("stationV2/window/small_corner_bottomleft");
		
		window.mGfxWindowData.mGfxBorderTop.SetFile("stationV2/window/small_border_top");
		window.mGfxWindowData.mGfxBorderLeft.SetFile("stationV2/window/small_border_left");
		window.mGfxWindowData.mGfxBorderRight.SetFile("stationV2/window/small_border_right");
		window.mGfxWindowData.mGfxBorderBottom.SetFile("stationV2/window/small_border_bottom");
	}
	else
	{
		window.mGfxWindowData.mGfxCornerTopRight.SetFile("stationV2/window/big_corner_topright");
		window.mGfxWindowData.mGfxCornerTopLeft.SetFile("stationV2/window/big_corner_topleft");
		window.mGfxWindowData.mGfxCornerBottomRight.SetFile("stationV2/window/big_corner_bottomright");
		window.mGfxWindowData.mGfxCornerBottomLeft.SetFile("stationV2/window/big_corner_bottomleft");
		
		window.mGfxWindowData.mGfxBorderTop.SetFile("stationV2/window/big_border_top");
		window.mGfxWindowData.mGfxBorderLeft.SetFile("stationV2/window/big_border_left");
		window.mGfxWindowData.mGfxBorderRight.SetFile("stationV2/window/big_border_right");
		window.mGfxWindowData.mGfxBorderBottom.SetFile("stationV2/window/big_border_bottom");		
	}
	
	window.mGfxLabelData.mGfxBackground.mColor = cColor_White;
	
	window.mFontAlign = eFontAlign_Left;
	window.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	window.mFont.SetFile("sansation_large_additive.fnt");
	window.mFont.mMaterial = eGuiMaterial_Additive;
	window.mHeaderType = eImGuiWindowHeader_FitCaption;
	
	window.SetLabelPadding(0.0f, 15.0f, 0.0f, 10.0f);
	
	return window;
}

//-------------------------------------------------------

cImGuiSliderData PathOS_CreateDefaultSliderData()
{
	cImGuiSliderData sliderData;
	
	sliderData.mGfxBackground.SetFile("station/scrollbar/scrollbar_bar_vert");
	sliderData.mGfxBaseInFocus.SetFile("station/scrollbar/scrollbar_bar_infocus");
	sliderData.mGfxButton.SetFile("station/scrollbar/scrollbar_button");
	sliderData.mGfxButtonInFocus.SetFile("station/scrollbar/scrollbar_button_infocus");
	sliderData.mColorBase = gStationGuiColor_Normal;
	sliderData.mGfxBaseInFocus.mColor = gStationGuiColor_Normal;
	sliderData.mGfxBackground.mvUVMax.y = ImGui_NrmSizeKeepRatio(0.00001).y;
	sliderData.mGfxBaseInFocus.mvUVMax.y = ImGui_NrmSizeKeepRatio(0.00001).y;
	sliderData.mvButtonSize.y = ImGui_NrmSizeKeepRatio(0.05).y;
	
	return sliderData;
}

//-------------------------------------------------------

cImGuiTextFrameData PathOS_CreateDefaultTextFrameData()
{
	cImGuiTextFrameData textData;
	
	textData.mbUseBackgroundGfx = false;
	textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	textData.mFontAlign = eFontAlign_Left;
	textData.mColorText = gStationGuiColor_Normal;
	
	return textData;
}

