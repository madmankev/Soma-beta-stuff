//-------------------------------------------------------

void Depth_ImGui_DrawScanlines(const tString &in asFile, const cColor &in aCol, eGuiMaterial aMat, float afVTileAmount)
{
	cImGuiGfx scanlinesGfx(asFile);
	scanlinesGfx.mColor = aCol;
	scanlinesGfx.mMaterial = aMat;
	scanlinesGfx.mvUVMax = cVector2f(1.0f, afVTileAmount);
	
	ImGui_DrawGfx(scanlinesGfx, cVector3f(0,0,5), ImGui_GetSize());
}

//-------------------------------------------------------

/////////////////////////////////////////
// SIZING
/////////////////////////////////////////

//-------------------------------------------------------

enum eImGuiSizeType
{
	eImGuiSizeType_Default,
	eImGuiSizeType_Normalized,
	eImGuiSizeType_NormalizedGroup,
	eImGuiSizeType_CorrectAspectWidth,
	eImGuiSizeType_CorrectAspectWidthNormalized
}

//-------------------------------------------------------

cVector2f Depth_ImGui_GetFinalSize(const cVector2f &in avInSize, const cImGuiGfx &in aGfx, eImGuiSizeType aType)
{
	cVector2f vFinalSize = avInSize;
	
	switch(aType)
	{
	case eImGuiSizeType_Normalized:
		vFinalSize = ImGui_NrmSize(vFinalSize); break;
	case eImGuiSizeType_NormalizedGroup:
		vFinalSize = ImGui_NrmSizeGroup(vFinalSize); break;
	case eImGuiSizeType_CorrectAspectWidth:
		vFinalSize = ImGui_GetRatioCorrectSizeByWidth(aGfx, vFinalSize.x); break;
	case eImGuiSizeType_CorrectAspectWidthNormalized:
		vFinalSize = ::ImGui_GetRatioCorrectSizeByNrmWidth(aGfx, vFinalSize.x); break;
	}
	
	return vFinalSize;
}

//-------------------------------------------------------

/////////////////////////////////////////
// LINE STRIP
/////////////////////////////////////////

//-------------------------------------------------------

void Depth_ImGui_DrawLineStrip(const array<cVector2f> &in avVertices, float afZ, float afThickness, const cColor &in aCol, const cImGuiGfx &in aGfx, bool abNormalized=false)
{
	int lEnd = avVertices.size()-1;
	float fOffset = 0.0f;
	
	float fHalfThickness = afThickness*0.27f;
	for(int i=0; i<lEnd; ++i)
	{
		cVector2f vVtx1 = avVertices[i];
		cVector2f vVtx2 = avVertices[i+1];
		
		cVector2f vDir1 = vVtx2-vVtx1;
		vDir1.Normalize();
		
		if(abNormalized)
		{
			cVector3f vGroupPos = ImGui_GetCurrentGroupPos();
			cVector2f vGroupSize = ImGui_GetCurrentGroupSize();
			
			vVtx1.x = vVtx1.x*vGroupSize.x + vGroupPos.x;
			vVtx1.y = vVtx1.y*vGroupSize.y + vGroupPos.y;
			vVtx2.x = vVtx2.x*vGroupSize.x + vGroupPos.x;
			vVtx2.y = vVtx2.y*vGroupSize.y + vGroupPos.y;
		}
		
		cVector2f vVtx1Orig = vVtx1;
		cVector2f vVtx2Orig = vVtx2;
		
		if(i>0)
		{
			vVtx1 -= vDir1*fOffset;
		}
		
		if(i<lEnd-1)
		{
			cVector2f vVtx3 = avVertices[i+2];
			cVector2f vDir2 = vVtx3-vVtx2;
			
			vDir2.Normalize();
			
			float fPrevOffset = fOffset;
						
			float fAngle = cMath_GetAngleFromPoints2D(vDir1, vDir2);
			fOffset = cMath_Abs(cMath_Tan(fAngle*0.5f))*fHalfThickness;
			vVtx2 += vDir1*fOffset;
		}
		
		//cLux_AddDebugMessage("Segment: " + vVtx1 + "->" + vVtx2 +" - was - " + vVtx1Orig + "->" + vVtx2Orig);
		ImGui_DrawLineExt(vVtx1, vVtx2, afZ, afThickness, aCol, aGfx);
	} 
}

