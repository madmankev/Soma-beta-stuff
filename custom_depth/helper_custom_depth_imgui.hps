/**
 * Create a main menu and populate it with apps.
 * 
 * @param asTransCat, category in the lang file.
 * @param avEntries, entries in lang with name of buttons for apps.
 * 
 **/
void PathOS_MainMenu(array<tString> avAppEntries)
{
	/////////////
	// Default setup
	cImGuiWindowData window = StationGui_CreateDefaultWindowData();
	window.mGfxWindowData.mGfxCornerBottomRight.SetFile("station/window/sleek_corner_bottomright_alt");

	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
		
	cImGuiLabelData label;
	label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0234375);
	label.mbUseBackgroundGfx = false;
	label.mFont.SetFile("sansation_large_additive.fnt");
	
	cImGuiGfx gfx_menu_ornamentOS("stationV2/background/background_logo_pathOS_small");
	cImGuiGfx gfx_menu_ornament1("station/chinsymbol/big_default_help");
	cImGuiGfx gfx_menu_ornament2("station/chinsymbol/big_default_tools");
	
	gfx_menu_ornament1.mColor = gStationGuiColor_Normal;
	gfx_menu_ornament2.mColor = gStationGuiColor_Normal;
	
	int lAppCount = avAppEntries.size();
	
	//////////////////////////
	//Draw main menu with app buttons, copy text and gfx.
	ImGui_DoWindowStart("", window, ImGui_NrmPos(cVector3f(0.25, 0.2-0.035*lAppCount, 1)), ImGui_NrmSize(cVector2f(0.5, 0.25+0.12*lAppCount)));
	
		for (int i=0;i<lAppCount;i++)
		{
			ImGui_DoButtonExt(avAppEntries[i], avAppEntries[i], button, 
				ImGui_NrmPos(cVector3f(0.03, i/7.5+0.025, 1.1)), ImGui_NrmSize(cVector2f(0.44, 0.11))
			);

			if(ImGui_PrevPressed()) ImGui_SetStateInt("PathOS_ActiveApp", i);
		}
		
		ImGui_DoLabelExt("MMPathOSTM", label, ImGui_NrmPosGroup(cVector3f(0.03, 0.89+0.015*lAppCount, 1.1)));
		ImGui_DrawGfx(gfx_menu_ornamentOS, ImGui_NrmPos(cVector3f(0.261, 0.337+0.085*lAppCount, 1.1)), ImGui_GetRatioCorrectSizeByNrmWidth(gfx_menu_ornamentOS, 0.4));
		ImGui_DrawGfx(gfx_menu_ornament1, ImGui_NrmPos(cVector3f(0.655, 0.384+0.085*lAppCount, 1.1)), ImGui_GetRatioCorrectSizeByNrmWidth(gfx_menu_ornament1, 0.065));
		ImGui_DrawGfx(gfx_menu_ornament2, ImGui_NrmPos(cVector3f(0.695, 0.33+0.085*lAppCount, 1.1)), ImGui_GetRatioCorrectSizeByNrmWidth(gfx_menu_ornament2, 0.09));
	
	ImGui_DoWindowEnd();
}

//-------------------------------------------------------

/**
 * Taskbar at bottom of screen with backbutton and station logo.
 * 
 * @param abBackEnabled, if back should be enabled when running an app.
 * @param asStationFile, graphics file to use for station art located bottom right. thirdparty/train/transport_symbol_*
 * @param asBackgroundFile, background graphics file for the taskbar. Should not really need to change it from default.
 * 
 **/
void PathOS_Taskbar(bool abBackEnabled, const tString &in asStationFile="thirdparty/train/transport_symbol_lambda", const tString &in asBackgroundFile="stationV2/background/taskbar")
{
	ImGui_SetTransCategory("PathOS");
	
	/////////////
	// Default setup
	cImGuiGfx gfx_taskbar(asBackgroundFile);
	
	gfx_taskbar.mColor = gStationGuiColor_Normal2;
	gfx_taskbar.mColor.a = 0.5f;
	
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		button.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/small_corner_topright");
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/small_corner_slanted_bottomleft");
		button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_bottomright");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/small_corner_slanted_topleft");
	}
	else
	{
		button.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/big_corner_topright");
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/big_corner_slanted_bottomleft");
		button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_bottomright");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/big_corner_slanted_topleft");
	}

	button.mFontAlign = eFontAlign_Center;
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	
	cImGuiGfx gfx_button_ornament("station/chinsymbol/big_default_exit");
	cImGuiGfx gfx_station_ornament(asStationFile);
	
	//////////////////////////
	//Draw Taskbar
	ImGui_DrawGfx(
		gfx_taskbar,
		cVector3f(0., ImGui_GetSize().y-ImGui_NrmSize(0.083334).y-ImGui_NrmSize(0.013).y, 0.1),
		cVector2f(ImGui_GetSize().x,ImGui_NrmSize(0.083334).y+ImGui_NrmSize(0.038).y)
	);

	ImGui_DrawGfx(
		gfx_station_ornament,
		cVector3f(ImGui_NrmPos(0.85).x, ImGui_NrmPos(0.808).y, 0.2),
		ImGui_GetRatioCorrectSizeByNrmWidth(gfx_station_ornament, 0.125)
	);
	
	///////////////
	//Set back button to be disabled 
	if(!abBackEnabled) 
	{
		gfx_button_ornament.mColor.a = 0.2;
		ImGui_SetModUseInput(false);
	} 
	
	//////////////////////////
	//Draw back button on taskbar
	ImGui_DoButtonExt(
		"TaskbarBackButton", "TBBack", button,
		cVector3f(ImGui_NrmPos(0.005).x, ImGui_GetSize().y-ImGui_NrmSize(0.0905).y, 0.2),
		cVector2f(ImGui_NrmSize(0.205).x, ImGui_NrmSize(0.083334).y)
	);

	ImGui_DrawGfx(
		gfx_button_ornament,
		cVector3f(ImGui_NrmPos(0.159).x, ImGui_NrmPos(0.929).y, 0.3),
		ImGui_GetRatioCorrectSizeByNrmHeight(gfx_station_ornament, 0.05)
	);

	//////////////
	//Pressing back goes to menu
	if(ImGui_PrevPressed())
	{
		ImGui_SetStateInt("PathOS_ActiveApp", ePathOS_AppMainMenu);
		
		PathOS_AudioPlayerStopTrack();
	}
}

//-------------------------------------------------------

void PathOS_AudioPlayer(const tString&in asAppName, const tString &in asAudioFileNameCategory, array<tString> avAudioNames, array<tString> avAudioFiles)
{
	///////////////////////////////
	// Check if file has ended
	bool bPlaybackActive = ImGui_GetStateInt("PathOS_TrackPlaying", ePathOS_AudioNoTrack) >= 0;

	if (bPlaybackActive && !Sound_Exists(ImGui_GetName()+"_AudioPlaybackSound"))
	{
		PathOS_AudioPlayerStopTrack();
	}
	
	/////////////
	// Default setup
	cImGuiWindowData window = PathOS_CreateDefaultWindowData();
	
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.04);

	cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
	cImGuiGfx gfx_app_icon("stationV2/ossymbols/ossymbol_player");
	
	///////////////////////////////
	// Draw window
	ImGui_DoWindowStart(asAppName, window, ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
	
		ImGui_SetTransCategory(asAudioFileNameCategory);
		
		float fOsc;
		tString sAudioName;
		tString sAudioFile;
		
		///////////////////////////////
		// Create buttons and gauges
		for (int i=0;i < int(avAudioNames.size()); i++)
		{
			sAudioName = avAudioNames[i];
			
			//////////////////////////////////////////
			//Button not pressed and no "audio meter"
			if(ImGui_GetStateInt("PathOS_TrackPlaying", ePathOS_AudioNoTrack) != i)
			{
				ImGui_DoToggleButtonExt("Track_"+i, sAudioName, false, button, ImGui_NrmPosGroup(cVector3f(0.02, i/7.0+0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.38, 0.12)));
				ImGui_DoGauge(gauge, 0, ImGui_NrmPosGroup(cVector3f(0.45, i/7.0+0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.53, 0.12)));
			}
			
			///////////////////////////////////////
			//Button pressed and doing "audio meter"
			else
			{
				fOsc = Depth_ImGui_GetOscillatingSignalValue("1", 1, eEasing_Linear, 0.4, 0.9, 0.07);
				
				ImGui_DoToggleButtonExt("Track_"+i, sAudioName, true, button, ImGui_NrmPosGroup(cVector3f(0.02, i/7.0+0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.38, 0.12)));
				ImGui_DoGauge(gauge, fOsc, ImGui_NrmPosGroup(cVector3f(0.45, i/7.0+0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.53, 0.12)));
			}
				
			///////////////////////////////
			// Pressing button toggles audio 
			if(ImGui_PrevPressed())
			{
				if(ImGui_GetStateInt("PathOS_TrackPlaying") == i)
				{
					PathOS_AudioPlayerStopTrack();
				}
				else
				{
					sAudioFile = avAudioFiles[i];
					
					StationGui_StopAudioPlayback(ImGui_GetName(), true);
					StationGui_StartAudioPlayback(ImGui_GetName(), sAudioFile);
					ImGui_SetStateInt("PathOS_TrackPlaying", i);
				} 
			}
		}
		
		///////////////////////////////
		// App art bottom left
		ImGui_DrawGfx(gfx_app_icon, ImGui_NrmPosGroup(cVector3f(0.03, 0.93, 1.1)), ImGui_GetRatioCorrectSizeByNrmHeight(gfx_app_icon, 0.17));
		
	ImGui_DoWindowEnd();
}

//-------------------------------------------------------

void PathOS_LogReader(const tString&in asAppName, const tString&in asLogCategory, array<tString> avLogNames, array<tString> avLogFiles, int alDefaultFile=-1)
{
	/////////////
	// Default setup
	cImGuiWindowData windowData = PathOS_CreateDefaultWindowData();
	
	cImGuiGfx gfx_app_icon("stationV2/ossymbols/ossymbol_reader");
	cImGuiGfx gfx_line("stationV2/misc/GUI_line");
	
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	cImGuiTextFrameData textData = PathOS_CreateDefaultTextFrameData();
	ImGui_SetDefaultTextFrame(textData);
	
	cImGuiSliderData sliderData = PathOS_CreateDefaultSliderData();
	
	/////////////////////////
	// Draw log window
	float fOffs = ImGui_GetStateFloat("TextOffset_"+asAppName);
	float fOverlap = 0;

	ImGui_DoWindowStart(asAppName, windowData, ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
	
		ImGui_SetTransCategory(asLogCategory);
		
		tString sLogName;
		int lLog = ImGui_GetStateInt("PathOS_Log", -1);
		
		for(int i=0; i < int(avLogNames.size()); i++)
		{
			sLogName = avLogNames[i];
			
			if(lLog == i) 
				ImGui_DoToggleButtonExt("Log_"+i, sLogName, true, button, ImGui_NrmPosGroup(cVector3f(0.02, i/7.5+0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.115)));
			else
				ImGui_DoToggleButtonExt("Log_"+i, sLogName, false, button, ImGui_NrmPosGroup(cVector3f(0.02, i/7.5+0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.115)));
			
			if(ImGui_PrevPressed() && lLog == i) ImGui_SetStateInt("PathOS_Log", -1);
			else if(ImGui_PrevPressed()) ImGui_SetStateInt("PathOS_Log", i);
			
			if(alDefaultFile == i && ImGui_GetStateInt("PathOS_LogFirstLaunch", 1) == 1)
			{
				ImGui_SetStateInt("PathOS_Log", alDefaultFile);
				ImGui_SetStateInt("PathOS_LogFirstLaunch", 0);
			}
		}	
		
		//////////////
		//Line splitting buttons from log texts
		ImGui_DrawLineExt(cVector2f(ImGui_NrmPosGroup(0.415).x, 0), cVector2f(ImGui_NrmPosGroup(0.415).x,ImGui_NrmPosGroup(1.0).y), 1.1, ImGui_NrmSize(0.004).x, gStationGuiColor_Normal,  gfx_line);

		/////////////////////////
		// Draw log text
		if (lLog >= 0)
		{
			tString sLogEntry = avLogFiles[lLog];
			
			fOverlap = ImGui_DoTextFrame(sLogEntry, ImGui_NrmSizeGroup(cVector2f(0, 0)), 0, fOffs,
								  ImGui_NrmPosGroup(cVector3f(0.415, 0, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.544, 0.915)));
		}
		
		//////////////
		//Log reader app icon bottom left
		ImGui_DrawGfx(gfx_app_icon, ImGui_NrmPosGroup(cVector3f(0.015, 0.925, 1.1)), ImGui_GetRatioCorrectSizeByNrmHeight(gfx_app_icon, 0.17));

		if (fOverlap>0.0f)
		{
			fOffs = fOverlap-ImGui_DoSliderVerticalExt("TextSlider", fOverlap-fOffs, 0, fOverlap, 0.1f, sliderData, ImGui_NrmPosGroup(cVector3f(0.965, 0.1, 1.1)),  ImGui_NrmSizeGroup(cVector2f(0.025, 0.74)));
		} else ImGui_SetStateFloat("TextOffset_"+asAppName,0);
	 
	ImGui_DoWindowEnd();
	
	/////////////////////
	// For keyboard/pad scrolling
	PathOS_InputScroll(asAppName, fOffs, fOverlap);
}

//-------------------------------------------------------

array<array<tString>> gvPathOSConversationsAttachments;
void PathOS_Messenger(const tString&in asAppName, const tString&in asMsgCategory, array<array<tString>> avConversations, array<array<tString>> avConversationsAttachments=gvPathOSConversationsAttachments, tString &in asDefaultMsg="")
{
	/////////////
	// Default setup
	cImGuiWindowData windowData = PathOS_CreateDefaultWindowData();
	
	cImGuiButtonData button = PathOS_CreateDefaultButtonData();
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	cImGuiButtonData buttonSquare = button;
	if(ImGui_NrmSize(0.083334).y < 64) buttonSquare.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_bottomright");
	else buttonSquare.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_bottomright");
					
	cImGuiGfx gfx_app_icon("stationV2/ossymbols/ossymbol_mail");
	cImGuiGfx gfx_line("stationV2/misc/GUI_line");
	
	cImGuiTextFrameData textData = PathOS_CreateDefaultTextFrameData();
	textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	ImGui_SetDefaultTextFrame(textData);
	
	cImGuiSliderData sliderData = PathOS_CreateDefaultSliderData();
	
	cImGuiLabelData labelData;
	
	/////////////////////////
	// Disable everything but error message window
	// TODO: BROKEN AS ONLY MOVE EVERYTHING TO A METHOD
	if(ImGui_GetStateInt("PathOS_MessageShowErrorWindow", -1) == 1)
	{
		//TODO: LANG THE ERROR AND MESSAGHE
		PathOS_PopUpWindow("ERROR", "Communication with server failed.");
	}

	/////////////////////////
	// Draw log window
	float fOffs = ImGui_GetStateFloat("TextOffset_"+asAppName);
	float fOverlap = 0;
	int lMessage = ImGui_GetStateInt("PathOS_Message", -1);
	
	
	ImGui_DoWindowStart(asAppName, windowData, ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
		
		//////////////
		//Conversations label
		labelData.mColorBase = gStationGuiColor_Normal;
		labelData.mFont.mColor = cColor_White*5;
		labelData.mFontAlign = eFontAlign_Center;
		labelData.mFont.SetFile("sansation_large_additive.fnt");
		labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.02);
		labelData.mFont.mMaterial = eGuiMaterial_Additive;
		labelData.mbUseBackgroundGfx = true;
		
		ImGui_SetTransCategory("");
		
		ImGui_DoLabelExt(cString_To8Char(cResources_Translate("PathOS", "MsgConversations")), labelData, ImGui_NrmPosGroup(cVector3f(0.02, 0.03, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.04)), ImGui_NrmSizeKeepRatio(0.002).y);
		
		int lYPos = 0;
		float fYPos = 0.0;
		tString sTopic = "";
		tString sTopicButton = "";
		
		/////////////////////////
		// Button for each topic of conversation
		for(int i=0; i < int(avConversations.size()); i++)
		{
			if(avConversations[i][ePathOS_MessageTopic] != sTopic)
			{
				fYPos = lYPos*0.12+0.08;
				lYPos++;
				
				sTopic = avConversations[i][ePathOS_MessageTopic];

				sTopicButton = cString_To8Char(cResources_Translate(asMsgCategory, sTopic));
				
				if(sTopicButton.length() > 20)
				{
					sTopicButton.resize(20);
					sTopicButton += "...";
				} 
				
				if(lMessage == i)
					ImGui_DoToggleButtonExt(sTopic, sTopicButton, true, button, ImGui_NrmPosGroup(cVector3f(0.02, fYPos, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.115)));
				else
					ImGui_DoToggleButtonExt(sTopic, sTopicButton, false, button, ImGui_NrmPosGroup(cVector3f(0.02, fYPos, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.115)));
				
				/////////////////////////
				// Check what button is clicked
				if(ImGui_PrevPressed() && lMessage == i) ImGui_SetStateInt("PathOS_Message", -1);
				else if(ImGui_PrevPressed()) ImGui_SetStateInt("PathOS_Message", i);
				
				/////////////////////////
				// Set a conversation to be open on first launch (default to not do this).
				if(asDefaultMsg == avConversations[i][ePathOS_MessageTopic] && ImGui_GetStateInt("PathOS_MessageFirstLaunch", 1) == 1)
				{
					ImGui_SetStateInt("PathOS_Message", i);
					ImGui_SetStateInt("PathOS_MessageFirstLaunch", 0);
				}
			}
		}	
		
		//////////////
		//Lines right of button and top of screen below title
		ImGui_DrawLineExt(cVector2f(ImGui_NrmPosGroup(0.415).x, 0), cVector2f(ImGui_NrmPosGroup(0.415).x,ImGui_NrmPosGroup(0.95).y), 1.1, ImGui_NrmSize(0.004).x, gStationGuiColor_Normal,  gfx_line);
		
		
		//////////////////////////////////////////////
		// Simplified version of above button stuff
		// Need to check with Jens if this does everything before uncommenting
/*		array<tString> vButtonEntries();
		for(uint i=0;i<avConversations.size();i++)
		{
			if(avConversations[i][ePathOS_MessageTopic] != sTopic)
			{				
				sTopic = avConversations[i][ePathOS_MessageTopic];
				sTopicButton = cString_To8Char(cResources_Translate(asMsgCategory, sTopic));				
				vButtonEntries.push_back(sTopicButton);
				
				/////////////////////////
				// Set a conversation to be open on first launch (default to not do this).
				if(asDefaultMsg == avConversations[i][ePathOS_MessageTopic] && ImGui_GetStateInt("PathOS_MessageFirstLaunch", 1) == 1)
				{
					ImGui_SetStateInt("PathOS_Message", i);
					ImGui_SetStateInt("PathOS_MessageFirstLaunch", 0);
				}
			}
		}
		int lMessage = PathOS_DoSubjectList(cString_To8Char(cResources_Translate("PathOS", "MsgConversations")), vButtonEntries, button, ImGui_GetStateInt("PathOS_Message", -1));
		ImGui_SetStateInt("PathOS_Message", lMessage);*/
		
		ImGui_DrawLineExt(cVector2f(ImGui_NrmPosGroup(0.415).x, ImGui_NrmPosGroup(0.135).y), cVector2f(ImGui_NrmPosGroup(0.98).x,ImGui_NrmPosGroup(0.135).y), 1.1, ImGui_NrmSize(0.001).x, gStationGuiColor_Normal*0.8,  gfx_line);

		/////////////////////////
		// Draw conversation section with title and messages.
		if(lMessage >= 0)
		{
			ImGui_SetTransCategory(asMsgCategory);
			
			//Title
			ImGui_DoLabel(avConversations[lMessage][ePathOS_MessageTopic], ImGui_NrmPosGroup(cVector3f(0.415, 0.015, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.56, 0.02)), ImGui_NrmSizeKeepRatio(0.003).y);
			ImGui_DoLabel(avConversations[lMessage][ePathOS_MessageDate], ImGui_NrmPosGroup(cVector3f(0.415, 0.06, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.56, 0.02)), ImGui_NrmSizeKeepRatio(0.002).y);

			//Message
			fOverlap = ImGui_DoTextFrame(avConversations[lMessage][ePathOS_MessageBody], ImGui_NrmSizeGroup(cVector2f(0, 0)), 0, fOffs,
								  ImGui_NrmPosGroup(cVector3f(0.415, 0.11, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.555, 0.74)));
					
			ImGui_SetTransCategory("");
			
			/////////////////////////
			// Attachments button if there are attachments for currently displayed message
			int lAttachIndex;

			for(uint i=0;i<avConversationsAttachments.size();i++)
			{
				lAttachIndex = cString_ToInt(avConversationsAttachments[i][ePathOS_MessageAttachMsgIndex], -1);

				if(lAttachIndex == lMessage)
					ImGui_SetStateInt("PathOS_MessageHasAttachment", 1);
			}
			
			//Always show attachment button but disable it when no attachments available
			if(ImGui_GetStateInt("PathOS_MessageHasAttachment", -1) == 1 && ImGui_GetStateInt("PathOS_MessageShowErrorWindow", -1) != 1) 
				ImGui_SetModUseInput(true);
			else 
				ImGui_SetModUseInput(false);
			
			ImGui_DoButtonExt("AttachButton", cString_To8Char(cResources_Translate("PathOS", "MsgAttach")), buttonSquare, ImGui_NrmPosGroup(cVector3f(0.556, 0.87, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.25, 0.115)));
			ImGui_SetStateInt("PathOS_MessageHasAttachment", -1);
			
			/////////////////////////
			// Send button for outgoing messages
			if(ImGui_GetStateInt("PathOS_MessageShowErrorWindow", -1) != 1) ImGui_SetModUseInput(true);
				
			ImGui_DoButtonExt("SendButton", cString_To8Char(cResources_Translate("PathOS", "MsgSend")), button, ImGui_NrmPosGroup(cVector3f(0.811, 0.87, 1.1)), ImGui_NrmSizeGroup(cVector2f(0.17, 0.115)));
				
			if(ImGui_PrevPressed()) ImGui_SetStateInt("PathOS_MessageShowErrorWindow", 1);
		}
		
		//////////////
		//Message reader app icon bottom left
		ImGui_DrawGfx(gfx_app_icon, ImGui_NrmPosGroup(cVector3f(0.03, 0.935, 1.1)), ImGui_GetRatioCorrectSizeByNrmHeight(gfx_app_icon, 0.17));

		if (fOverlap>0.0f)
		{
			fOffs = fOverlap-ImGui_DoSliderVerticalExt("TextSlider", fOverlap-fOffs, 0, fOverlap, 0.01f, sliderData, ImGui_NrmPosGroup(cVector3f(0.977, 0.107, 1.1)),  ImGui_NrmSizeGroup(cVector2f(0.025, 0.74)));
		} 
		else ImGui_SetStateFloat("TextOffset_"+asAppName,0);
	 
	ImGui_DoWindowEnd();
	
	/////////////////////
	// For keyboard/pad scrolling
	PathOS_InputScroll(asAppName, fOffs, fOverlap);
}

//-------------------------------------------------------

//////////////////////////////////////////////////////
// CELLPHONE
//////////////////////////////////////////////////////

//-------------------------------------------------------

enum eCellPhoneGuiState
{
	eCellPhoneGuiState_Idle=0,
	eCellPhoneGuiState_Ringing,
	eCellPhoneGuiState_CallInProgress,
	eCellPhoneGuiState_MissedCall,
	eCellPhoneGuiState_Rejected,
	eCellPhoneGuiState_DecideToCall,
	eCellPhoneGuiState_Calling,
	eCellPhoneGuiState_CancelledCall
}

enum eCellPhoneGuiAction
{
	eCellPhoneGuiAction_None=0,
	eCellPhoneGuiAction_HungUp,
	eCellPhoneGuiAction_Answered,
	eCellPhoneGuiAction_MissedCall,
	eCellPhoneGuiAction_RejectedCall,
	eCellPhoneGuiAction_Called,
	eCellPhoneGuiAction_CancelledCall
}

//-------------------------------------------------------

int CellPhoneGui_GetState()
{
	return ImGui_GetStateInt("CallState");
}

//-------------------------------------------------------

// Translation string under 'Phone' to use as time
void CellPhoneGui_SetClockString(const tString& in asName)
{
	Entity_SetVarString(ImGui_GetName(), "ClockString", asName);
}

//-------------------------------------------------------

// Icon set to use for reception icons
// A = 3 bars
// B = 2 bars
void CellPhoneGui_SetReceptionIcons(const tString& in asName)
{
	Entity_SetVarString(ImGui_GetName(), "ReceptionIcons", asName);
}

//-------------------------------------------------------

// Will use translation string "Caller_"+asCallerID
// and avatar image "smartphone_avatar_"+asCallerID
void CellPhoneGui_StartRinging(const tString& in asCallerID, float afTimeOut=0)
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_Ringing);	// Ringing
	Entity_SetVarString(ImGui_GetName(), "CallerID", asCallerID);
	if (afTimeOut!=0)
		ImGui_AddTimer("PhoneTimeout", afTimeOut);
}

//-------------------------------------------------------

// Will use translation string "Caller_"+asCallerID
// and avatar image "smartphone_avatar_"+asCallerID
void CellPhoneGui_DecideToCall(const tString& in asCallerID)
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_DecideToCall);
	Entity_SetVarString(ImGui_GetName(), "CallerID", asCallerID);
}

//-------------------------------------------------------

// Will use translation string "Caller_"+asCallerID
// and avatar image "smartphone_avatar_"+asCallerID
void CellPhoneGui_PickUp(const tString& in asCallerID)
{
	// Start call time
	ImGui_FadeStateFloat("CallTime", 1000, 1000, eEasing_Linear);
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_CallInProgress);	// Call in progress
	Entity_SetVarString(ImGui_GetName(), "CallerID", asCallerID);
	Sound_CreateAtEntity("PhoneBeep", "00_01_subway/SFX/phone_beep_action", "Player");
	ImGui_StopTimer("PhoneTimeout");
}

//-------------------------------------------------------

void CellPhoneGui_HangUp()
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_Idle);
	Sound_CreateAtEntity("PhoneBeep", "00_01_subway/SFX/phone_beep_action", "Player");
}

//-------------------------------------------------------

void CellPhoneGui_RejectCall(const tString& in asCallerID)
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_Rejected);
	Sound_CreateAtEntity("PhoneBeep", "00_01_subway/SFX/phone_beep_action", "Player");
}

//-------------------------------------------------------

void CellPhoneGui_MissedCall(const tString& in asCallerID)
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_MissedCall);
	Entity_SetVarString(ImGui_GetName(), "CallerID", asCallerID);
}

//-------------------------------------------------------

void CellPhoneGui_CancelledCall(const tString& in asCallerID)
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_CancelledCall);
	Sound_CreateAtEntity("PhoneBeep", "00_01_subway/SFX/phone_beep_action", "Player");
	Entity_SetVarString(ImGui_GetName(), "CallerID", asCallerID);
}

//-------------------------------------------------------

void CellPhoneGui_Calling(const tString& in asCallerID)
{
	ImGui_SetStateInt("CallState", eCellPhoneGuiState_Calling);
	Sound_CreateAtEntity("PhoneBeep", "00_01_subway/SFX/phone_beep_action", "Player");
	Entity_SetVarString(ImGui_GetName(), "CallerID", asCallerID);
}

//-------------------------------------------------------

eCellPhoneGuiAction CellPhoneGui_Update()
{
	float fCallTime = ImGui_GetStateFloat("CallTime",0);
	int lState = ImGui_GetStateInt("CallState",0);
	tString sClockString = Entity_GetVarString(ImGui_GetName(), "ClockString");
	tString sReceptionIcons = Entity_GetVarString(ImGui_GetName(), "ReceptionIcons");
	
	ImGui_SetTransCategory("Phone");
	
	// Background		
	ImGui_DoImage(cImGuiGfx("smartphone_backdrop"), 0, ImGui_NrmSize(1));
	
	// Power/signal icons
	ImGui_DoImageCorrectAspect(cImGuiGfx("smartphone_icons"+sReceptionIcons), ImGui_NrmPos(0.02, -0.03, 1), ImGui_NrmSize(0.2, 0.1));
	
	// Clock
	cImGuiLabelData label = ImGui_GetDefaultLabel();
	label.mFont.SetFile("sansation_medium_bold.fnt");
	label.mFontAlign = eFontAlign_Right;
	label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	ImGui_DoLabelExt(sClockString, label, ImGui_NrmPos(0, 0, 1), ImGui_NrmSize(0.97, -1));
	
	tString sCallerID = Entity_GetVarString(ImGui_GetName(), "CallerID");
	
	//////////////
    // Image
	if (lState!=eCellPhoneGuiState_Idle)
	{
		// Image
		ImGui_DoImageCorrectAspect(cImGuiGfx("smartphone_avatar_"+sCallerID), ImGui_NrmPosGroup(0.2, 0.05, 1), ImGui_NrmSizeGroup(0.6, 0.5));
		
		// Caller ID
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
		ImGui_DoLabelExt("Caller_"+sCallerID, label, ImGui_NrmPos(0, 0.5, 1), ImGui_NrmSize(1, -1));
	}
	
	if (lState==eCellPhoneGuiState_Idle)
	{
	}
	else if (lState==eCellPhoneGuiState_Ringing)
	{
		// Answer
		cImGuiButtonData answerButton;
		answerButton.mbUseBackgroundGfx = true;
		answerButton.mbUseInFocusColor = true;
		answerButton.mGfxBackground = cImGuiGfx("smartphone_icon_answer");
		answerButton.mColorInFocus = cColor(ImGui_FadeOscillateFloat("ButtonFocusColor", 0.75, 1.5, 1, eEasing_QuadOut));
				
		// Ignore
		cImGuiButtonData ignoreButton = answerButton;
		ignoreButton.mGfxBackground = cImGuiGfx("smartphone_icon_ignore");
		
		if (ImGui_DoButtonExt("AnswerButton", "", answerButton, ImGui_NrmPosGroup(0.05, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Answered
			CellPhoneGui_PickUp(sCallerID);
			return eCellPhoneGuiAction_Answered;
		}
		if (ImGui_DoButtonExt("IgnoreButton", "", ignoreButton, ImGui_NrmPosGroup(0.525, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Hung up
			CellPhoneGui_RejectCall(sCallerID);
			return eCellPhoneGuiAction_RejectedCall;
		}
			
		if(ImGui_BecameInFocus())
		{
			ImGui_SetFocus("AnswerButton");
		}
		
		if(ImGui_TimerOver("PhoneTimeout"))
		{
			CellPhoneGui_MissedCall(sCallerID);
			return eCellPhoneGuiAction_MissedCall;
		}
	}
	else if (lState==eCellPhoneGuiState_CallInProgress)
	{
		// Call in Progress icon
		ImGui_SetModRotateAngle(ImGui_FadeOscillateFloat("CallProgressIcon",25,35,1.0f));
		ImGui_DoImageCorrectAspect(cImGuiGfx("smartphone_calling"), ImGui_NrmPos(0.3,0.55,1), ImGui_NrmSize(0.4,0.3));
		ImGui_SetModRotateAngle(0);
		
		// Duration
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.03);
		ImGui_DoLabelExt("DurationHeader", label, ImGui_NrmPos(0, 0.8, 1), ImGui_NrmSize(1, -1));
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
		ImGui_SetTransCategory("");
		ImGui_DoLabelExt(String_SecondsToClockDisplay(fCallTime, true, true, true, false), label, ImGui_NrmPosGroup(0, 0.83, 1), ImGui_NrmSizeGroup(1, -1));
	}
	else if (lState==eCellPhoneGuiState_MissedCall)
	{
		// Missed Call
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
		ImGui_DoLabelExt("MissedCall", label, ImGui_NrmPos(0, 0.7, 1), ImGui_NrmSize(1, -1));
	}
	else if (lState==eCellPhoneGuiState_Rejected)
	{
		// Rejected Call
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
		ImGui_DoLabelExt("RejectedCall", label, ImGui_NrmPos(0, 0.7, 1), ImGui_NrmSize(1, -1));
	}
	else if (lState==eCellPhoneGuiState_DecideToCall)
	{
		// Call
		cImGuiButtonData callButton;
		callButton.mbUseBackgroundGfx = true;
		callButton.mbUseInFocusColor = true;
		callButton.mGfxBackground = cImGuiGfx("smartphone_icon_call");
		callButton.mColorInFocus = cColor(ImGui_FadeOscillateFloat("ButtonFocusColor", 0.75, 1.5, 1, eEasing_QuadOut));
				
		// Cancel
		cImGuiButtonData cancelButton = callButton;
		cancelButton.mGfxBackground = cImGuiGfx("smartphone_icon_cancel");
		
		if (ImGui_DoButtonExt("CallButton", "", callButton, ImGui_NrmPosGroup(0.05, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Called
			CellPhoneGui_Calling(sCallerID);
			return eCellPhoneGuiAction_Called;
		}
		if (ImGui_DoButtonExt("CancelButton", "", cancelButton, ImGui_NrmPosGroup(0.525, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Cancelled
			CellPhoneGui_CancelledCall(sCallerID);
			return eCellPhoneGuiAction_CancelledCall;
		}
			
		if(ImGui_BecameInFocus())
		{
			ImGui_SetFocus("CallButton");
		}
	}
	else if (lState==eCellPhoneGuiState_CancelledCall)
	{
		// Cancelled Call
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
		ImGui_DoLabelExt("CancelledCall", label, ImGui_NrmPos(0, 0.7, 1), ImGui_NrmSize(1, -1));
	}	
	else if (lState==eCellPhoneGuiState_Calling)
	{
		// Calling
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
		ImGui_DoLabelExt("Calling", label, ImGui_NrmPos(0, 0.7, 1), ImGui_NrmSize(1, -1));
	}
	
	return eCellPhoneGuiAction_None;
}

//-------------------------------------------------------