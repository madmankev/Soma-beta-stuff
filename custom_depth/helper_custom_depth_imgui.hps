/////////////////////////////////////////
// EFFECTS
/////////////////////////////////////////

//-------------------------------------------------------

/**
 *  Animates 3 dots that go ""->"."->". ."->". . ." and then start over.
 */
tString Depth_ImGui_Effect_AnimatedDots(const tString &in asVarName="__DefaultAnimDots")
{
	if(ImGui_IsFading(asVarName)==false)
	{
		ImGui_SetStateFloat(asVarName, 0);
		ImGui_FadeStateFloat(asVarName, 1, 1, eEasing_Linear, true);
	} 
	float fT = ImGui_GetStateFloat(asVarName);
	tString sDots = "";
	if(fT>0.25) sDots = ".";
	if(fT>0.5) sDots = ". .";
	if(fT>0.75) sDots = ". . .";
	return sDots;
}

//-------------------------------------------------------

/**
 *  Makes a character blink with a frequence by returning asChar or "" at regular intervals
 */
tString Depth_ImGui_Effect_BlinkChar(const tString &in asChar, float afFreq, const tString &in asVarName="__DefaultBlinkChar")
{
	if(ImGui_IsFading(asVarName)==false)
	{
		if(afFreq<=0) afFreq = 0.00001f;
		
		ImGui_SetStateFloat(asVarName, 0);
		ImGui_FadeStateFloat(asVarName, 1, 1/afFreq , eEasing_Linear, true);
	} 
	float fT = ImGui_GetStateFloat(asVarName);
	
	return fT>0.5 ? asChar : "";
}

//-------------------------------------------------------

/////////////////////////////////////////
// DRAWING
/////////////////////////////////////////

//-------------------------------------------------------


void Depth_ImGui_DrawLineDistortedGfx(	cImGuiGfx&in aGfx, 
											const cVector3f&in avPos, 
											const cVector2f&in avSize,
											const cColor&in aColor,
											float afDistortionAmount,
											float afDistortionSpeed,
											int alRandSeed=0)
{
		cVector2f vSize = avSize;
		
		int lFragments = 10 + int(afDistortionAmount*10);
		cVector2f vFragmentSize = vSize;
		cVector3f vFragmentPos = 0;
		float fTotalSize = 0;
		
		float fT = ImGui_GetTimeCount();
		fT *= afDistortionSpeed;
		int lFragCount =alRandSeed;		
		
		while(fTotalSize < vSize.y)
		{
			float fHeight;
			float fFloatSeed = fT*7*2 + 12319*lFragCount;
			int lFragSeed = lFragCount + int(cMath_Sin(fT)*7 +cMath_Sin(fT*0.5)*14 + +cMath_Sin(fT*0.25)*14 + 12319*lFragCount);
			
			////////////////////////////
			// Calculate height
			fHeight= vSize.y/float(lFragments);
			fHeight *= 0.5f + (cMath_FastRandomFloat(lFragSeed)+1)*0.5f;
			//fHeight *= 0.5f + (cGenerate_GetNoisePerlin1D(fT*7)+1)*0.5f;
			if(fTotalSize + fHeight > vSize.y) fHeight = vSize.y - fTotalSize;
			
			vFragmentSize.y = fHeight;
			vFragmentPos.y = fTotalSize;
			
			////////////////////////////
			// Calculate X-offset
			float fXAmount = 	cGenerate_GetNoisePerlin1D(fFloatSeed) +
								cGenerate_GetNoisePerlin1D(fFloatSeed*0.5f) +
								cGenerate_GetNoisePerlin1D(fFloatSeed*0.25f);
			vFragmentPos.x = fXAmount*vSize.x*0.3f*afDistortionAmount;
			
			////////////////////////////
			// Calculate Y-offset
			vFragmentPos.y += (cMath_FastRandomFloat(lFragSeed)-1)*5*afDistortionAmount;
			
			////////////////////////////
			// Draw Graphics
			aGfx.mvUVMin.y = fTotalSize / vSize.y;
			aGfx.mvUVMax.y = (fTotalSize+fHeight) / vSize.y;
			
			cColor col = aColor;
			float fCol = cMath_InterpolateLinear(1, (cMath_FastRandomFloat(lFragSeed)+1)*0.5, afDistortionAmount);
			col = col * fCol;
			
			ImGui_DrawGfx(aGfx, avPos +vFragmentPos, vFragmentSize, col);
			
			////////////////////////////
			// Update variables
			fTotalSize += fHeight;
			lFragCount++;
		}
}

