/**
 * Adds graphics to the desktop, positioned and sized relative to the screen size.
 * **/
void PathOSBG_Backdrop(const tString &in asFile="stationV2/background/background_logo_pathosstation", cVector2f avRelPos=cVector2f(0,0), float avRelSize=0.5f)
{
	cImGuiGfx gfx(asFile);
	gfx.mColor.a = 0.35;
	
	cVector2f vSize = ImGui_GetRatioCorrectSizeByNrmWidth(gfx, avRelSize);
	cVector3f vPos = ImGui_NrmPos(cVector3f(avRelPos.x,avRelPos.y,0));
	
	ImGui_DrawGfx(gfx, vPos, vSize);
}

