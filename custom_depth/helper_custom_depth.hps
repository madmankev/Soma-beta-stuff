 * Set the voice character used for the tool
 *
 * @param asCathTool, the CathTool entity.
 * @param asCharacter
 **/
void CathTool_SetVoiceCharacter(const tString &in asCathTool, const tString &in asCharacter)
{	
	cScript_SetGlobalArgString(0,asCharacter);
	cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_SetVoiceCharacter");
}

