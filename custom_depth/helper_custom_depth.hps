//-------------------------------------------------------

/////////////////////////////////////////
// CATHERINE TOOL
//{///////////////////////////////////////

//-------------------------------------------------------

/**
 * Default CanUse callback for the OmniTool.
 *
 * @param asTool, the cath tool entity.
 * @param asEntity, the entity the player is aiming at.
 **/
bool CathTool_CanUse(const tString &in asTool, const tString &in asEntity)
{
	return (Entity_GetVarBool(asEntity, "IsOmniSlot") && 
		   OmniSlot_GetAttachAllowed(asEntity)) ||
		   (Entity_GetVarBool(asEntity, "IsOmniPanel") &&
		   Button_IsDisabled(asEntity)==false && 
		   Button_IsSwitchedOn(asEntity)==false &&
		   Entity_GetVarBool(asEntity, "InUse")==false);
}

//-------------------------------------------------------

/**
 * Insert CathTool in a Cath panel
 *
 * @param asCathTool, the cath tool entity to place at the target position.
 * @param asTargetSlot, the OmniSlot to plug the tool into.
 * @param abEffects, if false, insert will happen instantly without any effects.
 **/
void CathTool_Insert(const tString &in asCathTool, const tString &in asTargetSlot, bool abEffects=true)
{
	cScript_SetGlobalArgString(0, asCathTool);
	cScript_SetGlobalArgBool(1, abEffects);
	cScript_RunGlobalFunc(asTargetSlot, "cScrPropOmniSlot", "_Global_Insert");
}

//-------------------------------------------------------

/**
 * Allow picking up CathTool
 *
 * @param asCathTool, the CathTool entity.
 * @param abEffects, if effects and fading should be done or if it should happen immediately.
 **/
void CathTool_AllowDetach(const tString &in asCathTool, bool abEffects = true)
{	
	tString sSlot = CathTool_GetOmniSlot(asCathTool);
	if (sSlot == "") return;
	
	cScript_SetGlobalArgString(0, asCathTool);
	cScript_SetGlobalArgBool(1, abEffects);
	cScript_RunGlobalFunc(sSlot, "cScrPropOmniSlot", "_Global_AllowDetach");
}

//-------------------------------------------------------

/**
 * Allow picking up CathTool
 *
 * @param asCathTool, the CathTool entity.
 * 
 * @return bool, if the tool is currently inserted
 **/
bool CathTool_IsInserted(const tString &in asCathTool)
{	
	cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_IsInserted");
	
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------------

/**
 * Returns the name of the OmniSlot that the tool is attached to. 
 *
 * @param asCathTool, the CathTool entity.
 * 
 * @return tString, the name of the OmniSlot. An empty string if not inserted.
 **/
tString CathTool_GetOmniSlot(const tString &in asCathTool)
{
	cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_GetSlot");
	
	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------------

/**
 * Handles using the tool on an OmniPanel. 
 *
 * @param asCathTool, the CathTool entity.
 * @param asOmniPanel, the OmniPanel entity.
 * 
 **/
void CathTool_UseOnPanel(const tString &in asCathTool, const tString &in asOmniPanel)
{
	if (Entity_GetVarBool(asOmniPanel, "InUse"))
		return;

	Entity_SetVarBool(asOmniPanel, "InUse", true);
	Player_PlayCustomToolAnimation("tool_omnitool_use_panel", false, "");
	Player_FadeMoveSpeedMulTo(0.3, 0.5);
	Player_FadeLookSpeedMulTo(0.3, 0.5);
	Player_SetRunSpeedMul(0);
	Player_StartLookAt(asOmniPanel, 5, 2, 3);
	Map_AddTimer(asOmniPanel, 2, "$_CathTool_UseOnPanel_Timer");
}

void _CathTool_UseOnPanel_Timer(const tString &in asTimer)
{
	Player_FadeMoveSpeedMulTo(1, 1);
	Player_FadeLookSpeedMulTo(1, 1);
	Player_SetRunSpeedMul(1);
	Player_StopLookAt(1);
	Entity_CallEntityInteract(asTimer);
	
	Entity_SetVarBool(asTimer, "InUse", false);
}

//-------------------------------------------------------

/**
 * Set hint callback for this map - will be called to see
 * if Cath wants to give a hint when she's not doing anything else and when CathTool_SetHintsActive(true)
 * was called.
 *
 * @param asCathTool, the CathTool entity.
 * @param asHintsCallback, a callback which will be called to work out which line to respond with. 
 * Return the name of a line _without_ numeric extension i.e. if your line variants are SomeHint_1, SomeHint_2, reply with SomeHint
 * If the line has already played, it'll play the next variant, until it runs out.
 *  Syntax: tString Func(const tString& in asEntityName)
 **/
void CathTool_SetHintsCallback(const tString &in asCathTool, const tString &in asHintsCallback)
{	
	cScript_SetGlobalArgString(0,asHintsCallback);
	cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_SetHintsCallback");
}

//-------------------------------------------------------

/**
 * Enable/disable Cath hints.
 *
 * @param asCathTool, the CathTool entity.
 * @param abEnable
 **/
void CathTool_SetHintsEnabled(const tString &in asCathTool, bool abEnable)
{	
	cScript_SetGlobalArgBool(0,abEnable);
	cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_SetHintsEnabled");
}

