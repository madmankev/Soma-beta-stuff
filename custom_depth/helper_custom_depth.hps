/**
 * Sets if the OmniSlot allows insertion of the OmniTool or not.
 *
 * @param asOmniSlot, the slot.
 * @param abAllowed, state to set.
 * @param abEffects, if lights should fade on/off or switch instantly.
 **/
void OmniSlot_SetAttachAllowed(const tString &in asOmniSlot, bool abAllowed, bool abEffects=true)
{
	cScript_SetGlobalArgBool(0, abAllowed);
	cScript_SetGlobalArgBool(1, abEffects);
	cScript_RunGlobalFunc(asOmniSlot, "cScrPropOmniSlot", "_Global_SetAttachAllowed");
}

//-------------------------------------------------------

/**
 * Checks if the OmniSlot allows insertion of the OmniTool or not.
 *
 * @param asOmniSlot, the slot.
 * 
 * @return bool, true if attach is allowed.
 **/
bool OmniSlot_GetAttachAllowed(const tString &in asOmniSlot)
{
	cScript_RunGlobalFunc(asOmniSlot, "cScrPropOmniSlot", "_Global_GetAttachAllowed");
	return cScript_GetGlobalReturnBool();
}

