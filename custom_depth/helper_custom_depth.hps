void Viperfish_SetIdle(const tString &in asEntityName)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asEntityName, eLuxEntityType_Agent, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any entities with name '"+asEntityName+"' for Viperfish_SetIdle");
		return;
	}
	
	for (uint i=0;i<vEntities.size();++i)
	{
		cScript_RunGlobalFunc(vEntities[i].GetName(), "cScrViperfish", "_Global_SetIdle");
	}
}

