/////////////////////////////////////////
// OMNIPANEL
//{///////////////////////////////////////

//-------------------------------------------------------

void _OmniPanel_OnGui(const tString&in asEntityName, float afTimeStep)
{
	StationGuiBG_Scanlines();
	if (Button_IsDisabled(asEntityName))
		return;
	
	tString sLangCat = "StationGUI";
	tString sLangEntry = "";
	cColor col = cColor_White;
	float fSizeMul = 1;
	
	cStationGui_BigStatusMessageSettings settings;
	settings.mvEdgeSpacing = ImGui_NrmSize(0, 0);
	
	if (Entity_GetVarBool(asEntityName, "DisplayAccessDeniedText"))
	{
		tString sCustomLangCat = Entity_GetVarString(asEntityName, "CustomLangCategory");
		tString sCustomLangEntry = Entity_GetVarString(asEntityName, "CustomLangEntry");
		
		if (sCustomLangCat != "")
			sLangCat = sCustomLangCat;
		
		sLangEntry = sCustomLangEntry != "" ? sCustomLangEntry : "Panel_AccessDenied";
		
		col = gStationGuiColor_Warning;
		fSizeMul = 2;
	}
	else if (Button_IsLocked(asEntityName))
	{
		col = gStationGuiColor_Warning;
		sLangEntry = "Panel_Locked";
		fSizeMul = 2;
	}
	else if (Button_IsSwitchedOn(asEntityName))
	{
		col = gStationGuiColor_Highlight;
		sLangEntry = "Panel_On";
		fSizeMul = 2;
	}
	else
	{
		col = gStationGuiColor_Highlight2;
		sLangEntry = "Panel_Off";
		fSizeMul = 1.75;
	}
	
	ImGui_SetTransCategory(sLangCat);
	StationGui_BigStatusMessage(sLangEntry, col, fSizeMul, false, 0.5, eEasing_Linear, settings);
}

//-------------------------------------------------------

/**
 * Call this before calling CathTool_UseOnPanel to disable access to the panel. 
 * This state is reset automatically and has to be called every time the panel is used.
 *
 * @param asEntityName, name of the panel.
 * @param asLangCat, lang category for the error message. If left empty, a default category will be used.
 * @param asLangEntry, lang entry for the error message. If left empty, a default entry will be used.
 * 
 **/
void OmniPanel_AccessDenied(const tString&in asEntityName, const tString&in asLangCat="", const tString&in asLangEntry="")
{	
	cScript_SetGlobalArgString(0, asLangCat);
	cScript_SetGlobalArgString(1, asLangEntry);
	cScript_RunGlobalFunc(asEntityName, "cScrPropOmniPanel", "_Global_SetAccessDenied");
}

//-------------------------------------------------------

//} OMNIPANEL

//-------------------------------------------------------

/////////////////////////////////////////
// ANIMATION DOOR
//{///////////////////////////////////////

//-------------------------------------------------------

void AnimationDoor_SetOpen(const tString &in asClosedDoor, const tString &in asOpenDoor, bool abOpen, bool abPlayAnim=true,
						   const tString &in asCloseAnim="door_closing", const tString &in asOpenAnim="door_open")
{
	if (abOpen)
	{
		Entity_SetVarString(asClosedDoor, "AnimationDoor_SetOpen_OpenDoor", asOpenDoor);
		
		if(abPlayAnim)
			Entity_PlayAnimation(asClosedDoor, asOpenAnim, 0, false, true, "$AnimationDoor_SetOpen_AnimCallback");
		else
			AnimationDoor_SetOpen_AnimCallback(asClosedDoor, "");				
	}
	else
	{
		Entity_SetActive(asOpenDoor, false);
		Entity_SetActive(asClosedDoor, true);
		
		if(abPlayAnim)
			Entity_PlayAnimation(asClosedDoor, asCloseAnim, 0, false, true);
	}
}

//-------------------------------------------------------

void AnimationDoor_SetOpen_AnimCallback(const tString &in asEntity, const tString &in asAnimName)
{
	Entity_SetActive(asEntity, false);
	Entity_SetActive(Entity_GetVarString(asEntity, "AnimationDoor_SetOpen_OpenDoor"), true);
}

//-------------------------------------------------------