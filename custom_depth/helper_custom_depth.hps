/////////////////////////////////////////
// CONSTRUCT WORKER
/////////////////////////////////////////

//-------------------------------------------------------

void ConstructWorker_StartFeed(	const tString &in asConstruct, const tString &in asFoodEntity, 
								const tString &in asStopAtPathNode,
								float afFeedTime, array<tString> &in avAttachAreas)
{
	/////////////////////////////
	// Get Food Entity
	iLuxEntity @pFood = cLux_GetCurrentMap().GetEntityByName(asFoodEntity);
	if(pFood is null)
	{
		Error("Could not find food entity '"+asFoodEntity+"' for '"+asConstruct+"' feeding");
		return;
	}
	
	/////////////////////////////
	// Get attach areas
	array<cVector3f> vAttachPos;
	vAttachPos.resize(avAttachAreas.size());
	for(uint i=0; i<avAttachAreas.size(); ++i)
	{
		iLuxEntity @pArea = cLux_GetCurrentMap().GetEntityByName(avAttachAreas[i]);
		if(pArea is null)
		{
			Error("Could not find attach area '"+avAttachAreas[i]+"' for '"+asConstruct+"' feeding");
			return;
		}
		vAttachPos[i] = pArea.GetPosition();
	}
	
	/////////////////////////////
	// Call function
	cScript_SetGlobalArgID(0, pFood.GetID());
	cScript_SetGlobalArgString(1, asStopAtPathNode);
	cScript_SetGlobalArgFloat(2, afFeedTime);
	cScript_SetGlobalArgBool(3, true); //Setting that this IS a scripted feed.
	
	cScript_SetGlobalArgInt(4, vAttachPos.size());
	for(uint i=0; i<vAttachPos.size(); ++i)
	{
		cScript_SetGlobalArgVector3f(5+i, vAttachPos[i]);
	}
	
	cScript_RunGlobalFunc(asConstruct, "", "_Global_StartFeed");
}

