class cScrMap : iScrMap
{
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// MAIN CALLBACKS
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	void Setup()
	{
		GetBase().SetDisplayNameEntry("01-02-upsilon-inside");

	}

	//-------------------------------------------------------

	tString GetCommRoomContactCode(eCommRoomContact aContact)
	{
		switch (aContact)
		{
			case eCommRoomContact_None: return "NULL";
			case eCommRoomContact_Paris: return "1622";
			case eCommRoomContact_NewYork: return "1623";
			case eCommRoomContact_Toronto: return "1624";
			case eCommRoomContact_Shanghai: return "1625";
			case eCommRoomContact_Hamburg: return "1626";
			case eCommRoomContact_London: return "1627";
			case eCommRoomContact_Upsilon: return "2201";
			case eCommRoomContact_Theta: return "2202";
			case eCommRoomContact_Lambda: return "2203";
			case eCommRoomContact_Delta: return "2204";
			case eCommRoomContact_Omicron: return "2205";
			case eCommRoomContact_Tau: return "2206";
			case eCommRoomContact_Phi: return "2207";
			case eCommRoomContact_Omega: return "2208";
		}

		return "";
	}

	//-------------------------------------------------------

	cVector2f GetCommRoomStationPosition(eCommRoomContact aContact)
	{
		switch (aContact)
		{
			case eCommRoomContact_Upsilon: return cVector2f(3.84f, 6.04f);
			case eCommRoomContact_Theta: return cVector2f(2.62f, 3.15f);
			case eCommRoomContact_Lambda: return cVector2f(1.24f, 6.67f);
			case eCommRoomContact_Delta: return cVector2f(7.84f, 8.35f);
			case eCommRoomContact_Omicron: return cVector2f(0.73f, 2.73f);
			case eCommRoomContact_Tau: return cVector2f(4.84f, 3.26f);
			case eCommRoomContact_Phi: return cVector2f(2.05f, 8.84f);
			case eCommRoomContact_Omega: return cVector2f(2.67f, 4.07f);
		}

		return cVector2f_Zero;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{	
		//////Level Audio and Preloads	
		Player_SetClothing("default");
		Player_SetFootWear("default");
		Sound_PreloadCoreSounds();
		Sound_PreloadCoreInteractions();			
		Sound_PreloadGroup("01_02_upsilon_inside_02/amb", true);
		Sound_PreloadGroup("01_02_upsilon_inside_02/sfx", true);
		//Sound_SetGlobalVolume(0.0f, eSoundEntryType_All); //Removed becuase of transition
		
		//Soften steam volume
		Sound_CreateAtEntity("SteamSoundLoopInitial", "01_02_upsilon_inside_02/sfx/valve_burst/valve_steam_loop", "SteamSoundSource_1", 0.0f, true, 1.0f);
		
		//////////////////////////////////////////
		// Specific setup functions
		SetupTunnels();
		SetupElectricDoors();
		SetupControlRoomPanel();
		SetupGeneratorRoom();
		SetupTransformerArea();
		SetupStairsArea();
		SetupHubRoom();
		SetupMachineRoom();
		KillMachineRoom();
		SetupCommRoom();
		
		//////////////////////////////////////////
		// Setup entities
	
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Indoors();
		Player_SetMoveSpeedMul(1); //Set to 0 by preload in 1.1 for slow computers.
		PlayerHands_SetHandModel_Human();
		
		//////////////////////////////////////////
		// No flashlight until later on in the game
		Player_SetFlashlightDisabled(true);
		
		PlayerEnergy_ShowTentacle(false);
		
		//////////////////////////////////////////
		// Begin game in tunnels
		Map_AddTimer("AmbientRumbleTimer", cMath_RandRectf(5.f, 30.f), "TimerTunnelAmbientRumble");
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
			Player_SetFlashlightDisabled(false);
			Player_SetStandDisabled(false);
			Effect_ToneMapping_FadeExposure(0,0.1f);
			Effect_DoF_Reset();
			
			//Effect_Fade_Out(0.0f);
			Map_AddTimer("TimerFadeInLevel",0.1f,"TimerFadeInLevel");
			Sound_Stop("SteamSoundLoopInitial", 0.0f);
		}
		else
		{	
		//	Effect_Fade_Out(0.0f);
			Map_AddTimer("TimerFadeInLevel",0.5f,"TimerFadeInLevel");
		}
	}
	
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		
		if(cLux_ScriptDebugOn() == false) Game_AutoSave();
	}
	
	//-------------------------------------------------------
	
	void TimerFadeInLevel(const tString&in asTimer)
	{ 
		//Disabled as transitions from 1.1
	//	cLux_AddDebugMessage("Fade in!");
	//	Effect_Fade_In(3.0f);
	//	Sound_FadeGlobalVolume(1.0f, 1.5f, eSoundEntryType_All);
		mbLeversInit = true;
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}
	
	//-------------------------------------------------------
	
	
	void OnPlayerKilled(int alRecentDeaths, const tString&in asDeathSource)
	{
		if (asDeathSource=="TransformerBot")
		{
			
		}
	}
	
	//-------------------------------------------------------
		
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;

		if(alAction == eAction_Test1)
		{
			cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
				return;
				
			tString sEntity = pData.mpEntity.GetName();

			Button_SetLocked(sEntity, !Button_IsLocked(sEntity), true);
			Lamp_SetLit(sEntity, !Lamp_GetLit(sEntity), true);
			SlideDoor_SetClosed(sEntity, false);
		}

		if(alAction == eAction_Test2)
		{
			SetHubFloorPowerOn(!Lamp_GetLit("HubRoomLamp_5"));
		}
		if(alAction == eAction_Test3)
		{ 
			ParticleSystem_CreateAtEntity("TortureSparksPSStart_1", "elec_spark_oneshot.ps", "TortureSpark_1", false);
			ParticleSystem_CreateAtEntity("TortureSparksPSStart_3", "elec_spark_oneshot.ps", "TortureSpark_3", false);
			ParticleSystem_CreateAtEntity("TortureSparksPSStart_4", "elec_spark_oneshot.ps", "TortureSpark_4", false);
			ParticleSystem_CreateAtEntity("TortureSparksPSStart_5", "elec_spark_oneshot.ps", "TortureSpark_5", false);
			
			int lShake = Effect_Shake_Start(0.08, 0, 0, 0.4);
			Effect_Shake_SetSourceEntity(lShake, "CarlConstruct", 3, 10);
		}
		
		if(alAction == eAction_Test4)
		{
			Seq_BacktrackMaintenanceGlimpse("");
		}
		
		if(alAction == eAction_Test5)
		{
			SequenceGeneratorTurnedOn("");
			UnlockControlRoomDoor("");
		}
		
		if (alAction == eAction_Test6)
		{
		    SequenceFloodCommRoom("");
			//GeneratorRoomBlackout();
			//Sound_CreateAtEntity("radio_connect_scan", "01_02_upsilon_inside_02/special/radio_pannel/connect", "radio_panel_sound", 0, false);
		}
		
		if (alAction == eAction_Test7)
		{
			Entity_SetActive("VentRobot", true);
			ActivateVentRobotPath();
		}
		
		if (alAction == eAction_Test8)
		{
			mbCommRoomPoweredOn = true;
		}
		
		if (alAction == eAction_Test9)
		{
			//StartFirstContactDialog();
			Player_SetAmbientLight(6, 5.1, 2);
		}
		
	}
	
		
	//-------------------------------------------------------
	
	//} MAIN CALLBACKS
	
	/////////////////////////////////////////
	// TUNNELS
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbControlRoomMusic = false;
	
	//-------------------------------------------------------
	
	void SetupTunnels()
	{
    	Entity_PlayAnimation("maintenance_hatch_static_open_*", "open_state", 0.1f, true, false);
		Entity_PlayAnimation("maintenance_hatch_static_closed_*", "closed_state", 0.1f, true, false);
	}
	
	//-------------------------------------------------------
	
	void OnHatchStateChanged(const tString &in asEntity, int alState)
	{
		Entity_SetActive("HatchClimb_2", (alState==1)&&(!mbInTunnels));
	}
	
	//-------------------------------------------------------
	
	bool CollideCrouchTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		Player_SetJumpDisabled(true);
		return false;
	}
	
	//-------------------------------------------------------
	
	bool TriggerConstructLoop(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("ConstructVentLoopStart", "01_02_upsilon_inside_02/sfx/vent/construct/loop_intro", "ConstructVentSoundSource", 0.0f, false, 1.0f);
		Map_AddTimer("BeginConstructLoopTimer", 3.5f, "BeginConstructLoop");
		Depth_Audio_Fear_LowIntensity();
		return false;
	}
	
	//-------------------------------------------------------
		
	void BeginConstructLoop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("ConstructVentLoop", "01_02_upsilon_inside_02/sfx/vent/construct/loop", "ConstructVentSoundSource", 0.0f, false, 1.0f);
	}

	//-------------------------------------------------------
	
	bool CollideConstructSoundTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddTodoMessage("SOUND: Construct moving around.");
		return false;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////////////
	// Triggers random rumbles while in the tunnels
	void TimerTunnelAmbientRumble(const tString &in asTimer)
	{
		Sound_CreateAtEntity("TunnelRumbleTremor", "01_02_upsilon_inside_02/sfx/vent/tremor", "Player", 0.0f, false, 1.0f);
		Effect_Shake_Start(cMath_RandRectf(0.0015f, 0.0025f), cMath_RandRectf(0.5f, 1.0f), cMath_RandRectf(0.5, 1.0f), cMath_RandRectf(0.75f, 1.25f));
		Map_AddTimer("AmbientRumbleTimer", cMath_RandRectf(5.f, 25.f), "TimerTunnelAmbientRumble");
		
		for (int i = 1; Entity_Exists("TunnelDustPSArea_" + i); i++)
		{
			ParticleSystem_CreateAtEntityExt("TunnelDustPS_" + i, "dust_falling_fast.ps", "TunnelDustPSArea_" + i, true, cColor(0.415,0.645,0.645,1), 0.75f, true, 1.f, 3.f);
		}
	}
	
	//-------------------------------------------------------
	
	// Auto standup when leaving the tunnels for the first time.
	bool OnTriggerUncrouch(const tString &in asParent, const tString &in asChild, int alState)
	{
		Player_SetCrouching(false);
		//CloseHatch();
		return false;
	}

	//-------------------------------------------------------

	bool mbInTunnels = true;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////
	// Sets the ambience the station or the tunnels when player leaves or enters tunnels
	bool CollisionTunnelExit(const tString &in asArea, const tString &in asEntity, int alState)
	{
		if (alState == -1)
		{
			cLux_AddDebugMessage("Left tunnels");
			/////////////////////////////
			//Stop ventilation music and add timer to trigger control room music - allow player to take in surroundings before triggering
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Map_RemoveTimer("AmbientRumbleTimer");
			
			Player_SetJumpDisabled(false);
			Entity_SetActive("HatchClimb_2", true);
			
			mbInTunnels = false;
		}
		return true;
	}
	
		//-------------------------------------------------------
	
	void HatchClimb_2_OnPlayerInteract(const tString &in asEntity)
	{
		if (Entity_GetCollide("Player","HatchClimbtestArea_Alt"))
		{
			CameraAnimation_Begin("SecondClimbAnim","OnClimbComplete",true);
			mbInTunnels = true;
			Entity_SetActive("HatchClimb_2", false);
			Sound_CreateAtEntity("ClimbVent", "01_02_upsilon_inside_02/sfx/foley/vent_climb", "Player");
			Emotion_PlayEventBreath("01_02_upsilon_inside_02/sfx/foley/vent_climb_vo", 1);
		}
	}
	
	//-------------------------------------------------------
	
	void OnClimbComplete(const tString &in asEntity)
	{
		cLux_AddDebugMessage("Entered tunnels");
		Music_Stop(3.f, eMusicPrio_BgAmb);
		
		Map_AddTimer("AmbientRumbleTimer", cMath_RandRectf(5.f, 30.f), "TimerTunnelAmbientRumble");
		
		Player_SetJumpDisabled(true);
		Entity_SetActive("HatchClimb_2", false);
		
		mbInTunnels = true;
	}
	
	//-------------------------------------------------------

	void ControlRoomMusicTrigger(const tString &in asTimer)
	{
		if(mbControlRoomMusic==false)
		{
			/////////////////////////////
			//Trigger Control Room Music
			Music_PlayExt("01_02_controlroom.ogg", true, 0.45, 1, 4, 8, eMusicPrio_BgAmb, true);
			mbControlRoomMusic = true;
		}
		else if (mbControlRoomMusic==true)
		{
			cLux_AddDebugMessage("Control Room Music triggered, no do not play");
		}
	
	}
	
	//-------------------------------------------------------
	

	//} END Tunnels
	
	/////////////////////////////////////////
	// TUNNEL ROBOT GLIMPSES
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool Trigger_MaintenanceTunnelWauGlimpse(const tString &in asParent, const tString &in asChild, int alState)
	{
		Seq_MaintenanceTunnelGlimpse("");
		return false;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mMaintenanceTunnelGlimpseSequence;
	
	void Seq_MaintenanceTunnelGlimpse(const tString &in asTimer)
	{
		Sequence_Begin("Seq_MaintenanceTunnelGlimpse", mMaintenanceTunnelGlimpseSequence);
			
		if (Sequence_DoStepAndWait(1))
		{
			Prop_MoveLinearTo("MaintenanceGlimpseLight_1", "MaintenanceGlimpseLight_Target", 5, 2, 0, true);
			Light_FadeTo("MaintenanceGlimpseDummy_1", cColor(0.239,0.321,0.449,1), -1, 0.5);
			
			Effect_VideoDistortion_Start(0.6, 1,0.5,5);
			
			Sound_Stop("ConstructVentLoop", 0.0f);
			Sound_Stop("ConstructVentLoopStart", 0.0f);
			Map_RemoveTimer("BeginConstructLoopTimer");
			Sound_CreateAtEntity("ConstructNotice", "01_02_upsilon_inside_02/sfx/vent/construct/flee", "ConstructVentSoundSource", 0.0f, false, 1.0f);
			Depth_Audio_Fear_HighIntensity(5.0f,8.0f,3,true,true);
		}
		else if (Sequence_DoStepAndPause(0))
		{
			Light_FadeTo("MaintenanceGlimpseDummy_1", cColor(0,0,0,0), -1, 0.5);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			Light_FadeTo("MaintenanceGlimpseDummy_2", cColor(0.239,0.321,0.449,1), -1, 0.5);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Light_FadeTo("MaintenanceGlimpseDummy_2", cColor(0,0,0,0), -1, 0.5);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Entity_FadeEffectBaseColor("MaintenanceGlimpseLight_*", cColor(0), 0.5);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			Entity_SetActive("MaintenanceGlimpseLight_*", false);
		}
		else
		{
			/////////////////////
			//Begin stinger piece
			Music_Play("NPC_construct_short2.ogg", 0.35, false, eMusicPrio_BigEvent);
			/////////////////////
			//Begin ambient music
			Music_PlayExt("01_02_tunnel", true, 0.35, 1, 5, 0, eMusicPrio_BgAmb, false);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool Trigger_NextGlimpseLight(const tString &in asParent, const tString &in asChild, int alState)
	{
		SequenceStates_Resume("Seq_MaintenanceTunnelGlimpse");
		return false;
	}
	
	//-------------------------------------------------------
	
	bool Trigger_BacktrackGlimpse(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive("TunnelBacktrackLookAt", alState==1);
		return true;
	}
	
	//-------------------------------------------------------
	
	void LookAtBacktrackGlimpse(const tString &in asEntity, int alState)
	{
		if (alState != 1)
			return;
			
		Seq_BacktrackMaintenanceGlimpse("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mBacktrackMaintenanceGlimpseSequence;
		
	void Seq_BacktrackMaintenanceGlimpse(const tString &in asTimer)
	{
		Sequence_Begin("Seq_BacktrackMaintenanceGlimpse", mBacktrackMaintenanceGlimpseSequence);
			
		if (Sequence_DoStepAndWait(1.0f))
		{
			Entity_SetActive("MaintenanceGlimpseLight_3", true);
			Prop_MoveLinearTo("MaintenanceGlimpseLight_3", "MaintenanceGlimpseLight_3_Target", 2, 0.5, 0, true);
			Prop_AlignRotation("MaintenanceGlimpseLight_3", "MaintenanceGlimpseLight_3_Target", 1, 1, 0, false);
			
			Sound_CreateAtEntity("BackTrackConstruct", "01_02_upsilon_inside_02/sfx/vent/construct/backtrack", "VentBackTrackSoundSource", 0, false, 1);
			
			Effect_VideoDistortion_Start(0.6, 1,0.5,2.5);
		}
		
		else if (Sequence_DoStepAndWait(1))
		{		
			Depth_Audio_Fear_MediumIntensity();
		}
		
		else if (Sequence_DoStepAndWait(1))
		{
			Music_Play("NPC_construct_short1", 0.35, false, eMusicPrio_BigEvent);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	//} END Maintenance tunnels
	
	
	/////////////////////////////////////////
	// ELECTRIC DOORS
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupElectricDoors()
	{
		Entity_SetEffectsActive("BrokenDoorControl*", false, false);
		ParticleSystem_SetVisible("ControlRoomDoorLightParticles", false);
		
		/////////////////////////////////
		// Door buttons
		// Setting up callbacks here to avoid dependency problems at startup
		Entity_SetConnectionStateChangeCallback("ElectricsDoor_Control_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("ElectricsDoor_Control_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("StorageDoor_Control_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("StorageDoor_Control_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("MachineRoomDoor_Control_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("MachineRoomDoor_Control_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("NorthDoorControl_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("NorthDoorControl_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("ReactorFlowDoorControl_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("ReactorFlowDoorControl_2", "StateChangeElectricDoorButton");
		
		// Connecting buttons with the one on the other side of the door they open
		Entity_SetVarString("ElectricsDoor_Control_1", "OtherButton", "ElectricsDoor_Control_2");
		Entity_SetVarString("ElectricsDoor_Control_2", "OtherButton", "ElectricsDoor_Control_1");
		Entity_SetVarString("StorageDoor_Control_1", "OtherButton", "StorageDoor_Control_2");
		Entity_SetVarString("StorageDoor_Control_2", "OtherButton", "StorageDoor_Control_1");
		Entity_SetVarString("MachineRoomDoor_Control_1", "OtherButton", "MachineRoomDoor_Control_2");
		Entity_SetVarString("MachineRoomDoor_Control_2", "OtherButton", "MachineRoomDoor_Control_1");
		Entity_SetVarString("NorthDoorControl_1", "OtherButton", "NorthDoorControl_2");
		Entity_SetVarString("NorthDoorControl_2", "OtherButton", "NorthDoorControl_1");
		Entity_SetVarString("ReactorFlowDoorControl_1", "OtherButton", "ReactorFlowDoorControl_2");
		Entity_SetVarString("ReactorFlowDoorControl_2", "OtherButton", "ReactorFlowDoorControl_1");
	}
	
	//-------------------------------------------------------
	
	void StateChangeElectricDoorButton(const tString &in asEntity, int alState)
	{
		// If one button changes state, so should the one on the other side of the door.
		Button_SetSwitchedOn(Entity_GetVarString(asEntity, "OtherButton"), alState == 1, false);
	}
	
	//-------------------------------------------------------
	
	void OnInteractAirlock(const tString &in asEntity)
	{
		Map_AddTimer("SequenceAirlockFail",0.1f,"SequenceAirlockFail");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceAirlockFail;
	void SequenceAirlockFail(const tString& in asTimer)
	{
		Sequence_Begin("SequenceAirlockFail", mSequenceAirlockFail);
		
		if (Sequence_DoStepAndWait(0.1f))
		{
			SlideDoor_SetOpenAmount("slidedoor_airlock_1",0.01,false);
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "Airlock_Control", true);
			Sound_CreateAtEntity("AirlockFail", "01_02_upsilon_inside_02/sfx/bulkhead_broken/bulkhead_fail", "AirlockDoorSoundSource");
			Map_AddTimer("AirlockFailAlarm", 1.5f, "AirlockFailAlarm");
			
			Sound_CreateAIEventAtEntity("Airlock_Control", 30, 2);
			
			//Disable interaction for 4 seconds to stop player spamming event
			Entity_SetInteractionDisabled("Airlock_Control", true);
			Map_AddTimer("AirlockFailInteract", 3.0f, "AirlockFailInteract");
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_1", true);
		}
		else if (Sequence_DoStepAndWait(0.2f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_2", true);
		}
		else if (Sequence_DoStepAndWait(0.15f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_3", true);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			SlideDoor_SetOpenAmount("slidedoor_airlock_1",0.00,false);
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_4", true);
		}
		else if (Sequence_DoStepAndWait(0.15f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_5", true);
		}
	
		Sequence_End();
	}
	
	void AirlockFailAlarm(const tString& in asTimer)
	{
		Sound_CreateAtEntity("AirlockFailAlarm", "01_02_upsilon_inside_02/sfx/bulkhead_broken/bulkhead_alarm", "AirlockAlarmSoundSource");
	}
	
	void AirlockFailInteract(const tString& in asTimer)
	{
		Entity_SetInteractionDisabled("Airlock_Control", false);
	}
	
	//-------------------------------------------------------
	
	//} END Electric doors
	
	
	/////////////////////////////////////////
	// CONTROL ROOM BASICS
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbControlPanelOn = false;
	bool mbPowerOn_1 = false;
	int mlKnobsTurned = 0;
	
	void SetupControlRoomPanel()
	{	
		Entity_SetPlayerInteractCallback("JonsiTalkTo", "Interact_Jonsi", false);
		
		Voice_SetSource("Radio", "RadioPanelMonitor_GUI", 6, 24, true, 20);
		Voice_SetSource("Catherine", "RadioPanelMonitor_GUI", 6, 24, true, 20);
		Voice_AddCharacterSpeakingCallback("Catherine", "OnCathSpeaking");
		Terminal_SetGuiActive("RadioPanelMonitor_GUI", true);
		
		//////////////////////////////////
		// Control panel effects
		Entity_SetEffectsActive("ControlRoomPanel", false, false);
		Lamp_SetLit("ControlPanelMonitor_*", false, false);
		
		Lamp_SetLit("RadioLamp1",false,false);
		Entity_SetEffectBaseColor("LampControlBoardButton",cColor(1.0f,0.0f,0.0f));
			
		/////////////////////////////////
		// Tentacles
		Map_AddTimer("RightTentacleDrainTimer", cMath_RandRectf(5.f, 15.f), "Seq_RightTentacleEnergyDrain");
		Map_AddTimer("LeftTentacleDrainTimer", cMath_RandRectf(5.f, 15.f), "Seq_LeftTentacleEnergyDrain");
		Entity_SetVarBool("ControlBoardTentacle_Right", "Attached", true);
		Entity_SetVarBool("ControlBoardTentacle_Left", "Attached", true);
		Light_SetFlickerActive("ControlBoardTentacle_Right_DrainLight", false);
		Light_SetVisible("ControlBoardTentacle_Right_DrainLight", false);
		Light_SetFlickerActive("ControlBoardTentacle_Left_DrainLight", false);
		Light_SetVisible("ControlBoardTentacle_Left_DrainLight", false);
		
		//MovingButton_SetCanBeSwitchedOn("ControlPanelKnob_*", false);	
		MovingButton_SetCanBeSwitchedOff("ControlPanelKnob_*", false);
		
		StickyArea_AttachBody("ControlBoardTentacle_Left_Sticky","ControlBoardTentacle_Left_Body_11");
		StickyArea_AttachBody("ControlBoardTentacle_Right_Sticky","ControlBoardTentacle_Right_Body_11");
		
		/////////////////////////////
		// Setup Cath connect time
		const float fTotalConnectTime = 20.f;
		const float fMinMaxConnectVariationMul = 0.2f;
		
		float fTimeLeft = fTotalConnectTime;
		
		for (int i = 1; i <= glConnectStationCount; i++)
		{
			float fLoadTime = fTimeLeft/(glConnectStationCount-(i-1));
			if (i != glConnectStationCount)
				fLoadTime*=1.f+cMath_RandRectf(-fMinMaxConnectVariationMul, fMinMaxConnectVariationMul);
				
			Terminal_SetImGuiStateFloat("RadioPanelMonitor_GUI", "StationConnectTime_"+i, fLoadTime);
			fTimeLeft-=fLoadTime;
		}
		
		/////////////////////////////
		// Setup control room lighting
		
		Lamp_SetLit("control_room_ceiling_lamp_1", false, false);
	}
	
	//-------------------------------------------------------
	
	//} END CONTROL ROOM BASICS
	
	
	/////////////////////////////////////////
	// CONTROL ROOM JONSI ENCOUNTER
	//{//////////////////////////////////////
	
		/////////////////////////////////////////
		// Jonsi: General
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		bool mbJonsiDead = false;
		
		//-------------------------------------------------------
	
		void LookAt_Jonsi(const tString &in asEntity, int alState)
		{
		}
	
		//-------------------------------------------------------
		
		void Interact_Jonsi(const tString &in asEntity)
		{
			Entity_SetInteractionDisabled(asEntity, true);
			if (Voice_CharacterIsSpeaking("Player"))
				Voice_StopAll();
				
			if (mbJonsiDead==false)
				Voice_Play("2A_TalkToJonsi", -1, "VoiceOver_JonsiTalkOver");
			else
				Voice_Play("2A_TalkToJonsi_Dead", -1, "VoiceOver_JonsiTalkOver");
		}
	
		//-------------------------------------------------------
		
		void LineOver_TalkToDeadJonsi(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
		{
			Entity_SetActive("JonsiTalkTo", false);
		}
	
		//-------------------------------------------------------
		
		void VoiceOver_JonsiTalkOver(const tString&in asScene, const tString&in asSubject)
		{
			Entity_SetInteractionDisabled("JonsiTalkTo", false);
		}
	
		//-------------------------------------------------------
		
		//} END Jonsi: GEneral
	
		/////////////////////////////////////////
		// Jonsi: Voice
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		bool Trigger_BodyMoans(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1 || Map_GetTimerTime("BodyMoans") > 0)
				return true;
			
			Voice_SetSource("ControlRoomBody", "ControlRoomBody", 4, 20, true, 20);
			Map_AddTimer("BodyMoans", cMath_RandRectf(0.5, 2), "TimerBodyMoans");
			return true;
		}
		
		//-------------------------------------------------------
		
		void TimerBodyMoans(const tString &in asTimer)
		{
			if (!Entity_GetCollide("Player", "BodyMoaningTrigger"))
				return;
			if (!Entity_GetVarBool("ControlBoardTentacle_Left", "Attached") && 
				!Entity_GetVarBool("ControlBoardTentacle_Right", "Attached"))
				return;
				
			cLux_AddTodoMessage("VOICE: 2A - Robot sucks energy out of the control panel, enjoying itself somewhat");
			Voice_Play("2A_ControlRoomBodyMoans");
			Map_AddTimer("BodyMoans", cMath_RandRectf(3, 6), "TimerBodyMoans");
		}
		
		//} END Jonsi: Voice
	
		/////////////////////////////////////////
		// Jonsi: control panel
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		void InteractControlRoomButton(const tString &in asEntity)
		{
			Sound_CreateAtEntity(asEntity+"InteractSound", "Entities_Station/tech/control_board_pplant_button/interact", asEntity, 0, false);
			
			////////////////////////////////
			// Make the button always work if script debug is turned on
			bool bOverridePuzzle = false;
			if (cLux_ScriptDebugOn())
			{
				bOverridePuzzle = true;
				Voice_Play("ControlRoomBodyDies", -1, "", 2);
				Terminal_SetGuiActive("ControlPanelMonitor_GUI", false, 1);
				Map_AddTimer("ChangeControlRoomOnGuiFunc", 1, "TimerChangeControlRoomOnGuiFunc");
			}
			
			/////////////////////////////
			// Button doesn't work yet
			if ((Entity_GetVarBool("ControlBoardTentacle_Left", "Attached") || 
				Entity_GetVarBool("ControlBoardTentacle_Right", "Attached")) &&
				bOverridePuzzle == false)
			{
				SequenceControlRoomButtonError("");
			}
			
			/////////////////////////////
			// Turn on control panel
			else
			{
				mbControlPanelOn = true;
				Terminal_SetUpdateWhenOutOfView("RadioPanelMonitor_GUI", true);
				Sound_CreateAtEntity("ControlPanelOn", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_switch_on", "PowerPuzzleTerminalSoundSource");
				Light_SetFlickerActive("control_board_screen_gobo", false);
				//MovingButton_SetCanBeSwitchedOn("ControlPanelKnob_*", true);	
				
				///////////////////////
				//Start part 1 of power puzzle sound
				//Sound_CreateAtEntity("PowerPuzzleCPUStage1", "01_02_upsilon_inside_02/sfx/generator_puzzle/machine/A", "PowerPuzzleCPUSoundSource", 0.0f, true, 1.0f);
				
				
				///////////////////////////////////////
				// Check for knobs already turned on
				for (int i = 1; i <= 3; i++)
				{
					if (MovingButton_IsSwitchedOn("ControlPanelKnob_" + i))
					{		
						// Set green lamp to unlit, then activate it and fade it on
						Lamp_SetLit("KnobLamp_" + i + "_On", false, false);
						ActivateControlPanelKnob(i);
					}
				}
				
				//////////////////////////
				// Sound
				//Sound_CreateAtEntity("ControlPanelHum", "Entities_Station/tech/control_board_hum/hum_start", "server_medium_pplant_23", 0.0, true);
				
				//////////////////////////
				// Entity effects
				Map_AddTimer("KnobLamp_*", 0.5f, "TimerTurnOnLamp");
				Light_FadeTo("KnobLight_*",cColor_Red,-1,0.05f);
				
				Terminal_SetGuiActive("ControlPanelMonitor_GUI", true, 1);
				
				Map_AddTimer("ControlPanelMonitor_2", 1.25f, "TimerTurnOnLamp");
				Map_AddTimer("ControlPanelMonitor_3", 2.25f, "TimerTurnOnLamp");
				Map_AddTimer("ControlPanelMonitor_4", 1.5f, "TimerTurnOnLamp");
			}
			
			
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mControlRoomButtonErrorSequence;
		
		//////////////////////////////////////////////////////////////////////////////////
		// Feedback when pressing control panel button before pulling out tentacles
		void SequenceControlRoomButtonError(const tString &in asName)
		{
			Sequence_Begin("SequenceControlRoomButtonError", mControlRoomButtonErrorSequence);
			
			if (Sequence_DoStepAndWait(0.7))
			{
				Map_RemoveTimer("RightTentacleDrainTimer");
				Map_RemoveTimer("LeftTentacleDrainTimer");
				
				Terminal_SetImGuiStateFloat("ControlPanelMonitor_GUI", "DistortionAmount",1.0f);
				
				if (Entity_GetVarBool("ControlBoardTentacle_Right", "Attached"))
				{
					ParticleSystem_CreateAtEntity("ElecSparkPS", "elec_spark_oneshot.ps", 
						"ControlBoardTentacle_Right_Sticky", true);
				}
				if (Entity_GetVarBool("ControlBoardTentacle_Left", "Attached"))
				{
					ParticleSystem_CreateAtEntity("ElecSparkPS", "elec_spark_oneshot.ps", 
						"ControlBoardTentacle_Left_Sticky", true);
				}
			}
			
			else if (Sequence_DoStepAndWait(1.2))
			{
				Sound_CreateAtEntity("ControlPanelNotReady", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_bootup_warning", "PowerPuzzleTerminalSoundSource", 0, false);
			}
			else if (Sequence_DoStepAndWait(0.2))
			{
				Sound_Stop("ControlPanelNotReady", 0);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				if (Entity_GetVarBool("ControlBoardTentacle_Right", "Attached"))
					Seq_RightTentacleEnergyDrain("");
				if (Entity_GetVarBool("ControlBoardTentacle_Left", "Attached"))
					Seq_LeftTentacleEnergyDrain("");
			}
			else if (Sequence_DoStepAndWait(0))
			{				
				MovingButton_SetSwitchedOn("ControlRoomButton", false, true);
			}
			
			Sequence_End();
		}
		
		//} END Jonsi: control panel
	
	
		/////////////////////////////////////////
		// Jonsi: tentacles
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		cSequenceStatesData mRightTentacleEnergyDrainSequence;
		void Seq_RightTentacleEnergyDrain(const tString &in asTimer)
		{
			Sound_CreateAtEntity("EnergySuck", "01_02_upsilon_inside_02/sfx/wau_tube/suck", "ControlBoardTentacle_Right");
			TentacleDrainSequence("ControlBoardTentacle_Right", "Seq_RightTentacleEnergyDrain", mRightTentacleEnergyDrainSequence);
			Body_AddImpulse("ControlBoardTentacle_Right_Body_5", cVector3f_Up*3, false);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mLeftTentacleEnergyDrainSequence;
		void Seq_LeftTentacleEnergyDrain(const tString &in asTimer)
		{
			Sound_CreateAtEntity("EnergySuck", "01_02_upsilon_inside_02/sfx/wau_tube/suck", "ControlBoardTentacle_Left");
			TentacleDrainSequence("ControlBoardTentacle_Left", "Seq_LeftTentacleEnergyDrain", mLeftTentacleEnergyDrainSequence);
			Body_AddImpulse("ControlBoardTentacle_Left_Body_5", cVector3f_Up*3, false);
		}
		
		//-------------------------------------------------------
		
		void TentacleDrainSequence(const tString &in asTentacle, const tString &in asSequenceName, cSequenceStatesData& aSequenceData)
		{
			Sequence_Begin(asSequenceName, aSequenceData);
			
			if (!Entity_GetVarBool(asTentacle, "Attached")) // Abort sequence if the tentacle has been detatched
			{
				Light_SetFlickerActive(asTentacle+"_DrainLight", false);
				Light_SetVisible(asTentacle+"_DrainLight", false);
				Sequence_Stop();
				return;
			}
			
			///////////////////
			// Effects on
			if (Sequence_DoStepAndWait(0.05))
			{
				//cLux_AddTodoMessage("Sound: Energy Suck");
				Sound_CreateAtEntity(asTentacle+"_SuckingEnergy", "01_02_upsilon_inside_02/sfx/wau_tube/suck", asTentacle+"_Sticky", 0.0f, false);
				Light_SetVisible(asTentacle+"_DrainLight", true);
				Light_SetFlickerActive(asTentacle+"_DrainLight", true);
			}
					
			//////////////////////////////////////////////////////
			// Add an impulse to each tentacle segment in turn
			for (int i = 11; i >= 1; i--)
			{
				if (Sequence_DoStepAndWait(0.15))
				{
					Body_AddImpulse(asTentacle+"_Body_" + i, cVector3f_Up*2, false);
					break;
				}
			}
			
			///////////////////
			// Effects off
			if (Sequence_DoStepAndWait(0))
			{
				Light_SetFlickerActive(asTentacle+"_DrainLight", false);
				Light_SetVisible(asTentacle+"_DrainLight", false);
				
				Map_AddTimer(asTentacle+"_DrainTimer", cMath_RandRectf(2.f, 8.f), asSequenceName);
			}
			
			Sequence_End();
		}
			
		//-------------------------------------------------------
		
		void DetachControlBoardTentacle(const tString &in asAreaName, const tString &in asBodyName)
		{
			TentacleDetached(asAreaName, asBodyName);
			Sound_CreateAtEntity("EnergyRemove", "01_02_upsilon_inside_02/sfx/wau_tube/unplug", asAreaName);
			if (!Entity_GetVarBool("ControlBoardTentacle_Right", "Attached") && 
				!Entity_GetVarBool("ControlBoardTentacle_Left", "Attached"))
			{
				///////////////////////////////////
				// Player detaches all tentacles - robot pleads then dies
				Voice_Play("2A_ControlRoomBodyDies", -1, "", 2);
				Map_AddTimer("TimerControlRoomBodyDies",8.0f,"TimerControlRoomBodyDies");
				
				Entity_SetActive("JonsiLookAt", false);
				Entity_SetActive("JonsiTalkTo", false);
			}
			else
			{
				///////////////////////////////////
				// Player detaches one tentacle, robot pleads
				Dialog_Begin();
					Dialog_AddBranch("DetachTentacle");
						Dialog_AddSubject("2A_DetachTentacle");
				Dialog_End();
			}
		}
		
		//-------------------------------------------------------
		
		void TimerControlRoomBodyDies(const tString& in asTimer)
		{
			Entity_SetActive("JonsiDistortion", false);
			
			mbJonsiDead = true;
			Entity_SetActive("JonsiTalkTo", true);
			Entity_SetEffectsActive("ControlRoomBody", false, true);
			Entity_PlayAnimation("ControlRoomBody", "death", 0.1f, false, false);
			
			/////////////////////////////////////////
			// Terminals come online
			Terminal_SetGuiActive("ControlPanelMonitor_GUI", false, 1);
			Map_AddTimer("ChangeControlRoomOnGuiFunc", 1, "TimerChangeControlRoomOnGuiFunc");
		}
		
		//-------------------------------------------------------
		
		void TentacleDetached(const tString &in asAreaName, const tString &in asBodyName)
		{
			tString sEntity = Body_GetEntityName(asBodyName);
			if (!Entity_GetVarBool(sEntity, "Attached"))
				return;
				
			Entity_SetVarBool(sEntity, "Attached", false);
			Entity_SetActive("Interact"+sEntity,false);
			
			Entity_SetInteractionDisabled(sEntity+"_Flower", false);
			EnergySource_SetEnergy(sEntity+"_Flower", 0.0f);
			
			//////////////////
			// Effects
			ParticleSystem_CreateAtEntityExt(asAreaName + "SparkParticles", "ps_impact_metal_high.ps", asAreaName, false, cColor(0.5,0.5,1,1), 3.f);
			ParticleSystem_CreateAtEntityExt(asAreaName + "DustParticles", "dust_puff.ps", asAreaName, false, cColor(0.3f,1));
			
			cLux_AddTodoMessage("Sound:Detach tentacles pain sound");
			//Sound_CreateAtEntity(sEntity+"_Detatch", "01_02_upsilon_inside/special/tentacles/pain", asAreaName, 0, false);
			
			//Entity_SetActive(asAreaName, false);
		}
		
		
		//-------------------------------------------------------
		
		void TimerChangeControlRoomOnGuiFunc(const tString &in asTimer)
		{
			cLux_AddTodoMessage("SOUND: Control knob puzzle activates - ready to play!");
			Terminal_SetGuiActive("ControlPanelMonitor_GUI", true, 1);
			Terminal_SetOnGuiFunction("ControlPanelMonitor_GUI", "OnGuiControlPanel");
			Entity_SetEffectBaseColor("LampControlBoardButton",cColor(0.0f,1.0f,0.0f));
		}
		
		//-------------------------------------------------------
		
		void InteractControlBoardTentacle(const tString &in asEntity)
		{
			Joint_Break(asEntity + "_connection_joint");
			
			ParticleSystem_CreateAtEntity("ElecSparkPS", "elec_spark_oneshot.ps", 
				Entity_GetVarString(asEntity, ""), true);
			
			if (Entity_GetVarBool("ControlBoardTentacle_Left", "Attached") && 
				Entity_GetVarBool("ControlBoardTentacle_Right", "Attached"))
			{
				Voice_Play("ControlRoomBodyPleads_1", -1, "", 1);
			}
			else
			{
				Voice_Play("ControlRoomBodyPleads_2", -1, "", 1);
			}
			Entity_SetInteractionDisabled("ConstructWauFlower", false);
			EnergySource_SetEnergy("ConstructWauFlower", 0.0f);
		}
		
		//} END Jonsi tentacles
	
	
	//} END JONSI ENCOUNTER
 
	/////////////////////////////////////////
	// CONTROL ROOM START PUZZLE
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	void StateChangeControlPanelKnob(const tString &in asEntity, int alState)
	{
		if (!mbControlPanelOn)
		{
			if (alState==1)
			{
				Map_AddTimer(asEntity,0.5f,"TimerResetControlPanelKnob");
			}
			return;
		}
		
		if (alState != 1) 
			return;
				
		//////////////////
		// Activate knob
		int lIndex = cString_GetNumericSuffixInt(asEntity);
		
		float fTimerTime = Map_GetTimerTime("ControlPanelKnob_"+(lIndex-1));
		float fTimerFract = 1.f-fTimerTime/gfControlRoomKnobTurnTimer;
		
		if (fTimerTime <= 0)
		{
			// Player turned the wrong knob
			if (mlKnobsTurned > 0 || lIndex != 1)
			{
				cLux_AddDebugMessage("Player turned the wrong knob");
				CancelControlPanelPuzzle();
				return;
			}
		}
		
		// Player turned too late or too early
		else if (fTimerFract < gfControlRoomKnobTurnWindowMin || fTimerFract > gfControlRoomKnobTurnWindowMax)
		{
			cLux_AddDebugMessage("Player turned too late or too early. Time: "+fTimerTime);
			CancelControlPanelPuzzle(lIndex-1);
			return;
		}
		
		if (lIndex > 1)
			Map_RemoveTimer("ControlPanelKnob_"+(lIndex-1));
			
		ActivateControlPanelKnob(lIndex);
		
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "UpdatePuzzleGauge_"+(lIndex-1), 0);
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "UpdatePuzzleGauge_"+lIndex, 1);
		
		Sound_Stop("ProgressBarFill", 0.0f);
		Sound_CreateAtEntity("ProgressBarFill", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_progress_bar", "PowerPuzzleTerminalSoundSource", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("ButtonPress", "Entities_Station/tech/control_board_pplant_button/interact", asEntity);
		
		if (mlKnobsTurned == 3) // all knobs activated
		{
			cLux_AddTodoMessage("SOUND: Control knob puzzle COMPLETE! (Sounds may need to go in this sequence");
			SequenceGeneratorTurnedOn("");
		}
		else
		{
			if (mlKnobsTurned > 1)
			{
				Sound_CreateAtEntity("ProgressBarSuccess", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_progress_bar_success", "PowerPuzzleTerminalSoundSource", 0.0f, false, 1.0f);
				//Sound_CreateAtEntity("PowerPuzzleCPUStage2", "01_02_upsilon_inside_02/sfx/generator_puzzle/machine/B", "PowerPuzzleCPUSoundSource", 0.0f, true, 1.0f);
				Sound_Stop("PowerPuzzleCPUStage1", 0.25f);
			}
			else
			{
				Sound_CreateAtEntity("ProgressBarFill", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_progress_bar", "PowerPuzzleTerminalSoundSource", 0.0f, false, 1.0f);
			}
			
			Map_AddTimer(asEntity, gfControlRoomKnobTurnTimer, "TimerControlPanelKnobTurned");
			Sound_Stop("ProgressBarFill", 0.0f);
		}
	}
	
	//-------------------------------------------------------
	
	void TimerResetControlPanelKnob(const tString &in asTimer)
	{
		MovingButton_SetSwitchedOn(asTimer,false,true);
	}
	
	//-------------------------------------------------------
	
	void TimerControlPanelKnobTurned(const tString &in asTimer)
	{
		CancelControlPanelPuzzle(cString_GetNumericSuffixInt(asTimer));
	}
	
	//-------------------------------------------------------
	
	void CancelControlPanelPuzzle(int alErrorIndex=-1)
	{	
		cLux_AddTodoMessage("SOUND: Control knob fail");
		Sound_CreateAtEntity("PuzzleError", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_progress_bar_fail", "PowerPuzzleTerminalSoundSource");
		Sound_Stop("ProgressBarFill", 0.0);
				
		DisableControlPanelKnobInteraction(1);
		DisableControlPanelKnobInteraction(2);
		DisableControlPanelKnobInteraction(3);
		
		cLux_AddDebugMessage("CancelControlPanelPuzzle Stopping "+(1));
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "UpdatePuzzleGauge_1", 0);
		cLux_AddDebugMessage("CancelControlPanelPuzzle Stopping "+(2));
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "UpdatePuzzleGauge_2", 0);
		
		if (alErrorIndex > 0)
		{
			Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "PuzzleGaugeError_"+alErrorIndex, 1);
		}
		Map_AddTimer("ControlPanelErrorOver", 2, "TimerControlPanelErrorOver");
	}
	
	//-------------------------------------------------------
	
	void TimerControlPanelErrorOver(const tString &in asTimer)
	{
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "PuzzleGaugeError_1", 0);
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "PuzzleGaugeError_2", 0);
		
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "UpdatePuzzleGauge_1", 0);
		Terminal_FadeImGuiStateFloat("ControlPanelMonitor_GUI", "PuzzleGaugeFill_1", 0.05, 1);
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "UpdatePuzzleGauge_2", 0);
		Terminal_FadeImGuiStateFloat("ControlPanelMonitor_GUI", "PuzzleGaugeFill_2", 0.05, 1);
		
		//Sound_Stop("PowerPuzzleCPUStage1", 0.25f);
		//Sound_Stop("PowerPuzzleCPUStage2", 0.25f);
		//Sound_CreateAtEntity("PowerPuzzleCPUStage1", "01_02_upsilon_inside_02/sfx/generator_puzzle/machine/A", "PowerPuzzleCPUSoundSource", 0.0f, true, 1.0f);
		
		
		mlKnobsTurned = 0;
		DeativateControlPanelKnob(1);
		DeativateControlPanelKnob(2);
		DeativateControlPanelKnob(3);
	}
	
	//-------------------------------------------------------
	
	void ActivateControlPanelKnob(int alIndex)
	{
		mlKnobsTurned++;
		
		// Replace red light with green light
		Entity_SetActive("KnobLamp_" + alIndex, false);
		Entity_SetActive("KnobLamp_" + alIndex + "_On", true);
		Light_FadeTo("KnobLight_"+alIndex,cColor_Green,-1,0.05f);
	}	
	
	//-------------------------------------------------------	
	
	void DisableControlPanelKnobInteraction(int alIndex)
	{
		tString sProp = "ControlPanelKnob_" + alIndex;

		if (Entity_IsInteractedWith(sProp))
		{
			Player_ChangeStateToNormal();
			Player_SetLookSpeedMul(0);
			Player_FadeLookSpeedMulTo(1, 2);
		}
	}
	
	//-------------------------------------------------------
	
	void DeativateControlPanelKnob(int alIndex)
	{
		tString sProp = "ControlPanelKnob_" + alIndex;
		MovingButton_SetSwitchedOn(sProp, false, true);
		
		// Replace green light with red light
		Entity_SetActive("KnobLamp_" + alIndex, true);
		Entity_SetActive("KnobLamp_" + alIndex + "_On", false);
		Light_FadeTo("KnobLight_"+alIndex,cColor_Red,-1,0.05f);
		
		Map_RemoveTimer(sProp);
	}
	
	//} END CONTROL ROOM START PUZZLE
	
	/////////////////////////////////////////
	// CONTROL ROOM CATH TALKING
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool OnCathSpeaking(const tString &in asCharacter, bool abStartedTalking)
	{
		Lamp_SetLit("RadioLamp1",abStartedTalking,true);
		return true;
	}
	
	//-------------------------------------------------------
		
	void StartFirstContactDialog()
	{	
		//Pause quakes and duck world for VO
		Audio_PauseQuakes(true);
		Map_AddTimer("DuckLight", 0.1f, "Audio_ConversationDucking");
		
		//Button_SetDisabled("ControlRoomDoor_Control_2", false);
		mbControlRoomConnectFailing = true;
		Voice_SetFocusScene("");
		Terminal_SetGuiActive("RadioPanelMonitor_GUI", true);
		Dialog_Begin("OneWayTransmission");
			Dialog_AddBranch("FirstContact");
				Dialog_AddSubject("2D_FirstContact_1", "FirstContactPart1End");
		Dialog_End();
	}
			
	//-------------------------------------------------------
	
	//////////////////////////////////////////////////////////
	// Triggers static sound when part 1 of Catherine's call is over
	void FirstContactPart1End(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) 
			return;
	}
	
		//-------------------------------------------------------
	
	void OnCatherineFinishedFirstTransmission(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
	{
		if (abStart)
			return;
			
		mbControlRoomConnectFailing = false;
		mbControlRoomConversationOver = true;
	}
	
	//-------------------------------------------------------
		
	void LineOver_CathTransmissionFailing(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if (abStartOfLine)
		{
			Map_AddTimer("TimerControlRoomSparks",1.0f,"TimerControlRoomSparks");
			return;
		}
			
		Map_AddTimer("UnlockControlRoomDoor", 31.0f, "UnlockControlRoomDoor");
	}
	
	//-------------------------------------------------------
	
	void TimerControlRoomSparks(const tString& in asTimer)
	{
		ParticleSystem_CreateAtEntityExt("PSControlRoomSparks", "ps_impact_metal_high.ps", "ControlPanelMonitor_2", false, cColor_White, 3.f);
		Sound_CreateAtEntity("SparkTrigger", "02_05_theta/amb/spots/small_spark", "ControlPanelMonitor_2");
		Lamp_SetLit("ControlPanelMonitor_2", false,false);
	}
	
	//-------------------------------------------------------
	
	void UnlockControlRoomDoor(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Unlock control room door.");
		
		Button_SetDisabled("ControlRoomDoor_Control_2", false);
		Button_SetLocked("ControlRoomDoor_Control_2", false);
		
		Sound_CreateAtEntity("DoorFunctional", "Entities_Station/doors/upsilon/horizontal_auto/close_end", "ControlRoomDoor_Control_2", 0.25f, false);
		Sound_CreateAtEntity("CommRoomPanelUnlock", "Entities_Station/doors/upsilon/upsilon_button/upsilon_button_unlock", "ControlRoomDoorPanelSoundSource");					 
		
		// Activate transformer bot here
		Terminal_SetImGuiStateInt("ControlPanelMonitor_GUI", "Doors", 1);
		//Entity_SetActive("TransformerBot", true);
		
		//Reenable Quakes and bring back up audio
		Audio_PauseQuakes(false);
		Map_AddTimer("Return3s", 0.1f, "Audio_ConversationDucking");

		Achievement_Unlock(eAchievement_CathCall);
	}
	
	//-------------------------------------------------------
		
	//} END CONTROL ROOM CATH TALKING
			
	/////////////////////////////////////////
	// TERMINALS: CONTROL ROOM
	//{//////////////////////////////////////
	
		/////////////////////////////////////////
		// Radio Terminal
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
			
		bool mbControlRoomConnectFailing = false;
		bool mbControlRoomConversationOver = false;
		
		void OnGuiRadioPanel(const tString&in asEntityName, float afTimeStep)
		{		
			ImGui_SetTransCategory("01_02_upsilon_inside");
					
			///////////////////////////////////
			// Fading overlay
			if (ImGui_IsFirstRun())
			{
				Entity_SetEffectsActive(asEntityName, true, true);
				ImGui_SetStateFloat("ForegroundAlpha", 0);	// Turned off due to caching issue
				ImGui_FadeStateFloat("ForegroundAlpha", 0, 1.f);
				Light_FadeTo("RadioPanelMonitorLight_1", cColor(0.112,0.149,0.179,1), -1, 1.f);
			}
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
			ImGui_SetModColorMul(cColor(0, ImGui_GetStateFloat("ForegroundAlpha", 1.f)));
			ImGui_DoImage(cImGuiGfx(""), cVector3f(0, 0, 5), cVector2f(ImGui_GetSize().x, ImGui_GetSize().y));
			ImGui_ResetModifiers();
			
			///////////////////////////////////
			// Background
			cColor ornamentCol = ImGui_FadeOscillateColor("BlueCornerFade",cColor(1, 0.35f), cColor(1, 0.45f), 1.0f);
			StationGuiBG_Scanlines();
			//StationGuiBG_BackdropV2();
			StationGuiBG_TaskbarV2("transport_symbol_upsilon");
			
			if (!mbControlRoomCommOn||mbControlRoomConversationOver)
			{
				tString sMessage = mbControlRoomConversationOver ? 
								   "ControlTerminalNoConnection" :
								   "ControlTerminalNoPower";
								   
				StationGui_BigStatusMessage(sMessage, gStationGuiColor_Warning, 1, true);
						
				return;
			}
			
			if (ImGui_TimerOver("ConnectionEstablished"))
			{
				ImGui_SetStateInt("State", 1);
				Terminal_SetUpdateWhenOutOfView("RadioPanelMonitor_GUI", false);
				ImGui_AddTimer("DotFadeTimer", 1.5f);
				StartFirstContactDialog();
			}
			
			if (ImGui_GetStateInt("State", 0)==0)
				OnGuiRadioPanel_Connect(asEntityName, afTimeStep);
			else
				OnGuiRadioPanel_CathCommunication(asEntityName, afTimeStep);
		}
		
		//-------------------------------------------------------
		
		void OnGuiRadioPanel_Connect(const tString&in asEntityName, float afTimeStep)
		{		
			int lStationIndex = ImGui_GetStateInt("StationIndex", 1);
			
			/////////////////////////
			// Data
			cImGuiLabelData label;
			label.mFontAlign = eFontAlign_Left;
			label.mFont.SetFile("sansation_medium.fnt");
			
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			
			const float fFontHeight = 0.04;
			const float fStationWindowWidth = 0.65;
			float fStatusWindowStartX = fStationWindowWidth+0.05;
			
			const float fListStartY = 0.05;
			const float fEntryOffsetY = 0.075;
					
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.15, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.55, 0.85)));
			
				///////////////////////////////
				// Station list
				ImGui_DoWindowStart("StationWindowCaption", window, ImGui_NrmPosGroup(0), ImGui_NrmSizeGroup(cVector2f(fStationWindowWidth, 1)), false);
					for (int i = 1; i <= lStationIndex && i <= glConnectStationCount; i++)
					{
						int lActualContact = i;
						if (i == eCommRoomContact_Upsilon)
							lActualContact = int(eCommRoomContact_Delta);
							
						label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(fFontHeight);
						ImGui_DoLabelExt("CommContact_"+lActualContact, label, ImGui_NrmPosGroup(cVector3f(0.1,fListStartY+(i-1)*fEntryOffsetY,1)), ImGui_NrmSizeGroup(cVector2f(1,-1)));
					}
				ImGui_DoWindowEnd();
				
				///////////////////////////////
				// Connection status window
				label.mFontAlign = eFontAlign_Center;
				ImGui_DoWindowStart("StationStatusWindowCaption", window, ImGui_NrmPosGroup(cVector3f(fStatusWindowStartX, 0, 1)), 
													  ImGui_NrmSizeGroup(cVector2f(1.0f-fStatusWindowStartX, 1)), false);
					for (int i = 1; i <= lStationIndex && i <= glConnectStationCount; i++)
					{
						DoStationConnectionStatus(i, lStationIndex, glConnectStationCount, fListStartY+(i-1)*fEntryOffsetY, fFontHeight, label);
					}
				ImGui_DoWindowEnd();
			ImGui_GroupEnd();
		}
			
		//-------------------------------------------------------
		
		void DoStationConnectionStatus(int alIndex, int alCurrentIndex, int alStationCount, float afYPos, float afFontHeight, const cImGuiLabelData &in aLabel)
		{		
			if (alIndex == alCurrentIndex)
			{
				if (Depth_ImGui_LoadingGauge("ConnectionProgress_"+alIndex, ImGui_GetStateFloat("StationConnectTime_"+alIndex, 0), false, 
										 ImGui_NrmPosGroup(cVector3f(0.1,afYPos,1)), ImGui_NrmSizeGroup(cVector2f(0.8,afFontHeight)), 
										 StationGui_CreateDefaultGaugeData()))
				{
					float fStationOffline = cMath_RandRectf(0.1, 0.5);
					ImGui_AddTimer("NextStation", fStationOffline+0.3);
					ImGui_AddTimer("StationOffline", fStationOffline);
					
					ImGui_IncStateInt("StationIndex", 1);
					
					Depth_ImGui_ResetLoadingGauge("ConnectionProgress_"+(alIndex+1));
					
					if (alIndex == alStationCount)
						ImGui_AddTimer("ConnectionEstablished", 5.0f);
				}
			}
			else if (alIndex==alStationCount)
			{
				ImGui_SetModColorMul(cColor_Green);
				ImGui_DoLabelExt("Online", aLabel, ImGui_NrmPosGroup(cVector3f(0,afYPos,1)), ImGui_NrmSizeGroup(cVector2f(1,-1)) );
				ImGui_SetModColorMul(cColor_White);
			}
			else
			{
				ImGui_SetModColorMul(cColor_Red);
				ImGui_DoLabelExt("Offline", aLabel, ImGui_NrmPosGroup(cVector3f(0,afYPos,1)), ImGui_NrmSizeGroup(cVector2f(1,-1)) );
				ImGui_SetModColorMul(cColor_White);
			}
		}
			
		//-------------------------------------------------------
		
		void OnGuiRadioPanel_CathCommunication(const tString&in asEntityName, float afTimeStep)
		{
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.SetFile("sansation_large.fnt");
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.075);
			label.mFontAlign = eFontAlign_Center;
			
			///////////////////////////////////
			// Station icons
			cImGuiGfx sitesGfx;
			sitesGfx.SetFile("transport_symbol_upsilon");
			ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.075f, 0.2f, 2.0f)), ImGui_NrmSize(cVector2f(0.25f,0.4f)));
			ImGui_DoImageCorrectAspect(sitesGfx, ImGui_NrmPosGroup(cVector3f(0.0f, 0, 2.0f)), ImGui_NrmSizeGroup(cVector2f(1,0.9f)) );
			ImGui_DoLabelExt("CommContact_7", label, ImGui_NrmPosGroup(cVector3f(0.0f, 0.9f, 2.0f)), ImGui_NrmSizeGroup(1, 0.1));
			ImGui_GroupEnd();
			
			sitesGfx.SetFile("transport_symbol_lambda");
			ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.675f, 0.2f, 2.0f)), ImGui_NrmSize(cVector2f(0.25f,0.4f)));
			ImGui_DoImageCorrectAspect(sitesGfx, ImGui_NrmPosGroup(cVector3f(0.0f, 0, 2.0f)), ImGui_NrmSizeGroup(cVector2f(1,0.9f)) );
			ImGui_DoLabelExt("CommContact_9", label, ImGui_NrmPosGroup(cVector3f(0.0f, 0.9f, 2.0f)), ImGui_NrmSizeGroup(1, 0.1));
			ImGui_GroupEnd();

			
			//////////////////////////////////
			// Oscillating link dots
			cImGuiGfx inactiveDotGfx("station/comm/firstcontact_dot_inactive");
			cImGuiGfx activeDotGfx("station/comm/firstcontact_dot_active");
			
			ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(cVector3f(0.175f, 0.675f, 2.0f)), ImGui_NrmSize(cVector2f(1, 0.4f)), cVector2f(45.0f, 0.0f));
				
				if(ImGui_TimerOver("DotFadeTimer"))
				{
					int lDotIndex = ImGui_GetStateInt("DotIndex");
					if(lDotIndex == 6)
						ImGui_SetStateInt("DotSign", -1);
					else if(lDotIndex == 0)
						ImGui_SetStateInt("DotSign", 1);

					
					ImGui_IncStateInt("DotIndex", 1 * ImGui_GetStateInt("DotSign", 1));
					ImGui_AddTimer("DotFadeTimer", 0.4f);
				}
				
				if (mbControlRoomConnectFailing)
					ImGui_SetModColorMul(cColor_Red*(0.5f+cMath_RandRectf(0.0,0.5f))*cColor_White);
					
				for(int i = 0; i < 7; i++)
				{
					if (ImGui_GetStateInt("DotIndex") == i)
						ImGui_DoImage(activeDotGfx, cVector3f_Zero, cVector2f(32.0f, 32.0f));
					else 
						ImGui_DoImage(inactiveDotGfx, cVector3f_Zero, cVector2f(32.0f, 32.0f));
				}
				
			ImGui_LayoutEnd();
			ImGui_ResetModifiers();
		}
		
		//} END TERMINAL: CONTROL ROOM, RADIO
		
			
		/////////////////////////////////////////
		// Startup puzzle terminal
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnGuiControlPanel(const tString&in asEntityName, float afTimeStep)
		{		
			cColor chineseCol = gStationGuiColor_Normal2;
				
			ImGui_SetTransCategory("01_02_upsilon_inside");
			
			/////////////////////////////////////
			// Background
			cColor ornamentCol = ImGui_FadeOscillateColor("BlueCornerFade2",cColor(1, 0.7f), cColor(1, 0.9f), 1.4f);
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			StationGuiBG_OrnamentTopLeft();
			StationGuiBG_OrnamentBottomLeft();
			StationGuiBG_OrnamentBottomRight();
			StationGuiBG_Taskbar();
			
			////////////////////////////////////////
			/// Shared widget data		
			cImGuiLabelData labelData;
			labelData.mFont.SetFile("sansation_large_bold.fnt");
			labelData.mFont.mvSize = cVector2f(48, 48);
			ImGui_SetDefaultLabel(labelData);
			
			if (!mbControlPanelOn)
			{
				StationGui_BigStatusMessage("ControlRoomPrompt", gStationGuiColor_Warning, 1.25f);
				return;
			}
			
			if (mbPowerOn_1)
				OnGuiControlPanel_StatusScreen(asEntityName, afTimeStep);
			else
				OnGuiControlPanel_StartScreen(asEntityName, afTimeStep);
			
			///////////////////////////////////
			// Ornaments
			ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(cVector3f(0.135f, 0.65f, 0.0f)), ImGui_NrmSize(cVector2f(0.6f, 0.4f)), cVector2f(15.0f, 0.0f));
			{
				cImGuiGfx ornamentGreek("station/greeksymbol/upsilon");
				ornamentGreek.mColor = cColor(0.07f, 0.41f, 0.72f, 1)*cColor(0.6f, .7f);
				for(int i=1; i<=2; i++)
					ImGui_DoImage(ornamentGreek, cVector3f_Zero, ImGui_NrmSizeKeepRatio(cVector2f(0.2/i)));
			}
			ImGui_LayoutEnd();
			
			ImGui_DrawAlignedGfx(cImGuiGfx("station/chinsymbol/big_default_tools"), cVector3f(720.f, 490, 1.1f), eImGuiAlign_CenterCenter, cVector2f(90, 150), chineseCol);
		}
		
		//-------------------------------------------------------
		
		void OnGuiControlPanel_StartScreen(const tString&in asEntityName, float afTimeStep)
		{
			///////////////////////////////////
			// Data
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			window.SetLabelPadding(0,15.0f,0,10.0f);
			window.SetPadding(20.0f, 40.0f, 20.0f, 40.0f);
			window.mFont.mvSize = 28;
			
			///////////////////////////////////
			// Gauges
			{			
				StationGui_DoWindowStart("BootSequenceHeader", window, ImGui_NrmPos(cVector3f(0.1f, 0.06f, 1.0f)), ImGui_NrmSize(cVector2f(0.8f, 0.76f)), true);
				{
					cVector2f vBarSize = ImGui_NrmSizeGroup(cVector2f(0.95f, 0.25f));
					
					//ImGui_LayoutBegin(eImGuiLayout_Y, ImGui_NrmPosGroup(cVector3f(0, 0.1, 1)), cVector2f_MinusOne, cVector2f(0,vBarSize.y));
					
					////////////////////////////////////////
					// 3 horizontal gauge bars
					DoKnobGauge(1, vBarSize);
					DoKnobGauge(2, vBarSize);
					//DoKnobGauge(3, vBarSize);
				
					//ImGui_LayoutEnd();
				}		 
				StationGui_DoWindowEnd();
			}
		}
		
		//-------------------------------------------------------
		
		void DoKnobGauge(int alIndex, const cVector2f &in avBarSize)
		{
			cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
			gauge.mOrientation = eImGuiGaugeOrientation_Hori;
			
			///////////////////////////////
			// Get fill amount
			float fFill = 0;
			if (ImGui_GetStateInt("UpdatePuzzleGauge_"+alIndex)==1)
			{
				float fTimerTime = Map_GetTimerTime("ControlPanelKnob_"+alIndex);
				float fFillMul = cMath_Min(1.0f*(1.f/gfControlRoomKnobTurnTimer),0.95f);
			
				fFill = MovingButton_IsSwitchedOn("ControlPanelKnob_"+alIndex) ? 1.0f-fTimerTime*fFillMul : 0.05f;
				ImGui_SetStateFloat("PuzzleGaugeFill_"+alIndex, fFill);			
			}
			else
			{
				fFill = ImGui_GetStateFloat("PuzzleGaugeFill_"+alIndex, 0.05);
			}
			
			/////////////////////////////
			// Gauge color
			gauge.mGfxFill.mColor = cColor(1, 1, 0, 1);
			if (fFill > gfControlRoomKnobTurnWindowMin && fFill < gfControlRoomKnobTurnWindowMax)
				gauge.mGfxFill.mColor = cColor_Green;
			else if (fFill > gfControlRoomKnobTurnWindowMax)
				gauge.mGfxFill.mColor = cColor_Red;
			
			/////////////////////////////
			// Rendering
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0, 0.1, 0.5))+cVector3f_Up*avBarSize.y*(alIndex-1)*2, avBarSize);
			
				ImGui_DoLabel("BootSequence_"+alIndex, ImGui_NrmPosGroup(cVector3f(0.025, -0.375, 0)), cVector2f_MinusOne, 0.75f);
			
				// Blink if in error state
				if (ImGui_GetStateInt("PuzzleGaugeError_"+alIndex)==1 && ImGui_FadeOscillateFloat("PuzzleGaugeVisible", 0, 1, 0.25, eEasing_Linear) > 0.5f)
					fFill = 0;
					
				ImGui_DoGauge(gauge, fFill, cVector3f_Forward*0.5, ImGui_NrmSizeGroup(1));
					
				cVector3f vKnobTurnZonePos = ImGui_NrmPosGroup(cVector3f(gfControlRoomKnobTurnWindowMin, 0, 0));
				cVector2f vKnobTurnZoneSize = ImGui_NrmSizeGroup(cVector2f(gfControlRoomKnobTurnWindowMax-gfControlRoomKnobTurnWindowMin, 1));
				cVector3f vKnobLateZonePos = ImGui_NrmPosGroup(cVector3f(gfControlRoomKnobTurnWindowMax, 0, 0));
				cVector2f vKnobLateZoneSize = ImGui_NrmSizeGroup(cVector2f(1.0f-gfControlRoomKnobTurnWindowMax, 1));
				
				ImGui_SetModColorMul(cColor(0.1, 0.1, 0, 1));
				ImGui_DoImage(cImGuiGfx(""), 0, ImGui_NrmSizeGroup(cVector2f(gfControlRoomKnobTurnWindowMin, 1)));
				ImGui_SetModColorMul(cColor(0, 0.1, 0, 1));
				ImGui_DoImage(cImGuiGfx(""), vKnobTurnZonePos, vKnobTurnZoneSize);
				ImGui_SetModColorMul(cColor(0.1, 0, 0, 1));
				ImGui_DoImage(cImGuiGfx(""), vKnobLateZonePos, vKnobLateZoneSize);
				ImGui_SetModColorMul(cColor_White);
			ImGui_GroupEnd();
		}
		
		//} END TERMINAL: TERMINAL: CONTROL ROOM, START PUZZLE
		
		
		/////////////////////////////////////////
		// Reactor status terminal
		//{//////////////////////////////////////
	
	//-------------------------------------------------------
	bool mbControlRoomCommOn = false;
	void OnGuiControlPanel_StatusScreen(const tString&in asEntityName, float afTimeStep)
	{
		///////////////////////////////////
		// Data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		window.mFont.mvSize = 28;
		window.SetLabelPadding(0,15.0f,0,10.0f);
		window.SetPadding(20.0f, 40.0f, 20.0f, 40.0f);
		
		cImGuiLabelData boldLabel = ImGui_GetDefaultLabel();
		boldLabel.mFont.SetFile("sansation_large_bold.fnt");
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		
		if (ImGui_GetStateInt("BootStarted", 0)==0)
		{
			ImGui_SetStateInt("BootStarted", 1);

			ImGui_SetStateFloat("MainPower", 0);
			ImGui_FadeStateFloat("MainPower", 1, 3);
			
			ImGui_SetStateFloat("Turbines", 0);
			ImGui_AddTimer("TurbinesStart", 1);
			
			ImGui_SetStateFloat("Coolant", 0);
			ImGui_AddTimer("CoolantStart", 2);
			
			ImGui_SetStateInt("CommSystems", 0);
			ImGui_AddTimer("CommStart", 4.5);
		}
		
		if (ImGui_TimerOver("TurbinesStart"))
		{
			ImGui_FadeStateFloat("Turbines", 1, 3);
		}
		
		if (ImGui_TimerOver("CoolantStart"))
		{
			ImGui_FadeStateFloat("Coolant", 1, 3);
		}
		
		if (ImGui_TimerOver("CommStart"))
		{
			mbControlRoomCommOn = true;
			ImGui_SetStateInt("CommSystems", 1);
			Terminal_SetUpdateWhenOutOfView(asEntityName, false);
		}
		
		///////////////////////////////////
		// Coolant window
		{
			float fCooling = ImGui_GetStateFloat("Coolant", 0);
					
			gauge.mOrientation = eImGuiGaugeOrientation_Vert;
			gauge.mGfxFill.mColor = cColor(0.2, 0.2, 1,2);
			
			StationGui_DoWindowStart("Coolant", window, ImGui_NrmPos(cVector3f(.5f, 0.35f, 1.0f)), ImGui_NrmSize(cVector2f(0.38f, 0.35f)), true);
			{
				/////////////////////////////////////////////
				// 2 vertical gauge bars
				cVector2f vBarSize = ImGui_NrmSizeGroup(cVector2f(0.4f, 0.85f));
				ImGui_LayoutBegin(eImGuiLayout_X, cVector3f(0,0,1.0f), cVector2f_MinusOne, cVector2f(vBarSize.x*0.35f,0));
						
				float fHeight = cMath_Min(fCooling/0.6, 1.f);				
				ImGui_DoGauge(gauge, fHeight, cVector3f_Zero, vBarSize);
				fHeight = cMath_Clamp((fCooling/0.6)-0.4, 0, 1.0f);
				ImGui_DoGauge(gauge, fHeight, cVector3f_Zero, vBarSize);
				
				ImGui_LayoutEnd();
			}
			StationGui_DoWindowEnd();
		}
		
		///////////////////////////////////
		// Main power window
		{
			float fMainPower = ImGui_GetStateFloat("MainPower", 0);
					
			gauge.mOrientation = eImGuiGaugeOrientation_Hori;
			gauge.mGfxFill.mColor = cColor(0.6f + 0.1*(1-fMainPower), 0.2 + 0.4*fMainPower ,0.1f+0.1f*fMainPower,1);
			
			StationGui_DoWindowStart("MainPower", window, ImGui_NrmPos(cVector3f(0.05f, 0.06f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.4f)), true);
			{
				cVector2f vBarSize = ImGui_NrmSizeGroup(cVector2f(0.95f, 0.2f));
				
				ImGui_LayoutBegin(eImGuiLayout_Y, cVector3f(0,0,1.0f), cVector2f_MinusOne, cVector2f(0,vBarSize.y*0.55f));
				
				////////////////////////////////////////
				// 3 horizontal gauge bars
				float fFillSize = cMath_Min(fMainPower/0.6f, 1.0f);
				ImGui_DoGauge(gauge, fFillSize, cVector3f_Zero, vBarSize);
				fFillSize = cMath_Clamp((fMainPower/0.6f)-0.2f, 0, 1.0f);
				ImGui_DoGauge(gauge, fFillSize, cVector3f_Zero, vBarSize);
				fFillSize = cMath_Clamp((fMainPower/0.6f)-0.4f, 0, 1.0f);
				ImGui_DoGauge(gauge, fFillSize, cVector3f_Zero, vBarSize);
			
				ImGui_LayoutEnd();
			}		 
			StationGui_DoWindowEnd();
		}
		///////////////////////////////////
		// Turbines window
		{
			float fTurbineRPM = ImGui_GetStateFloat("Turbines", 0);
			
			window.SetPadding(0.0f, 10.0f, 10.0f, 0.0f);
					
			StationGui_DoWindowStart("Turbines", window, ImGui_NrmPos(cVector3f(0.5f, 0.06f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.2f)), true);
			{	
				//////////////////////////////////////////
				// RPM label
				cVector3f vLabelPos = ImGui_NrmPosGroup(cVector3f(0.7f, 0.14f, 0.1f));
				
				ImGui_SetModColorMul(cColor(0.6f + 0.1*(1-fTurbineRPM), 0.2 + 0.4*fTurbineRPM ,0.1f+0.1f*fTurbineRPM,1));
				ImGui_SetAlignment(eImGuiAlign_TopRight);
				ImGui_SetTransCategory("");
				ImGui_DoLabel("" + cMath_RoundToInt(fTurbineRPM*3600), vLabelPos, cVector2f_MinusOne, 1.5f);
				ImGui_SetTransCategory("01_02_upsilon_inside");
				ImGui_SetAlignment(eImGuiAlign_TopLeft);
				ImGui_DoLabel("RPM", vLabelPos, cVector2f_MinusOne, 0.75f);
				
				ImGui_ResetModifiers();
			}
			StationGui_DoWindowEnd();
		}
		
		//////////////////////////////////
		// Communications window
		{								
			StationGui_DoWindowStart("CommSystems", window, ImGui_NrmPos(cVector3f(0.05f, 0.475f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.2f)), true);
			{		
				bool bOnline = ImGui_GetStateInt("CommSystems", 0) == 1;
				ImGui_SetModColorMul(bOnline ? cColor_Green : cColor_Red);
				ImGui_SetAlignment(eImGuiAlign_CenterCenter);
				ImGui_DoLabelExt(bOnline ? "Online" : "Offline", boldLabel, ImGui_NrmPosGroup(cVector3f(0.5f, 0.4f, 1.0f)), cVector2f_MinusOne, 1.125f);
				ImGui_SetAlignment(eImGuiAlign_TopLeft);
				ImGui_SetModColorMul(cColor_White);
			}		 
			StationGui_DoWindowEnd();
		}
		
		//////////////////////////////////
		// Doors
		{								
			StationGui_DoWindowStart("Doors", window, ImGui_NrmPos(cVector3f(0.05f, 0.70f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.2f)), true);
			{		
				bool bUnlocked = ImGui_GetStateInt("Doors", 0) == 1;
				ImGui_SetModColorMul(bUnlocked ? cColor_Green : cColor_Red);
				ImGui_SetAlignment(eImGuiAlign_CenterCenter);
				ImGui_DoLabelExt(bUnlocked ? "Unlocked" : "Locked", boldLabel, ImGui_NrmPosGroup(cVector3f(0.5f, 0.4f, 1.0f)), cVector2f_MinusOne, 1.125f);
				ImGui_SetAlignment(eImGuiAlign_TopLeft);
				ImGui_SetModColorMul(cColor_White);
			}		 
			StationGui_DoWindowEnd();
		}
	}
	
