{	
	eCommRoomContact_None = 0,
	
	// Cities
	eCommRoomContact_Paris,
	eCommRoomContact_NewYork,
	eCommRoomContact_Toronto,
	eCommRoomContact_Shanghai,
	eCommRoomContact_Hamburg,
	eCommRoomContact_London,
	
	// Stations
	eCommRoomContact_Upsilon,
	eCommRoomContact_Theta,
	eCommRoomContact_Lambda,
	eCommRoomContact_Delta,
	eCommRoomContact_Omicron,
	eCommRoomContact_Tau,
	eCommRoomContact_Phi,
	eCommRoomContact_Omega,
	
