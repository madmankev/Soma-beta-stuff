		//-------------------------------------------------------
		
		void OnGui_LogIn_Main(int alUserState, int alCodeState, int alLoggedInState)
		{
			///////////////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
			label.mFontAlign = eFontAlign_Left;
			
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
			text.mbUseBackgroundGfx = true;
			
			ImGui_DoWindowStart("ControlTerminalApp_LogIn", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.25, 0.35, 1)), ImGui_NrmSize(cVector2f(0.5, 0.3)));
				//ImGui_DoLabelExt("ControlTerminalLogin_User", label, ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 1)), -1);
				
				//////////////////
				// Code
				ImGui_DoLabelExt("ControlTerminalLogin_Code", label, ImGui_NrmPosGroup(cVector3f(0.1, 0.15, 1)), -1);
				tString sCode = StationGui_GetNumpadInput();
				ImGui_SetTransCategory("");
				ImGui_DoTextFrameExt("#" + sCode, 5, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0.1, 0.315, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.18)));
				ImGui_SetTransCategory("01_02_upsilon_inside");
				if (ImGui_DoButton("IDSelect", "GUIChange", ImGui_NrmPosGroup(cVector3f(0.65, 0.275, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.295))))
				{
					StationGui_SetNumpadInput("");
					Depth_Audio_Terminal_Error(ImGui_GetName());
					//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_forward", ImGui_GetName(), 0.0f, false, 1.0f);
					StationGui_SetActiveApp(alCodeState);
				}
				
				//////////////////
				// OK button
				ImGui_SetTransCategory("GUI");
				if (ImGui_DoButton("OKButton", "OK", ImGui_NrmPosGroup(cVector3f(0.3, 0.65, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.175*1.8))))
				{
					if (sCode == gsCarlIDNo)
					{
						ImGui_SetStateInt("LoginUser", eHubRoomTerminalUsers_Carl);
						StationGui_SetActiveApp(alLoggedInState);
						//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_confirm", ImGui_GetName(), 0.0f, false, 1.0f);
						Depth_Audio_Terminal_Confirm(ImGui_GetName());
					}
					else if (sCode == gsAmyIDNo)
					{
						ImGui_SetStateInt("LoginUser", eHubRoomTerminalUsers_Amy);
						StationGui_SetActiveApp(alLoggedInState);
						Depth_Audio_Terminal_Confirm(ImGui_GetName());
						//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_confirm", ImGui_GetName(), 0.0f, false, 1.0f);					
					}
					else
					{	
						StationGui_SetError("ControlTerminalError_WrongCode");
					}
				}
			ImGui_DoWindowEnd();
		}
		
		//-------------------------------------------------------
		
		void OnGui_LogIn_User(int alMainState)
		{
			ImGui_DoWindowStart("ControlTerminalApp_LogIn", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.25, 0.1, 1)), ImGui_NrmSize(cVector2f(0.5, 0.8)));
				for (int i = 1; i <= 8; i++)
				{
					if (ImGui_DoButton("Staff_"+i, "ControlTerminalLogin_Staff_"+i, ImGui_NrmPosGroup(cVector3f(0.05, 0.05+0.1125*(i-1), 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.1))))
					{
						ImGui_SetStateInt("LoginUser", i);
						StationGui_SetActiveApp(alMainState);
					}
				}
			ImGui_DoWindowEnd();
		}
		
