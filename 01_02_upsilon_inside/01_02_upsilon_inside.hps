	//-------------------------------------------------------
	
	cSequenceStatesData mUnlockCommRoomDoorSequence;
		
	void Seq_UnlockCommRoomDoor(const tString &in asTimer)
	{
		Sequence_Begin("Seq_UnlockCommRoomDoor", mUnlockCommRoomDoorSequence);
			
		if (Sequence_DoStepAndWait(1))
		{
			Entity_SetEffectsActive("CommRoomLever", true, true);
			Lever_SetInteractionDisablesStuck("CommRoomLever", true);
			Light_FadeTo("CommRoomDoorAmbient_Open", cColor(0.651,0.925,1,0), -1, 0.2f);
			Light_FadeTo("CommRoomDoorAmbient_Closed", cColor(0,0,0,0), -1, 0.2f);
			Entity_SetActive("CommRoomDoorLamp_Closed_*", false);
			Entity_SetActive("CommRoomDoorLamp_Open_*", true);
			Sound_CreateAtEntity("CommRoomDoorOpen", "01_02_upsilon_inside_02/sfx/living_quarters_unlock/comm_room_unlock", "CommRoomDoor", 0, false);
		}
		else if (Sequence_DoStepAndWait(2))
		{
			
		}
		else
		{

		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mLockCommRoomDoorSequence;
		
	void Seq_LockCommRoomDoor(const tString &in asTimer)
	{
		Sequence_Begin("Seq_LockCommRoomDoor", mLockCommRoomDoorSequence);
			
		if (Sequence_DoStepAndWait(1))
		{
			Lever_SetStuckState("CommRoomLever", -1, true);
			Lever_SetInteractionDisablesStuck("CommRoomLever",false);
			Entity_SetEffectsActive("CommRoomLever", false, true);
			Light_FadeTo("CommRoomDoorAmbient_Open", cColor(0,0,0,0), -1, 0.2f);
			Light_FadeTo("CommRoomDoorAmbient_Closed", cColor(1,0,0,0), -1, 0.2f);
			Entity_SetActive("CommRoomDoorLamp_Closed_*", true);
			Entity_SetActive("CommRoomDoorLamp_Open_*", false);
			SlideDoor_SetClosed("CommRoomDoor", true);
			Sound_CreateAtEntity("CommRoomDoorOpen", "01_02_upsilon_inside_02/sfx/living_quarters_unlock/comm_room_lock", "CommRoomDoor", 0, false);
		}
		Sequence_End();
	}
	
