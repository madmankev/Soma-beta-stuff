		/////////////////////////////////////////
		// Generator Room: Rumbles
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void TimerGeneratorSmallRumble(const tString &in asTimer)
		{
			Effect_Shake_Start(0.008f, 2.5f, 0.5f, 1.f);
			Sound_CreateAtEntity_UsePrefix("Tremors", "01_02_upsilon_inside_02/sfx/tremor", "Player", 0.0f, false, 1.0f);
			
			////////////////////////////
			// Particles
			for (int i = 1; i < 8; i++)
				Map_AddTimer("RumblePSArea_" + cMath_RandRectl(1, glNumOfRumbleParticleAreas), 
				cMath_RandRectf(0, 2.f), "TimerCreateDustFallParticles");
				
			HandleRumbleFlicker();
			
			Map_AddTimer("SmallRumbleTimer", cMath_RandRectf(gfMinTimeBetweenRumbles, gfMaxTimeBetweenRumbles), "TimerGeneratorSmallRumble");
		}
		
		//-------------------------------------------------------
		
		void TimerCreateDustFallParticles(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntityExt(asTimer + "_Particles", "dust_falling_fast.ps", asTimer, false, cColor(1, 1), 0.2f);
		}
		
		//-------------------------------------------------------
		
		////////////////////////////////////////////////////////////
		// Makes a few of the ceiling lamps flicker for a while
		void HandleRumbleFlicker()
		{
			for (int i = 1; Entity_Exists("CatwalkLamp_" + i); i++)
			{
				if (cMath_RandRectf(0, 1.f) < 0.4f)
				{
					Lamp_SetFlickerActive("CatwalkLamp_" + i, true);
					Map_AddTimer("CatwalkLamp_" + i, cMath_RandRectf(2.f, 5.f), "TimerDeactivateLampFlicker");
				}
			}
			
			for (int i = 1; Entity_Exists("ElevatedPlatformLamp_" + i); i++)
			{
				if (cMath_RandRectf(0, 1.f) < 0.4f)
				{
					Lamp_SetFlickerActive("ElevatedPlatformLamp_" + i, true);
					Map_AddTimer("ElevatedPlatformLamp_" + i, cMath_RandRectf(2.f, 5.f), "TimerDeactivateLampFlicker");
				}
			}
		}

		//-------------------------------------------------------
		
		//} END Generator Room: Rumbles
		
		/////////////////////////////////////////
		// Generator Room: Transformers Basics
		//{//////////////////////////////////////
		eTransformerState mTransformerState = eTransformerState_Off;
		
		//-------------------------------------------------------
		
		void SetupTransformerArea()
		{
			Lamp_SetLit("TransformerLamp_*", false, false);
			Light_SetFlickerActive("TransformerElectricity_*", false);
			Light_SetVisible("TransformerElectricity_*", false);
			Light_SetVisible("BrokenTransformerElectricity", false);
			
			Entity_SetEffectsActive("Transformer_*", false, false);
			Entity_SetEffectsActive("BrokenTransformer", false, false);
			
			ParticleSystem_SetVisible("TransformerSparkPS*", false);
			
			Prop_SetStaticPhysics("BrokenTransformer", true);
			
			Prop_SetStaticPhysics("cable_collapse", true);
			Entity_SetEffectsActive("cable_collapse", false, false);
				
			mTransformerState = eTransformerState_Off;
			
			/////////////////////////////////
			// Transformer bot
			Voice_SetSource("TransformerBot", "TransformerBot", 4, 20, true);
		}
		
		//-------------------------------------------------------
		
		////////////////////////////////////////////////////////////////
		// Start up transformers	
		void StartUpTransformers()
		{
			Lamp_SetLit("TransformerLamp_*", true, true);
			Entity_SetEffectsActive("Transformer_*", true, true);
			Light_SetVisible("TransformerElectricity_*", true);
			Light_SetFlickerActive("TransformerElectricity_*", true);	
		
			//////////////////////////////////////////
			// Transformer effects pulse
			Map_AddTimer("Transformer_1", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			Map_AddTimer("Transformer_2", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			Map_AddTimer("Transformer_3", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			Map_AddTimer("Transformer_4", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			Map_AddTimer("Transformer_5", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			Map_AddTimer("Transformer_6", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			Map_AddTimer("Transformer_7", cMath_RandRectf(0.1, 0.5f), "TimerTransformerEffectsOff");
			
			Map_AddTimer("TimerOnTransformersStatusStarted",0.5f,"TimerOnTransformersStatusStarted");
		}
		
		//-------------------------------------------------------
		
		void TimerOnTransformersStatusStarted(const tString &in asTimer)
		{
			//cLux_AddTodoMessage("SOUND: OK chime for transformer startup.");
			mTransformerState = eTransformerState_On;
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////////////////////////////
		// Toggles the transformes on and off, creating a pulse effect
		void TimerTransformerEffectsOn(const tString &in asTimer)
		{
			Entity_FadeEffectBaseColor(asTimer, cColor(0.6, 0.6, 0.6, 0.8), 1.f);
			Map_AddTimer(asTimer, 1.f, "TimerTransformerEffectsOff");
		}
			
		//-------------------------------------------------------
		
		void TimerTransformerEffectsOff(const tString &in asTimer)
		{
			Entity_FadeEffectBaseColor(asTimer, cColor(0.2, 0.2, 0.2, 0.8), 2.f);
			Map_AddTimer(asTimer, 2.f, "TimerTransformerEffectsOn");
		}
		
		//-------------------------------------------------------
		
		//} END Generator Room: Transformers Basics
	
		/////////////////////////////////////////
		// Generator Room: Transformers Collapse
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void Drained_TransformerFlower(const tString &in asEntity)
		{
			SequenceTransformerCollapse("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mTransformerCollapseSequence;
		bool mbUpperAmbientMusicPlaying = false;
		void SequenceTransformerCollapse(const tString &in asName)
		{
			Sequence_Begin("SequenceTransformerCollapse", mTransformerCollapseSequence);
				
				if (Sequence_DoStepAndWait(1.f))
				{
					Music_Stop(2.0f, eMusicPrio_BgAmb);
					//Yank sound
					Sound_CreateAtEntity("TransformerBuildup", "01_02_upsilon_inside_02/special/transformer_sequence/buildup", "TransformerBuildUpSoundSource");
					Light_SetFlickerActive("TransformerElectricity_*", false);
					//Pause quake timer
					Audio_PauseQuakes(true);
				}
				else if(Sequence_DoStepAndWait(.45f))
				{
					Sound_CreateAtEntity("TransformerAlarm", "01_02_upsilon_inside_02/special/transformer_sequence/terminal_alarm", "TransformerBuildUpSoundSource");
					Effect_Shake_Start(0.03f, 3.0f, 0.4f, 0.4f);
					Map_AddTimer("RumblePSArea_14",	cMath_RandRectf(0, 1.f), "TimerCreateDustFallParticles");
					Map_AddTimer("RumblePSArea_16",	cMath_RandRectf(0, 1.f), "TimerCreateDustFallParticles");
				}
				
				////////////////////////////////////////
				//Unstable mode.
				else if(Sequence_DoStepAndWait(0.75))
				{
					//Turn off transformer hums
					Sound_Stop("transform_hum_working_*", 0.25f);
					Sound_Stop("transformer_area_loop", 0.25f);
					
					
					Map_AddTimer("DuckStrong", 0.1f, "Audio_ConversationDucking");
					
					ParticleSystem_SetVisible("TransformerSparkPS_*", false);
					Light_SetVisible("TransformerElectricity_*", false);
					Light_SetVisible("BrokenTransformerElectricity", false);
					
					Lamp_SetupFlicker("TransformerLamp_*", 0.7f, 2.1f, 0.4f, 1.2f);
					Lamp_SetFlickerActive("TransformerLamp_*", true);
					RepeatTimerTransformerSpark("");
					ParticleSystem_CreateAtEntityExt("TransformerOverloadPS_1", "elec_spark_large_continuous.ps", "TransformerOverloadPSArea_1", true, cColor(0.392,0.784,1,1),  50.0f);
					ParticleSystem_CreateAtEntityExt("TransformerOverloadPS_2", "elec_spark_large_continuous.ps", "TransformerOverloadPSArea_2", true, cColor(0.392,0.784,1,1),  50.0f);
					ParticleSystem_CreateAtEntityExt("TransformerOverloadPS_3", "elec_spark_large_continuous.ps", "TransformerOverloadPSArea_3", true, cColor(0.392,0.784,1,1),  50.0f);
					ParticleSystem_CreateAtEntityExt("TransformerOverloadPS_4", "elec_spark_large_continuous.ps", "TransformerOverloadPSArea_4", true, cColor(0.392,0.784,1,1),  50.0f);
				
					////////////////////////////////
					//Event audio for collapse
					Sound_CreateAtEntity("TransformerCollapse", "01_02_upsilon_inside_02/special/transformer_sequence/collapse", "TransformerCollapseSoundSource", 0.0f, false);
					Sound_CreateAtEntity("TransformerCollapsePowerDown", "01_02_upsilon_inside_02/special/transformer_sequence/power_down", "Player", 0.0f, false);
					Sound_CreateAtEntity("TransformerSizzleLoop", "01_02_upsilon_inside_02/sfx/warehouse/spark", "BrokenTransformer", 5.0f, true);
					Sound_Stop("transformer_hum", 0.5f);
					
					mTransformerState = eTransformerState_Broken;
				}
					
				////////////////////////////////////////
				//Broken transformer overload
				else if(Sequence_DoStepAndWait(0.75f))
				{
					Effect_Shake_Start(0.003f, 2.0f, 0.4f, 0.6f);
				}
					
				////////////////////////////////////////
				//Explosion
				else if(Sequence_DoStepAndWait(5.00f))
				{				
					Entity_SetEffectsActive("BrokenTransformer", false, false);
					Entity_SetEffectsActive("cable_collapse", true, true);
					Prop_SetStaticPhysics("BrokenTransformer", false);
					Prop_SetStaticPhysics("cable_collapse", false);
					
					ParticleSystem_SetVisible("TransformerOverloadPS_1", false);
					ParticleSystem_SetVisible("TransformerOverloadPS_2", false);
					ParticleSystem_SetVisible("TransformerOverloadPS_3", false);
					ParticleSystem_SetVisible("TransformerOverloadPS_4", false);
					
					ParticleSystem_CreateAtEntityExt("TransformerSmokePS", "smoke_broken_transformer_loop.ps", "TransformerSmokePSArea", true, cColor(1,1,1,0.682f),  1.0f);
					RepeatTimerBrokenTransformerSpark("");
					
					InfectedRobot_ForceHuntState("TransformerBot");
					
					//GeneratorRoomBlackout();
				}
				else
				{
					// Robot begins chasing player
					Agent_SetSensesActive("TransformerBot", false);
					Prop_SetStaticPhysics("TransformerBotTentacle_1", false);
					//Map_AddTimer("TransformerCollapsePostMusicTimer", 3.0f, "TransformerCollapsePostMusic");
					Entity_SetActive("TriggerPushRobot_1",false);
					
					InfectedRobot_ForceIdleState("TransformerBot");
					
					// Affects ability to see terminal upstairs
					Terminal_SetGuiActive("PowerTerminal", false);
					
					//Resume quake timer
					Audio_PauseQuakes(false);
					Map_AddTimer("Return6s", 0.1f, "Audio_ConversationDucking");
				}
				
				
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		float mfBlackoutDelay = 0;
		void GeneratorRoomBlackout()
		{
			mfBlackoutDelay = 0;
			
			StartLampFlickerTimer("ElevatedPlatformLamp", 0, 1);
			StartLampFlickerTimer("CatwalkLamp", 0, 1);
			StartLampFlickerTimer("TransformerLamp", 0, 1);
			StartLampFlickerTimer("TurbineLamp", 0, 1);
			StartLampFlickerTimer("GeneratorLamp", 0, 1);
			
			for (int i = 1; Entity_Exists("transformer_sphere_lamp_"+i);i++)
				Map_AddTimer("transformer_sphere_lamp_"+i, cMath_RandRectf(2, 3), "TimerTurnOffLamp");
			
			for (int i = 1; Entity_Exists("ReactorTerminalLamp_"+i);i++)
				Map_AddTimer("ReactorTerminalLamp_"+i, cMath_RandRectf(2, 3), "TimerTurnOffLamp");
				
			Map_AddTimer("ControlRoomDoorLamp", 3.25, "TimerTurnOffLamp");
			Button_SetLocked("ControlRoomDoor_Control_1", true);
			Button_SetSwitchedOn("ControlRoomDoor_Control_1", false, true);
			Prop_SetActiveAndFade("ControlRoomDoor_Display", false, 0.5);
				
			Lamp_SetFlickerActive("StaircaseLamp_1", true);
			
			Lamp_SetLit("ThermalHoleTerminal_2", false, true);
			Lamp_SetLit("ThermalHoleTerminal_1", false, true);
			Billboard_SetVisible("Billboard_30", false);
			Terminal_SetGuiActive("ThermalHoleTerminal", false, 1);
		}

		//-------------------------------------------------------
		
		void StartLampFlickerTimer(const tString &in asLampPrefix, float afMinExtraDelay, float afMaxExtraDelay)
		{
			for (int i = 1; Entity_Exists(asLampPrefix+"_"+i);i++)
				Map_AddTimer(asLampPrefix+"_"+i, mfBlackoutDelay+cMath_RandRectf(afMinExtraDelay, afMaxExtraDelay), "TimerFlickerLampOff");
			
			mfBlackoutDelay+=afMaxExtraDelay;
		}

		//-------------------------------------------------------
		
		void TimerFlickerLampOff(const tString &in asTimer)
		{
			Lamp_SetupFlicker(asTimer, 0.05, 0.2, 0.025, 0.2, false);
			Lamp_SetFlickerActive(asTimer, true);
			Map_AddTimer(asTimer, cMath_RandRectf(0.25, 0.75), "TimerTurnOffLamp");
		}

		//-------------------------------------------------------
		
		void RepeatTimerBrokenTransformerSpark(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntityExt("TransformerSmokePSArea_elec_spark", "elec_spark_oneshot.ps", "TransformerSmokePSArea", true, cColor(0.392,0.784,1,1),  50.0f);
			Map_AddTimer("RepeatTimerBrokenSpark", cMath_RandRectf(0.5f, 1.5f), "RepeatTimerBrokenTransformerSpark");
		}
		
		//-------------------------------------------------------
		
		//Spawn blue sparks at random areas inside the transformer area.
		void RepeatTimerTransformerSpark(const tString &in asTimer)
		{
			for(int i = 0; i < 6; i++)
			{
				tString sArea = "TransformerSparkArea_"+cMath_RandRectl(1,24);
				ParticleSystem_CreateAtEntityExt(sArea+"elec_spark", "elec_spark_oneshot.ps", sArea, true, cColor(0.392,0.784,1,1),  50.0f);
				Sound_CreateAtEntity("SparkTrigger", "02_05_theta/amb/spots/small_spark", sArea);
			}
			
			Map_AddTimer("RepeatTimerSpark", cMath_RandRectf(1.5f, 3.0f), "RepeatTimerTransformerSpark");
		}
		
		//-------------------------------------------------------
		
		//Spawn smoke when the broken transformer parts hits the ground.
		bool CollideCollapseTransformer(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("TransformerPartsImpact", "level_01_02/events/generator_room_activated/transformer_parts_fall", asParent, 0.1f, false);
			ParticleSystem_CreateAtEntityExt(asParent+"smoke", "smoke_cloud_oneshot.ps", asParent, true, cColor(1,1,1,0.682f),  3.0f);
			
			//Deactivate areas that did not collide with the transformer parts.
			Entity_SetActive("BrokenTransformerCollisionArea_*", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Generator Room: Transformers Collapse
	
		/////////////////////////////////////////
		// Generator Room: stairs & steam
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetupStairsArea()
		{
		}
		
		//-------------------------------------------------------

		void StateChangeStairsLever(const tString &in asEntity, int alState)
		{
			Sound_CreateAIEventAtEntity("StairsDoor", 15, 1);
			
			SlideDoor_SetClosed("StairsDoor",(alState == -1));
			Lever_SetStuckState("StairsLever", alState, true);
			Lever_SetStuckState("StairsLever_2", alState, true);
			Entity_SetActive("StairsLeverLampOn_*", (alState == 1));
		}
		
		//-------------------------------------------------------
		
		bool Trigger_StairSteamDamage(const tString &in asParent, const tString &in asChild, int alState)
		{		
			if (alState == 1)
				TimerStairSteamDamage("StairSteamDamage");
			else
				Map_RemoveTimer("StairSteamDamage");
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void TimerStairSteamDamage(const tString &in asTimer)
		{
			ShowSteamDamageEffects("StairSteamDamageArea");
				
			Map_AddTimer(asTimer, 1.25, "TimerStairSteamDamage");
		}
		
		//-------------------------------------------------------
		
		///////////////////////////////////////////////
		// Handles initial push away from the steam
		bool CollisionStairsRoomSteamArea(const tString &in asParent, const tString &in asChild, int alState)
		{		
			
			if (alState == -1)
			{
				Map_RemoveTimer(asChild); // The player is outside, no more pushing needed
				return true;
			}

			Player_SetMoveSpeedMul(0);
			Player_FadeMoveSpeedMulTo(1, 3.f);
			TimerPushPlayerFromStairsRoomSteam(asChild);
			return true;
		}
		
		//-------------------------------------------------------
		
		// Keeps moving the player away from the steam as long as they remain inside the area.
		void TimerPushPlayerFromStairsRoomSteam(const tString &in asTimer)
		{
			if (Map_TimeHasPassed("TimerDamageDelay", 1.0f)) // Avoid frequent repitition
			{
				ShowSteamDamageEffects(asTimer);
			}
			Player_AddBodyForceAwayFromEntity(asTimer, 10000);
			
			Map_AddTimer(asTimer, 0.1f, "TimerPushPlayerFromStairsRoomSteam");
		}
		
		//-------------------------------------------------------
			
		/////////////////////////////
		//Trigger to kill stairwell steam to stop sound from leaking across map
		bool mbStairwellSteamBurst = false;
		
		bool OnKillStairwellSteam(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbStairwellSteamBurst==true)
			{
				Entity_SetActive("StairsRoomSteamArea", false);
				Sound_Stop("BrokenPipeSteamLoop", 0.0f);
				Sound_Stop("BrokenPipeSteamLoop2", 0.0f);
				ParticleSystem_Destroy("StairsRoomPipe_2_Steam");
				ParticleSystem_Destroy("StairsRoomPipe_1_Steam");
				cLux_AddDebugMessage("Steam active, killing");
				mbStairwellSteamBurst = false;
			}
			if (mbStairwellSteamBurst==false)
			{
				cLux_AddDebugMessage("Steam not currently active, nothing to kill");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END: Generator Room: stairs & steam
	
		/////////////////////////////////////////
		// Generator Room: steam valve
		//{//////////////////////////////////////
			
		void OnChangeStairsRoomSteamValve(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{			
				Entity_SetActive("valve_handle", false);
				Entity_SetActive("valve_handle_grab", true);
				Sound_CreateAtEntity("ValveBreak", "01_02_upsilon_inside_02/sfx/valve_burst/valve_break", "valve_handle", 0.0f, false);
				
				if (Entity_IsInteractedWith(asEntity))
				{
					Player_ChangeStateToNormal();
					Entity_CallEntityInteract("valve_handle_grab");
				}
				
				SequenceStairsRoomPipesBurst("");
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mStairsRoomPipesBurstSequence;
			
		bool mbPipeBroken = false;
		void SequenceStairsRoomPipesBurst(const tString &in asTimer)
		{
			Sequence_Begin("SequenceStairsRoomPipesBurst", mStairsRoomPipesBurstSequence);
			
			///////////////////////////////
			if (Sequence_DoStepAndWait(2.18f))
			// Delay with buildup effects
			{
				mbPipeBroken = true;
				Music_FadeVolumeMul(0.0f, 1.0f);
				ParticleSystem_CreateAtEntity("StairsRoomPipe_1_Steam_1", "steam_fast_small_loop.ps", "StairsRoomPipe_1_PSArea_1", false);
				Sound_CreateAtEntity("SteamRiser", "01_02_upsilon_inside_02/sfx/valve_burst/valve_pop_riser", "StairsRoomPipe_1_PSArea", 0.0f, false);
				
				Map_AddTimer("SimonGasp", 0.25f, "SteamEvent_SimonGasp");
				Sound_Stop("StairSteamSound_*", 0.5);
				ParticleSystem_Destroy("StairSteam_*");
				Entity_SetActive("StairSteamDamageArea", false);
			}
			
			if(Sequence_DoStepAndWait(0.07f))
			{
				//InfectedRobot_ForceHuntState("TransformerBot");
				
				Sound_CreateAIEventAtEntity("StairsRoomPipe_1_PSArea", 50, 10);
				
				////////////////////
				//Begin Pop Sound
				Sound_CreateAtEntity("ValveBurst", "01_02_upsilon_inside_02/sfx/valve_burst/valve_pop_sequence", "StairsRoomPipe_1_PSArea", 0.0f, false, 1.0f);
				Sound_Stop("SteamRiser", 0.08f);
			}
			
			//////////////////////////
			// Break first pipe
			if (Sequence_DoStepAndWait(0.5f))
			{
				mbStairwellSteamBurst = true;
				cLux_AddDebugMessage("Break first pipe");
				Effect_Shake_Start(0.1f, 0.2f, 0.2f, 0.2f);
				Entity_SetActive("StairsRoomPipe_1", false);
				Entity_SetActive("StairsRoomPipe_1_Broken", true);
				ParticleSystem_Destroy("StairsRoomPipe_1_Steam_1");
				ParticleSystem_Destroy("StairsRoomPipe_1_Steam");
				ParticleSystem_CreateAtEntity("StairsRoomPipe_1_Steam", "steam_fast_loop_refraction.ps", "StairsRoomPipe_1_PSArea", false);
				Entity_SetActive("StairsRoomSteamArea", true); // Enable pushback from steam
			}
			
			//////////////////////////
			// Break second pipe
			if (Sequence_DoStepAndWait(4.0f))
			{
				Effect_Shake_Start(0.12f, 0.2f, 0.2f, 0.2f);
				Entity_SetActive("StairsRoomPipe_2", false);
				Entity_SetActive("StairsRoomPipe_2_Broken", true);
				ParticleSystem_CreateAtEntity("StairsRoomPipe_2_Steam", "steam_fast_loop.ps", "StairsRoomPipe_2_PSArea", false);
				Sound_Stop("SteamSoundLoopInitial", 0.0f);
				Sound_CreateAtEntity("BoilerExplode", "01_02_upsilon_inside_02/sfx/valve_burst/steam_boiler_explode", "StairsRoomPipe_1_PSArea_2", 0.0f, false);
				
				/////////////////
				//Steam Loop Sound
				Sound_CreateAtEntity("BrokenPipeSteamLoop", "01_02_upsilon_inside_02/sfx/valve_burst/valve_steam_loop_longer_falloff", "StairsRoomPipe_1_PSArea", 1.0f, true);
				Map_AddTimer("SoftenSteamSoundTimer", 2.0f, "SoftenSteamSound");
				Music_FadeVolumeMul(1.0f, 1.0f);
				Depth_Audio_Fear_MediumIntensity(5.0f, 6.0f, 1, true, true);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Effect_Shake_Start(0.12f, 0.2f, 0.2f, 0.2f);
				ParticleSystem_CreateAtEntity("StairsRoomPipe_Stage2_1", "steam_fast_loop.ps", "StairsRoomPipe_1_PSArea_2", false);
				ParticleSystem_CreateAtEntity("StairsRoomPipe_Stage2_2", "steam_fast_loop.ps", "StairsRoomPipe_1_PSArea_3", false);
				
				// Make dangerous area bigger
				Entity_SetActive("StairsRoomSteamAreaBig", true);
				
				// Flicker lights
				Lamp_SetFlickerActive("ElevatedPlatformLamp_3", true);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				// Turn off lights
				Lamp_SetLit("ElevatedPlatformLamp_3", false, true);
			}
			
			Sequence_End();
		}
		
		//----------------------------------------------

		//////////////////////////////////
		//Soften steam sound volume after 4 seconds
		void SoftenSteamSound(const tString &in asTimer)
		{
			Sound_Fade("BrokenPipeSteamLoop", 0.7f, 6.0f);
			Sound_Fade("BrokenPipeSteamLoop2", 0.7f, 6.0f);
		}
		
		bool Trigger_StopLowerSteamSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Child : " +asChild + " Parent : " + asParent);
			if (mbPipeBroken==true && asChild=="Trigger_SteamBelowStop")
			{
				cLux_AddDebugMessage("Stop Power Hall Steam SFX");
				Sound_Fade("BrokenPipeSteamLoop",0.0f,1.0f);
			}
			if (mbPipeBroken==true && asChild=="Trigger_SteamBelowStart")
			{
				cLux_AddDebugMessage("Start Power Hall Steam SFX");
				Sound_Fade("BrokenPipeSteamLoop",0.7f,3.0f);
			}
			return true;
		}
		
		void SteamEvent_SimonGasp(const tString &in asTimer)
		{
			Depth_Audio_SimonGasp();
		}
		
		//} END Generator Room: Steam Valve
	
	//-------------------------------------------------------
	
	//} END GENERATOR ROOM
	
	
	/////////////////////////////////////////
	// TERMINALS: GENERATOR ROOM
	//{///////////////////////////////////////
	
		/////////////////////////////////////////
		// Thermal Hole Terminal
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnGuiThermalHoleTerminal(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("");
			///////////////////////////////////
			// Background
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			StationGuiBG_OrnamentBottomLeft();
			StationGuiBG_OrnamentTopRight();
			StationGuiBG_OrnamentBottomRight("station/chinsymbol/small_default_tools", cVector2f(30), eImGuiSizeType_CorrectAspectWidth, cColor(0.07f, 0.41f, 0.72f, 1));
					
			cImGuiGfx imageGfx;
			
			if(ImGui_GetStateInt("ButtonPressedIndex") == 0)
			{
				cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
				windowData.SetPadding(2.0f, 10.0f, 2.0f, 30.0f);
				
				cImGuiTextFrameData textFrameData;
				textFrameData.mFontAlign = eFontAlign_Left;
				textFrameData.mbUseBackgroundGfx = false;
				textFrameData.mFont.SetFile("sansation_medium.fnt");
				textFrameData.mFont.mvSize =cVector2f(14, 16);
				
				cImGuiLabelData labelData;
				labelData.mFont.SetFile("sansation_medium.fnt");
				labelData.mFont.mvSize =cVector2f(14, 16);
				
				cImGuiGaugeData gaugeData = StationGui_CreateDefaultGaugeData();
				gaugeData.mGfxFill.mColor = gStationGuiColor_Highlight;
				gaugeData.mOrientation = eImGuiGaugeOrientation_Vert;
				
				ImGui_SetTransCategory("01_02_upsilon_inside");
				
				////////////////////////////////
				// Production window
				StationGui_DoWindowStart("ThermalTerminalCaption1", windowData, ImGui_NrmPos(cVector3f(0.025f, 0.45f, 1)), ImGui_NrmSize(cVector2f(0.4f, 0.28f)), true);
				{
					ImGui_DoTextFrameExt("ThermalTerminalText1", cVector2f(3,3), 3.0f, 0, textFrameData, cVector3f(0,5,4), ImGui_GetCurrentGroupSize());
				}
				StationGui_DoWindowEnd();
				
				////////////////////////////////
				// Transformers window
				StationGui_DoWindowStart("ThermalTerminalCaption4", windowData, ImGui_NrmPos(cVector3f(0.025f, 0.76f, 1)), ImGui_NrmSize(cVector2f(0.4f, 0.155f)), true);
				{
					ImGui_DoLabelExt("ThermalTerminalTransformerStatus",labelData,cVector3f(0,5,1));
					
					tString sStatus;
					switch (mTransformerState)
					{
						case eTransformerState_Off:
						{
							sStatus = "TransformersOff";
							ImGui_SetModTextColorMul(gStationGuiColor_Warning);
							break;
						}
						case eTransformerState_On:
						{
							sStatus = "TransformersOn";
							ImGui_SetModTextColorMul(gStationGuiColor_Highlight);
							break;
						}
						case eTransformerState_Broken:
						{
							sStatus = "TransformersBroken";
							ImGui_SetModTextColorMul(gStationGuiColor_Warning2);
							break;
						}
					}
					ImGui_DoLabelExt(sStatus,labelData,cVector3f(30,29,1));
					
					ImGui_ResetModifiers();
				}
				StationGui_DoWindowEnd();
				
				////////////////////////////////
				// Reactor sys window
				StationGui_DoWindowStart("ThermalTerminalCaption2", windowData, ImGui_NrmPos(cVector3f(0.03f, 0.02f, 1)), ImGui_NrmSize(cVector2f(0.65f, 0.4f)), true);
				{
					ImGui_DoTextFrameExt("ThermalTerminalText2", cVector2f(3,3), 3.0f, 0, textFrameData, cVector3f(0, 15, 1), ImGui_GetCurrentGroupSize()-cVector2f(25, 25));
					
					///////////////////////////////
					// Draw oscillating bars
					cVector2f vBarSize = ImGui_NrmSize(cVector2f(0.04f, 0.25f));
					ImGui_LayoutBegin(eImGuiLayout_X, cVector3f(280,10,2), cVector2f_MinusOne, cVector2f(vBarSize.x*0.5f,0));
					
					ImGui_DoGauge(gaugeData, Depth_ImGui_GetOscillatingSignalValue("ThermalHole", 0), cVector3f_Zero, vBarSize);
					ImGui_DoGauge(gaugeData, Depth_ImGui_GetOscillatingSignalValue("ThermalHole", 1), cVector3f_Zero, vBarSize);
					ImGui_DoGauge(gaugeData, Depth_ImGui_GetOscillatingSignalValue("ThermalHole", 2), cVector3f_Zero, vBarSize);
																 
					ImGui_LayoutEnd();
				}
				StationGui_DoWindowEnd();
				
				////////////////////////////////
				// Structure window
				StationGui_DoWindowStart("ThermalTerminalCaption3", windowData, ImGui_NrmPos(cVector3f(0.45f, 0.45f, 1)), ImGui_NrmSize(cVector2f(0.525f, 0.46f)), true);
				{
					ImGui_DoTextFrameExt("ThermalTerminalText3", cVector2f(3,3), 3.0f, 0, textFrameData, cVector3f(0, 25, 1), ImGui_GetCurrentGroupSize()-cVector2f(25, 25));
					
					////////////////////////////////////
					// Draw pulsating structure icons
					ImGui_LayoutBegin(eImGuiLayout_X, cVector3f(235, 105, 1), cVector2f_MinusOne, cVector2f(15,0));
					
					imageGfx.mColor = ImGui_FadeOscillateColor("ButtonFade",cColor(0.9, .7), cColor(0.9, .55), 0.5f);
					imageGfx.SetFile("station/powerplant/stat_structurebars_default");
					ImGui_DoImage(imageGfx, cVector3f_Zero, ImGui_NrmSize(cVector2f(0.03f, 0.2f)));
					
					imageGfx.SetFile("station/powerplant/stat_structurebars_broken");
					ImGui_DoImage(imageGfx, cVector3f_Zero, ImGui_NrmSize(cVector2f(0.03f, 0.2f)));
					ImGui_DoImage(imageGfx, cVector3f_Zero, ImGui_NrmSize(cVector2f(0.03f, 0.2f)));
					
					ImGui_LayoutEnd();
					
					////////////////////////////////////
					// Draw chinese symbols
					ImGui_LayoutBegin(eImGuiLayout_X, cVector3f(236, 125, 1.5f), cVector2f_MinusOne, cVector2f(19,0));

					imageGfx.mColor = ImGui_FadeOscillateColor("BlueFade",cColor_White, cColor(0.9, 1), 0.5f);
					imageGfx.SetFile("station/chinsymbol/small_default_tools");
					ImGui_DoImage(imageGfx, cVector3f_Zero, ImGui_NrmSize(cVector2f(0.025f, 0.075f)));
					
					imageGfx.SetFile("station/chinsymbol/small_default_error");
					imageGfx.mColor = ImGui_FadeOscillateColor("YellowFade", gStationGuiColor_Highlight2, gStationGuiColor_Warning2, 0.5f);
					ImGui_DoImage(imageGfx, cVector3f_Zero, ImGui_NrmSize(cVector2f(0.025f, 0.075f)));
					ImGui_DoImage(imageGfx, cVector3f_Zero, ImGui_NrmSize(cVector2f(0.025f, 0.075f)));
					
					ImGui_LayoutEnd();	
					
				}
				StationGui_DoWindowEnd();
			}
		}
		
		//} END TERMINAL: GENERATOR ROOM, THERMAL HOLE

		/////////////////////////////////////////
		// Thermal Hole Terminal
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
			
		void OnGuiTransformers(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("01_02_upsilon_inside");
			
			if (Entity_GetVarBool("TransformerBotTentacle", "Attached"))
			{
				OnGuiLeechGibberish(asEntityName, afTimeStep);
				return;
			}
			
			///////////////////
			// Background
			cColor ornamentCol = ImGui_FadeOscillateColor("BlueCornerFade",cColor(1, 0.35f), cColor(1, 0.45f), 1.0f);
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			StationGuiBG_OrnamentBottomRight();
			StationGuiBG_Taskbar();

			///////////////////
			// Status String
			cImGuiTextFrameData textFrameData;
			textFrameData.mbUseBackgroundGfx = false;
			textFrameData.mFont.SetFile("sansation_large_bold.fnt");
			textFrameData.mFontAlign = eFontAlign_Center;
			textFrameData.mFont.mvSize = cVector2f(80.0f,80.0f);
			
			ImGui_SetModColorMul(gStationGuiColor_Warning2);

			ImGui_DoTextFrameExt("TransformersBroken",
				cVector2f_Zero, 4.0f, 0.0f, textFrameData,
				ImGui_NrmPos(cVector3f(0.1f, 0.2f, 0.1f)), ImGui_NrmSize(cVector2f(0.8f, 0.5f)) );
						
			ImGui_ResetModifiers();
		}
		
		//-------------------------------------------------------
		
		//} END TERMINAL: GENERATOR ROOM, TRANSFORMERS
		
	//} END TERMINALS: GENERATOR ROOM
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// HUB ROOM
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
		bool mbCommRoomPoweredOn = false;
		
		//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Hub room: setup
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetupHubRoom()
		{		
			Light_SetVisible("HubRoomTerminal_Spot", false);
			Light_SetVisible("HubRoomTerminal_Point", false);
			Lamp_SetLit("EmergencyHubRoomLamp_*", true, true);
			Lamp_SetLit("HubRoomLamp_*", true, true);
			Lamp_SetLit("HubRoomMonitor_*", true, true);
			
			Entity_SetEffectBaseColor("DeskLamp*",cColor(0,0,0));
			
			SetHubFloorLighting(false);
		}
		
		//-------------------------------------------------------
		
		//} END Hub room: setup
		
		/////////////////////////////////////////
		// Hub room: lower floor sounds 
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
	
		bool Collide_TriggerStopLowerSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
				return true;
				
			cLux_AddDebugMessage("stop lower sounds");
			Entity_SetActive("CarlConstruct", true);
			Sound_Fade("TransformerSizzleLoop", 0.0f, 1.0f);
			if (mTransformerState==eTransformerState_Broken)
			{
				Light_SetVisible("TransformerElectricity_*",false);
			}
			if (mbPipeBroken)
			{
				Sound_Stop("PipeGeneratorSteamLoop1",1.0f);
				Sound_Stop("PipeGeneratorSteamLoop2",1.0f);
			}
			
			return true;
		}

		//-------------------------------------------------------

		bool Collide_TriggerStartLowerSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
				return true;
				
			cLux_AddDebugMessage("start lower sounds");
			Sound_Fade("TransformerSizzleLoop", 1.0f, 1.0f);
			Entity_SetActive("CarlConstruct", false);
			if (mTransformerState==eTransformerState_Broken)
			{
				Light_SetVisible("TransformerElectricity_*",true);
			}
			if (mbPipeBroken)
			{
				Sound_Stop("PipeStairsSteamLoop1",0.0f);
				Sound_CreateAtEntity("PipeStairsSteamLoop1", "Entities_Station/special/01_02_pipe_medium/break_steam", "StairsRoomPipe_1_PSArea", 1.0f, false);
				Sound_Stop("PipeStairsSteamLoop2",0.0f);
				Sound_CreateAtEntity("PipeStairsSteamLoop2", "Entities_Station/special/01_02_pipe_medium/break_steam", "StairsRoomPipe_2_PSArea", 1.0f, false);
			}
			
				
			return true;
		}
		
		//} END Hub room: lower floor sounds 


		/////////////////////////////////////////
		// Hub room: power up 
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		bool Trigger_TopOfStairs(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_EnterHubRoom("");
		
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqEnterHubRoom;
		void Seq_EnterHubRoom(const tString& in asName)
		{
			Sequence_Begin("Seq_EnterHubRoom", mSeqEnterHubRoom);
			if (Sequence_DoStepAndWait(3.0f))
			{
				
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// Start up lights
				SetHubFloorLighting(true,true);
				Sound_CreateAtEntity("LightsOn", "01_02_upsilon_inside_02/sfx/hubroom_lightson", "HubRoomLightsOnSoundSource");
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// Start up Carl
				Voice_SetSource("CarlConstruct", "CarlConstructSource", 1.5, 25, true, 25, 8000, 200, eLuxVoiceSourceFreqencyFlag_LowPass);
				Voice_Play("4A_CarlIntroductionShout", -1, "VoiceCarlShout");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				// Shut off bot downstairs
				InfectedRobot_ForceIdleState("TransformerBot");
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void VoiceCarlShout(const tString&in asScene, const tString&in asSubject)
		{
			Voice_SetSource("CarlConstruct", "CarlConstructSource", 1.5, 25, true, 25, 8000, 300, eLuxVoiceSourceFreqencyFlag_LowPass);
		}

		//-------------------------------------------------------
		
		//} END Hub room: power up 
	
	
	//-------------------------------------------------------
	
	//} END HUB ROOM
	
	
	/////////////////////////////////////////
	// TERMINALS: HUBROOM
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Power Terminal
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		void OnGuiPowerTerminal(const tString&in asEntityName, float afTimeStep)
		{
			///////////////////////
			// Data
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
			ImGui_SetDefaultButton(button);
				
			ImGui_SetTransCategory("01_02_upsilon_inside");	
			
			StationGuiBG_BackdropV2("background/background_logo_pathOS", cVector2f(0.01, 0.45));
			StationGuiBG_Scanlines();
			
			if (StationGui_DrawAndCheckErrors()) return;
			
			bool bBackButtonEnabled = true;
			int lBackApp = ePowerTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(ePowerTerminalState_LogIn_Main);
			switch (lActiveApp)
			{	
				case ePowerTerminalState_LogIn_Main:
				OnGui_LogIn_Main(ePowerTerminalState_LogIn_User, ePowerTerminalState_LogIn_Code, ePowerTerminalState_MainMenu);
				bBackButtonEnabled = false;
				break;
				
				case ePowerTerminalState_LogIn_User:
				OnGui_LogIn_User(ePowerTerminalState_LogIn_Main);
				lBackApp = ePowerTerminalState_LogIn_Main;
				break;
				
				case ePowerTerminalState_LogIn_Code:
				if (StationGui_Numpad("ControlTerminalApp_LogIn", 4))
				{
					StationGui_SetActiveApp(ePowerTerminalState_LogIn_Main);
				}
				lBackApp = ePowerTerminalState_LogIn_Main;
				break;
				
				case ePowerTerminalState_Status:
				StationGui_TextReaderSingle("PowerTerminalApp_Status", "PowerTerminalStatus");
				break;
				
				case ePowerTerminalState_EventLog:
				StationGui_TextReaderSingle("PowerTerminalApp_EventLog", "PowerTerminalEventLog");
				break;
				
				case ePowerTerminalState_PowerOutput:
				ImGui_DoWindowStart("PowerTerminalApp_PowerOutput", StationGui_CreateDefaultWindowData(), 
									ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.8)));
					ImGui_SetModColorMul(cColor_White*0.75);
					ImGui_DoImage(cImGuiGfx("poweroutput_bg"), ImGui_NrmPosGroup(cVector3f(0, 0, 1)), ImGui_NrmSizeGroup(1));
					ImGui_SetModColorMul(ImGui_FadeOscillateColor("Linecol", cColor_Green, cColor_Green*0.75, 2));
					ImGui_DoImage(cImGuiGfx("poweroutput_line"), ImGui_NrmPosGroup(cVector3f(0, 0, 2)), ImGui_NrmSizeGroup(1));
					ImGui_SetModColorMul(cColor_White);
				ImGui_DoWindowEnd();
				break;
				
				case ePowerTerminalState_LogOut:
				OnGui_LogOut();
				StationGui_SetActiveApp(ePowerTerminalState_LogIn_Main);
				break;
				
				case ePowerTerminalState_MainMenu:
				StationGui_AddApp("PowerTerminalApp_Status");
				StationGui_AddApp("PowerTerminalApp_EventLog");
				StationGui_AddApp("PowerTerminalApp_PowerOutput");
				StationGui_AddApp("ControlTerminalApp_LogOut");
				StationGui_MainMenu();
				bBackButtonEnabled = false;
				break;
			}
			
			StationGuiBG_TaskbarV2("thirdparty/train/transport_symbol_upsilon");
			StationGui_BackButton(bBackButtonEnabled, lBackApp);
		}
		
		//-------------------------------------------------------
		
		//} END Power Terminal

		/////////////////////////////////////////
		// Main Terminal
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		void OnHubRoomTerminalGUI(const tString&in asEntityName, float afTimeStep)
		{	
			///////////////////////
			// Setup		
			if (ImGui_IsFirstRun())
			{
				ImGui_SetStateBool("Power_1", false); //Machine Testing
				ImGui_SetStateBool("Power_2", false); //Storage
				ImGui_SetStateBool("Power_3", false); //Airlocks
				ImGui_SetStateBool("Power_4", false); //Comm Room
				ImGui_SetStateBool("Power_5", false); //Maintenance 1
				ImGui_SetStateBool("Power_6", false); //Maintenance 2
				
				StationGui_SetActiveApp(eHubRoomTerminalState_LogIn_Main);
			}
			
			///////////////////////
			// Data
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
			ImGui_SetDefaultButton(button);
			
			StationGuiBG_BackdropV2("background/background_logo_pathOS", cVector2f(0.01, 0.45));
			StationGuiBG_Scanlines();
				
			ImGui_SetTransCategory("01_02_upsilon_inside");	
			
			if (ImGui_GetStateBool("DisplayLowPowerError", false))
			{
				HubRoomTerminal_LowPowerError();
				return;
			}
			if (StationGui_DrawAndCheckErrorsV2()) return;
			
			int lMail = -1;
			bool bBackButtonEnabled = true;
			int lActiveApp = StationGui_GetActiveApp();
			switch (lActiveApp)
			{	
				case eHubRoomTerminalState_LogIn_Main:
				OnGui_LogIn_Main(eHubRoomTerminalState_LogIn_User, eHubRoomTerminalState_LogIn_Code, eHubRoomTerminalState_MainMenu);
				bBackButtonEnabled = false;
				break;
				
				case eHubRoomTerminalState_LogIn_User:
				OnGui_LogIn_User(eHubRoomTerminalState_LogIn_Main);
				bBackButtonEnabled = false;
				break;
				
				case eHubRoomTerminalState_LogIn_Code:
				if (StationGui_Numpad("ControlTerminalApp_LogIn", 4))
				{
					StationGui_SetActiveApp(eHubRoomTerminalState_LogIn_Main);
				}
				bBackButtonEnabled = false;
				break;
				
				case eHubRoomTerminalState_Mail:
				if (ImGui_GetStateInt("LoginUser")==eHubRoomTerminalUsers_Amy)
				{
					Depth_ImGui_AddMail("ControlTerminalMail_Subject_Amy_1", "ControlTerminalMail_Body_Amy_1", "", "ControlTerminalMail_Date_Amy_1", eMailAppEntryType_Sent);
					Depth_ImGui_AddMail("ControlTerminalMail_Subject_Amy_2", "ControlTerminalMail_Body_Amy_2", "", "ControlTerminalMail_Date_Amy_2", eMailAppEntryType_Inbox);
				}
				else
				{
					Depth_ImGui_AddMail("ControlTerminalMail_Subject_Carl_1", "ControlTerminalMail_Body_Carl_1", "", "ControlTerminalMail_Date_Carl_1", eMailAppEntryType_Draft);
				}
				StationGui_MailApp("SentMail_HubRoomTerminal");
				break;
				
				case eHubRoomTerminalState_Mail_Send:
				StationGui_DialogBox_Start("ControlTerminalMail_Sending", "");
					if (Depth_ImGui_LoadingGauge("MailSending", 3, false, ImGui_NrmPosGroup(cVector3f(0.1, 0.5, 1)), 
												 ImGui_NrmSizeGroup(cVector2f(0.8, 0.3)), StationGui_CreateDefaultGaugeData()))
					{
						//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_confirm", ImGui_GetName(), 0.0f, false, 1.0f);
						Depth_Audio_Terminal_Confirm(ImGui_GetName());
						StationGui_SetActiveApp(eHubRoomTerminalState_Mail);
					}
				StationGui_DialogBox_End();
				break;
				
				case eHubRoomTerminalState_Power:
				HubRoomTerminal_PowerManager();
				break;
		
				case eHubRoomTerminalState_Staff:
				StationGui_TextReaderSingle("ControlTerminalStaff_Header", "ControlTerminalStaff_Text");
				break;
				
				case eHubRoomTerminalState_LogOut:
				OnGui_LogOut();
				StationGui_SetActiveApp(eHubRoomTerminalState_LogIn_Main);
				break;
				
				case eHubRoomTerminalState_MainMenu:
				StationGui_AddApp("ControlTerminalApp_Mail");
				StationGui_AddApp("ControlTerminalApp_Power");
				StationGui_AddApp("ControlTerminalApp_Staff");
				StationGui_AddApp("ControlTerminalApp_LogOut");
				StationGui_MainMenu();
				bBackButtonEnabled = false;
				break;
			}
			
			StationGuiBG_TaskbarV2("thirdparty/train/transport_symbol_upsilon");
			StationGui_BackButton(bBackButtonEnabled);
		}

		//-------------------------------------------------------
		
		bool SentMail_HubRoomTerminal(const tString &in asTitle)
		{
			if (!mbCommRoomPoweredOn)
			{
				StationGui_SetError("ControlTerminalError_CommRoomPower");
			}
			else
			{
				//StationGui_SetActiveApp(eHubRoomTerminalState_Mail_Send);
			}
			
			return mbCommRoomPoweredOn;
		}

		//-------------------------------------------------------
		
		void HubRoomTerminal_PowerManager()
		{
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			///////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFontAlign = eFontAlign_Right;
			
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
			button.mColorBase = gStationGuiColor_Warning;
			button.mColorTriggered = gStationGuiColor_Normal; 
		
			ImGui_DoWindowStart("ControlTerminalApp_Power", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
				for (int i = 0; i < 6; i++)
				{

					bool bOn = ImGui_GetStateBool("Power_"+i, false);
					cVector3f vStart = cVector3f((i/3)*0.45, 0.1+(i%3)*0.3, 1);
					
					ImGui_SetModColorMul(bOn ? cColor_Green : cColor_Red);
					ImGui_DoLabelExt("ControlTerminalRoom_"+(i+1), label, 
									 ImGui_NrmPosGroup(vStart), ImGui_NrmSizeGroup(cVector2f(0.3, -1)), 1.5);
					ImGui_SetModColorMul(cColor_White);
					
					cVector3f vButtonPos = ImGui_NrmPosGroup(vStart+cVector3f(0.325, -0.05, 0));
					cVector2f vButtonSize = ImGui_NrmSizeGroup(cVector2f(0.15, 0.15));
					if (i == eHubRoomTerminalRoom_Storage || (i == eHubRoomTerminalRoom_CommRoom && !mbAssemblyActive))
					{
						ImGui_SetModUseInput(i == eHubRoomTerminalRoom_Storage || SequenceStates_IsActive("Seq_UnlockCommRoomDoor")==false);
						bOn = ImGui_DoToggleButtonExt("PwrButton_"+(i+1), "ControlTerminalPower_"+(bOn ? "On" : "Off"), bOn, button, vButtonPos, vButtonSize);
						if (ImGui_PrevBecamePressed())
						{
							tString sSound = bOn ? "terminal_forward" : "terminal_negative";
							//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/"+sSound, ImGui_GetName(), 0.0f, false, 1.0f);
							Depth_Audio_Terminal_Error(ImGui_GetName());
						}
						ImGui_SetModUseInput(true);
					}
					else
					{
						tString sText = "ControlTerminalPower_NA";
						if (i == eHubRoomTerminalRoom_CommRoom) sText = "ControlTerminalPower_Off";
						
						ImGui_DoButtonExt("PwrButton_"+(i+1), sText, button, vButtonPos, vButtonSize);
					}
											   
					if (ImGui_PrevBecamePressed())
					{
						if (i == eHubRoomTerminalRoom_Storage)
						{
							mbStoragePowerOn = bOn;
							bool bStorageLightsOn = MovingButton_IsSwitchedOn("StorageLightSwitch");
							Entity_SetEffectsActive("StorageLightSwitch", bOn && !mbReactorControlFlowPulled, true);
							Lamp_SetLit("StorageRoomLamp_*", bOn && !mbReactorControlFlowPulled && bStorageLightsOn,true);
							Button_SetLocked("StorageDoor_Control_1", mbReactorControlFlowPulled || !bOn, true);
							Sound_Play("storage_hum_*", 1.0f);
							if (bOn == false)
							{
								Sound_Stop("storage_hum_*", 1.0f);
							}
							if (mbReactorControlFlowPulled==false && bOn==false)
							{
								//lock
								Sound_CreateAtEntity("Storage_Lock", "01_02_upsilon_inside_02/sfx/living_quarters_unlock/storage_room_door_lock", "Storage_SoundSource");
								Sound_Stop("Storage_Unlock", 1.0f);
							}
							if (mbReactorControlFlowPulled==false && bOn==true)
							{
								//unlock
								Sound_CreateAtEntity("Storage_Unlock", "01_02_upsilon_inside_02/sfx/living_quarters_unlock/storage_room_door_unlock", "Storage_SoundSource");
								Sound_Stop("Storage_Lock", 1.0f);
							}
						}
						else if (i != eHubRoomTerminalRoom_CommRoom)
						{
							StationGui_SetError("ControlTerminalError_NoConnection");
							//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_negative", ImGui_GetName(), 0.0f, false, 1.0f);
							Depth_Audio_Terminal_Error(ImGui_GetName());
						}
						else if (mbAssemblyActive)
						{
							ImGui_SetStateBool("DisplayLowPowerError", true);
							//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_negative", ImGui_GetName(), 0.0f, false, 1.0f);
							Depth_Audio_Terminal_Error(ImGui_GetName());
						}
						else
						{
							if (mbCarlBeingTortured)
								Lever_SetStuckState("electric_switch_1", bOn ? 1 : 0, false);
								
							mbCommRoomPoweredOn = bOn;
							if (bOn)
								Seq_UnlockCommRoomDoor("");
							else
								Seq_LockCommRoomDoor("");
						}
					}
										 
					ImGui_SetStateBool("Power_"+i, bOn);
				}
			ImGui_DoWindowEnd();
		}

		//-------------------------------------------------------
		
		void HubRoomTerminal_LowPowerError()
		{
			if (mbAssemblyActive==false)
			{
				cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
				dialogBox.mType = eGuiDialogBoxType_OK;
				eGuiDialogCode code = Depth_ImGui_DialogBox("ControlTerminalDialog_Info", "ControlTerminalDialog_PowerRerouted", dialogBox);
				
				if (code == eGuiDialogCode_OK)
				{
					ImGui_SetStateBool("DisplayLowPowerError", false);
				}
				
				return;
			}
			
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mbUseBackgroundGfx = false;
			text.mFontAlign = eFontAlign_Center;
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
			
			ImGui_DoWindowStart("ControlTerminalApp_Power", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
					ImGui_DoTextFrameExt("ControlTerminalError_LowPower", ImGui_NrmSizeGroup(0), 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_SetModColorMul(ImGui_FadeOscillateColor("MapRedFlash", cColor_White, cColor(0.3, 1), 0.25, eEasing_Linear));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map_reactor_flow"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1.1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map_assembly"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1.1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_SetModColorMul(ImGui_FadeOscillateColor("MapGreenFlash", cColor_Green, cColor(0, 0.3, 0, 1), 0.5, eEasing_Linear));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map_you_are_here"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1.1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_SetModColorMul(cColor_White);
			ImGui_DoWindowEnd();
			
			if (StationGui_BackButton(true, eHubRoomTerminalState_Power))
			{
				ImGui_SetStateBool("DisplayLowPowerError", false);
			}
		}
		
