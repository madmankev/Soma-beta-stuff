	//-------------------------------------------------------

	void OnGuiLeechGibberish(const tString &in asEntity, float afTimeStep)
	{
		// Static overlay
		if (ImGui_RepeatTimer("StaticIndex", 0.1))
		{
			ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
			ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
		}
		ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(0.4, 0.8));
		ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
		ImGui_DoImage(cImGuiGfx("static_"+ImGui_GetStateInt("StaticImageIndex", 0)+""), 0, ImGui_NrmSizeGroup(1));
		
		if (ImGui_RepeatTimer("ImageIndex", 0.14))
		{
			ImGui_SetStateInt("GibberishImageIndex", cMath_RandRectl(0, 2));
		}
		ImGui_SetModColorMul(cColor(0.4, 1));
		ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
		
		float fDistortionAmount = ImGui_GetStateFloat("DistortionAmount",0.0f);
		fDistortionAmount=cMath_Clamp(fDistortionAmount-0.5f*afTimeStep, 0.0f, 1.0f);
		ImGui_SetStateFloat("DistortionAmount",fDistortionAmount);
		
		Depth_ImGui_DrawLineDistortedGfx(	cImGuiGfx("leechgibberish_"+ImGui_GetStateInt("GibberishImageIndex", 0)), 
											cVector3f_Back, 
											 ImGui_NrmSizeGroup(1),
											cColor_White,
											fDistortionAmount, 1.0f);
		ImGui_ResetModifiers();
	}
	
