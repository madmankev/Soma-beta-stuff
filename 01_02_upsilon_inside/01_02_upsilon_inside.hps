	void Audio_ConversationDucking(const tString &in asTimer) 
	{
		if (asTimer=="DuckSubtle")
		{
			Sound_FadeGlobalVolume(0.9, 2.0f);
			cLux_AddDebugMessage("Ducking Audio for VO - Light");
		}
		
		else if (asTimer=="DuckLight")
		{
			Sound_FadeGlobalVolume(0.75, 2.0f);
			cLux_AddDebugMessage("Ducking Audio for VO - Light");
		}
		
		else if (asTimer=="DuckMedium")
		{
			Sound_FadeGlobalVolume(0.55, 2.0f);
			cLux_AddDebugMessage("Ducking Audio for VO - Medium");
		}
		
		else if (asTimer=="DuckStrong")
		{
			Sound_FadeGlobalVolume(0.35, 2.0f);
			cLux_AddDebugMessage("Ducking Audio for VO - Strong");
		}
		
		else if (asTimer=="Return3s")
		{
			Sound_FadeGlobalVolume(1.0f, 3.0f);
			cLux_AddDebugMessage("Returning Audio to Normal - 3 seconds");
		}
		
		else if (asTimer=="Return6s")
		{
			Sound_FadeGlobalVolume(1.0f, 6.0f);
			cLux_AddDebugMessage("Returning Audio to Normal - 6 seconds");
		}
		
		else if (asTimer=="Return9s")
		{
			Sound_FadeGlobalVolume(1.0, 9.0f);
			cLux_AddDebugMessage("Returning Audio to Normal - 9 seconds");
		}
	}
	
