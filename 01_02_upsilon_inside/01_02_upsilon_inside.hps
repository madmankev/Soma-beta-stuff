	//-------------------------------------------------------
	
	
	void SetupCommRoom()
	{
		Sound_Stop("water_leak_*", 0);
		
		Entity_SetEffectsActive("CommRoomLever", false, false);
		
		SwingDoor_SetDisableAutoClose("LoosePanel_2", true);
		SwingDoor_SetClosed("LoosePanel_2", false, false);
		
		Entity_SetInteractionDisabled("CommRoomLamp_ScreenLeft", true);
		Entity_SetInteractionDisabled("CommRoomLamp_ScreenRight", true);
		
		ParticleSystem_SetActive("CommRoomBubbles_*", false);
		ParticleSystem_SetActive("CommRoomWaterDust_*", false);
		ParticleSystem_SetActive("PourSplashPS_*", false);
		ParticleSystem_SetActive("PourUnderwaterPS_*", false);
		
		Light_SetVisible("WaterReflection_*", false);
		
		//Light_SetVisible("SpotLight_42", false);
		
		Entity_SetActive("CommDoorBlocker",false);
		
		Entity_SetActive("TopLever",true);
		Entity_SetActive("BrokenHandle",false);
		Entity_SetActive("BrokenTopLever",false);
		
		ParticleSystem_SetActive("WauLeak_1", false);
		ParticleSystem_SetActive("WauLeak_2", false);
		ParticleSystem_SetActive("WauLeak_impact_*", false);
		ParticleSystem_SetActive("spark_wauflower_commroom_*", false);
	}
	
	//-------------------------------------------------------
	
	void OnCommRoomWauFlowerDrained(const tString &in asEntity)
	{
		SequenceCommRoomWauFlower("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqCommRoomWauFlower;
	void SequenceCommRoomWauFlower(const tString& in asName)
	{
		Sequence_Begin("SequenceCommRoomWauFlower", mSeqCommRoomWauFlower);
		
		if (Sequence_DoStepAndWait(1.5f))
		{
			cLux_AddTodoMessage("SOUND: Wau flower sparks.");
			ParticleSystem_CreateAtEntity("CommWauFlower_PS1", "elec_spark_oneshot.ps", "CommRoomWauFlower", true );
			Sound_CreateAtEntity("Tremors", "01_02_upsilon_inside_02/sfx/medium_room/tremor", "Player", 0.0f, false, 1.0f);
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			Effect_Shake_Start(0.04f, 0.7f, 0.2f, 0.7f);
		}
		else if (Sequence_DoStepAndWait(0.2f))
		{
			Lamp_SetFlickerActive("CommRoomLamp_2", true);
			Prop_SetActiveAndFade("CommRoomPour_1", true, 0.4f);
		}
		else if (Sequence_DoStepAndWait(0.7f))
		{
			ParticleSystem_SetActive("CommRoomFloorFroth_1", true);
			ParticleSystem_SetActive("spark_wauflower_commroom_*", true);
			Sound_CreateAtEntity("explode", "01_02_upsilon_inside_02/sfx/controlroom/catherineconversation/screenexplode", "CommRoomWauFlower", 0.0f, false, 1.0f);
			Effect_Shake_Start(0.06f, 0.3f, 0.1f, 0.3f);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
		    Sound_CreateAtEntity("Break", "01_02_upsilon_inside_02/sfx/valve_burst/valve_break", "wauleak_3_soundsource", 0.0f, false, 1.0f);
			ParticleSystem_SetActive("WauLeak_1", true);
			ParticleSystem_SetActive("WauLeak_3", true);
		}
		else if (Sequence_DoStepAndWait(0.7f))
		{
			Lamp_SetLit("CommRoomLamp_2", false, false);
			Lamp_SetLit("CommRoomLamp_AbovePanel_1", false, false);
			ParticleSystem_SetActive("WauLeak_2", true);
			Effect_Shake_Start(0.04f, 0.25f, 0.1f, 0.3f);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
		ParticleSystem_SetActive("WauLeak_impact_*", true);
		Entity_SetActive("WauLeak_effect_1", true);
		Sound_CreateAtEntity("leak1", "01_02_upsilon_inside_02/sfx/water/water_splat", "wauleak_1_soundsource", 0.0f, false, 1.0f);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	

	bool OnCommRoomDoorway(const tString &in asArea, const tString &in asEntity, int alState)
	{
		if (alState==1)
		{
			cLux_AddDebugMessage("Going into comm room.");
			
			/////////////////////////////////////////////////////
			// Stop enemy from following player up the stairs
			if (Entity_GetCollide("VentRobot", "CommRoomStairsProximity"))
			{
				Pathfinder_Stop("VentRobot");
				Agent_SetSensesActive("VentRobot", false);
				Entity_SetActive("ShutterRedLampOff",false);
				Entity_SetActive("ShutterRedLampOn",true);
				SlideDoor_SetClosed("CommRoomDoor", true);
				Entity_SetActive("CommDoorBlocker",true);
				
				SwitchToStuckLever();
				
				Map_AddTimer("VentRobot", 9, "TimerDeactivateEntity");
			}
			
			// Stop VentRobot seeing us through the floor
			Agent_SetSensesActive("VentRobot", false);
		}
		else
		{
			cLux_AddDebugMessage("Going out of comm room.");
			
			// Start VentRobot seeing again
			Agent_SetSensesActive("VentRobot", true);
		}

		return false;
	}
	
	//-------------------------------------------------------
	
	void OnGuiCommRoomLogTerminal(const tString&in asEntityName, float afTimeStep)
	{				
		ImGui_SetTransCategory("01_02_upsilon_inside");
		
		StationGuiBG_BackdropV2();
		StationGuiBG_Scanlines();

		int lRestoredFiles = 0;
		if (StationGui_DataRestoration(4, 4.2, lRestoredFiles) == false)
		{
			ImGui_SetModColorMul(cColor(1, 0.5));
			ImGui_SetModUseInput(false);
		}
		for (int i = 1; i <= 4; i++)
			if (lRestoredFiles >= i) Depth_ImGui_AddAudioFile_Voice("CommLogTerminal_File_"+i, "CommRoomRecording_"+i);
		StationGui_AudioPlaybackApp();
	}
	
	//-------------------------------------------------------
	
	bool mbLeversInit = false;
	
	void StateChangeCommRoomLever(const tString &in asEntity, int alState)
	{
		if (!mbLeversInit)
			return;
			
		Light_SetVisible("SpotLight_42", true);
		
		bool bClose = SlideDoor_GetOpenAmount("CommRoomDoor")>0.5f;
		SlideDoor_SetClosed("CommRoomDoor", bClose);
		Lever_SetStuckState(asEntity,alState,true);
		
		Sound_CreateAIEventAtEntity("CommRoomDoor", 10, 2);
	}
	
	//-------------------------------------------------------
	bool mbCommRoomMusicTriggered = false;
	
	void StateChangeTopLever(const tString &in asEntity, int alState)
	{
		if (!mbLeversInit)
			return;
		bool bClose = SlideDoor_GetOpenAmount("CommRoomDoor")>0.5f;
		SlideDoor_SetClosed("CommRoomDoor", bClose);
		Lever_SetStuckState(asEntity,alState,true);
		
		if (mbCommRoomMusicTriggered == false)
		{
			mbCommRoomMusicTriggered = true;
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Map_AddTimer("CommRoomEnterMusic", 3.0f, "PlayEnterCommRoomMusic");
		}
		
		Map_AddTimer("RemoveUpstairTransformerRobot", 3, "Timer_RemoveUpstairTransformerRobot");
	}
	
	void Timer_RemoveUpstairTransformerRobot(const tString&in asTimer)
	{
		Entity_SetActive("VentRobot", false);
	}
	
