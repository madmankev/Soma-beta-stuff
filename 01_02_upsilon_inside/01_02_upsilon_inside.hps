	//Entering upstairs areas
	
	bool Trigger_StopLowerAmbience(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbPipeBroken==true)
		{
			Music_Stop(5.0f, eMusicPrio_BgAmb);
			return false;
		}
		return true;
	}

	bool EnterUpperAreaTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbUpperAmbientMusicPlaying==false)
		{
			Music_PlayExt("01_02_exploring",true, 0.5, 1, 1, 0, eMusicPrio_BgAmb, true);
			cLux_AddDebugMessage("Ambient Upper Music not playing - triggering music");
			mbUpperAmbientMusicPlaying = true;
		}
		if (mbUpperAmbientMusicPlaying==true)
		{
			cLux_AddDebugMessage("Ambient Music already playing - not triggering music");
		}
		return false;
	}
	
