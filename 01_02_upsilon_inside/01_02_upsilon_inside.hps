	//-------------------------------------------------------
	
	// Close the door behind the player when they aren't looking.
	void LookAtCommRoomPanel(const tString &in asEntity, int alState)
	{
		SequenceCloseCommRoomShutter("");
		Entity_SetActive("CommRoomPanelLookAt", false);
	}
	
	//-------------------------------------------------------
		
	cSequenceStatesData mCommRoomShutter;	
	void SequenceCloseCommRoomShutter(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCloseCommRoomShutter", mCommRoomShutter);
		
		////////////////////////////
		// Initialize
		if (Sequence_DoStepAndWait(2.0f)) 
		{
			SwitchToStuckLever();
			
			if (SlideDoor_GetOpenAmount("CommRoomDoor")>0.1f)
			{
				Sound_CreateAtEntity("CommRoomDoorAlarm", "01_02_upsilon_inside_02/amb/spot/comm_room_alarm", "ShutterRedLampOn", 0.0f, true, 1.0f);
				Entity_SetActive("ShutterRedLampOff",false);
				Entity_SetActive("ShutterRedLampOn",true);
				
				if(mbCommRoomMusicTriggered == false)
				{
					mbCommRoomMusicTriggered = true;
					Music_Stop(3.0f, eMusicPrio_BgAmb);
					Map_AddTimer("CommRoomEnterMusic", 3.0f, "PlayEnterCommRoomMusic");
				}
			}
		}
		else if (Sequence_DoStepAndWait(9.0f))
		{
			Light_SetCastShadows("SpotLight_42", false);
			SlideDoor_SetClosed("CommRoomDoor", true);
			Entity_SetActive("CommDoorBlocker",true);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			Entity_SetActive("VentRobot",false);
			Voice_FadeSceneVolumeTo("CarlConstruct",0.0f,1.0f);
			
			cLux_AddTodoMessage("SOUND: Stop alarm.");
			Sound_Stop("CommRoomDoorAlarm", 0.0f);
			Entity_SetActive("ShutterRedLampOff",true);
			Entity_SetActive("ShutterRedLampOn",false);
			
			// Shut down a bunch of stuff we don't want reacting with the water area
			Prop_SetStaticPhysics("CarlRagdoll", true);
			Prop_SetStaticPhysics("junk_computer_part_*", true);
			Prop_SetStaticPhysics("junk_chip_basket_*", true);
			Prop_SetStaticPhysics("workshop_tool_*", true);
			Prop_SetStaticPhysics("blowtorch_*", true);
			Prop_SetStaticPhysics("can_*", true);
			Prop_SetStaticPhysics("container_*", true);
			Prop_SetStaticPhysics("fire_*", true);
			Prop_SetStaticPhysics("empty_battery_*", true);
			Prop_SetStaticPhysics("cable_roll_*", true);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			Entity_SetActive("CarlConstruct",false);
			StopCarlSpeakTimer();
		}

		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void SwitchToStuckLever()
	{
		Entity_SetActive("TopLever",false);
		Entity_SetActive("TopLeverStuck",true);
		
		Preload();
	}
	
	//-------------------------------------------------------
	
	void SwitchToBrokenLever()
	{
		Entity_SetActive("TopLever",false);
		Entity_SetActive("TopLeverStuck",false);
		Entity_SetActive("BrokenHandle",true);
		Entity_SetActive("BrokenTopLever",true);
	}
	
	//-------------------------------------------------------
	
	bool CollisionCommRoomDoorOpened(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		// Activating collide callback here avoids having to ignore the first call to the callback
		Entity_AddCollideCallback("CommRoomDoorImpactTrigger", "CommRoomDoor", "CollisionCommRoomDoorClosed");
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollisionCommRoomDoorClosed(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		Sound_CreateAtEntity_UsePrefix("Tremors", "01_02_upsilon_inside_02/sfx/tremor", "Player", 0.0f, false, 1.0f);
		Effect_Shake_Start(0.04f, 0.2f, 0.1f, 0.3f);
		Sound_Play("water_leak_1", 0);
		Sound_Play("water_leak_2", 0);
		
		return false;
	}

