	/////////////////////////////////////////
	// GENERATOR ROOM
	//{///////////////////////////////////////
		
	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Generator Room: Setup
		//{///////////////////////////////////////
	
		//-------------------------------------------------------
	
		void SetupGeneratorRoom()
		{		
			/////////////////////////////////////////
			// Turn off all lights and effects
			Light_FadeTo("ThermalLight_*", cColor(0,0,0,1), -1, 0);
			Light_FadeTo("ThermalLightAmbience_*", cColor(0,0,0,0), -1, 0);
			Lamp_SetLit("CatwalkLamp_*", false, false);
			Lamp_SetLit("transformers_ceiling_lamp_*", false, false);
			Lamp_SetLit("transformer_sphere_lamp_*", false, false);
			Lamp_SetLit("TurbineLamp_*", false, false);
			Lamp_SetLit("GeneratorLamp_*", false, false);
			Lamp_SetLit("ElevatedPlatformLamp_*", false, false);
			Lamp_SetLit("StaircaseLamp_*", false, false);
			Lamp_SetLit("upsilon_sign_lamp_*", false, false);
			Entity_SetEffectsActive("Turbine_*", false, false);	
			ParticleSystem_SetVisible("ThermalParticles_*", false);
			ParticleSystem_SetActive("ThermalHoleSmoke", false);
			ParticleSystem_SetActive("ThermalHoleRefraction", false);
			Entity_PlayAnimation("thermal_extraction_vent", "stop", 0.1f, false, false);
		}
	
		//-------------------------------------------------------
		
		//} END Generator Room: Setup
	
		
		/////////////////////////////////////////
		// Generator Room: Fall down ladder or bridge
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbLadderCollapsed = false;
		
		//-------------------------------------------------------
		
		bool PlayerCollideBridgeCollapse(const tString &in asParent, const tString &in asChild, int alState)
		{
			Prop_SetHealth("01_02_catwalk_collapse_straight_1", 0);
						
			Sound_CreateAtEntity("CatwalkCollapse", "01_02_upsilon_inside_02/sfx/catwalk_collapse/catwalk_collapse", "Player");
			Sound_FadeGlobalVolume(0.25f, 0.15f);
			Map_AddTimer("CatwalkFadeUp", 2.0f, "CatwalkFadeUp");
			
			Map_AddTimer("BridgeCollapsePushDown", 0.1, "Timer_BridgeCollapsePushDown");
			Map_AddTimer("BridgeCollapsePushDown", 3, "Timer_BridgeCollapseStatic");
			
			Effect_Shake_Start(0.3, 0.3, 0.1, 0.6);
			
			return false;
		}
		
		void CatwalkFadeUp(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 3.5f);
		}
		
		int mlBridgeCollapsePushCount=0;
		void Timer_BridgeCollapsePushDown(const tString&in asTimer)
		{
			Entity_AddImpulse("01_02_catwalk_collapse_straight_*", cVector3f(0,-0.1,0), false, false);
			
			if(mlBridgeCollapsePushCount++<10)
				Map_RestartCurrentTimer();
		}
		
		void Timer_BridgeCollapseStatic(const tString&in asTimer)
		{
			Sound_CreateAIEventAtEntity("Player", 20, 2);
			
			Prop_SetStaticPhysics("01_02_catwalk_collapse_straight_*", true);
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerLadderCollapse(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(mbLadderCollapsed) return false;
			
			if(Player_GetCurrentStateName()!="State_Ladder")
			{
				return true;	
			}
			
			cLux_AddDebugMessage("Collide with :"+asChild);
			
			Player_ChangeStateToNormal();
			
			Prop_SetStaticPhysics("01_02_ladder_collapse_1", false);
			Entity_SetActive("block_box_ladder", false);
			Entity_SetInteractionDisabled("LadderArea_1", true);
			//Entity_SetActive("LadderArea_1", false);
			Entity_SetActive("LadderCollapse_PlayerHitFloor", true);
						
			Effect_Shake_Start(0.15, 0.3, 0.1, 0.7);
						
			Seq_FallDownLadder("");
			
			cLux_AddTodoMessage("Sound: Ladder collapses");
			
			mbLadderCollapsed = true;
						
			return false;
		}
		
		cSequenceStatesData mSeqFallDownLadder;
		void Seq_FallDownLadder(const tString &in asX)
		{
			Sequence_Begin("Seq_FallDownLadder", mSeqFallDownLadder);
			
			if (Sequence_DoStepAndWait(0.1)){}
			else if (Sequence_DoStepAndWait(0.3))
			{
				Player_StartLookAt("LadderCollapse_Up",1,1,1);
				Player_FadeLookSpeedMulTo(0.3,0.1);
				
				Entity_AddImpulse("01_02_ladder_collapse_1", cVector3f(-0.5,0,-2), false, false);
				Player_AddBodyForce(cVector3f(0,0,-250*70), false);
			}
			else if (Sequence_DoStepAndPause())
			{
				//Wait for player to hit floor
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
				Player_StartLookAt("LadderCollapse_LookUp",0.5,0.75,1);
				
				Player_SetMoveSpeedMul(0);
				
				Player_SetCrouching(true);
				Player_SetCrouchDisabled(true);
			
				Player_MoveHeadPos(cVector3f(0,-0.95, 1.26), 2,3,0.01f);
				
				Sound_CreateAIEventAtEntity("Player", 20, 2);
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				Player_MoveHeadPos(cVector3f(0,0, 0), 0.5,0.2,0.2f);	
			}
			else if (Sequence_DoStepAndWait(0.8))
			{
				Player_StopLookAt(2);
				Player_FadeLookSpeedMulTo(1,2);
			}
			else if (Sequence_DoStepAndWait(0.8))
			{
				Player_FadeMoveSpeedMulTo(1, 1);
				Player_SetCrouchDisabled(false);
				Player_SetCrouching(false);
			}
			
			
			Sequence_End();
		}
		
		bool OnTrigger_LadderCollapse_PlayerHitFloor(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("HIT FLOOR!");
			
			SequenceStates_Resume("Seq_FallDownLadder");
			
			cLux_AddTodoMessage("Sound: player hits floor after ladder collpase.");
			
			return true;
		}
		
		//-------------------------------------------------------
				
		//} END Generator Room: Fall down stair or bridge
		
		/////////////////////////////////////////
		// Generator Room: Generator Turned On
		//{///////////////////////////////////////
		
		cSequenceStatesData mGeneratorTurnedOnSequence;
		
		void SequenceGeneratorTurnedOn(const tString &in asTimer)
		{
			Sequence_Begin("SequenceGeneratorTurnedOn", mGeneratorTurnedOnSequence);
			
			///////////////////////////
			// Initial stuff
			if (Sequence_DoStepAndWait(0.75f))
			{
				//Little pause before screen change to allow for chime of completion
				Entity_SetActive("TunnelBacktrackTrigger", false);
			}
			if (Sequence_DoStepAndWait(4.5f))
			{
				mbPowerOn_1 = true;
				Terminal_SetUpdateWhenOutOfView("ControlPanelMonitor_GUI", true);
				//Sound_Stop("PowerPuzzleCPUStage1", 0.25f);
				//Sound_Stop("PowerPuzzleCPUStage2", 0.25f);
				//Sound_CreateAtEntity("PowerPuzzleCPUStage3", "01_02_upsilon_inside_02/sfx/generator_puzzle/machine/C", "PowerPuzzleCPUSoundSource", 0.0f, true, 1.0f);
				Sound_CreateAtEntity("PuzzleSuccess", "01_02_upsilon_inside_02/sfx/generator_puzzle/generator_puzzle_bootup_sequence", "PowerPuzzleTerminalSoundSource");
				Sound_Stop("ProgressBarFill", 0.0f);
			}
			
			if (Sequence_DoStepAndWait(3.2f))
			{
				//////////////////////////
				//Stage 01 power on sound
				Sound_CreateAtEntity("PowerOnStage01", "01_02_upsilon_inside_02/special/power_sequence/power_sequence_stage_01", "Player", 0, false);
				Map_AddTimer("PowerOnSequenceAlarm", 7.5f,"PowerOnAlarm");
				Sound_FadeGlobalVolume(0.25f, 2.0f, eSoundEntryType_World);
				cSound_FadeHighPassFilter(250.0f, 0.0f, 6.0f, eSoundEntryType_World);
				Music_Stop(5.0f, eMusicPrio_BgAmb);
				Sound_CreateAtEntity("radio_connect_scan", "01_02_upsilon_inside_02/special/radio_pannel/connect", "radio_panel_sound", 0, false);
				Entity_PlayAnimation("thermal_extraction_vent", "spin", 0.1f, true, true);
			}
			
			///////////////////////////
			// Catwalk lamps
			for (int i = 1; i <= 7; i++)
			{
				if (Sequence_DoStepAndWait(cMath_RandRectf(0, 0.2f)))
				{
					Lamp_SetLit("CatwalkLamp_" + i, true, true);
					
					if (i == 5) ParticleSystem_SetVisible("CatwalkTunnelParticles_*", true);
		
					break;
				}
			}
			
			///////////////////////////
			// Elevated platform lamps
			for (int i = 1; i <= 3; i++)
			{
				if (Sequence_DoStepAndWait(cMath_RandRectf(0, 0.2f)))
				{
					Lamp_SetLit("ElevatedPlatformLamp_" + i, true, true);
					break;
				}
			}
			
			///////////////////////////
			// Electrical doors
			if (Sequence_DoStepAndWait(0.4f))
			{			
				ParticleSystem_SetVisible("ControlRoomDoorLightParticles", true);
				
				Lamp_SetLit("ControlRoomDoorLamp", true, true);
				Lamp_SetLit("control_room_ceiling_lamp_1", true, true);
				Music_Stop(1.5f, eMusicPrio_BgAmb);
			}
			
			///////////////////////////
			// Staircase lamp
			else if (Sequence_DoStepAndWait(0.1f))
			{
				Lamp_SetLit("StaircaseLamp_*", true, true);
			}
			
			///////////////////////////
			// Upsilon sign lamp
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Lamp_SetLit("upsilon_sign_lamp_*", true, true);
			}
		
			///////////////////////////
			// Transformer Lamps
			if (Sequence_DoStepAndWait(0.4f))
			{
				Lamp_SetLit("transformers_ceiling_lamp_*", true, true);
				Lamp_SetLit("transformer_sphere_lamp_*", true, true);
			}
				
			///////////////////////////////
			// Generators and transformers
			if (Sequence_DoStepAndWait(0.4f))
			{
				Lamp_SetLit("GeneratorLamp_*", true, true);
				
				//for(int i = 1; i < 3; i++)
				//	Sound_CreateAtEntity("Generator"+i+"Sound", "null", "generator_radio_single_"+i, 1.5f, true);
				
				StartUpTransformers();
			}
			
			///////////////////////////
			// Turbines
			else if (Sequence_DoStepAndWait(0.4f))
			{
				Lamp_SetLit("TurbineLamp_*", true, true);
				
				//for(int i = 1; i < 3; i++)
				//	Sound_CreateAtEntity("Turbine"+i+"Sound", "null", "Turbine_"+i, 1.5f, true);
			}
			
			///////////////////////////
			// Monitors
			else if (Sequence_DoStepAndWait(0.1f))
			{
				Map_AddTimer("PipeMonitor_1", 0.5f, "TimerTurnOnLamp");
				Lamp_SetLit("ReactorTerminalLamp_*", true, true);
				Lamp_SetLit("WalkwaySmallTerminal", true, true);
				Terminal_SetGuiActive("ThermalHoleTerminal_4", true);
			}
			
			///////////////////////////
			// Clanks
			if (Sequence_DoStepAndWait(4.5f))
			{
				//Sound_CreateAtEntity("GeneratorClanks", "level_01_02/events/generator_room_activated/deep_clanks", "ThermalHoleSoundSource", 0, false);
			}
			
			///////////////////////////
			// Rumble
			else if (Sequence_DoStepAndWait(0.75f))
			{
				Effect_Shake_Start(0.015f, 2.f, 2.f, 1.0f);
				
				/////////////////////////
				//Stage 02 power on and timer to fade out stage 01
				Sound_CreateAtEntity("PowerOnStage02", "01_02_upsilon_inside_02/special/power_sequence/power_sequence_stage_02", "Player", 0, false);
				Map_AddTimer("FadeOutPowerStage1Sound", 2.0f, "PowerStage1Fadeout");
				Map_AddTimer("ControlRoomPowerBoolTimer", 4.0f, "ControlRoomPowerBool");
				Map_AddTimer("PowerStage_AudioMixReturn", 5.0f, "PowerStage_AudioMixReturn");
			}
			
			///////////////////////////
			// Thermal pit lights
			else if (Sequence_DoStepAndWait(4.3f))
			{
				Light_FadeTo("ThermalLight_*", cColor(1,0.492,0,1), -1, 3.f);
				Light_FadeTo("ThermalLightAmbience_*", cColor(1,0.492,0,0), -1, 3.f);
				ParticleSystem_SetVisible("ThermalParticles_*", true);
				ParticleSystem_SetActive("ThermalHoleSmoke", true);
				ParticleSystem_SetActive("ThermalHoleRefraction", true);
			}
			
			/////////////////////////
			// Finalize
			else if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("SmallRumbleTimer", cMath_RandRectf(gfMinTimeBetweenRumbles, gfMaxTimeBetweenRumbles), "TimerGeneratorSmallRumble");
			}
			
			Sequence_End();
		}
		
		void PowerStage_AudioMixReturn(const tString &in asTimer)
		{
			cLux_AddDebugMessage("Return Audio to normal");
			Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_World);
			cSound_FadeHighPassFilter(0.0f, 0.0f, 4.0f, eSoundEntryType_World);
		}
			
		//-------------------------------------------------------
		
		void PowerOnAlarm(const tString &in asTimer)
		{
			///////////////////////////////////
			//Pre Stage 2 alarm sound
			Sound_CreateAtEntity("PowerOnAlarm", "01_02_upsilon_inside_02/special/power_sequence/power_sequence_alarm", "Player", 0, false);
		}
			
		//-------------------------------------------------------
		
		void PowerStage1Fadeout(const tString &in asTimer)
		{
			///////////////////////////////////
			//Fade out power on stage 1 sound
			Sound_Stop("PowerOnStage01", 0.5f);
		}
			
		//-------------------------------------------------------
		
		void ControlRoomPowerBool(const tString &in asTimer)
		{
			Music_PlayExt("01_02_controlroompass.ogg", false, 0.35, 1, 3, 0, eMusicPrio_BigEvent, true);
			Music_Stop(0.0f, eMusicPrio_BgAmb);
		}
		
		//} END Generator Room: Generator Turned On
		
		/////////////////////////////////////////
		// Generator Room: Transformer Robot
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		
		//-------------------------------------------------------
		
		bool OnTriggerActivateTransformerRobot(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(mbLadderCollapsed==false)
			{
				Entity_SetActive("LadderCollapse_Up", true);
				Entity_SetActive("LadderCollapse_Down", false);
			}
			
			Map_AddTimer("StartTransformerRobot", 0.5f, "TimerStartTransformerRobot");
			
			CheckPoint_Setup("Checkpoint_TransformerBot");
			AttackMeter_SetAttackerTeleportPosition("MonsterSpawn_Transformer_*");
					
			return false;
		}
		
		void TimerStartTransformerRobot(const tString&in asTimer)
		{
			cLux_AddTodoMessage("Sound: Construct Infected roar (the robot is behind a door) @TransformerBot");
			
			Entity_SetActive("TransformerBot", true);
						
			Pathfinder_Track_Clear("TransformerBot");
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_60", 1, 4);
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_46", 1, 4);
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_18", 1, 4);
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_63", 1, 4);
			Pathfinder_Track_Start("TransformerBot", true, 0, "");
		}
		
		//-------------------------------------------------------
		
		void Checkpoint_TransformerBot(int alRecentDeaths, const tString&in asDeathSource)
		{
		}
		
		//-------------------------------------------------------
		
		bool CollideTransformerBotBangsDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState!=1) return true;
			
			cLux_AddDebugMessage("Robot in bang door area! OpenAmount: "+SlideDoor_GetOpenAmount("StairsDoor"));
			
			if(SlideDoor_GetOpenAmount("StairsDoor")<0.6f)
			{
				Map_AddTimer("StairDoorPound", 2, "Timer_StairDoorPound");
				Map_AddTimer("StairDoorPound", 3, "Timer_StairDoorPound");
				
				return false;
			}
			
			return true;
		}
		
		void Timer_StairDoorPound(const tString&in asTimer)
		{
			cLux_AddTodoMessage("Sound: better door pound sound here! @StairsDoor");
			Sound_CreateAtEntity("StairsDoorPound", "02_07_theta_exit_a/SFX/akers_door_smash/akers_door_smash", "StairsDoor");
			int lID = Effect_Shake_Start(0.5, 0.5, 0.1, 0.5);
			Effect_Shake_SetSourceEntity(lID, "StairsDoor", 2, 7);
			
			cLux_AddDebugMessage("POUND ON STAIR DOOR!");
		}
		
		//-------------------------------------------------------
				
		bool OnTriggerDisableTransformerRobot(const tString &in asParent, const tString &in asChild, int alState)
		{
			Agent_SetAutoDisableWhenOutOfSightActive("TransformerBot", true, 8.0f);
		
			return false;
		}
		
		//-------------------------------------------------------
		
		bool CollideTransformerBotAtLowerFloor(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			return true;
		}
		
