    //-------------------------------------------------------
 
	cSequenceStatesData mDropStrunRodSequence;
	void SequenceDropStrunRod(const tString &in asTimer)
	{
		Sequence_Begin("SequenceDropStrunRod", mDropStrunRodSequence);
		
		float fBlinkTime = 0.5;
		
		if (Sequence_DoStepAndWait(fBlinkTime))
		{
			cLux_AddDebugMessage("SequenceDropStrunRod 1");
			if (Player_GetCurrentToolEntityName() == "")
				Player_EquipTool("StunRod");
			
			Entity_RemoveEntityAttachment("StunRod");
			
			Sound_CreateAtEntity("StunrodPowerOut", "02_03_delta/SFX/stunrod/powerout_beep", "Player", 0.0f, false, 1.0f);
			Entity_SetEffectBaseColor("StunRod_HudObject", cColor_Red);
			Entity_SetEffectsActive("StunRod_HudObject", true, false);
		}
		StunRodLowEnergy_Off(fBlinkTime);
		StunRodLowEnergy_On(fBlinkTime);
		StunRodLowEnergy_Off(fBlinkTime);
		StunRodLowEnergy_On(fBlinkTime);
		StunRodLowEnergy_Off(fBlinkTime);
		StunRodLowEnergy_On(fBlinkTime);
		if (Sequence_DoStepAndWait(2))
		{
			cLux_AddDebugMessage("SequenceDropStrunRod 3");
			Entity_SetEffectsActive("StunRod_HudObject", false, true);
		}
		
		if (Sequence_DoStepAndWait(0))
		{
			cLux_AddDebugMessage("SequenceDropStrunRod 4");
			if (Player_GetCurrentToolEntityName() == "")
				Player_EquipTool("StunRod");
		}
		
		if (Sequence_DoStepAndWait(0.3))
		{
			cLux_AddDebugMessage("SequenceDropStrunRod 5");
/*			if (Player_GetCurrentToolEntityName() == "StunRod")
				Player_UnequipTool(true);
			else*/
				Player_RemoveTool("StunRod");
		}
		
		if (Sequence_DoStepAndWait(0))
		{
			cLux_AddDebugMessage("SequenceDropStrunRod 6");
			Entity_SetActive("StunRod", true);
			Entity_PlaceAtEntity("StunRod", "Player");
			Prop_DisableCollisionUntilOutsidePlayer("StunRod");
			//Prop_SetHighlightActive("StunRod", false);
			Prop_SetStaticPhysics("StunRod", false);
			Entity_AddImpulseFromEntity("StunRod", "Player", 1, true);
			Entity_AddTorque("StunRod", cMath_RandRectVector3f(-5, 5), true, true);
			Entity_SetInteractionDisabled("StunRod", true);
			
			//////////////////////////////////////////////////////////////////////////////////////
			// Temp solution to stunrod falling through floor, remove once bug is fixed.
			{
				cLux_AddTodoMessage("Script: Remove temp solution to stun rod falling trhough floor if bug has been fixed.");
				cLuxProp@ pProp = Map_GetProp("StunRod");
				cVector3f vPos = pProp.GetPosition();
				pProp.SetMatrix(cMath_MatrixTranslate(vPos));
			}
		}
		
		Sequence_End();
	}
	
	void StunRodLowEnergy_Off(float afBlinkTime)
	{
		if (Sequence_DoStepAndWait(afBlinkTime)) 
		{
			Entity_SetEffectsActive("StunRod_HudObject", false, false);
		}
	}
	
	void StunRodLowEnergy_On(float afBlinkTime)
	{
		if (Sequence_DoStepAndWait(afBlinkTime))
		{
			Sound_CreateAtEntity("StunrodPowerOut", "02_03_delta/SFX/stunrod/powerout_beep", "Player", 0.0f, false, 1.0f);
			Entity_SetEffectsActive("StunRod_HudObject", true, false);
		}
	}
 
