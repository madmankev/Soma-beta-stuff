	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Locked doors
    /////////////////////////////////////////
 
	//-------------------------------------------------------
	
	void InteractBunkerDoor(const tString &in asEntity)
	{
		if (mbStopKateFollowing || Entity_GetVarBool(asEntity, "FailedOpen")) return;
		
		Entity_SetActive("KateKillzone", false);
		Entity_SetActive("GoyaKillzone", false);
				
		TimerKateDoorWelding(asEntity);
		Kate_Investigate("Kate", asEntity+"_WeldingPos", asEntity+"_WeldingFlare", -1, "KateAtPanel_LaunchSite");
	}
 
	//-------------------------------------------------------
	
	void InteractMainBaseDoor(const tString &in asEntity)
	{
		if (mbStopKateFollowing || Entity_GetVarBool(asEntity, "FailedOpen")) return;
		
		Entity_SetActive("KateKillzone", false);
		Entity_SetActive("GoyaKillzone", false);
				
		TimerKateDoorWelding(asEntity);
		Kate_Investigate("Kate", asEntity+"_WeldingPos", asEntity+"_WeldingFlare", -1, "KateAtPanel_MainBase");
	}
 
	//-------------------------------------------------------
	
	void TimerKateDoorWelding(const tString &in asTimer)
	{		
		if (!Entity_IsInPlayerFOV("KateInPlayerFOVArea"))
		{
			Entity_PlaceAtEntity("Kate", asTimer+"_UnlockTeleportPos");
			Agent_FaceEntity("Kate", asTimer+"_WeldingFlare");
		}
		
		Entity_SetVarBool(asTimer, "FailedOpen", true);
		Map_RemoveTimer("KateFollowPlayerTimer");
		Map_AddTimer("HelpfulSoundTimer", 0.75, "TimerKateHelpfulSound");
	}
 
	//-------------------------------------------------------
	
	void TimerKateHelpfulSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("HelpfulKate", "NPC_Kate/talk/katebot_idle_talk", "Kate", 0, false);
	}
 
    //-------------------------------------------------------
	
	void OnChangeDoorButton(const tString &in asEntity, int alState)
	{
		//////////////////////////////////////
		// Temporarily disable interaction
		Entity_SetInteractionDisabled(asEntity, true);
		//////////////////
		//Need to be above 3-4 seconds to prevent sound from being spammed/breaking
		Map_AddTimer(asEntity, 4.0f, "TimerEnableInteraction");
		
		///////////////////////////////////////////////
		// Change state of other button as well
		tString sConnectedButton = Entity_GetVarString(asEntity, "ConnectedButton");
		if (sConnectedButton != "") Button_SetSwitchedOn(sConnectedButton, alState == 1, true);
	}
 
