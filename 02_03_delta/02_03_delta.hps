	//-------------------------------------------------------
	
	void AkersComputerMainMenu()
	{		
		StationGuiBG_OrnamentTopLeft();
		StationGuiBG_OrnamentBottomLeft();
		StationGuiBG_OrnamentBottomRight();
		
		// Buttons
		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		buttonData.mFont.mvSize = cVector2f(30, 30);
		buttonData.mColorText = cColor(0.8, 1);
		ImGui_SetDefaultButton(buttonData);
		
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.25, 0.25, 1)), ImGui_NrmSize(cVector2f(0.5, 0.7)));
			if (DoMainMenuSelectionButton("FrequencyScanner", 0, 0.2))
			{
				mlGuiAkersRow=0;
				ImGui_SetStateInt("CurrentState", 1);
			}
			if (DoMainMenuSelectionButton("ChessGame", 0.5, 0.2))
			{
				ImGui_SetStateInt("CurrentState", 3);
			}
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------
	
	void AkersComputerScanning()
	{
		if ( ImGui_ActionTriggered(eImGuiAction_Up)||ImGui_ActionTriggered(eImGuiAction_Down)||
			ImGui_ActionTriggered(eImGuiAction_Left)||ImGui_ActionTriggered(eImGuiAction_Right))
		{
			if (mlGuiAkersRow==1)
			{
				mlGuiAkersRow=0;
				ImGui_SetFocus("ScanButton");
			}
			else
			{
				mlGuiAkersRow=1;
				ImGui_SetFocus("ScanningBackButton");
			}
		}
		
		cImGuiGaugeData gaugeData = StationGui_CreateDefaultGaugeData();
		gaugeData.mOrientation = eImGuiGaugeOrientation_Vert;
		
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		
		ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 2)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.5)));
			float fBars = 30;
			bool bScanningActive = ImGui_GetStateInt("ScanningActive")==1;
			for (int i = 0; i < fBars; i++)
			{
				float fSignal = 0.05;
				if (bScanningActive) fSignal = Depth_ImGui_GetOscillatingSignalValue("Scanning", i, eEasing_QuadOut, 0.05, 0.15, 0.05);
				ImGui_DoGauge(gaugeData, fSignal, ImGui_NrmPosGroup(cVector3f(i*(1/fBars), 0, 2)), ImGui_NrmSizeGroup(cVector2f(1/fBars, 0.9)));
			}
			ImGui_DoLabelExt("FrequencyScannerRangeFrom", labelData, ImGui_NrmPosGroup(cVector3f(0, 0.925, 2)), cVector2f_MinusOne, 2);
			labelData.mFontAlign = eFontAlign_Right;
			ImGui_DoLabelExt("FrequencyScannerRangeTo", labelData, ImGui_NrmPosGroup(cVector3f(0, 0.925, 2)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 2);
		ImGui_GroupEnd();
		
		if (ImGui_DoButton("ScanButton", bScanningActive ? "FrequencyScannerStop" : "FrequencyScannerScan", 
						   ImGui_NrmPosGroup(cVector3f(0.05, 0.575, 1)), ImGui_NrmSizeGroup(cVector2f(0.2, 0.09))))
		{
			if (bScanningActive)
			{
				Sound_Stop("ScanSound", 0.5);
			}
			else
			{
				cLux_AddTodoMessage("Sound: Frequency scanner active");
				Sound_CreateAtEntity("ScanSound", "01_02_upsilon_inside/VIPScriptedEvents/radio/signal_bad", ImGui_GetName(), 1.f, true);
			}
			ImGui_SetStateInt("ScanningActive", bScanningActive ? 0 : 1);
		}
		labelData.mFontAlign = eFontAlign_Left;
		ImGui_DoLabelExt("FrequencyScannerSignalsFound", labelData, ImGui_NrmPosGroup(cVector3f(0.05, 0.685, 2)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 2);
		
		if (ImGui_DoButton("ScanningBackButton", "GUIBack", ImGui_NrmPosGroup(cVector3f(0.725, 0.85, 1)), ImGui_NrmSizeGroup(cVector2f(0.2, 0.09))))
		{
			ImGui_SetStateInt("CurrentState", 0);
		}
	}
	
	 //////////////////////////////////////////////////////////////////////////////////////////
	 // ==============
	 // AUDIO
	 // ==============
	 //{//////////////////////////////////////////////////////////////////////////////////////
		
	//---------------------------------------------------------------------
	/**
	*Simple ambient music player that fades the ambience randomly whilst playing to stop it from getting repetitive
	**/
	bool mbAmbientMusicPlaying = false;
	void AmbientMusicHandler(const tString &in asTimer)
	{
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbZeppelinArrived==false && mbPlayerinBunker==false)
		{
			cLux_AddDebugMessage("Ambient music triggering");
			Music_PlayExt("02_03_ambient", true, 0.3f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			Music_FadeVolumeMul(1.0f, 3.0f);
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(15.f,30.f), "AmbientMusicFade");
			Map_AddTimer("FadeOut", cMath_RandRectf(35.f,65.f), "AmbientMusicFade");
		}
		
		//Fade Music back up
		else if (asTimer=="AmbientMusicFadeBackIn" && mbAmbientMusicPlaying==true)
		{
			Music_FadeVolumeMul(1.0f, cMath_RandRectf(12.f,15.f));
			Map_AddTimer("FadeOut", cMath_RandRectf(35.f,65.f), "AmbientMusicFade");
		}
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		  else if (asTimer=="StopAmbientMusicQuickly" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(1.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
	}
	
	void AmbientMusicFade(const tString &in asTimer)
	{
		if(asTimer=="FadeOut")
		{	
			Map_RemoveTimer("RandomFadeRider");
			cLux_AddDebugMessage("Ambient Music Fading Out");
			Music_FadeVolumeMul(0.0f, cMath_RandRectf(12.0f,15.0f));
			Map_AddTimer("AmbientMusicFadeBackIn", cMath_RandRectf(25.f,45.f), "AmbientMusicHandler");
		}
		if(asTimer=="RandomFadeRider")
		{
			cLux_AddDebugMessage("Ambient Music Fading");
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicFade");
			Music_FadeVolumeMul(cMath_RandRectf(0.65f, 1.2f), cMath_RandRectf(5.0f,8.0f));
		}
	}
	
	//---------------------------------------------------------------------
	
	void FadeOutAudio(const tString&in asTimer)
	{
		Sound_FadeGlobalVolume(0.0f, 7.0f, eSoundEntryType_All);
		cLux_AddDebugMessage("Fade Out Audio Triggered");
	}
	
	//----------------------------------------------------
	
	void FadeInAudioLevelStart(const tString&in asTimer)
	{
		Sound_FadeGlobalVolume(1,1.4,eSoundEntryType_All);
		cLux_AddDebugMessage("Fade In Audio Triggered");
	}
	
	//----------------------------------------------------
	
	//Goya music stinger
	bool Trigger_GoyaMusicLookAt(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("GoyaLookAtMusicTrigger", true);
		}
		else
		{
			Entity_SetActive("GoyaLookAtMusicTrigger", false);
		}
		return true;
	}
	
	void Trigger_GoyaMusicSting(const tString &in asEntity, int alState)
	{
		Map_AddTimer("Timer_GoyaMusicSting", 2.25f, "Timer_GoyaMusicSting");
		Map_AddTimer("StopAmbientMusicQuickly", 0.5f, "AmbientMusicHandler");
	}
	
	//Adding bool to Goya music sting incase player exits bunker and lookat is called again
	bool mbGoyaMusicStingPlayed = false;
	void Timer_GoyaMusicSting(const tString &in asTimer)
	{
		if(mbGoyaMusicStingPlayed == false)
		{
			Music_Play("02_03_goya_sight", 0.55f, false, eMusicPrio_MinorEvent);
			Map_AddTimer("StartAmbient", cMath_RandRectf(12.f,16.f),"AmbientMusicHandler");
			mbGoyaMusicStingPlayed = true;
		}
	}
	
	bool mbPlayerinBunker = false;
	bool Trigger_MusicEnterBunker(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbPlayerinBunker = true;
			cLux_AddDebugMessage("Player entered bunker - stopping music");
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
			Entity_SetActive("GoyaLookAtEnable", false);
		}
		else
		{
			mbPlayerinBunker = false;
			cLux_AddDebugMessage("Player left bunker - starting music");
			Map_AddTimer("StartAmbient", cMath_RandRectf(3.f,6.f),"AmbientMusicHandler");
			Entity_SetActive("GoyaLookAtEnable", true);
		}
		return true;
	}
		
	//----------------------------------------------------
	
	//} END AUDIO
