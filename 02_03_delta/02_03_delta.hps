	//-------------------------------------------------------
	
	bool mbHasLastStunrodBeenShot=false;
	
	cSequenceStatesData mStunRodEffectsSequence;
		
	void SequenceStunRodEffects(const tString &in asTimer)
	{
		Sequence_Begin("SequenceStunRodEffects", mStunRodEffectsSequence);
			
		if (Sequence_DoStepAndWait(0.075))
		{
			//Effect_Flash_Start(0.1, 0, 0.5);
			Effect_ToneMapping_FadeExposure(9, 0.075);
			Effect_Shake_Start(0.05, 0, 0.1, 0.1);
			Sound_CreateAtEntity("UseStunRod", "02_03_delta/SFX/stunrod/fire", "Player", 0, false);
			Entity_SetEffectsActive("StunRod_HudObject", false, true);
		}
		else if (Sequence_DoStepAndWait(0.075))
		{
			Effect_ToneMapping_FadeExposure(0, 0.075);
		}
		else if (Sequence_DoStepAndWait(0.075))
		{
			Effect_ToneMapping_FadeExposure(10, 0.075);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			Effect_ToneMapping_FadeExposure(0, 0.5);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			if (mbHasLastStunrodBeenShot==false)
			{
				Sound_CreateAtEntity("StunRodOutOfJuice", "02_03_delta/SFX/stunrod/beep_powerdown", "Player", 0, false);
				return;
			}
		}
		Sequence_End();
	}
 
