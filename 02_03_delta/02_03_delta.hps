	//-------------------------------------------------------
	
	cSequenceStatesData mCrashedPodWakeUpSequence;
		
	void SequenceCrashedPodWakeUp(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCrashedPodWakeUp", mCrashedPodWakeUpSequence);
			
		if (Sequence_DoStepAndWait(2))
		{
			if (Player_GetHealth()>=0.8)
				Player_SetHealth(0.8);
			Entity_SetEffectsActive("Kate", false, false);
			
			CameraAnimation_Begin("CrashWakeUpAnim", "", true);
			Voice_Play("2_EscapePodDistressSignal");
		}	
		if (Sequence_DoStepAndWait(2))
		{
			Effect_Fade_In(3);
			Effect_ImageTrail_Start(2.25, 0, 3, 10);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------

	bool CrashAnimationWakeUp(const tString &in asEntity, int alDirection)
	{
		if (asEntity == "CrashWakeUpAnim_2" && alDirection == 1)
		{
			cLux_AddDebugMessage("Wake Up Animation Sound Start");
			Sound_CreateAtEntity("WakeUpAnimation", "02_03_delta/SFX/pod_crash/rise_up_animation", "Player", 0.0f, false, 1.0f);
			return true;
		}
		
		else if (asEntity == "CrashWakeUpAnim_2" && alDirection == -1)
		{
			cLux_AddDebugMessage("Wake Up Animation Sound Stop");
			Sound_Stop("WakeUpAnimation", 0.5f);
			return true;
		}
		return true;
	}


