	//-------------------------------------------------------
	bool mbHasExitRaftMusicPlayed = false;
	bool LeavePodMusic(const tString &in asEntity, int alDirection)
	{
		if (asEntity == "EscapePodClimbAnim_3" && alDirection == 1)
		{
			cLux_AddDebugMessage("Leave Pod Sound and Ambient Music Start");
			Sound_CreateAtEntity("LeavePodAnimation", "02_03_delta/SFX/pod_crash/rise_climb_out_of_pod", "Player", 0.0f, false, 1.0f);
			Emotion_PlayEventBreath("02_03_delta/SFX/pod_crash/rise_climb_out_of_pod_VO", 2);
			Sound_Stop("RiseIntoClimb", 0.5f);
			
			if(mbHasExitRaftMusicPlayed==false)
			{
				mbHasExitRaftMusicPlayed=true;
				Music_Play("02_03_afterescape", 0.65f, false, eMusicPrio_MinorEvent);
				Sound_FadeGlobalVolume(0.65f, 12.0f, eSoundEntryType_WorldClean);
				Map_AddTimer("FadeUp", 20.0f, "FadeUpIntroMusic");
				Map_AddTimer("StartAmbient", cMath_RandRectf(60.f,70.f),"AmbientMusicHandler");
			}
			return true;
		}
		else if (asEntity == "EscapePodClimbAnim_3" && alDirection == -1)
		{
			cLux_AddDebugMessage("Leave Pod Animation Sound Stop");
			Sound_Stop("LeavePodAnimation", 0.5f);
			return true;
		}
		return true;
	}

