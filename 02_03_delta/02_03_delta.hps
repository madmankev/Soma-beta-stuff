class cScrMap : iScrMap
{
	//--------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	/////////////////////////////////////////

	//--------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{		
		bool bDoIntro = true;
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{			
			bDoIntro = false;			
			Trigger_GoyaStart("", "", 1);
			Entity_SetActive("Trigger_MusicBunker_*", true);
			Map_AddTimer("StartAmbient", cMath_RandRectf(5.f,8.f),"AmbientMusicHandler");
		}
		
		if (bDoIntro)
		{
			Sound_SetGlobalVolume(0.0f);
			SetupSceneEscapePod();
			Map_AddTimer("SequenceIntro", 1, "SequenceIntro");
			
		}
		else
		{
			StartSceneAwakenRobotRelay(false);
		}
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Outdoors();
		
		PlayerHands_SetHandModel_Diving();
		
		SetupSceneAwakenRobotRelay();
		SetupExploreLaunchSite();
		SetupExploreRocketConstruction();
		SetupExploreReefAndConstructionSite();
		SetupActivateMainBase();
		SetupSubBase2();
		SetupKillRobot();
		
		Critter_AddExtraEscapeEntity("Shoal_*", "Kate");	
		
		///////////////////////////////////////////////////
		///Fade in audio
		Map_AddTimer("StartLevelAudioFadeIn",0.1f, "FadeInAudioLevelStart");
		Sound_SetGlobalVolume(0,eSoundEntryType_All);
		Music_Stop(12.0f, eMusicPrio_BigEvent);
		
		///////////////////////////////////////////////////
		//////Load audio
		Sound_PreloadCoreSounds();
		Sound_PreloadCoreUWInteractions();
		Sound_PreloadCoreUWSounds();
		Sound_PreloadGroup("02_03_delta/SFX", true);
		
		///////////////////////////////////////////////////
		///Entities
		Entity_SetInteractionDisabled("transformer_cabinet_electricity_1", true);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{		
	
		//iTexture@ pSkybox = cResources_CreateTextureCubeMap("grayscale_gradient_1_4_fog.dds",false);
		cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(null);
		
		Game_AutoSave();
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{

	}
	
	//-------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if (!abPressed) return;
		
		if (alAction == eAction_Test1)
		{
			cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
				return;
				
			tString sFocusEntity = pData.mpEntity.GetName();
			
			SlideDoor_SetClosed(sFocusEntity, SlideDoor_GetOpenAmount(sFocusEntity) > 0.5, false);
			Button_SetSwitchedOn(sFocusEntity, true, true);
		}
		
		///////////////
		//Call zepp to landing site and teleport player, press 8 to take off. (F3 is good to not forget as well..)
		else if(alAction == eAction_Test2)
		{
			Player_Teleport("StartZeppLanding");
			SequenceZeppelinArrives("");
			//Seq_GoyaCrashed("");
			//Seq_KateCrashed("");
			//mbStopKateFollowing = true;
		}
		
		/////////////
		// Use to test transition, press 8 after this one. !!! Starting position in next level wwill not be the same
		// as if you transition using test 2 (regular path) so don't use for testing of things in 2.4.
		
		else if(alAction == eAction_Test3)
		{
			Entity_SetActive("ZepTerminalA", true);
			Entity_SetActive("ZepTerminalB", true);
			Entity_SetActive("ZeppelinPlatform", true);
			Entity_SetActive("Zeppelin", true);
			Entity_SetActive("CatherineSlotInteract", true);
			Entity_SetActive("ZeppelinCathTerminal", true);
			Entity_SetActive("TerminalCathZep", true);
			Entity_SetActive("ZeppelinPlatformRailing_*", true);
			Entity_SetActive("StunRodLockbox", true);
			Entity_SetActive("StunRodLockboxLid", true);
			Entity_SetActive("StunRodLockboxButton", true);
			Entity_SetActive("StunRodInnerHatch", true);
			Entity_SetActive("StunRod", true);
			Entity_SetActive("LiftoffLever", true);
			Entity_SetActive("LiftoffButton", true);
			Entity_SetActive("LiftoffLever_Lamp", true);
			Entity_SetActive("LiftoffButton_Lamp", true);
			Entity_SetActive("CatherineTerminal", true);
			Entity_SetActive("zeppelin_searchlight01_1", true);
			Entity_SetActive("zeppelin_searchlight01_2", true);
			Entity_SetActive("CathSlotGoo", true);
			Entity_SetActive("CathSlotGoo_Sticky", true);
			Entity_SetActive("BrokenRadio", true);
			Entity_SetInteractionDisabled("ZeppelinPlatformRailing_*", true);
			Entity_SetInteractionDisabled("LiftoffButton", true);
			Entity_SetEffectsActive("LiftoffLever", false, false);
			Entity_SetEffectsActive("LiftoffButton", false, false);
			Player_Teleport("StartInZepp");
			Entity_TeleportToEntity("ZeppelinPlatform", "ZeppelinTargetPos_3");
			Preload();
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
		
		else if(alAction == eAction_Test4)
		{
			Timer_CheckGoyaMovement("");
		}
		
		//Give cath tool
		else if(alAction == eAction_Test5)
		{
			Entity_PlaceAtEntity("Kate", "Player", cVector3f_Forward*2);
			Entity_CallEntityInteract("CathTool");
		}
		
		else if(alAction == eAction_Test6)
		{
			Entity_PlaceAtEntity("Kate", "Player", cVector3f_Forward*2);
			mlStunRodHits_Kate = 3;
		}
		
		else if(alAction ==eAction_Test7)
		{
			Entity_CallEntityInteract("StunRod");
		}
		
		///////////////
		//Take off with the zep, should use 2 or 3 before using this.
		else if(alAction ==eAction_Test8)
		{
			OnChangeLiftoffControls("LiftoffLever", 1);
			OnChangeLiftoffControls("LiftoffButton", 1);
		}
	}
	
	//-------------------------------------------------------
	
	void Setup()
	{
		GetBase().SetDisplayNameEntry("02-03-delta");

		////////////////////
		// PRESETS FOR NEXT LEVEL TRANSITIOn
		Map_Preset_SetupBloom("Outside2.4", 160, 0.00001, 0, cColor(0.3, 0.3, 0.3, 0.0));
		Map_Preset_SetupDepthOfField("Outside2.4", true, 1, 12, 1.0);
		Map_Preset_SetupColorGrading("Outside2.4", "textures/colorgrading/grading_default.dds");
	}
 
