	//-------------------------------------------------------
	
	void SetupActivateMainBase()
	{
		Entity_SetInteractionDisabled("TrainDoor", true);
		
		Entity_SetVarInt("Antenna_Peripheral1", "RotationIndex", 12);
		Entity_SetVarFloat("Antenna_Peripheral1", "RotationOffset", -16.821);
		Entity_SetVarBool("Antenna_Peripheral1", "Active", false);
		Entity_SetVarBool("Antenna_Peripheral1", "RotationDisabled", false);
		
		Entity_SetVarString("MainBaseDoorButton_Outside", "ConnectedButton", "MainBaseDoorButton_Inside");
		Entity_SetVarString("MainBaseDoorButton_Inside", "ConnectedButton", "MainBaseDoorButton_Outside");
		
		Entity_AttachToEntity("CatherineToolArea", "ZeppelinPlatform", "", true);
		
		cVector3f vInitialZeppelinDelta = Entity_GetDeltaToEntity("ZeppelinTargetPos_2", "ZeppelinPlatform");
		vInitialZeppelinDelta.y = 0;
		mfInitialZeppelinDistance = vInitialZeppelinDelta.Length();
		
		Entity_SetEffectsActive("MainBaseDoor_1_WeldingFlare", false, false);
		LensFlare_SetVisible("MainBaseDoor_1_WeldingFlare_LensFlare_*", false);
	}
 
