	//-------------------------------------------------------
	
	int mlGuiMainCol = 0;
	
	//-------------------------------------------------------
	
	void OnGuiMainBaseTerminal(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_03_delta");
		
		int lActiveApp = StationGui_GetActiveApp(eMainBaseTerminalApp_MainMenu);
		bool bDoBackButton = true;
		
		/////////////////////////
		// States
		switch (lActiveApp)
		{
			case eMainBaseTerminalApp_MainMenu:
				StationGui_AddApp("RobotManual");
				StationGui_AddApp("Messages");
				StationGui_AddApp("AccessLog");
				StationGui_AddApp("ChessGame");
				StationGui_MainMenu();
				bDoBackButton = false;
				break;
			case eMainBaseTerminalApp_RobotManual:
				OnGuiDeflectInfo();
				break;
			case eMainBaseTerminalApp_Messages:
				MainBaseMessages();
				break;
			case eMainBaseTerminalApp_Log:
				MainBaseAccessLog();
				break;
			case eMainBaseTerminalApp_Chess:
				OnGuiChess("ChessStats_MainBase");
				break;
		}
		
		if (bDoBackButton)
		{
			StationGui_BackButton();
		}
	}
	
	//-------------------------------------------------------
	
	void OnGuiDeflectInfo()
	{		
		/////////////////////
		// Data
		cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
		text.mbUseBackgroundGfx = false;
		text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.03);
		
		StationGuiBG_Backdrop();
		StationGuiBG_Scanlines();
		
		ImGui_AddItemString("RobotManual_Name_1");
		ImGui_AddItemString("RobotManual_Name_2");
		ImGui_AddItemString("RobotManual_Name_3");
		ImGui_AddItemString("RobotManual_Name_4");
		int lSelectedFile = StationGui_FileList("RobotManual", 4, ImGui_NrmPosGroup(0.025, 0.025, 1), ImGui_NrmSizeGroup(0.35, 0.8));
		
		if (lSelectedFile <= 0) return;
		
		ImGui_DoWindowStart("RobotManual_Name_"+lSelectedFile, StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.4, 0.025, 1), ImGui_NrmSizeGroup(0.575, 0.8));
			ImGui_DoImageCorrectAspect(cImGuiGfx("deltabaseterminal_robot_"+lSelectedFile, eImGuiGfx_Texture), ImGui_NrmPosGroup(0,0,1), ImGui_NrmSizeGroup(1, 0.5));
			ImGui_DoTextFrameExt("RobotManual_Robot_"+lSelectedFile, ImGui_NrmSizeGroup(0.05, 0.05), 0, 0, text, ImGui_NrmPosGroup(0,0.5,1), ImGui_NrmSizeGroup(1, 0.5));
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void MainBaseMessages()
	{		
		if ( ImGui_ActionTriggered(eImGuiAction_Left)||ImGui_ActionTriggered(eImGuiAction_Right) )
		{
			if (mlGuiMainCol==1)
			{
				mlGuiMainCol=0;
				ImGui_SetFocus("FileSelection$0");
			}
			else
			{
				mlGuiMainCol=1;
				ImGui_SetFocus("MessageBackButton");	
			}
		}
		
		//////////////////////
		// GUI Data
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorText = cColor(0.6, 1);
		
		cImGuiTextFrameData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(20, 20);
		textData.mFontAlign = eFontAlign_Left;
		textData.mColorText = cColor(0.8, 1);
		
		cImGuiButtonData toggleButtonData = StationGui_CreateToggleButtonData();
		ImGui_SetDefaultButton(toggleButtonData);
		
		ImGui_DoWindowStart("BunkerMessages_0", windowData, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.23, 0.75)));
			for (int i = 1; i <= 4; i++)
			{
				ImGui_AddItemString("MainBaseMailName_"+i);
			}
			int lSelectedFile = ImGui_DoMultiToggle("FileSelection", 0, 1, ImGui_NrmSizeGroup(cVector2f(0, 0.02)), ImGui_NrmPosGroup(cVector3f(0.075, 0.05, 2)), 
								  ImGui_NrmSizeGroup(cVector2f(0.85, 0.480)));
			lSelectedFile++;
			//if (!mbSentLaunchBunkerDraft)
				//ImGui_DoButton("DraftButton", "BunkerDraftName", ImGui_NrmPosGroup(cVector3f(0.1, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.12)));
		ImGui_DoWindowEnd();
		
		ImGui_DoWindowStart("MainBaseMailName_"+lSelectedFile, windowData, ImGui_NrmPosGroup(cVector3f(0.3, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.65, 0.75)));
			ImGui_DoTextFrameExt("MainBaseMail_"+lSelectedFile, ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 5, 0, textData, 
								 ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
