	//-------------------------------------------------------
	
	void OnGuiChess(const tString &in asStatsEntry)
	{
		bool bChessError = ImGui_GetStateBool("ChessError", false);
		//////////////////////
		// GUI Data
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorText = cColor(0.6, 1);
		windowData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
		
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		labelData.mFontAlign = eFontAlign_Center;
		labelData.mFont.SetFile("default_medium_outline.fnt");
		labelData.mFont.mColor = labelData.mFont.mColor*0.7f;
		
		cImGuiTextFrameData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(20, 20);
		textData.mFontAlign = eFontAlign_Left;
		textData.mColorText = cColor(0.7, 1);
		
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
		
		ImGui_SetModColorMul(gStationGuiColor_Normal*0.9);
		ImGui_DoImage(cImGuiGfx("chessboard.tga"), ImGui_NrmPosGroup(cVector3f(0.35, 0.18, 1)), ImGui_NrmSizeKeepRatio(cVector2f(0.75, 0.75)));
		ImGui_SetModColorMul(cColor_White);
		
		ImGui_DoLabelExt("ChessGame", labelData, ImGui_NrmPosGroup(cVector3f(0.35, 0.05, 1)), ImGui_NrmSizeKeepRatio(cVector2f(0.75, -1)), 5);
		
		ImGui_DoWindowStart("", windowData, ImGui_NrmPosGroup(cVector3f(0.025, 0.18, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.6)));
			
		ImGui_SetModUseInput(!bChessError);
		if (ImGui_DoButtonExt("ChessNewGameButton", "ChessNewGame", button, ImGui_NrmPosGroup(cVector3f(0.1, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.1625))))
		{
			ImGui_SetStateBool("ChessError", true);
		}
		
		ImGui_SetModUseInput(false);
		ImGui_DoButtonExt("ChessContinueButton", "ChessContinue", button, ImGui_NrmPosGroup(cVector3f(0.1, 0.3, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.1625)));
		ImGui_SetModUseInput(!bChessError);
			
/*		if (ImGui_DoButton("ChessExitButton", "ChessExit", ImGui_NrmPosGroup(cVector3f(0.1, 0.35, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.13))))
		{
			ImGui_SetStateInt("CurrentState", 0);
		}*/
		
		ImGui_DoTextFrameExt(asStatsEntry, ImGui_NrmSizeGroup(cVector2f(0.1, 0.05)), 5, 0, textData, 
							 ImGui_NrmPosGroup(cVector3f(0, 0.5, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		
		ImGui_DoWindowEnd();
		ImGui_SetModUseInput(true);
		
		if (bChessError)
		{
			StationGui_DialogBox_Start("GUIError", "ChessError", cVector2f(0.6, 0.25), 4);
				if (ImGui_DoButton("OKDialogButton", "GUIOK", ImGui_NrmPosGroup(cVector3f(0.35, 0.5, 2)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.4))))
					ImGui_SetStateBool("ChessError", false);
			StationGui_DialogBox_End();
		}
	}
 
