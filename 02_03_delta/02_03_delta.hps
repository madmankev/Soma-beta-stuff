    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("02_04_theta_outside.hpm", eWorldStreamPriority_Low);
	}

	//-------------------------------------------------------
	
	void PreloadSetPrioNormal()
	{
		if(PreloadDisabled()) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
		
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("transfer2324");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		//PreloadDeload();
		
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_AddTimer("FadePreset", 0, "PreloadTimer");
				Map_AddTimer("ChangeMap", 10, "PreloadTimer");
				Map_AddTimer("ChangePrio", 12, "PreloadTimer");
				Map_AddTimer("ChangeMapNotReady", 15, "PreloadTimer");
				
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 2.9);
			
			Map_AddTimer("FadeGlobal", 3.0, "PreloadTimer");
		}

		if(asTimer == "FadePreset")
		{
			Map_Preset_Fade("Outside2.4", 2.9); 
			Map_FadeEnvironmentParticleColor("*", cColor(0.295,0.556,0.59,1.0), 2.9);
		}
		
		if(asTimer == "ChangePrio")
		{
			Map_SetPreloadPriority(eWorldStreamPriority_High);
		}
		
		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Entity_SetActive("LiftoffBlocker_*", false);
				Entity_SetActive("ZeppelinPlatformRailing_*", false);
				Entity_SetActive("StunRodInnerHatch", false);
				Entity_SetActive("StunRodLockboxButton", false);
				Entity_SetActive("zeppelin_searchlight01_1", false);
				Entity_SetActive("zeppelin_searchlight01_2", false);
				Entity_SetActive("LiftoffLever", false);
				Entity_SetActive("LiftoffButton", false);
				Entity_SetActive("CathTool", false);
				
				Description_SetForceFading(true);
				Map_ChangeMap("02_04_theta_outside.hpm", "", "transfer2324", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.55f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
		
	//-------------------------------------------------------

	void PreloadManualChangeMap()
	{
		Map_ChangeMap("02_04_theta_outside.hpm", "PlayerStartArea_1", "", "");
	}
	
    //-------------------------------------------------------
 
    /////////////////////////////////////////
