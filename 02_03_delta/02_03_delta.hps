		Sound_CreateAtEntity("Button", "Entities_OceanBottom/button/plastic_stiff" ,asEntity, 0.0f, false, 1.0f);
		
		Sound_CreateAtEntity("DeflectTerminalSound", "Entities_OceanBottom/tech/terminal/loop", "DeflectInfoTerminal", 2.0f, true, 1.0f);
