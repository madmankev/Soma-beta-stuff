	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// SCENE 9 *GO NEAR THE ABYSS (OPTIONAL)*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlAbyssAreaCount = 0;
	int mlFallAreaIndex;
	int mlRescuedByKateCount = 0;
	int mlAbyssCommentCount = 0;
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 9 Event A *Low-freq sound*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool CollisionAbyssProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
		{			
			mlAbyssAreaCount++;
			if (mlAbyssAreaCount > 1) return true;
			
			Sound_CreateAtEntity("AbyssTone", "", "Player", 1.5f, true);
			if (mlAbyssCommentCount < 2)
			{
				Voice_Play("9_NearEdge", mlAbyssCommentCount);
				mlAbyssCommentCount++;
			}
		}
		else
		{
			mlAbyssAreaCount--;
			if (mlAbyssAreaCount > 0) return true;
			
			Sound_Stop("AbyssTone", 1.5f);
		}
		return true;
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 9 Event B *Jump into the abyss. (dialog)*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool CollisionAbyssFall(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (SequenceStates_IsActive("SequenceAbyssFall") || alState == -1) return true;
		
		cLux_AddDebugMessage("BeginFall " + alState + " " + asChild);
		
		mlFallAreaIndex = cString_ToInt(cString_GetLastChar(asChild), 1);
		SequenceAbyssFall("");
		
		return true;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mAbyssFallSequence;
		
	void SequenceAbyssFall(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAbyssFall", mAbyssFallSequence);
	
		// Silence everything except dark tone
		if (Sequence_DoStepAndWait(6.f))
		{
			//Stop Music
			mbAmbientMusicPlaying = false;
			Music_Stop(3.0, eMusicPrio_BgAmb);
			Music_Stop(3.0, eMusicPrio_BigEvent);
			
			//Fade out level audio
			Sound_FadeGlobalVolume(0.0f ,3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.0f ,3.0f, eSoundEntryType_WorldClean);
			
			//Create Falling Sound
			Sound_CreateAtEntity("AbyssFall", "Player/action/underwater/abyss_fall", "Player", 0.0f, false, 1.0f);
			Prop_MoveLinearTo("AbyssWall_1", "AbyssFallLoopTrigger_1", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_2", "AbyssFallLoopTrigger_1", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_3", "AbyssFallLoopTrigger_1", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_4", "AbyssFallLoopTrigger_2", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_5", "AbyssFallLoopTrigger_2", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_6", "AbyssFallLoopTrigger_2", 100, 20, 0, true);
			
			Effect_Fade_Out(1.f);
		}
		
		if (mbStopKateFollowing)
		{
			AbyssFallCrushed();
		}
		else
		{
			AbyssFallRescued();
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////
	// No Kate to save player
	void AbyssFallCrushed()
	{
		/////////////////////
		// Start falling
		if (Sequence_DoStepAndWait(2.f))
		{
			Effect_Fade_In(1.f);
			Player_SetMoveSpeedMul(0);
			Player_Teleport("abyss_fall_loop", false);
			Map_SetEnvironmentParticleGravityVelocity(cVector3f_Up * 20);
			
			Effect_Shake_Start(0.2, 2, 12, 0);
			
			//Breathing
			Sound_CreateAtEntity("HeavyBreathing", "Player/breaths/abyss/breathing", "Player", 0.0f, false, 1.0f);
		}
		
	
		else if (Sequence_DoStepAndWait(4.75f))
		{
			//Trigger Suit Pressure Alarm
			Sound_CreateAtEntity("PressureAlarmMediumSpeed", "Player/UI/Suit/pressure_alarm_medium", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(1.f))
		{
			//Stop Medium Alarm and Trigger Fast Alarm
			Sound_Stop("PressureAlarmMediumSpeed", 0.0f);
			Sound_CreateAtEntity("PressureAlarmHighSpeed", "Player/UI/Suit/pressure_alarm_high", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(2.5f))
		{
			//Trigger Suit Cracking Under Pressure
			Sound_CreateAtEntity("SuitCracking", "Player/action/underwater/abyss_suit_crack", "player", 0.0f, false);
		}
				
		else if (Sequence_DoStepAndWait(7.5f))
		{
			//Stop all sounds apart from the big finale, quick fade to black
			Sound_Stop("AbyssFall", 0.0f);
			Sound_Stop("PressureAlarmHighSpeed", 0.0f);
			
			//Suit Crack Open
			Sound_CreateAtEntity("SuitCrackOpen", "Player/action/underwater/abyss_suit_end", "player", 0.0f, false);
			Effect_Fade_Out(0.1f);
		}
		
		// Return things to normal
		else if (Sequence_DoStepAndWait(2.f))
		{
			Player_Teleport("abyss_fall_" + mlFallAreaIndex);
			Voice_Stop("9_NearEdge");
			// Setup and start camera animation
			CameraAnimationNode_SetAutoMove("AbyssWakueUpAnim_" + mlFallAreaIndex + "_1", 0);
			CameraAnimation_Begin("AbyssWakueUpAnim_" + mlFallAreaIndex, "", true);
						
			Effect_Fade_In(2.0f);
			
			//Fade audio back in 			
			Sound_FadeGlobalVolume(1, 4.5);
			Player_SetMoveSpeedMul(0);
			Player_FadeMoveSpeedMulTo(1, 5.f);
			Player_SetActive(false);
			Map_SetEnvironmentParticleGravityVelocity(cVector3f_Zero);
			Prop_StopMovement("AbyssWall_*");
			//Sound_Stop("AbyssFallTone", 4.f);
			
			///////////////////////
			//Check if Zeppelin has arrived - if so, do not resume ambient music
			if (mbZeppelinArrived==false)
			{
				Map_AddTimer("StartAmbient", cMath_RandRectf(5.f,8.f),"AmbientMusicHandler");
				cLux_AddDebugMessage("Zeppelin not arrived - triggering music");
				return;
			}

			if (mbZeppelinArrived==true)
			{
				cLux_AddDebugMessage("Zeppelin arrived - not triggering music");
				return;
			}
			
			Effect_ImageTrail_Start(1.5, 0, 0.5f, 10.0f);
	
		}
		else if (Sequence_DoStepAndWait(2.0))
		{
			CameraAnimationNode_SetAutoMove("AbyssWakueUpAnim_" + mlFallAreaIndex + "_1", 0.5f);
			Sound_CreateAtEntity("AbyssRiseVO", "Player/camera_anim/underwater/abyss_recover/vo", "Player", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("AbyssRiseFoley", "Player/camera_anim/underwater/abyss_recover/foley", "Player", 0.0f, false, 1.0f);
			Voice_Stop("9_NearEdge");
		}
		
		else if (Sequence_DoStepAndWait(0))
		{
			Player_SetActive(true);
		}
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////
	// Kate saves player
	void AbyssFallRescued()
	{
		//////////////////////////////////////////
		// Play sound of Kate rescuing player
		if (Sequence_DoStepAndWait(3.f))
		{
			Sound_Fade("AbyssFallTone", 0.65f, 5.0f);
			Sound_Fade("AbyssFall", 0.65f, 5.0f);
			Sound_CreateAtEntity("KateSavesPlayer", "02_03_delta/SFX/special/abyss/kate_save_player", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(13.5f))
		{
			Sound_Stop("AbyssFallTone", 3.25f);
			Sound_Stop("AbyssFall", 3.25f);
		}
		
		////////////////////////////////
		// Return things to normal
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Player_Teleport("abyss_fall_" + mlFallAreaIndex);
			Voice_Stop("9_NearEdge");

			
			Effect_Fade_In(6.0f);
			Player_SetMoveSpeedMul(0);
			Player_FadeMoveSpeedMulTo(1, 8.f);
			
			Map_SetEnvironmentParticleGravityVelocity(cVector3f_Zero);
			Prop_StopMovement("AbyssWall_*");
			
			Effect_ImageTrail_Start(1.5, 0, 0.5f, 25.0f);

			//Bring Sound back up
			Sound_FadeGlobalVolume(1, 6);
	
			/////////////////
			// Place Kate
			Entity_PlaceAtEntity("Kate", "KateAbyssRescuePos_" + mlFallAreaIndex);
			Agent_FaceEntity("Kate", "AbyssWakueUpAnim_" + mlFallAreaIndex + "_1");
			
			///////////////////////
			//Check if Zeppelin has arrived - if so, do not resume ambient music
			if (mbZeppelinArrived==false)
			{
				Map_AddTimer("StartAmbient", cMath_RandRectf(5.f,8.f), "AmbientMusicHandler");
				cLux_AddDebugMessage("Zeppelin not arrived - triggering music");
			}

			if (mbZeppelinTerminalActive==true)
			{
				cLux_AddDebugMessage("Zeppelin arrived - not triggering music");
			}
		}
		else if (Sequence_DoStepAndWait(6.f))
		{
			// Setup and start camera animation
			CameraAnimationNode_SetAutoMove("AbyssWakueUpAnim_" + mlFallAreaIndex + "_1", 0.5f);
			CameraAnimation_Begin("AbyssWakueUpAnim_" + mlFallAreaIndex, "", true);
			Voice_Stop("9_NearEdge");
			Sound_CreateAtEntity("AbyssRiseVO", "Player/camera_anim/underwater/abyss_recover/vo", "Player", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("AbyssRiseFoley", "Player/camera_anim/underwater/abyss_recover/foley", "Player", 0.0f, false, 1.0f);
			
		}
		else if (Sequence_DoStepAndWait(3))
		{
			if (mlRescuedByKateCount < 3)
			{
				Voice_Play("9_KateHelpedPlayer", mlRescuedByKateCount, "");
				mlRescuedByKateCount++;
			}
		}
		
		else if (Sequence_DoStepAndWait(0))
		{
			if (mlRescuedByKateCount < 3)
			{
				Sound_CreateAtEntity("KateIdle", "NPC_Kate/talk/katebot_idle_talk", "Kate", 0, false);
			}
			CameraAnimationNode_SetAutoMove("AbyssWakueUpAnim_" + mlFallAreaIndex + "_1", 0.5f);
		}
	}
	
	//-------------------------------------------------------
	
	bool LoopAbyssFall(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lTrigger = cString_GetNumericSuffixInt(asParent);
		Entity_PlaceAtEntity(asChild, "AbyssWallSpawnArea_" + lTrigger);
		
		return true;
	}
 
    //-------------------------------------------------------
	
	/////////////////////////////////////////////////////////////////
	// Make sure player doesn't stop falling on top of a pipe
	bool CollisionAbyssPipes(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			Player_SetMoveSpeedMul(0.3);
			Map_AddTimer(asChild, 0.05, "TimerAbyssPipePush");
		}
		else
		{
			Player_SetMoveSpeedMul(1);
			Map_RemoveTimer(asChild);
		}
		return true;
	}
 
    //-------------------------------------------------------
	
	void TimerAbyssPipePush(const tString &in asTimer)
	{
		/////////////////////////////////////////////////////////////////////////////////
		// Get forward vector of entity, would be good to do this in a simpler way
		cVector3f vTargetVelocity = cMath_MatrixInverse(Map_GetEntity(asTimer).GetMatrix()).GetForward();
		
		////////////////////////////////////////////////////////////
		// Make sure player is pushed away from middle of pipe
		if (Entity_PlayerIsInFront(asTimer) == false) vTargetVelocity = vTargetVelocity*-1;
		
		vTargetVelocity = vTargetVelocity*6.5;
		cVector3f vCurrentVelocity = Player_GetVelocity();
		vCurrentVelocity.y = 0; //Ignore fall speed
		
		cVector3f vPushDir = vTargetVelocity-vCurrentVelocity;
		cLux_AddDebugMessage("vPushDir " + vPushDir);
		//vPushDir = vPushDir + cVector3f_Up*0.5; // Push from ground to avoid friction
		
		Player_AddBodyForce(vPushDir*2000, false);
		Map_AddTimer(asTimer, 0.05, "TimerAbyssPipePush");
	}
 
