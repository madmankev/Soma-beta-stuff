    //-------------------------------------------------------
	
	void KateWeldSequence_Start(const tString &in asDoor)
	{
		if (Sequence_DoStepAndWait(0.75))
		{
			Map_RemoveTimer("KateFollowPlayerTimer");
		}
		if (Sequence_DoStepAndPause(0))
		{
			Sound_CreateAtEntity("KateWelding", "NPC_Kate/tool/torch", asDoor+"_WeldingFlare", 0.0, true);
			Entity_SetActive(asDoor+"_WeldingFlare", true);
			Entity_SetEffectsActive(asDoor+"_WeldingFlare", true, true);
			LensFlare_SetVisible(asDoor+"_WeldingFlare_LensFlare_*", true);
			Entity_AttachToEntity("Kate", asDoor+"_WeldingFlare", "", false);
			Prop_MoveLinearTo(asDoor+"_WeldingFlare", asDoor+"_WeldTarget_1", 2, 0.15, 0.1, true);
			Kate_LookAt("Kate", asDoor+"_WeldingFlare");
			
			CharMover_SetUseMoveStateAnimations("Kate", false);
			Entity_PlayAnimation("Kate", "welding", 0.1, true);
		}
		for (int i = 2; Entity_Exists(asDoor+"_WeldTarget_"+i); i++)
		{
			if (!Sequence_DoStepAndPause(0)) continue;
			
			Prop_MoveLinearTo(asDoor+"_WeldingFlare", asDoor+"_WeldTarget_"+i, 10, 0.15, 0.1, true);
			Kate_LookAt("Kate", asDoor+"_WeldingFlare");
		}
		if (Sequence_DoStepAndWait(0.25))
		{
			Entity_RemoveEntityAttachment("Kate");
			CharMover_SetDirection("Kate", eLuxCharMoveDirection_Backward);
			Pathfinder_MoveToNode("Kate", asDoor+"_WeldingDonePos", "");
			
			Sound_Stop("KateWelding", 0);
			Entity_SetEffectsActive(asDoor+"_WeldingFlare", false, true);
			LensFlare_SetVisible(asDoor+"_WeldingFlare_LensFlare_*", false);
			
			Entity_StopAnimation("Kate");
			CharMover_SetUseMoveStateAnimations("Kate", true);
		}
	}
 
    //-------------------------------------------------------
	
	void KateWeldSequence_End(const tString &in asDoor)
	{
		if (Sequence_DoStepAndWait(0.75f))
		{
			Entity_SetActive(asDoor+"_KateBlocker", true);
			CharMover_SetDirection("Kate", eLuxCharMoveDirection_Forward);
			CharMover_TurnToEntity("Kate", "Player");
			
			Voice_Play("3_KateOpenedDoor");
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Kate_FollowPlayer("Kate");
			Entity_SetActive("KateKillzone", true);
			Entity_SetActive("GoyaKillzone", true);
		}
	}
 
	//-------------------------------------------------------
	
	bool CollisionPlayerEnteredLaunchBunker(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		bool bEntered = Entity_PlayerIsInFront(asChild);
		
		BarkMachine_SetActive("Goya", !bEntered);
		
		if (bEntered && !mbStopKateFollowing)
		{
			Kate_AddInvestigateTarget("Kate", "BunkerInvestigationNode_1", "KateBunkerInvestigationArea_1");
			Kate_AddInvestigateTarget("Kate", "BunkerInvestigationNode_2", "KateBunkerInvestigationArea_2");
			Kate_AddInvestigateTarget("Kate", "BunkerInvestigationNode_3", "KateBunkerInvestigationArea_3");
			Kate_InvestigateMultiple("Kate");
		}
		else if (!mbStopKateFollowing)
		{
			Kate_FollowPlayer("Kate");
		}
		
		return true;
	}
 
