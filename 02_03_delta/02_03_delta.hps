    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 10 Event *Airlock*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool mbAirlockFull = true;
 
    //-------------------------------------------------------
	
	void OnChangeAkerDoorPanel(const tString &in asEntity, int alState)
	{
		SetAkersDoorOpen(alState==1);
		
		if (alState == 1 && Map_TimeHasPassed("AkerAutoSave", 60)) Game_AutoSave();
	}
 
    //-------------------------------------------------------
	
	void SetAkersDoorOpen(bool abOpen)
	{
		//////////////////////////////////////////////////////////////////////
		// Make sure state is set even when function is called from script
		Button_SetSwitchedOn("AkersBuildingOuterPanel_Outside", abOpen, false);
		
		Map_RemoveTimer("PushAirlockDoor");
		Entity_SetInteractionDisabled("AkersSwingDoor", true);
		if (abOpen)
		{
			SwingDoor_SetLocked("AkersSwingDoor", false, true);
			SwingDoor_SetClosed("AkersSwingDoor", false, true);
			SwingDoor_SetDisableAutoClose("AkersSwingDoor", true);
			TimerPushAirlockDoorOpen("");
		}
		else
		{
			TimerPushAirlockDoorClosed("");
		}
	}
 
    //-------------------------------------------------------
	
	void TimerPushAirlockDoorOpen(const tString &in asTimer)
	{
		if (SwingDoor_GetState("AkersSwingDoor")==1) 
		{
			Entity_SetInteractionDisabled("AkersSwingDoor", false);
			return;
		}
		
		Entity_AddForce("AkersSwingDoor", cVector3f_Back*125, true, true);
		Map_AddTimer("PushAirlockDoor", 0.1, "TimerPushAirlockDoorOpen");
	}
 
    //-------------------------------------------------------
	
	void TimerPushAirlockDoorClosed(const tString &in asTimer)
	{
		if (SwingDoor_GetState("AkersSwingDoor")==-1) 
		{
			Entity_SetInteractionDisabled("AkersSwingDoor", false);
			SwingDoor_SetLocked("AkersSwingDoor", true, true);
			
			if (SequenceStates_IsActive("SequenceAirlockEmpty"))
				SequenceStates_Resume("SequenceAirlockEmpty");
			
			return;
		}
		
		Entity_AddForce("AkersSwingDoor", cVector3f_Forward*125, true, true);
		Map_AddTimer("PushAirlockDoor", 0.1, "TimerPushAirlockDoorClosed");
	}
 
    //-------------------------------------------------------
	
	void OnChangeActivateAirlock(const tString &in asEntity, int alState)
	{
		Entity_SetInteractionDisabled(asEntity, true);
		if (mbAirlockFull) SequenceAirlockEmpty("");
		else 			  SequenceAirlockFill("");
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockEmptySequence;
		
	void SequenceAirlockEmpty(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAirlockEmpty", mAirlockEmptySequence);
			
		if (Sequence_DoStepAndPause(0))
		{
			SetAkersDoorOpen(false);
		}
		else if (Sequence_DoStepAndWait(9))
		{
			if (!Entity_GetCollide("Player", "AkersBuildingLiquidArea_Up"))
			{
				Entity_SetInteractionDisabled("AirlockActivateButton", false);
				Sequence_Stop();
				return;
			}
			mbAirlockFull = false;
			Entity_SetActive("AkersBuildingLiquidArea", true);
			LiquidArea_MoveLinearTo("AkersBuildingLiquidArea","AkersBuildingLiquidArea_Down",0.1, 1, 0.5, false);
			cLux_AddDebugMessage("SequenceAirlockEmpty");
			Map_SetUnderwater(false,false);
			
			///////////////////////////////////////
			//Turn on Akers Bunker Soundscape Area and turn off scuba sounds
			Entity_SetActive("AMB_BunkInt_1", true);
			Entity_SetActive("AMB_Airlock_Air_1", true);
			
			Entity_SetActive("AMB_Airlock_Water_1", false);
			Entity_SetActive("AMB_Global", false);
			
			//Map_SetEnvironmentParticleGravityVelocity()
			
			Entity_SetActive("AkersBunkerOccluder_*", false);
			FogArea_SetVisible("AkersBunkerFog_*", false);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			OnChangeDoorButton("AkersBuildingInnerPanel_Inside", 1);
			Button_SetSwitchedOn("AkersBuildingInnerPanel_Inside", true, false);
		}
		else
		{
			Entity_SetInteractionDisabled("AirlockActivateButton", false);
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockFillSequence;
		
	void SequenceAirlockFill(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAirlockFill", mAirlockFillSequence);
			
		if (Sequence_DoStepAndPause(0.5))
		{
			OnChangeDoorButton("AkersBuildingInnerPanel_Inside", -1);
			Button_SetSwitchedOn("AkersBuildingInnerPanel_Inside", false, false);
			
			if (Entity_GetCollide("AkersBuildingInnerDoor", "AirlockInnerDoorClosedTrigger"))
			{
				SequenceStates_Resume("SequenceAirlockFill");
			}
		}
		else if (Sequence_DoStepAndWait(9))
		{
			if (!Entity_GetCollide("Player", "AkersBuildingLiquidArea_Up"))
			{
				Entity_SetInteractionDisabled("AirlockActivateButton", false);
				Sequence_Stop();
				return;
			}
			mbAirlockFull = true;
			LiquidArea_MoveLinearTo("AkersBuildingLiquidArea","AkersBuildingLiquidArea_Up",0.1, 1, 0.5, false);
			//Map_SetEnvironmentParticleGravityVelocity()
			
			Entity_SetActive("AkersBunkerOccluder_*", true);
			FogArea_SetVisible("AkersBunkerFog_*", true);
		}
		else
		{
			Entity_SetActive("AkersBuildingLiquidArea", false);
			cLux_AddDebugMessage("SequenceAirlockFill");
			Map_SetUnderwater(true,false);
			
			///////////////////////////////////////
			//Turn off Akers Bunker and airlock dry soundarea, turn on Airlock water soundarea and turn on suit sounds
			Entity_SetActive("AMB_BunkInt_1", false);
			Entity_SetActive("AMB_Airlock_Air_1", false);
			
			Entity_SetActive("AMB_Global", true);
			Entity_SetActive("AMB_Airlock_Water_1", true);
			
			SetAkersDoorOpen(true);
			Entity_SetInteractionDisabled("AirlockActivateButton", false);
		}
		
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	bool CollisionAirlockInnerDoorClosed(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && SequenceStates_IsActive("SequenceAirlockFill"))
			SequenceStates_Resume("SequenceAirlockFill");
			
		return true;
	}
 
    //-------------------------------------------------------
	
	bool CollisionAirlockSurface(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_SetEnvironmentParticlesActive(alState==-1);
		return true;
	}
 
    //-------------------------------------------------------
	
	bool CollisionPlayerEnteredAkersBunker(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		bool bEntered = Entity_PlayerIsInFront(asChild);
		
		BarkMachine_SetActive("Goya", !bEntered);
		
		if (bEntered && !mbStopKateFollowing)
		{
			Kate_Investigate("Kate", "AkerAntennaInvestigationNode", "AntennaTerminal_Peripheral1", -1);
		}
		else if (!mbStopKateFollowing)
		{
			Kate_FollowPlayer("Kate");
		}
		
		return true;
	}
 
