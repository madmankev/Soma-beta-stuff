    //-------------------------------------------------------
	
	cSequenceStatesData mRelayFlowerDrainedSequence;
		
	void Seq_RelayFlowerDrained(const tString &in asTimer)
	{
		Sequence_Begin("Seq_RelayFlowerDrained", mRelayFlowerDrainedSequence);
			
		if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetConnectionStateChangeCallback("RelayStationLeverFixed", "");
		}
		else if (Sequence_DoStepAndWait(0.75))
		{
			ParticleSystem_SetActive("RelayComputerBubbleParticles_*", true);
			ParticleSystem_SetActive("RelayComputerSparkParticle_*", true);
			
			Light_SetVisible("RelayComputerSparkLight", true);
			
			Sound_CreateAtEntity("BrokenLeverBubbles", "02_03_delta/SFX/broken_lever/broken_lever_sparks", "RelayStationComputer", 0, false);
			
			Terminal_SetGuiActive("RelayStationComputer", false, 1);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			ParticleSystem_Destroy("RelayComputerSparkParticle_*");
			Light_SetVisible("RelayComputerSparkLight", false);
		}
		Sequence_End();
	}
 
	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// SCENE 1 *INSIDE ESCAPE POD; CRASH*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlEscapePodMoveShakeID;
	bool mbPlayerStoodUp = false;

	//-------------------------------------------------------
	
	void SetupSceneEscapePod()
	{
		CameraAnimation_Begin("EscapePodRideAnim", "", true);
		
		Map_SetUnderwater(false);
		Map_SetEnvironmentParticlesActive(false);
		cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(false);
		
		Entity_SetVarBool("MapDisplay", "Error", false);
		Entity_SetVarBool("StatusDisplay", "Error", false);
		
		Sound_CreateAtEntity("EscapePodEngine", "02_03_delta/SFX/transport/transport_moving", "PodSoundSource", 0, true);
		
		Voice_SetSource("Catherine", "cath_box_2", 2, 20, true, 20);
		
		Effect_Fade_Out(0);
	}
	
    //-------------------------------------------------------
	
	bool StandUpSound(const tString &in asEntity, int alDirection)
	{
		if (asEntity == "EscapePodRideAnim_1" && alDirection == 1)
		{
			cLux_AddDebugMessage("Stand Up Animation Sound Start");
			Sound_CreateAtEntity("StandUpAnimation", "02_03_delta/SFX/pod_crash/simon_stand_in_pod", "Player", 0.0f, false, 1.0f);
			return true;
		}
		
		else if (asEntity == "EscapePodRideAnim_1" && alDirection == -1)
		{
			cLux_AddDebugMessage("Stand Up Animation Sound Stop");
			Sound_Stop("StandUpAnimation", 0.5f);
			return true;
		}
		return true;
	}

    //-------------------------------------------------------
	
	bool AnimationStandingRide(const tString &in asEntity, int alDirection)
	{
		mbPlayerStoodUp = true;
		return true;
	}
	
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 1 Event A *Level starts. Catherine explains mission*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	cSequenceStatesData mIntroSequence;
		
	void SequenceIntro(const tString &in asTimer)
	{
		Sequence_Begin("SequenceIntro", mIntroSequence);
			
		if (Sequence_DoStepAndWait(4))
		{			
			Player_Teleport("escape_pod_functional");
			Effect_Fade_In(5);
			mlEscapePodMoveShakeID = Effect_Shake_Start(0.0015, -1, 0, 0, cVector3f_One, 20);
			
			Lamp_SetupFlicker("EscapePodLamp_3", 0.05, 1.0, 0.025, 0.15);
			Lamp_SetFlickerActive("EscapePodLamp_3", true);
			Entity_SetActive("Trigger_MusicBunker_*", true);
		}
		else if (Sequence_DoStepAndWait(3))
		{
			Dialog_Begin();
				Dialog_AddBranch("1_Intro");
					Dialog_AddSubject("1_Intro", "SubjectEscapePodDialog");
			Dialog_End();
		}
		Sequence_End();
	}
 
	//-------------------------------------------------------
	
	void SubjectEscapePodDialog(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		SequenceCurieBoomAndCrash("");
	}
	
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 1 Event B *Status screens*
    /////////////////////////////////////////

	//-------------------------------------------------------
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 1 Event C *Boom is heard; Pod has major failure & crash (dialog)*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	cSequenceStatesData mCurieBoomAndCrashSequence;
	void SequenceCurieBoomAndCrash(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCurieBoomAndCrash", mCurieBoomAndCrashSequence);
			
		if (Sequence_DoStepAndWait(2))
		{
			////////////////
			//Wave approach and impact sound all go here, for memory saving and ease of tweaking
			Sound_CreateAtEntity("DistantExplosion", "02_03_delta/SFX/pod_crash/distant_explosion", "Player", 0, false);
			Sound_CreateAtEntity("HitandShake", "02_03_delta/SFX/pod_crash/wavehit_descent", "Player", 0, false);
			
		}
		else if (Sequence_DoStepAndWait(4.75))
		{
			Voice_Play("1_AfterExplosion");
		}
		else if (Sequence_DoStepAndWait(1.1))
		{
			CameraAnimationNode_SetInteractiveMovement("EscapePodRideAnim_*", false);
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			
			Effect_Shake_Start(0.03, 1, 0.1, 2);
			if (mbPlayerStoodUp)
			{
				CameraAnimation_Begin("ShockwaveStandAnim", "", false);
			}
			else
			{
				CameraAnimation_End();
				CameraAnimation_Begin("CrashSittingAnim", "", false);
			}
			
			Voice_Stop("1_AfterExplosion");
			Lamp_SetupFlicker("EscapePodLamp_*", 0.1, 0.3, 0.05, 0.3);
			Lamp_SetFlickerActive("EscapePodLamp_*", true);
			Prop_SetStaticPhysics("FireExtinguisher", false);
			Entity_AddImpulse("FireExtinguisher", cVector3f(0.5, 1, 1.2), true, true);
			Map_AddTimer("FireExtinguisherMovementTimer", cMath_RandRectf(0.1, 0.3), "TimerFireExtinguisherMovement");
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetVarBool("StatusDisplay", "Error", true);
			
			///////////////////////////////////
			///Stop Engine Sound
			Sound_Stop("EscapePodEngine", 0.0f);
			
			Effect_Shake_FadeOut(mlEscapePodMoveShakeID, 7);
			mlEscapePodMoveShakeID = Effect_Shake_Start(0.03, -1, 7, 0, cVector3f_One, 40);
			
			
			Voice_Play("1_AfterBeingHit", -1, "SubjectPodCrashDialog", 1);
		}
		else if (Sequence_DoStepAndPause(0))
		{
			Lamp_SetLit("EscapePodLED_10", false, false);
			Lamp_SetFlickerActive("EscapePodLED_3", true);
			Lamp_SetupFlicker("EscapePodLamp_*", 0.05, 1, 0.025, 0.15);
			Entity_SetVarBool("MapDisplay", "Error", true);
			
		}
		else if (Sequence_DoStepAndWait(0.0))
		{
			
			Terminal_SetGuiActive("StatusDisplay", false);
			Terminal_SetGuiActive("MapDisplay", false);
			Effect_Shake_Start(0.03, 1, 0.1, 2);
			CameraAnimationNode_SetAutoMove("CrashSittingAnim_4", 1.f);
			CameraAnimationNode_SetInteractiveMovement("ShockwaveStandAnim_*", false);
			Map_RemoveTimer("FireExtinguisherMovementTimer");
			
			Voice_Stop("1_AfterExplosion");
			
			Entity_SetActive("AMB_StaticTransporter", false);
			Effect_Fade_Out(0.0);
			
			///////////////////////////////////////////////////
			//// Play impact sound, fade out world and worldclean audio, trigger wake up sound timer			
			Sound_CreateAtEntity("HitGround", "02_03_delta/SFX/pod_crash/ground_hit", "Player", 0.0f, false, 1.0f);
			Map_AddTimer("WakeUpSound", 15.0f, "WakeUpDreamSound");
			Sound_FadeGlobalVolume(0.0f, 0.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.0f, 0.0f, eSoundEntryType_WorldClean);


		}
		else if (Sequence_DoStepAndWait(21))
		{
			Effect_Fade_Out(0.2);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Effect_Shake_FadeOut(mlEscapePodMoveShakeID, 0);
			CameraAnimation_End();
			Player_Teleport("crash_site");
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldClean);
			StartSceneAwakenRobotRelay();
		}
		Sequence_End();
	}
 
	//-------------------------------------------------------
	void SubjectPodCrashDialog(const tString&in asScene, const tString&in asSubject)
	{
		SequenceStates_Resume("SequenceCurieBoomAndCrash");
	}
 
	//-------------------------------------------------------
	
	void TimerFireExtinguisherMovement(const tString &in asTimer)
	{
		Entity_AddImpulse("FireExtinguisher", cMath_RandRectVector3f(cVector3f(-0.2, 0.3, 0.5), cVector3f(0.2, 0.5, 1)), false, true);
		Map_AddTimer("FireExtinguisherMovementTimer", cMath_RandRectf(0.1, 0.3), "TimerFireExtinguisherMovement");
	}
 
	//-------------------------------------------------------
	
	void LineOver_StopRiseSound(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
	{
		if (abStart)
			return;
		Sound_Stop("HitandShake", 0.0);
	}

	/////////////////////////////////////////
	// ==============
	// SCENE 2 *AWAKEN, MEET ROBOT AND FIND RELAY STATION*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbAllowKateWelding = false;

	//-------------------------------------------------------
	
	void SetupSceneAwakenRobotRelay()
	{		
		////////////////////
		// Escape pod
		Entity_SetEffectsActive("WeldingFlare", false, false);
		LensFlare_SetVisible("WeldingFlare_LensFlare_*", false);
		
		//////////////////////////
		// Relay station general
		Entity_SetInteractionDisabled("RelayStationHatch", true);
		Entity_SetInteractionDisabled("RelayStationComputer", true);
		Terminal_SetGuiActive("RelayStationComputer", false);
		
		////////////////////
		// Broken Lever
		ParticleSystem_SetActive("RelayStationBrokenLever_Bubbles", false);
		ParticleSystem_SetActive("RelayStationBrokenLever_Sparks_*", false);
		Light_SetVisible("RelayStationBrokenLever_Light", false);
		
		////////////////////
		// Wau flower
		ParticleSystem_SetActive("RelayComputerSparkParticle_*", false);
		ParticleSystem_SetActive("RelayComputerBubbleParticles_*", false);
		Light_SetVisible("RelayComputerSparkLight", false);
		
		//////////////////////////
		// Relay door starts open
		Entity_SetInteractionDisabled("RelayStationHatchWheel", true);
		Entity_SetInteractionDisabled("RelayStationHatch", true);
		SwingDoor_SetDisableAutoClose("RelayStationHatch", true);
		SwingDoor_SetLocked("RelayStationHatch", false, true);
		SwingDoor_SetClosed("RelayStationHatch", false, true);
		
		Prop_SetStaticPhysics("RelayStationLadder", false);
		
	}
 
    //-------------------------------------------------------
	
	void WakeUpDreamSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("WakeUpSequence", "02_03_delta/SFX/pod_crash/wakeup", "Player", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("CathBeep", "02_03_delta/SFX/pod_crash/cath_beep", "BeepSoundSource", 0.0f, false, 1.0f);
		cLux_AddDebugMessage("Wake up sound triggered");
	}
	
	//-------------------------------------------------------
	
	void StartSceneAwakenRobotRelay(bool abStartInPod = true)
	{
		///////////////////////////
		// Underwater settings
		cLux_AddDebugMessage("StartSceneAwakenRobotRelay");
		Map_SetUnderwater(true);
		Map_SetEnvironmentParticlesActive(true);
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		
		float fFadeTime = 0.0;
		Effect_Bloom_FadeBrightPass(0.00001, fFadeTime); //sets pixels over 127 (255 * 0.5) to add to bloom
		Effect_Bloom_FadeBloomWidth(160, fFadeTime); //sets 128 pixels in bloom width, looks best within 32 - 512 pixels.
		Effect_Bloom_FadeBloomTint(0.3, 0.3, 0.3, fFadeTime); //sets red tint to bloom
		
		Effect_DoF_Start(0, 12, 1.0f, 3);
		
		cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(true);
		
		//////////////////
		// Other stuff
		Lamp_SetLit("CrashedPodLamp_*", false, false);
		
		Entity_AttachToEntity("KateKillzone", "Kate", "", false);
		Entity_AttachToEntity("GoyaKillzone", "Goya", "", false);
		if (abStartInPod)
		{ 
			SequenceCrashedPodWakeUp("");
		}
		else 
		{
			Kate_FollowPlayer("Kate");
		}
	}
 
