	bool CollisionAntennaProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbStopKateFollowing) return false;
		if (alState == 1)
		{
			tString sLocation = Entity_GetVarString(asChild, "");
			Kate_Investigate("Kate", "AntennaLookNode_" + sLocation, "AntennaTerminal_" + sLocation, -1);
		}
		else
