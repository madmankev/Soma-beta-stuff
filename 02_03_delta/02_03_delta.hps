    //-------------------------------------------------------
	
	cSequenceStatesData mInsertCatherineChipSequence;
		
	void SequenceInsertCatherineChip(const tString &in asTimer)
	{
		Sequence_Begin("SequenceInsertCatherineChip", mInsertCatherineChipSequence);
			
		if (Sequence_DoStepAndWait(0.5))
		{			
			Player_FadeMoveSpeedMulTo(0, 0.5);
			Prop_MoveLinearTo("CathChip_Old", "CathChip_New", 1, 0.5, 0, true);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Prop_SetActiveAndFade("CathChip_Old", false, 0.2);
		}
		else if (Sequence_DoStepAndWait(0.3))
		{
			Prop_SetActiveAndFade("CathChip_New", true, 0.2);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Prop_MoveLinearTo("CathChip_New", "CathChip_Target", 1, 0.5, 0, true);
			Sound_CreateAtEntity("CathChipInserted", "02_03_delta/SFX/voice_chip_insert", "ZeppelinCathTerminal", 0, false);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Voice_StopAll();
			
			Dialog_StartConversation("Catherine", "CathTool");
			Dialog_Begin();
				Dialog_AddBranch("8_FixCatherine");
					Dialog_AddSubject("8_FixCatherine_Start");
					if (msKilledRobot == "Kate")
						Dialog_AddSubject("8_FixCatherine_Kate");
					else
						Dialog_AddSubject("8_FixCatherine_DelusionalRobot");
					Dialog_AddSubject("8_FixCatherine_End", "Subject_CatherineFixed");
			Dialog_End();
			
			
			Player_FadeMoveSpeedMulTo(1, 0.5);
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	void Subject_CatherineFixed(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		Lamp_SetLit("LiftoffLever_Lamp", true, true);
		Entity_SetEffectBaseColor("LiftoffLever_Lamp", cColor_Red);
		Lever_SetStuckState("LiftoffLever", 0, true);
		Lamp_SetLit("LiftoffButton_Lamp", true, true);
		Entity_SetEffectBaseColor("LiftoffButton_Lamp", cColor_Red);
		Entity_SetInteractionDisabled("LiftoffButton", false);
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 8 Event E *Start Zeppelin (dialog)*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	int mlLiftoffControlsUsed = 0;
 
    //-------------------------------------------------------
	
	void OnChangeLiftoffControls(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		mlLiftoffControlsUsed++;

		Entity_FadeEffectBaseColor(asEntity+"_Lamp", cColor_Green, 0.5);
		
		if (mlLiftoffControlsUsed == 1)
		{
			Prop_SetStaticPhysics("ZeppelinPlatformRailing_*", false);
			Lever_SetAutoMoveEnabled("ZeppelinPlatformRailing_*", true);
			Lever_SetAutoMoveTarget("ZeppelinPlatformRailing_*", -1);
			Entity_SetConnectionStateChangeCallback("ZeppelinPlatformRailing_*", "OnChangeZeppelinRailingUp");
			Sound_CreateAtEntity("ZeppelinRailingsUp", "NPC_Zeppelin/SFX/linear/gates_close_onboard", "ZeppelinPlatformRailing_4", 0.0f, false, 1.0f);
			
			Lever_SetAutoMoveTarget("StunRodLockboxLid", -1);
			Slide_SetLocked("StunRodInnerHatch", true, false);
			
			Entity_SetActive("LiftoffBlocker_*", true);
		}
		else
		{
			SequenceZeppelinLiftoff("");
		}
	}
 
    //-------------------------------------------------------
	
	void LiftOffButtonPressed(const tString &in asEntity)
	{
		Sound_CreateAtEntity("LiftOffButtonPressed", "Entities_OceanBottom/button/plastic_red_push", "LiftoffButton", 0.0f, false, 1.0f);
	}
	
	cSequenceStatesData mZeppelinLiftoffSequence;
		
	void SequenceZeppelinLiftoff(const tString &in asTimer)
	{
		Sequence_Begin("SequenceZeppelinLiftoff", mZeppelinLiftoffSequence);
		
		if (Sequence_DoStepAndWait(2))
		{
			///////////////////////////////////////
			///Trigger lift off sound, end level music, shut off engine idle and add timer for sound fadeout.
			Sound_CreateAtEntity("ZeppelinLiftOff" , "NPC_Zeppelin/SFX/linear/takeoff_sequence", "Player", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("ZeppelinLiftEngineMotion","NPC_Zeppelin/SFX/engine/motion", "Player", 16.0f, false, 1.0f);
			Sound_Stop("ZeppelinIdleEngine", 6.0f);
			Music_Play("02_03_leavinglevel.ogg", 0.7f, false, eMusicPrio_BigEvent);
			Sound_FadeGlobalVolume(0.65f, 9.0f, eSoundEntryType_WorldClean);
			//Map_AddTimer("EndLevelSoundFade", 10.0f, "FadeOutAudio");
			
			Entity_SetEffectsActive("ZeppelinPlatform", true, false);
			
			Voice_StopAll();
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Prop_SetStaticPhysics("LiftoffLever", true); //Bugs out if you fiddle with it otherwise.
			 
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_3", 0.17, 1, 0, true);
			
			Prop_SetStaticPhysics("ZeppelinPlatformRailing_*", true);
			
			Voice_Play("8_ZeppelinLiftoff");
		}
		else if (Sequence_DoStepAndWait(6))
		{
			Prop_RotateToSpeed("ZeppelinPlatform", 0.05, -0.12, false, "");
			//Prop_AlignRotation("ZeppelinPlatform", "ZeppelinTargetPos_3", 0.05, 0.1, 0, true);
		}
		else if (Sequence_DoStepAndWait(18))
		{
			//Prop_AlignRotation("ZeppelinPlatform", "ZeppelinTargetPos_4", 0.05, 0.2, 0, false);
			
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_4", 0.1, 2.7, 0, false);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			PreloadSetPrioNormal();
			
			Prop_RotateToSpeed("ZeppelinPlatform", 0.05, 0, false, "");
			
			Music_Stop(6, eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
		}
		else if (Sequence_DoStepAndWait(8))
		{
			PreloadChangeOfMap();
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_4", 0.03, 1.4, 0, false);
		}
		
		Sequence_End();
	}
 
    //-------------------------------------------------------
 
	void OnChangeZeppelinRailingUp(const tString &in asEntity, int alState)
	{
		if (alState == -1) Prop_SetStaticPhysics(asEntity, true);
	}
 
