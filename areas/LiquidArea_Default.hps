#include "interfaces/LiquidArea_Interface.hps"

#include "helpers/helper_player.hps"
#include "helpers/helper_map.hps"

class cScrLiquidAreaDefault : iScrLiquidArea, iScrLiquidArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		msCameraEnterEffectPreset = apVars.GetVarString("CameraEnterEffectPreset", "");
		msCameraExitEffectPreset = apVars.GetVarString("CameraExitEffectPreset", "");
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// EXIT AND ENTER
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	void OnBodyEnterLiquid(iPhysicsBody @apBody)
	{
	}
	
	void OnBodyExitLiquid(iPhysicsBody @apBody)
	{
	}
	
	//-----------------------------------------------------------------------
	
	void OnCharBodyEnterLiquid(iCharacterBody @apBody)
	{
		if(apBody is cLux_GetPlayer().GetCharacterBody())
		{
			cLux_GetPlayer().AddUsedLiquidArea(GetBase());
		}
	}
	
	void OnCharBodyExitLiquid(iCharacterBody @apBody)
	{
		if(apBody is cLux_GetPlayer().GetCharacterBody())
		{
			cLux_GetPlayer().RemoveUsedLiquidArea(GetBase());
		}
	}
	
	//-----------------------------------------------------------------------
	
	void OnCameraEnter()
	{
		if(msCameraEnterEffectPreset != "")
		{
			Map_Preset_Fade(msCameraEnterEffectPreset, 0.0);
		}
	}

	void OnCameraExit()
	{
		if(msCameraExitEffectPreset != "")
		{
			Map_Preset_Fade(msCameraExitEffectPreset, 0.0);
		}
		
		Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.4f, 0.2f, 0.6f); 
		Effect_Screen_Start("water_drip_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 1, 2, 1);
	}

	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbPlayerIsIn;
	[nosave] tString msCameraEnterEffectPreset;
	[nosave] tString msCameraExitEffectPreset;
	
	//------------------------------------------------------------
		
}	