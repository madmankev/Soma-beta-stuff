			//PathNodeArea_271
			//PathNodeArea_274
			//PathNodeArea_425
			//PathNodeArea_279
			//PathNodeArea_281 // wait here - then go back.. but also activate the remove@distance thing
			
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_409", 3.0f, 5.0f);
