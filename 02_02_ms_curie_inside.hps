	/////////////////////////////////////////////////////////
	
	//--------------------------------------------------------
	
	void OnChangeLadderWheel(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		
		MoveObject_SetStateExt("CrewQuarterLadder", 1.f, 2, 1, 0, false);
		
		//Sound
		Sound_CreateAtEntity("LadderDrop", "02_02_ms_curie_inside/SFX/ladder_drop/ladder_drop", "CrewQuarterLadder");

		Map_AddTimer("CrewQuarterLadderSoundTimer", 4, "TimerAcivateLadderArea");
		
		Map_AddTimer("timer_flesher_ladder",5.0f,"TimerFlesherLadder");
	}

