			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_591");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_593");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_33");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_2");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_187");
