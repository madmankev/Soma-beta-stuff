	void TimerBeginWindowFlesherPatrol(const tString &in asTimer)
	{
		if (mbWindowFlesherPatrolStarted) return;
		
		mbWindowFlesherPatrolStarted = true;
		
		////////////////////////////////////////////////
		// Make flesher walk by the window for build up when player leaves the area
		Pathfinder_Track_Clear("agent_flesher_floor1");
		
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_488");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_564");
