	//------------------------------------------------------
	
	int mlTentaclesDetached = 0;
	tString msRespawnPoint = "post_flesher_spawn";
	
	//------------------------------------------------------
	
	void SetupElectricsTentacles()
	{
		StickyArea_AttachBody("CylinderWauCable_1_Sticky","CylinderWauCable_1_Body_11");
		StickyArea_AttachBody("CylinderWauCable_2_Sticky","CylinderWauCable_2_Body_11");
		StickyArea_AttachBody("CylinderWauCable_3_Sticky","CylinderWauCable_3_Body_11");
		StickyArea_AttachBody("CylinderWauCable_4_Sticky","CylinderWauCable_4_Body_11");
		StickyArea_AttachBody("CylinderWauCable_5_Sticky","CylinderWauCable_5_Body_11");
		StickyArea_AttachBody("CylinderWauCable_6_Sticky","CylinderWauCable_6_Body_11");
		
		ParticleSystem_SetActive("PS_Electric_Squirt_*",false);
	}
	
	//------------------------------------------------------
	
	bool EnterElectricRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		mbFoundPowerRoom = true;
		
		/////////////////////////////////////
		// Attempt Preload 02_03 at this point
		AttemptPreloadHere();
			
		return false;
	}
	
	//------------------------------------------------------
	
	void CylinderWauCable_Sticky_Detach(const tString &in asStickyArea, const tString &in asBodyName)
	{
		
		cLux_AddDebugMessage("STICK AREA : " +asStickyArea);
		
		////////////////////////////////////////////////
		// Which tentacle is being detached? Specify terminal
		int lTerminalNumber = -1;
		
		if (asStickyArea == "CylinderWauCable_1_Sticky")
			lTerminalNumber = 1;
		if (asStickyArea == "CylinderWauCable_2_Sticky")
			lTerminalNumber = 2;
		if (asStickyArea == "CylinderWauCable_3_Sticky")
			lTerminalNumber = 3;
		if (asStickyArea == "CylinderWauCable_4_Sticky")
			lTerminalNumber = 4;
		if (asStickyArea == "CylinderWauCable_5_Sticky")
			lTerminalNumber = 5;
		if (asStickyArea == "CylinderWauCable_6_Sticky")
			lTerminalNumber = 6;
		

		///////////////////////////////////////////////
		// Spray structure gel
		cLux_AddTodoMessage("TODO: DETACH EFFECTS FOR " + lTerminalNumber);
		Map_AddTimer("EffectAreaSquirt_"+lTerminalNumber,0.1f,"TimerGeneratorOil");
		ParticleSystem_CreateAtEntity("ps_oil_splash_"+lTerminalNumber,"oil_splash_small_oneshot.ps","EffectAreaSquirt_"+lTerminalNumber,true);
		
		
		// Sound at spark area
		Sound_CreateAtEntity("Unplug_"+lTerminalNumber, "02_02_ms_curie_inside/SFX/wau_boiler/unplug", "EffectAreaSquirt_"+lTerminalNumber);
		Sound_Stop("wau_boiler_"+lTerminalNumber, 0.25f);
		
		Map_AddTimer("EffectAreaSparks_A_"+lTerminalNumber,cMath_RandRectf(1.0f,2.0f),"TimerGeneratorSparks");
		Map_AddTimer("EffectAreaSparks_B_"+lTerminalNumber,cMath_RandRectf(2.0f,3.0f),"TimerGeneratorSparks");
		Map_AddTimer("EffectAreaSparks_C_"+lTerminalNumber,cMath_RandRectf(2.5f,3.5f),"TimerGeneratorSparks");
		
		///////////////////////////////////////////////
		// Increment # of tentacles detached, trigger puzzle solved when all three are detached
		++mlTentaclesDetached;
		if (mlTentaclesDetached >= 3)
		{
			OnElectricsPuzzleSolved();
		}
		
		//////////////////////////////
		// Begin Flesher encounter
		if (mlTentaclesDetached == 1)
		{
			Map_AddTimer("timer_flesherelectrics",4.5f,"TimerFlesherElectrics");
		}
		
		////////////////////////////////////////////////
		// Delay on effects
		Map_AddTimer("timer_detachWau_"+mlTentaclesDetached,cMath_RandRectf(1.0f,2.0f),"TimerDetachWau");
	}
		
	//------------------------------------------------------
	
	void Timer_ElectricsPuzzleSolved(const tString &in asTimer)
	{
		OnElectricsPuzzleSolved();
	}
	
	//------------------------------------------------------
	
	void TimerGeneratorOil(const tString &in asTimer)
	{
		ParticleSystem_CreateAtEntity("ps_oil_splash_"+asTimer,"oil_splash_small_oneshot.ps",asTimer,true);
		
		// Loop timer
		Map_AddTimer(asTimer,cMath_RandRectf(0.75f,2.25f),"TimerGeneratorOil");
	}
	
	//------------------------------------------------------
	
	void TimerGeneratorSparks(const tString &in asTimer)
	{
		ParticleSystem_CreateAtEntity("ps_sparks_"+asTimer,"elec_spark_medium_oneshot",asTimer,true);
		ParticleSystem_CreateAtEntity("ps_sparks_"+asTimer,"elec_spark_physics_few_oneshot",asTimer,true);
		
		// Loop timer
		Map_AddTimer(asTimer,cMath_RandRectf(2.0f,3.0f),"TimerGeneratorSparks");
	}
	
	//------------------------------------------------------
	
	void TimerShipShakes(const tString &in asTimer)
	{
		float fTime = 3.0f;
		Effect_Shake_Start(cMath_RandRectf(0.025f,0.05f),fTime,0.2f,0.2f);
		
		Map_AddTimer("timer_shipshakes",fTime + 0.5f,"TimerShipShakes");
	}
	
	//------------------------------------------------------
	
	void TimerDetachWau(const tString &in asTimer)
	{
		// Number of tentacles detached is passed as timer name and we cast this to a float
		int lPhase = mlTentaclesDetached;
		float fModifier = mlTentaclesDetached * 0.015f;
		
		// Three different phases of tentacle removal
		cLux_AddDebugMessage("Phase: " + lPhase);
		switch (lPhase)
		{
			////////////////////////////
			// First tentacle is detached
			case 1:
				Sound_CreateAtEntity("ReactorBlow1", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/explosion_01", "Player");
				Sound_FadeGlobalVolume(0.25f, 0.05f);
				Map_AddTimer("ReactorFadeIn", 0.5f, "ReactorFadeIn");
				Effect_Shake_Start(0.05f + fModifier,1.0f,0.2f,0.2f);
			break;
			
			////////////////////////////
			// Second tentacle is detached
			case 2:
				Map_AddTimer("SecondTentacle", 1.0f, "ReactorShake");
			break;
			
			////////////////////////////
			// Third tentacle is detached
			case 3:
				Map_AddTimer("ThirdTentacle", 1.0f, "ReactorShake");
			break;
			
			default:
			/* Not used */
			break;
		}
	}
	
	//------------------------------------------------------
	
	void ReactorShake(const tString &in asTimer)
	{
		if(asTimer=="SecondTentacle")
		{
			Sound_CreateAtEntity("ReactorBlow2", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/explosion_02", "Player");
			Sound_Stop("ReactorBlow1", 0.05f);
			Sound_FadeGlobalVolume(0.2f, 0.05f);
			Map_AddTimer("ReactorFadeIn", 0.5f, "ReactorFadeIn");
			Effect_Shake_Start(0.1, 0.3, 0.1, 0.3);
			Player_FadeRollTo(-5.0f,2.0f,3.0f);
		}
		if(asTimer=="ThirdTentacle")
		{
			Sound_CreateAtEntity("ReactorBlow3", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/explosion_03", "Player");
			Sound_Stop("ReactorBlow2", 0.05f);
			Sound_FadeGlobalVolume(0.2f, 0.05f);
			Map_AddTimer("ReactorFadeIn", 0.6f, "ReactorFadeIn");
			Effect_Shake_Start(0.15, 0.3, 0.1, 0.2);
		}
	}
		
	//------------------------------------------------------
	
	void ReactorFadeIn(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 4.0f);
	}
	
	//------------------------------------------------------
	
	bool OnCollideSetBlackoutSpawn(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			msRespawnPoint = Entity_GetVarString(asChild,"");
			cLux_AddDebugMessage("Respawn point set to : " + msRespawnPoint);
		}
		
		return true;
	}

	//------------------------------------------------------
	
	void OnElectricsPuzzleSolved()
	{
		if (mbWAURemoved) return;
		
		cLux_AddTodoMessage("SCRIPT: Catherine Radio transmission. Get to da lifeboat!!");
		cLux_AddTodoMessage("SCRIPT: Creepier lighting!");
		mbLifeboatAvailable = true;
		mbWAURemoved = true;
		mbPlayerKilledMessageAllowed = false;
		
		//////////////////////////////////////
		// Disable return to pod areas
		Entity_SetActive("AreaReturnToPod*",false);
		Entity_SetActive("AreaActivatePodReturn_*",false);
		
		// Enable chasing flesher
		SetupFinalChase();
		
		//////////////////////////////////////
		// Activate area to trigger escape
		// (Note that player will have to plug Catherine in to start the escape if they havent already)
		Entity_SetActive("AreaEscapeInPod",true);
		
		
		
		Map_AddTimer("timer_knockout",0.1f,"SequenceElectricsKnockout");
		
		//SequenceFlesherKnockout("");
		
		/* We want to progress in to Scene 3 Event B now - some sequences to add tension there */
		SetupEscapeSequence();
		
		mbFinalChaseInProgress = true;
			
	}
	
	//------------------------------------------------------
	
	cSequenceStatesData mSequenceElectricsKnockout;
	void SequenceElectricsKnockout(const tString &in asTimer)
	{
		Sequence_Begin("SequenceElectricsKnockout", mSequenceElectricsKnockout);
		
		if (Sequence_DoStepAndWait(0.25f))
		{
			cLux_AddTodoMessage("SOUND: Big bang!");
			
			Effect_Shake_Start(0.8f,0.25f,0.0f,0.0f);
			Effect_Flash_Start(0.1,0.15f,0.0f);
			
			
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			cLux_AddTodoMessage("SOUND: Get knocked out!");
			
			Sound_PlayGui("Player/UI/death_hit", 1.0f);
			Effect_Fade_Out(0.0f);
			
			Entity_SetActive("Agent_Flesher_Electrics",false);
			
			
			cLux_AddTodoMessage("SOUND: Drop out the audio here");
			Sound_FadeGlobalVolume(0.0f,1.5f);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			//////////////////////////////////////
			// Set player knocked down and move to start pos
			Player_Teleport(msRespawnPoint,true);
			
			if (Map_TimerExists("timer_flesherelectrics"))
				Map_RemoveTimer("timer_flesherelectrics");
			
			
			
			
			
			
			Player_FadeRollTo(78,10,100);
			Player_SetForceCrawling(true);
			Player_SetCrouching(true,true,true);
			Player_SetStandDisabled(true);
			Player_SetMoveSpeedMul(0.0f);
			
			
			Entity_SetActive("agent_flesher_finalchase",true);
			Agent_SetSensesActive("agent_flesher_finalchase",false);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			cLux_AddTodoMessage("SOUND: Bring audio back in");
			Sound_FadeGlobalVolume(1.0f,3.0f);
			
			Effect_Fade_In(3.0f);
			Player_SetSlowStandupMotion(true);
			Player_SetForceCrawling(false);
			Player_SetStandDisabled(false);
			Player_SetCrouching(false);
			Player_SetStandDisabled(true);
			Player_FadeMoveSpeedMulTo(1.0f,3.0f);
			Player_SetAfterDamageCrawl(false);
			Player_FadeRollTo(0,8,30);
			Player_FadeMoveSpeedMulTo(1.0f,3.0f);
			
			//////////////////////////////////////
			// Set emergency states and start falling cylinders
			
			SlideDoor_SetClosed("CargoBayDoor",false,true);
			SlideDoor_SetClosed("StorageRoomDoor",false,true);
			SlideDoor_SetClosed("StorageRoomDoor_1",true,true);
			Entity_SetActive("falling_crate_cable_*",false);
			
			SequenceFallingCylinders("");
			SetEmergencyLampsActive(true);			
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			Player_SetStandDisabled(false);
			Player_SetSlowStandupMotion(false);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			/////////////////////////////////
			// Begin Hunt!
			Agent_SetSensesActive("agent_flesher_finalchase",true);
			BeginFinalChase();
		}
	
		Sequence_End();
	}
	
	//------------------------------------------------------
	
	void TimerAwakenAfterPuzzle(const tString &in asTimer)
	{
		
	}
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 - Cylinders Fall
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	bool OnCollideAreaFallingCylinder(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		Effect_Shake_Start(0.015f,1.0f,0.2f,0.2f);
		ParticleSystem_CreateAtEntity("ps_bubbles_"+asParent,"oneshot_waterbubbles_explosion.ps",asParent,true);
		//oneshot_waterbubbles_big.ps
		
		if(asChild=="ElectricFallingCylinder_1")
		{
			Sound_CreateAtEntity("CylinderFall_1", "02_02_ms_curie_inside/SFX/curie_tilt/cylinder_drops/metal_cylinder_drop_03", asChild);
		}
		else if(asChild=="ElectricFallingCylinder_2")
		{
			Sound_CreateAtEntity("CylinderFall_2", "02_02_ms_curie_inside/SFX/curie_tilt/cylinder_drops/metal_cylinder_drop_02", asChild);
		}
		else if(asChild=="ElectricFallingCylinder_3")
		{
			Sound_CreateAtEntity("CylinderFall_3", "02_02_ms_curie_inside/SFX/curie_tilt/cylinder_drops/metal_cylinder_drop_01", asChild);
		}
		return false;
	}
	
	//----------------------------------------------------------------------
	
	cSequenceStatesData mSequenceFallingCylinders;
		
	void SequenceFallingCylinders(const tString &in asTimer)
	{
		Sequence_Begin("SequenceFallingCylinders", mSequenceFallingCylinders);
	
		if (Sequence_DoStepAndWait(1.5f))
		{
			
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			Sound_Stop("wau_boiler_*", 0.05f);
			TiltCurieRight(true);
			OpenEscapePodDoor();
			StopMorseCodeSound();
			ParticleSystem_CreateAtEntity("ps_bubbles_detach_ElectricFallingCylinder_1","oneshot_waterbubbles_explosion.ps","ElectricFallingCylinder_1",false);
			Prop_SetStaticPhysics("ElectricFallingCylinder_1",false);
			
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			ParticleSystem_CreateAtEntity("ps_bubbles_detach_ElectricFallingCylinder_2","oneshot_waterbubbles_explosion.ps","ElectricFallingCylinder_2",false);
			Prop_SetStaticPhysics("ElectricFallingCylinder_2",false);
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			ParticleSystem_CreateAtEntity("ps_bubbles_detach_ElectricFallingCylinder_3","oneshot_waterbubbles_explosion.ps","ElectricFallingCylinder_3",false);
			Prop_SetStaticPhysics("ElectricFallingCylinder_3",false);
		}
		
		Sequence_End();
	}
	
	
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 EVENT B Run to Lifeboat
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	int mlCargoFlesherPatrols = 0;
	int mlCargoFlesherWindowCount = 0;
	
	//------------------------------------------------------
	
	void SetupEscapeSequence()
	{
		// Some lights are failing
		Lamp_SetFlickerActive("spotlight_tripod_flesher_lamp_2",true);
		Lamp_SetLit("sunken_warning*",false,true);
		Lamp_SetLit("StorageRoomDoorLamp",false,true);
		
		cLux_AddTodoMessage("ART: CONNECT ALL LIGHTS AND BILLBOARDS ON RED WARNING LAMPS");
		
		///////////////////////////////////////
		// Activate triggers for return journey
		//Entity_SetActive("AreaFlesherBreakIn",true);
			
	}
	
	bool mbIsAlarmSequenceActive = false;
	void StartAlarmSequence()
	{
		if(mbIsAlarmSequenceActive == false)
		{
			///////////////////////////////////
			// Begin alarm and light escape lamps
			StartEscapeAlarms();
			Lamp_SetLit("EscapeLamp_*",true,true);
			mbIsAlarmSequenceActive = true;
		}

	}
	
	//------------------------------------------------------
	
	bool CollideAreaFlesherBreakIn(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////////////////
		// When player leaves the Electrics room, a Flesher will break in to the Cargo bay
		if (alState != 1) return true;
		
		//////////////////
		// Disable both areas
		Entity_SetActive("AreaFlesherBreakIn*",false);
		
		//////////////////
		// Sound/Music
		cLux_AddTodoMessage("MUSIC: Stringer as Flesher attempts to break in");
		Music_Play("02_01_fleshervehicle.ogg",1.0f,false,eMusicPrio_BigEvent);
		
		/* Determine how the Flesher will get in here */
		
		///////////////////////////////////////
		// First Priority - the Cargo bay doors..
		if (PhysicsSlideDoor_GetClosed("CargoBayDoor") == false)
		{
			
			Entity_SetActive("Agent*",false);
			Entity_SetActive("Agent_flesher_windowbreak",true);
			Entity_PlaceAtEntity("Agent_flesher_windowbreak","Agent_Flesher_WindowDestination",cVector3f_Zero,true);
			Agent_SetSensesActive("Agent_flesher_windowbreak",true);
			Map_AddTimer("timer_flesher_startpatrol",1.0f,"TimerCargoFlesherPatrol");
		}
		//////////////////////////////////////
		// Second priority - route via the storage room
		else if (PhysicsSlideDoor_GetClosed("StorageRoomDoor") == false && PhysicsSlideDoor_GetClosed("StorageRoomDoor_1") == false)
		{
			Entity_SetActive("Agent*",false);
			Entity_SetActive("Agent_flesher_windowbreak",true);
			Entity_PlaceAtEntity("Agent_flesher_windowbreak","Agent_Flesher_WindowDestination",cVector3f_Zero,true);
			Agent_SetSensesActive("Agent_flesher_windowbreak",true);
			Map_AddTimer("timer_flesher_startpatrol",1.0f,"TimerCargoFlesherPatrol");
		}
		/////////////////////////////////////
		// Third priority - it'll break through the window
		else
		{
			SequenceFlesherBreaksGlass("");
		}
		
		return false;
	}
	
	//------------------------------------------------
	
	cSequenceStatesData mSequenceFlesherBreaksGlass;
		
	void SequenceFlesherBreaksGlass(const tString &in asTimer)
	{
		Sequence_Begin("SequenceFlesherBreaksGlass", mSequenceFlesherBreaksGlass);
	
		if (Sequence_DoStepAndWait(1.0f))
		{
		
			Entity_SetActive("Agent*",false);
			Entity_SetActive("Agent_flesher_windowbreak",true);
			Agent_SetSensesActive("Agent_flesher_windowbreak",false);
		}
		if (Sequence_DoStepAndWait(2.25f))
		{
			///////////////////////////
			// First impact..
			cLux_AddTodoMessage("SOUND:/JUICE: Glass breaking..");
			Sound_CreateAtEntity("HammerGlassBroken", "flesher/door/breaking", "AreaSFXBreakGlass", 0, false);
			Entity_SetActive("BreakableGlass_2",false);
			Entity_SetActive("BreakableGlass_2_Minor",true);
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			Sound_CreateAtEntity("HammerGlassBroken", "flesher/door/breaking", "AreaSFXBreakGlass", 0, false);
			Entity_SetActive("BreakableGlass_2_Minor",false);
			Entity_SetActive("BreakableGlass_2_Damaged",true);
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			Sound_CreateAtEntity("HammerGlassBroken", "flesher/door/breaking", "AreaSFXBreakGlass", 0, false);
			Entity_SetActive("BreakableGlass_2_Damaged",false);
			Entity_SetActive("BreakableGlass_2_Broken",true);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			/////////////////////////////////////////
			// Forcably teleport the Flesher inside this room
			Entity_PlaceAtEntity("Agent_flesher_windowbreak","Agent_Flesher_WindowDestination",cVector3f_Zero,true);
			Agent_SetSensesActive("Agent_flesher_windowbreak",true);
			Map_AddTimer("timer_flesher_startpatrol",1.0f,"TimerCargoFlesherPatrol");
		}
		
		Sequence_End();
	
	}
	
	//------------------------------------------------------
	
	void TimerCargoFlesherPatrol(const tString &in asTimer)
	{
		Map_AddTimer("timer_cargoflesherdistortion",cMath_RandRectf(1.0f,2.0f),"TimerCargoFlesherDistortion");
		
		Pathfinder_Track_Clear("Agent_flesher_windowbreak");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_522");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_525");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_524");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_523");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_526", 4.0f,7.0f);	// Wait!
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_535");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_537");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_534");
			
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_530", 4.0f,7.0f); // Wait!
			
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_534");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_537");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_535");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_526", 4.0f,7.0f);	// Wait!
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_523");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_524");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_525");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_522");
		Pathfinder_Track_Start("Agent_flesher_windowbreak",true,1,"");
	}
	
	//------------------------------------------------------
	
	void OnCargoFlesherEndPath(const tString& in asEntityName)
	{
		++mlCargoFlesherPatrols;
		cLux_AddDebugMessage("AI/SCRIPT: Flesher ended his path.. " + mlCargoFlesherPatrols + " times..");
	}
	
	//------------------------------------------------------
	
	void TimerCargoFlesherDistortion(const tString &in asTimer)
	{
		//Map_AddTimer("timer_cargoflesherdistortion",cMath_RandRectf(10.0f,15.0f),"TimerCargoFlesherDistortion");
	}
	
	bool CollideAreaFlesherWindow(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		++mlCargoFlesherWindowCount;
		cLux_AddDebugMessage("AI/SCRIPT: Flesher was by window.. " + mlCargoFlesherWindowCount + " times..");
		
		if (mlCargoFlesherWindowCount >= 4)
		{
			////////////////////////////
			// We should teleport the Flesher away now..
			//Effect_VideoDistortion_Start(1.0f,0.1f,0.05f,0.05f,1.0f);
			Entity_SetActive("Agent_flesher_windowbreak",false);
		}
		return true;
	}
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 EVENT C Enter lifeboat and escape
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	tString msWaterDrainBranch = "3C_WaterDrained";
	
	//------------------------------------------------------
	
	bool CollideAreaEscapeInPod(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		SealPodDoors();
		StopEscapeAlarms_Small(3.5f);
		StopEscapeMusic(3.5f);
		StopFinalChase();
		Map_AddTimer("EscapeMusicStop", 3.5f, "EscapeMusicStop");
		Player_FadeRollTo(0.0f,15.0f,3.0f);
		
		if (mbCathPluggedIn)
		{
			Map_AddTimer("timer_escapeentry",1.0f,"TimerEscapeOnPodEntry");
		}
		
		Map_AddTimer("timer_sequenceBangPod",1.75f,"SequenceMonsterBangingPod");
		
		return false;
	}
	
	void EscapeMusicStop(const tString &in asTimer)
	{
		StopEscapeMusic(2.0f, true);
	}
	
	//------------------------------------------------------
	
	cSequenceStatesData mSequenceMonsterBangingPod;
	void SequenceMonsterBangingPod(const tString &in asTimer)
	{
		Sequence_Begin("SequenceMonsterBangingPod", mSequenceMonsterBangingPod);
		
		if (Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_doorpound","02_07_theta_exit_a/SFX/akers_door_smash/akers_door_smash","AreaPodDoorPoundEffect");	
			
			Effect_Shake_Start(0.1f,0.2f,0.0f,0.0f);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_scream","NPC_Creatures/Vocalisations/InWorld/Flesher/scream","AreaPodDoorPoundEffect");	
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_doorpound2","02_07_theta_exit_a/SFX/akers_door_smash/akers_door_smash","AreaPodDoorPoundEffect");	
			
			Effect_Shake_Start(0.1f,0.2f,0.0f,0.0f);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_scream","NPC_Creatures/Vocalisations/InWorld/Flesher/scream","AreaPodDoorPoundEffect");	
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_doorpound","02_07_theta_exit_a/SFX/akers_door_smash/akers_door_smash","AreaPodDoorPoundEffect");	
			
			Effect_Shake_Start(0.1f,0.2f,0.0f,0.0f);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_scream","NPC_Creatures/Vocalisations/InWorld/Flesher/scream","AreaPodDoorPoundEffect");	
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			cLux_AddTodoMessage("SOUND: Robot monster is pounding on the door");
			Sound_CreateAtEntity("sfx_doorpound2","02_07_theta_exit_a/SFX/akers_door_smash/akers_door_smash","AreaPodDoorPoundEffect");	
			
			Effect_Shake_Start(0.1f,0.2f,0.0f,0.0f);
		
		}
		
		Sequence_End();
	}
	
	//------------------------------------------------------
	
	void PodEscape(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		//////////////////////////////////////
		// Callback from dialogue after Catherine initiates escape sequence
		cLux_AddTodoMessage("SCRIPT: Pod Escape Sequence");
		msWaterDrainBranch = "3C_WaterDrained_Branch2";
		Map_AddTimer("timer_seq_drainwater",1.0f,"SequenceDrainWater");
	}
	
	//------------------------------------------------------
		
	void OpenEscapePodDoor()
	{
		Entity_SetActive("BlockBoxEscapePod",false);
		SwingDoor_PushOpen("Swingdoor_EscapePod",2.0f,4,0.1f);
		mbEscapePodSweetenerPlayed = false;
	}
	
	//------------------------------------------------------
	
	bool mbEscapePodSweetenerPlayed = false;
	void CloseEscapePodDoor()
	{
		bool bClosed = SwingDoor_GetClosed("Swingdoor_EscapePod");
		SwingDoor_PushOpen("Swingdoor_EscapePod",-2.0f,6,0.1f);
		Entity_SetActive("BlockBoxEscapePod",true);
		if(bClosed == false && mbEscapePodSweetenerPlayed == false)
		{
			//escape pod sweetener sound to tell the player they've successfully escaped
			Sound_CreateAtEntity("CloseEscapePod", "02_02_ms_curie_inside/SFX/escape_pod/escape_pod_door_close", "Swingdoor_EscapePod");
			mbEscapePodSweetenerPlayed = true;
		}
	}
	
	//------------------------------------------------------
		
	void SealPodDoors()
	{
		//////////////////////////////////////////////////////////
		// Close door and disable interaction when it is almost closed
		Entity_SetActive("BlockBoxEscapePod",true);
		CloseEscapePodDoor();
		Entity_SetInteractionDisabled("Swingdoor_EscapePod*",true);
		Map_AddTimer("EscapePodAlarm", 1.0f, "EscapePodAlarm");
		Sound_FadeGlobalVolume(1.0f, 3.5f);
		
		/////////////////////////////////////////////
		// Disable the fleshers
		Entity_SetActive("Flesher*",false);
		Entity_SetActive("Agent*",false);
		Effect_VideoDistortion_FadeOut(-1,1.0);
		
		Music_Stop(2.0f,eMusicPrio_BigEvent);
	}
	
	void EscapePodAlarm (const tString &in asTimer)
	{
		Sound_CreateAtEntity("EscapePodAlarm", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/escape_pod", "EscapePodAlarmSource");
		Map_AddTimer("EscapePodAlarm", 0.75f, "EscapePodAlarm");
	}
	
	//-------------------------------------------------------
	
	void TimerEscapeOnPodEntry(const tString &in asTimer)
	{
		//////////////////////////////////////////
		// Used when the player runs to the pod, after having already plugged Cath in
		//Dialog_StartConversation("Catherine", "PodDisplay_2", 0.5f);
		//Dialog_StartConversation()
		Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("3C_LifeboatEscape","","OnCathDrainWater");
		Dialog_End();
	}
	
	//------------------------------------------------------
	
	void OnCathDrainWater(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		//////////////////////////////////////
		// Callback from dialogue after Catherine starts to drain water
		cLux_AddTodoMessage("SCRIPT: Cath drains water - play the sequence!");
		Map_AddTimer("timer_seq_drainwater",1.0f,"SequenceDrainWater");
	}
	
	//------------------------------------------------------
	
	cSequenceStatesData mSequenceDrainWater;
		
	void SequenceDrainWater(const tString &in asTimer)
	{
		Sequence_Begin("SequenceDrainWater", mSequenceDrainWater);
	
		if (Sequence_DoStepAndWait(3.25f))
		{
			mbEscapePodScreensActive = true;
			Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f);
			Sound_CreateAtEntity("EscapePodDrainSweet", "02_02_ms_curie_inside/SFX/escape_pod/drain_sweetener", "Player", 1.0f, false, 1.0f);
			mfEscapePodGaugeMaxValue = 1.0f;
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			AirlockEffectsFlushWater();
			Map_SetEnvironmentParticlesActive(false);
			LiquidArea_MoveLinearTo("LiquidArea_EscapePod_1","AreaWaterDrainTarget",0.1, 1, 0.5, false);
		}
		else if (Sequence_DoStepAndWait(3.0))
		{
			Map_SetUnderwater(false,true);
			Entity_SetActive("AMB_Pre_EscapePodUW", false);
			Entity_SetActive("AMB_Post_Global", false);
			Entity_SetActive("AMB_Pre_EscapePodAir", true);
			Sound_Stop("EscapePodDrainSweet", 1.0f);
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			StartPodEscape();
			
			////////////////////////////////////////
			// Play dialog for escape
			Voice_Play(msWaterDrainBranch,-1,"",0);
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			Effect_Fade_Out(6.0f);
		}
		else if (Sequence_DoStepAndWait(13.0f))
		{
			//wait for sound to end
		}
		else if (Sequence_DoStepAndWait(0))
		{
			ExitLevel();
		}

		Sequence_End();
	}

	
	//------------------------------------------------------
	
	//////////////////////////////////////////////////
	// Breaking glass sequence
	//////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	tString msGlassToBreak;
	cSequenceStatesData mBreakGlassSequence;
		
	void SequenceBreakGlass(const tString &in asTimer)
	{
		Sequence_Begin("SequenceBreakGlass", mBreakGlassSequence);
		if (Sequence_DoStepAndWait(0.2))
		{
			Player_UnequipTool();
			Entity_SetInteractionDisabled("BreakableGlass_*", true);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			tString sNextBrokenStep = Entity_GetVarString(msGlassToBreak, "NextBrokenStep");
			Entity_SetActive(msGlassToBreak, false);
			Entity_SetActive(sNextBrokenStep, true);
			
			// Window broken
			if (cString_GetFirstStringPos(sNextBrokenStep, "_Broken") >= 0)
			{
				Sound_CreateAtEntity("HammerGlassBroken", "level_02_02/events/cabin_window/hit_hammer_break", sNextBrokenStep, 0, false);
				
				/////////////////////////////////////////////////////////////////////////
				// Enable player to climb through window
				if (sNextBrokenStep == "BreakableGlass_1_Broken")
				{
					Entity_SetActive("CargoRoomClimb_1_*", true);
				}
				if (sNextBrokenStep == "BreakableGlass_2_Broken")
				{
					Entity_SetActive("CargoRoomClimb_2_*", true);
				}
				
				cVector3f vImpulse;
				for (int i = 1; i <= 7; i++)
				{
					vImpulse = cVector3f(cMath_RandRectf(-0.5f, 0.5f), cMath_RandRectf(-0.5f, 0.5f), -1);
					vImpulse.Normalize();
					Body_AddImpulse(sNextBrokenStep + "_shard_body_" + i, vImpulse*0.3, true);
					
				}
				
				//Activate and push extra shards
				Entity_SetActive(sNextBrokenStep + "_Extra", true);
				Map_AddTimer(sNextBrokenStep + "_Extra", 3.f, "TimerInactivateEntity");
				for (int i = 1; i <= 23; i++)
				{
					vImpulse = cVector3f(cMath_RandRectf(-0.5f, 0.5f), cMath_RandRectf(-0.5f, 0.5f), -1);
					vImpulse.Normalize();
					Body_AddImpulse(sNextBrokenStep + "_Extra_Body_" + i, vImpulse*0.3, true);
					
				}
			}
			else
			{
				Sound_CreateAtEntity("HammerGlassCrack", "level_02_02/events/cabin_window/hit_hammer", sNextBrokenStep, 0, false);
			}
									
		}
		else if (Sequence_DoStepAndWait(0.3f))
		{
			Player_ReEquipTool(0.3f);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Entity_SetInteractionDisabled("BreakableGlass_*", false);
		}
		Sequence_End();
	}

	//------------------------------------------------------
	
	////////////////////////////////////////////////////
	// 3G BABBLING CORPSES
	////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////
	// 3H. ENTER CARGO BAY                           //
	///////////////////////////////////////////////////
	
	//-----------------------------------------------------------------
	
	bool CollisionEnteredCargoBay(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Entered Cargo Bay");
		
		///////////////////////////////
		// Player enters the cargo bay
				
		///////////////////////////////
		// Fleshers pull box with body up to the hatch
		SequencePullCrate("");
		
		///////////////////////////////////////////////
		//Sound for crate yank up
		Sound_CreateAtEntity("CoffinPull", "02_02_ms_curie_inside/SFX/coffin_pulley/coffin_pulley", "Sound_CoffinSoundArea", 0.0, false, 1.0f);
		
		return false;
	}
	
	//-----------------------------------------------------------------
	
	int mlCratePulls = 0;
	cSequenceStatesData mSequencePullCrate;
		
	void SequencePullCrate(const tString &in asTimer)
	{
		Sequence_Begin("SequencePullCrate", mSequencePullCrate);
			
		///////////////////////////////////////////////
		// Fleshers yank the crate up in a few pulls
		if (Sequence_DoStepWaitAndRepeat(4,3.0))
		{
			mlCratePulls++;
			Prop_MoveLinearTo("BodyCrate","Area_CrateTarget_"+mlCratePulls,1.0,2.0,1.0,false);
		}

		Sequence_End();
	}
	
	//-----------------------------------------------------------------
	
	bool TriggerArea_CrateHatch(const tString &in asParent, const tString &in asChild, int alState)
	{
		///////////////////////////////////////////////
		// Close hatch door when box is pulled through
		if (alState == 1)
		{
			SlideDoor_SetClosed("CargoBayCeilingDoor",true,false);
			return false;
		}
		return true;
	}
	
	//-----------------------------------------------------------------
	
	////////////////////////////////////////
	// CATHERINE COMMUNICATION SEQUENCE   //
	////////////////////////////////////////
	
	//-----------------------------------------------------------------
	
	cSequenceStatesData mCatherineElectricsTalk;
	void SequenceCatherineElectricsTalk(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCatherineElectricsTalk", mCatherineElectricsTalk);
	
		if (Sequence_DoStepAndWait(0.75f))
		{
			//Player_SetMoveSpeedMul(0);
			Sound_CreateAtEntity("RadioStart", "level_amb_shared_machines/signals/burst", "CathContactSpeaker_Lamp_Electrics", 0, false);
			Sound_CreateAtEntity("RadioCrackle", "level_amb_shared_machines/signals/crackling", "CathContactSpeaker_Lamp_Electrics", 0.75, true);
			
			Lamp_SetLit("CathContactSpeaker_Lamp_Electrics", true, true);
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			Voice_SetSource("Catherine", "CathContactSpeaker_Lamp_Electrics", 3, 10, true, 10);
			
			Voice_Play("19_EnterElectricsA",-1,"SubjectEnterElectricsOver");
			
			Lamp_SetFlickerActive("CathContactSpeaker_Lamp_Electrics", true);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			cLux_AddTodoMessage("Violent roar from flesher!\n");
			
			Sound_CreateAtEntity("FlesherHowl", "02_04_theta_outside/spot/mind_coral/distant_call", "FlesheTransmissions_4");
		
		}
		else if (Sequence_DoStepAndPause(0.5f))
		{
			Voice_Play("19_EnterElectricsB",-1,"SubjectCatherineElectricsOver");
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			Sound_Stop("RadioCrackle", 1.5f);		
			Lamp_SetLit("CathContactSpeaker_Lamp_Electrics", false, true);
			
			///////////////////////////
			// Explosion particles
			cLux_AddTodoMessage("Sound: Radio panel shorts out");
			Sound_CreateAtEntity("RadioShortcircuit","shipwreck/doors/cabin_door_panel/malfunction","CathContactSpeaker_Lamp_Electrics",0,false,1.0f);
			ParticleSystem_CreateAtEntity("elec_spark_huge_oneshot","elec_spark_huge_oneshot.ps","CathContactSpeaker_Lamp_Electrics",false);
		}
		else if (Sequence_DoStepAndWait(0.0))
		{
			//////////////////////////////
			// Simon curses
			Dialog_Begin();
				Dialog_AddBranch("19_EnterElectrics");
				Dialog_AddSubject("19_EnterElectricsC","");
			Dialog_End();
			
			/////////////////////////////
			// Remove blockbox on door
			Entity_SetActive("TransformerRoomBlocker",false);
		}
		
		Sequence_End();
	}	
	
	//-----------------------------------------------------------------
		
	///////////////////////////////////////////////////////
	// 3I PLAYER FINDS AND ENTER VENTILATION ENTRANCE
	///////////////////////////////////////////////////////
		
	//-----------------------------------------------------------------
	
	void OnChangeTransformerVent(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		Player_ChangeStateToNormal();
		Player_SetLookSpeedMul(0);
		Player_FadeLookSpeedMulTo(1, 0.5);
		
		Entity_SetActive(asEntity, false);
		Entity_SetActive(asEntity + "_Grab", true);
		Entity_PlaceAtEntity(asEntity + "_Grab", asEntity);
		
		Entity_AddImpulse(asEntity + "_Grab", cVector3f_Forward*1.5, true, true);
		
		Map_RemoveTimer(asEntity);
		Sound_Stop("TransformerVentStress", 0.05f);
		cLux_AddTodoMessage("Sound: Vent torn open");
		Sound_CreateAtEntity("TransformerVentTornOpen", "level_01_02/tech/lever_metallic/start", asEntity + "_Grab", 0, false);
		
		Effect_Shake_Start(0.015, 0.3f, 0.0f, 0.1f);
	}
	
	//-------------------------------------------------------
	
	void InteractTransformerVent(const tString &in asEntity)
	{
		// Play sound
		cLux_AddTodoMessage("Sound: Hinges of panel under stress");
		Sound_CreateAtEntity("TransformerVentStress", "level_01_02/tech/lever_metallic/loop", asEntity, 0.5f, true);
		Map_AddTimer(asEntity, 0.25f, "TimerCheckTransformerVentInteraction");
	}
	
	//-------------------------------------------------------
	
	void TimerCheckTransformerVentInteraction(const tString &in asTimer)
	{
		// Player has stopped interacting
		if (!Entity_IsInteractedWith(asTimer))
		{
			Sound_Stop("TransformerVentStress", 0.05f);
			return;
		}
		
		// Check again in x secs
		Map_AddTimer(asTimer, 0.25f, "TimerCheckTransformerVentInteraction");
	}
		
	//------------------------------------------------------
	
	void InteractReactorVentGrate(const tString &in asEntity)
	{
		cLux_AddTodoMessage("Sound: Vent torn open");
		Sound_CreateAtEntity("TransformerVentTornOpen", "level_01_02/tech/lever_metallic/start", asEntity, 0, false);
		
		Prop_SetStaticPhysics(asEntity, false);
		Entity_AddImpulse(asEntity, cVector3f_Forward*1.5, true, true);
		Player_ChangeStateToNormal();
		
		Effect_Shake_Start(0.015, 0.3f, 0.0f, 0.1f);
	}
	
	//------------------------------------------------------
	
	void ExitLevel()
	{
		cLux_AddDebugMessage("Change level!");
		Map_ChangeMap("02_03_delta.hpm", "escape_pod_functional", "", "");
	}
	
