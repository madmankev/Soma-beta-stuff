	void TimerLoopingVoiceFirstFloor(const tString &in asTimer)
	{
		///////////////////////////////////
		// If player is in the area, play voice and add a long timer
		if (Entity_GetCollide("Player","AreaNearAutomatedVoice"))
		{
			cLux_AddDebugMessage("Play message");
			Voice_SetSource("AutomatedVoice","AreaStaticVoice",5.0f,10.0f,false);
			Voice_Play("1_StaticVoice");
			Map_AddTimer("timer_loopingvoicerepeat",cMath_RandRectf(5.0f,7.0f),"TimerLoopingVoiceFirstFloor");
		}
		
		///////////////////////////////////
		// Otherwise make it a bit more frequent.
		else
		{
			Map_AddTimer("timer_loopingvoicerepeat",6.0f,"TimerLoopingVoiceFirstFloor");
		}
	}
	
