	/////////////////////////////////////////
	// TERMINALS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------------
	
	//-----------------------------------------------------------------------------
	
	void OnGuiCreepyImages(const tString&in asEntityName, float afTimeStep)
	{
		float fStaticTime = ImGui_GetStateFloat("CreepyStaticMax",0.0f);
		float fTimer = ImGui_GetStateFloat("CreepyStaticTimer", 0.0f);
		fTimer += afTimeStep;
		
		//bigscreen_L
		//desaster01
		
		//bigscreen_R
		//desaster02
		
		
		int lCreepyImageLoop = ImGui_GetStateInt("CreepyImageLoop",0);
		bool bCycleCreepyImage = false;
		tString sImageName = Entity_GetVarString(asEntityName,"");
		
		cVector2f vDimensions = cVector2f(-1,-1);
		
		//////////////////////////////////////////
		// Occasional bursts of static
		bool bStaticBurst = false;
		if (fTimer > fStaticTime)
		{
			bStaticBurst = true;
			TerminalStatic();
		}
		
		/////////////////////////////////////////
		// Communal Room first floor
		else if (sImageName == "CommunalRoom")
		{
			vDimensions = cVector2f(1.35,1);
			sImageName = "desaster00";
		}		
		
		else if (sImageName == "bigscreen_L")
		{
			sImageName = "desaster01";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		else if (sImageName == "bigscreen_R")
		{
			sImageName = "desaster02";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		////////////////////////////////////
		// Kitchen
		else if (sImageName == "kitchen_1")
		{
			sImageName = "desaster03";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		else if (sImageName == "kitchen_2")
		{
			sImageName = "desaster04";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		////////////////////////////////////
		// Bridge Deck
		else if (sImageName == "bridgedeck_1")
		{
			sImageName = "desaster05";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		else if (sImageName == "bridgedeck_2")
		{
			sImageName = "desaster06";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		
				
		//////////////////////////////////////////
		// Comm Room Screens
		else if (sImageName == "commroom_big_L1")
		{
			sImageName = "desaster07";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "commroom_big_L2")
		{
			sImageName = "desaster08";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "commroom_big_R1")
		{
			sImageName = "desaster09";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "commroom_big_R2")
		{
			sImageName = "desaster10";
			vDimensions = cVector2f(1.35,1);
		}
		
		
		//////////////////////////////////////////
		// Power Room Screens
		else if (sImageName == "powerroom_big_L")
		{
			sImageName = "desaster11";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "powerroom_big_M")
		{
			TerminalStatic();
		}
		else if (sImageName == "powerroom_big_R")
		{
			sImageName = "desaster12";
			vDimensions = cVector2f(1.35,1);
		}
		
		///////////////////////////////////////////
		// Show image when the static is not visible
		if (bStaticBurst == false)
		{
			ImGui_DoImage(cImGuiGfx(sImageName, eImGuiGfx_Texture), cVector3f(0,0,0), ImGui_NrmSize(vDimensions));
			StationGuiBG_Scanlines();
			TerminalStatic(0.1f);
		}
		
		//////////////////////////////////////
		// Reset static so we can see the image
		if (fTimer > (fStaticTime+0.5f))
		{
			fTimer = 0.0f;
			fStaticTime = cMath_RandRectf(1.25f,3.25f);
			ImGui_SetStateFloat("CreepyStaticMax",fStaticTime);
		}
		

		float fImageCycle = ImGui_GetStateFloat("CreepyImageTimer",0.0f);
		fImageCycle += afTimeStep;
		if (fImageCycle > 3.0f)
		{
			lCreepyImageLoop++;
			if (lCreepyImageLoop >= 3)
			{
				lCreepyImageLoop = 0;
				cLux_AddDebugMessage("Reset!");
			}
				
			fImageCycle = 0;
		}
		ImGui_SetStateInt("CreepyImageLoop",lCreepyImageLoop);
		ImGui_SetStateFloat("CreepyImageTimer",fImageCycle);
		
			
		ImGui_SetStateFloat("CreepyStaticTimer",fTimer);
		
	}
	
	//-----------------------------------------------------------------------------
	
	void TerminalStatic(float afAlpha=1.0f, tString asEntity="")
	{
		tString sTag = "";
		
		if (asEntity != "")
		{
			sTag = Entity_GetVarString(asEntity,"");
		}
		
		cVector2f vSize;
		cVector3f vPos=ImGui_NrmPosGroup(cVector3f(0.0f, 0.0f, 2.0f));
				
		cImGuiGfx imageGfx;
		if (ImGui_RepeatTimer("StaticIndex", 0.1))
		{
			ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
			ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
		}
		imageGfx.SetFile("static_"+ImGui_GetStateInt("StaticImageIndex", 0)+".tga");
		imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, afAlpha);
		vSize = ImGui_NrmSizeGroup(cVector2f(1.0, 1.0f));
					
		ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
		
		ImGui_GroupBegin(vPos, vSize);
			ImGui_DoImage(imageGfx, 0, ImGui_NrmSizeGroup(1));
		ImGui_GroupEnd();
		ImGui_SetModRotateAngle(0);
		
	}
	
	void TerminalCabin_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		TerminalStatic();
	}
	
	//-----------------------------------------------------------------------------
	
	void OnGuiSafetyProcedures(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_02_ms_curie_inside");
		
		//////////////////////////////
		// Widget data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		window.mColorBase = gStationGuiColor_Normal;
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(18);
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));
			ImGui_DoTextFrameExt("SafetyProcedures", ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 5, 0, textData, 
								 ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	float mfCaptainsLogTimer = 0;
	int mlCaptainsLogPage = 1;
	int mlCaptainsLogMaxPages = 3;
	float mfCaptainsLogAlpha = 0.0f;
	bool mbLogTransition = false;
	
	void OnGuiCaptainsLog(const tString&in asEntityName, float afTimeStep)
	{
		//////////////////////////////////
		// Pulse recording message
		/*mfCaptainsLogTimer += afTimeStep;
		if (fAlpha < 0)
			fAlpha *= -1;*/
		
		
		mfCaptainsLogAlpha = cMath_InterpolateLinear(mfCaptainsLogAlpha,1.0f,afTimeStep*2.0f);
		
		
		
		//////////////////////////////
		// Window data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		window.mColorBase = gStationGuiColor_Normal;
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(16);
		textData.mFontAlign = eFontAlign_Left;
		textData.mFont.mColor.a = mfCaptainsLogAlpha;
		
		/////////////////////////////////
		// Button
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		bool bDoPrev = mlCaptainsLogPage > 1 ? true : false;
		bool bDoNext = mlCaptainsLogPage < mlCaptainsLogMaxPages ? true : false;
		
		if (mbLogTransition)
		{
			mfCaptainsLogTimer += afTimeStep;
			mfCaptainsLogAlpha = 0;
			if (mfCaptainsLogTimer > 0.1f)
			{
				mbLogTransition = false;
			}
		}
		
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));
		
			ImGui_SetTransCategory("");
			ImGui_DoLabel("["+mlCaptainsLogPage + "/" + ""+mlCaptainsLogMaxPages+"]",ImGui_NrmPosGroup(cVector3f(0.46, 0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			//ImGui_DoTextFrameExt(, ImGui_NrmSizeGroup(cVector2f(0.8, 0.1)), 5, 0, textData, ));
			
			ImGui_SetTransCategory("02_02_ms_curie_inside");
			ImGui_DoTextFrameExt("CaptainsLog"+mlCaptainsLogPage, ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textData, ImGui_NrmPosGroup(cVector3f(0, -0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
								 
			
			ImGui_SetTransCategory("");
			if (bDoPrev)
			{
				
				if (ImGui_DoButtonExt("ButtonPrev","<<",button, ImGui_NrmPosGroup(cVector3f(0.2, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.2, 0.15))))
				{
					mlCaptainsLogPage--;
					mbLogTransition = true;
					mfCaptainsLogTimer = 0;
					Sound_PlayGui("Entities_Station/tech/terminal_beeps/terminal_forward",1.0);
				}
			}
			
			if (bDoNext)
			{
				if (ImGui_DoButtonExt("ButtonNext",">>",button, ImGui_NrmPosGroup(cVector3f(0.6, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.2, 0.15))))
				{
					mlCaptainsLogPage++;
					mbLogTransition = true;
					mfCaptainsLogTimer = 0;
					Sound_PlayGui("Entities_Station/tech/terminal_beeps/terminal_forward",1.0);
				}
			}
			
			
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	////////////////////////////
	// Screen Room (Screens showing creepy images)
	///////////////////////////
	
	//-----------------------------------------------------------------------------
	
	void terminal_screenroom_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		int lImageNumber = ImGui_GetStateInt("ImageNumber",-1);
		float fTimer = ImGui_GetStateFloat("ImageTimer",0.0f);
		
		fTimer += afTimeStep;
		
		////////////////////////////
		// Display Static
		if (lImageNumber == -1)
		{
			TerminalStatic();
			if (fTimer > 4.0f)
			{
				fTimer = 0.0f;
				lImageNumber = cMath_RandRectl(1,4);
			}
		}
		
		//////////////////////////
		// Display image (selected at random between static);
		else
		{
			ImGui_SetTransCategory("");
			
			ImGui_DoLabel("TODO:",cVector3f(100.0f,100.0f,100.0f),cVector2f_MinusOne,5.0f);
			ImGui_DoLabel("CREEPY IMAGE #"+lImageNumber,cVector3f(100.0f,200.0f,100.0f),cVector2f_MinusOne,5.0f);
			if (fTimer > 5.0f)
			{
				fTimer = 0.0f;
				lImageNumber = -1;
			}
		}
		
		ImGui_SetStateFloat("ImageTimer",fTimer);
		ImGui_SetStateInt("ImageNumber",lImageNumber);
	}
	
	//-----------------------------------------------------------------------------
	
	////////////////////////////
	// Port map Terminal
	///////////////////////////
	
	//-----------------------------------------------------------------------------
	
	tString msPortMapEntry = "PortmapLisbon";
	
	//-----------------------------------------------------------------------------
		
	void PortMapTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_02_ms_curie_inside");
		
		////////////////////////////////////////////
		// Background
		cColor ornamentCol = ImGui_FadeOscillateColor("BlueCornerFade",cColor(1, 0.35f), cColor(1, 0.45f), 1.0f);
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		StationGuiBG_OrnamentBottomRight();
		StationGuiBG_Taskbar();
		
		///////////////////////////////////////////
		// Text Declarations
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(18);
		
		//////////////////////////////
		// Definitions for GUI buttons
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		
		////////////////////////////////
		// Image declarations
		cImGuiGfx gfx_portMap;
		gfx_portMap.SetFile("station/portmap/portmap.tga");
		ImGui_DoImage(gfx_portMap,ImGui_NrmPos(cVector3f(0.475,0.05,0.1)),ImGui_NrmSize(cVector2f(0.5,0.5)));
		
		///////////////////////////////
		// Buttons
		float fLineX = 0.025;
		float fLineY = 0.075;
		
		if (ImGui_DoButtonExt("ButtonMap1","PortmapButton1",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapLisbon";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap2","PortmapButton2",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapCadiz";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap3","PortmapButton3",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapBrest";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap4","PortmapButton4",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapCasablanca";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap5","PortmapButton5",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapDublin";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap6","PortmapButton6",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapPlymouth";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap7","PortmapButton7",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapRabat";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap8","PortmapButton8",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapTangier";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap9","PortmapButton9",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapPathos";
		}
		
		ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(cVector3f(0.475, 0.6, 5)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.275)));
			ImGui_DoTextFrameExt(msPortMapEntry, ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 5, 0, textData, 
								 ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	////////////////////////////
	// Escape Pod Terminals
	///////////////////////////
	
	//-----------------------------------------------------------------------------
	
	bool mbEscapePodScreensActive = false;
	bool mbEscapePodInitializing = true;
	float mfEscapePodGaugeValue = 0.0f;
	float mfEscapePodGaugeMaxValue = 0.0f;
	
	//-----------------------------------------------------------------------------
	
	void DoDialogWindowStart(const tString&in asCaption, const tString&in asText, const cVector2f &in avNrmSize = cVector2f(0.6, 0.2), float afZ=1.5f)
	{
		//////////////////////////////////
		// Setup widget data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		cImGuiTextFrameData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(24, 24);
		textData.mFontAlign = eFontAlign_Center;
		textData.mColorText = cColor(0.8, 1);
		
		///////////////////////////////////////
		// Show message 
		ImGui_DoWindowStart(asCaption, window, ImGui_NrmPosGroup(cVector3f((1.f-avNrmSize.x)*0.5, (1.f-avNrmSize.y)*0.5, afZ)), ImGui_NrmSizeGroup(avNrmSize));
			
			ImGui_DoTextFrameExt(asText, ImGui_NrmSizeGroup(cVector2f(0.05, 0)), 0, 0, textData, 
							  ImGui_NrmPosGroup(cVector3f(0.0, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
	}

	//-------------------------------------------------------
	
	void DoDialogWindowEnd()
	{
		ImGui_DoWindowEnd();
	}	
	
	//-------------------------------------------------------
	
	void DoStatusGaugesHorizontal(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.75, 
								  float afMaxValue = 1.0f, const cColor &in aFillColor = cColor_White, const tString &in asPrefix = "Horizontal")
	{
		afMinValue *= mfEscapePodGaugeValue;
		afMaxValue *= mfEscapePodGaugeValue;
				
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mGfxFill.mColor = aFillColor;
		cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
		vSize.y = (vSize.y/alCount) * afThicknessMul;
		cVector3f vOffsetPos = cVector3f(0, avNrmSize.y/alCount, 0);
		for (int i = 0; i < alCount; i++)
			ImGui_DoGauge(gauge, Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, afMinValue, afMaxValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
	}

	//-------------------------------------------------------
	
	void DoStatusGaugesVertical(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.75, 
								float afMaxValue = 1.0f, const cColor &in aFillColor = cColor_White, const tString &in asPrefix = "Vertical")
	{
		
		afMinValue *= mfEscapePodGaugeValue;
		afMaxValue *= mfEscapePodGaugeValue;
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mGfxFill.mColor = aFillColor;
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
		vSize.x = (vSize.x/alCount) * afThicknessMul;
		cVector3f vOffsetPos = cVector3f(avNrmSize.x/alCount, 0, 0);
		for (int i = 0; i < alCount; i++)
			ImGui_DoGauge(gauge, Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, afMinValue, afMaxValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
	}

	//-------------------------------------------------------
	
	void DoRandomNumbers(int alColumns, int alRows, const cVector3f &in avNrmPos, const cVector2f &in avSpacing, int alFontSize = 2, 
						 int alMinValue = 100, int alMaxValue = 999, const tString &in asPrefix = "Number")
	{		
		for (int i = 0; i < alRows*alColumns; i++)
		{
			ImGui_DoLabel("" + int(Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, alMinValue, alMaxValue)), 
						  ImGui_NrmPosGroup(avNrmPos + cVector3f(avSpacing.x*(i%alColumns), avSpacing.y*(i/alColumns), 0)), cVector2f_MinusOne, alFontSize);
		}
	}
	
	//-----------------------------------------------------------------------------
	
	bool DoLoadingWindow(const tString &in asName, const tString &in asCaption, const tString &in asText, float afLoadTime, bool abReset, float afZ=1.5f)
	{		
		DoDialogWindowStart(asCaption, asText, cVector2f(0.6, 0.2), afZ);
			bool bDone = Depth_ImGui_LoadingGauge(asName, afLoadTime, abReset, ImGui_NrmPosGroup(cVector3f(0.1, 0.5, 1)), 
												  ImGui_NrmSizeGroup(cVector2f(0.8, 0.3)), StationGui_CreateDefaultGaugeData());
		DoDialogWindowEnd();
		
		return bDone;
	}
	
	//-----------------------------------------------------------------------------
	
	void OnGuiEscapePodMap(const tString&in asEntityName, float afTimeStep)
	{
		if (!mbEscapePodScreensActive) return;
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		StationGuiBG_OrnamentBottomLeft();
		StationGuiBG_OrnamentBottomRight();
		StationGuiBG_OrnamentTopRight();
		
		if (mbEscapePodInitializing)
		{
			if (DoLoadingWindow("pod_init", "Booting", "Standby", 2.0f, true))
			{
				mbEscapePodInitializing = false;
			}
			return;
		}
		
		ImGui_DoImage(cImGuiGfx("catherine_large.tga"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
	}

	//-----------------------------------------------------------------------------

	void OnGuiEscapePodStatus(const tString&in asEntityName, float afTimeStep)
	{
		//////////////////////////////////////
		// If pods are not active, display Catherine if appropriate
		if (!mbEscapePodScreensActive)
		{
			OnGuiEscapePodCatherine(asEntityName, afTimeStep);
			return;		
		}
		
			
		ImGui_SetTransCategory("");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		StationGuiBG_OrnamentBottomLeft();
		StationGuiBG_OrnamentBottomRight();
		StationGuiBG_OrnamentTopRight();
		
		if (mbEscapePodInitializing)
		{
			if (DoLoadingWindow("pod_init", "Booting", "Standby", 2.0f, true))
			{
				mbEscapePodInitializing = false;
			}
			return;
		}
		
		mfEscapePodGaugeValue = cMath_InterpolateLinear(mfEscapePodGaugeValue,mfEscapePodGaugeMaxValue,afTimeStep);
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		ImGui_DoWindowStart("Status", window, ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 3)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
		
			DoStatusGaugesHorizontal(5, cVector3f(0.1, 0.1, 1), cVector2f(0.75, 0.525));
			DoStatusGaugesVertical(4, cVector3f(0.55, 0.7, 1), cVector2f(0.2, 0.19), 0.6, 0.3, 0.9);
			DoRandomNumbers(3, 2, cVector3f(0.15, 0.7, 1), cVector2f(0.1, 0.1), 2, 10, 99);
			
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	void OnGuiEscapePodCatherine(const tString&in asEntityName, float afTimeStep)
	{
		if (mbCathPluggedIn == false) return;
		
		/////////////////////////////
		// Display Catherines face
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		ImGui_DoImage(cImGuiGfx("catherine_large.tga"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));

	}
	
	//-----------------------------------------------------------------------------
	
	//////////////////////////////////////////
	// Terminal - Electric room cylinders
	//////////////////////////////////////////
	
	//-----------------------------------------------------------------------------
	//-----------------------------------------------------------------------------
	
	void CylinderTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_02_ms_curie_inside");
		//tString sState = Entity_GetVarString(asEntityName,"");
		
		StationGuiBG_Scanlines();
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.075);
		ImGui_SetDefaultLabel(label);
		
		cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
		textFrame.mFont.mvSize = 40.0f;
		textFrame.mbUseBackgroundGfx = false;
		textFrame.mFontAlign = eFontAlign_Center;
		
		
		
		////////////////////////////////
		// Set warning text
		tString sTemperatureCat = "CoreTemperatureStable";
		tString sActionText = "CoreActionStable";
		cColor colorTemperature = cColor_White;
		
		if (mlTentaclesDetached >= 3)
		{
			sTemperatureCat = "CoreTemperatureCritical";	
			sActionText = "CoreActionCritical";
			colorTemperature = cColor_Red;
		}
		else if (mlTentaclesDetached >= 2)
		{
			sTemperatureCat = "CoreTemperatureWarning";	
			sActionText = "CoreActionWarning";
			colorTemperature = cColor(1,0.75,0,1);
		}
		else if (mlTentaclesDetached >= 1)
		{
			sTemperatureCat = "CoreTemperatureModerate";	
			sActionText = "CoreActionModerate";
			colorTemperature = cColor(0,1,0,1);
		}
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		gauge.mbUseBackgroundGfx = true;
		gauge.mGfxFill.mColor = colorTemperature;
		
		
		////////////////////////////////
		// Set target temperature
		float fTemperature = 0.1f;
		fTemperature += mlTentaclesDetached * 0.15f;
		if (mlTentaclesDetached >= 3) fTemperature = 1.0f;
		
		float fCurrentTemp = ImGui_GetStateFloat("CoreTemperature",0.0f);
		fCurrentTemp = cMath_InterpolateLinear(fCurrentTemp, fTemperature, afTimeStep * 2.0f);
		ImGui_SetStateFloat("CoreTemperature",fCurrentTemp);
		
		/////////////////////////////
		// Periodically flash a really big warning
		float fWarningTimer = ImGui_GetStateFloat("BigWarningTimer",0.0f);
		fWarningTimer += afTimeStep;
		if (fWarningTimer > 6.0f) fWarningTimer = 0.0f;
		ImGui_SetStateFloat("BigWarningTimer", fWarningTimer);
		
		if (sTemperatureCat == "CoreTemperatureCritical" && fWarningTimer > 3.0f)
		{
			GuiAbandonShip(sActionText, afTimeStep);
			return;
		}

		
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 3)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.95)));
		
			///////////////////////////
			// Show temperature gauge
			ImGui_DoGauge(gauge,fCurrentTemp,ImGui_NrmPosGroup(cVector3f(0.1,0.1,3)), ImGui_NrmSizeGroup(cVector2f(0.1f,0.8f)));
			
			ImGui_DoLabel("CoreTemperature",ImGui_NrmPosGroup(cVector3f(0.1,-0.4,3)),ImGui_NrmSizeGroup(1.0f,1.0f));
			
			ImGui_SetModColorMul(colorTemperature);
			ImGui_DoLabel(sTemperatureCat,ImGui_NrmPosGroup(cVector3f(0.1,-0.3,3)),ImGui_NrmSizeGroup(1.0f,1.0f));
			
			ImGui_SetModColorMul(cColor_White);
			ImGui_DoLabel("CoreAction",ImGui_NrmPosGroup(cVector3f(0.1,-0.1,3)),ImGui_NrmSizeGroup(1.0f,1.0f));
			
			float fWarningFlash = ImGui_GetStateFloat("WarningFlash",0.0f);
			fWarningFlash += afTimeStep;
			if (fWarningFlash > 1.0f) fWarningFlash = 0.0f;
			ImGui_SetStateFloat("WarningFlash",fWarningFlash);
			
			if (mlTentaclesDetached >= 2 && fWarningFlash > 0.5f)
			{
				ImGui_SetModColorMul(cColor_Red);
				ImGui_DoLabel(sActionText,ImGui_NrmPosGroup(cVector3f(0.1,-0.0,3)),ImGui_NrmSizeGroup(1.0f,1.0f));	
			}
			else if (mlTentaclesDetached < 2)
			{
				ImGui_SetModColorMul(cColor_White);
				ImGui_DoLabel(sActionText,ImGui_NrmPosGroup(cVector3f(0.1,-0.0,3)),ImGui_NrmSizeGroup(1.0f,1.0f));	
			}
			
		ImGui_DoWindowEnd();
	}
	
	//------------------------------------------
	
	void GuiAbandonShip(tString asActionText, float afTimeStep)
	{

		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.15f);
		ImGui_SetDefaultLabel(label);
		
		ImGui_SetModColorMul(cColor_Red);
		ImGui_DoLabel(asActionText,ImGui_NrmPosGroup(cVector3f(0.0,-0.12,3)),ImGui_NrmSizeGroup(1.0f,1.0f));	
	}
	
}
