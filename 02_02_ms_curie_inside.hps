	//-------------------------------------------------------
	
	///////////////////////////////////////////
	// FLESHER CHASE
	///////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupFinalChase()
	{
		/////////////////////////////////////////
		// Activate the flesher but leave senses turned off for now
		Entity_SetActive("agent_flesher_finalchase",true);
		Agent_SetSensesActive("agent_flesher_finalchase",false);
		
		OpenChaseDoors();
	}
	
	//-------------------------------------------------------
	
	void OpenChaseDoors()
	{
		/////////////////////////////
		// Help the players flow by forcing these doors to be open
		SwingDoor_SetOpenAmount("swingdoor_gate_electrical_1",1.0f);
		
		
		PhysicsSlideDoor_AutoMoveToState("CargoBayDoor",1);
		PhysicsSlideDoor_AutoMoveToState("shipwreck_slidedoor_medium_1",1);
		PhysicsSlideDoor_AutoMoveToState("shipwreck_slidedoor_medium_4",1);
		SlideDoor_SetOpenAmount("Floor3Door_Middle",1.0f,true);
		PhysicsSlideDoor_AutoMoveToState("Floor2Door",1);
	}
	
	//-------------------------------------------------------
	
	void BeginFinalChase()
	{
		StartEscapeMusic();
		
		/////////////////////////////
		// Kick off the chase
		Flesher_SetHuntOnlyAttackWhenLooking("agent_flesher_finalchase", true);
		Agent_SetSensesActive("agent_flesher_finalchase",true);
		Map_AddTimer("timer_finalchase",1.0f,"TimerFinalChase");
		
		//////////////////////////////
		// Make Flesher scream
		cLux_AddTodoMessage("SOUND: Player MUST hear the flesher screech here to alert the player that danger is near");
		Sound_CreateAtEntity("sfx_scream_finalchase","NPC_Creatures/Vocalisations/InWorld/Flesher/ladder_scream","agent_flesher_finalchase",0.0f, false, 1.0f);
	}
	
	//-------------------------------------------------------
	
	void TimerFinalChase(const tString &in asTimer)
	{
		Agent_RevealPlayerPosition("agent_flesher_finalchase");
		Flesher_HuntPlayer("agent_flesher_finalchase");
		Map_AddTimer("timer_finalchase",0.5f,"TimerFinalChase");
	}
	
	//-------------------------------------------------------
	
	void StopFinalChase()
	{
		Map_RemoveTimer("timer_finalchase");
		Entity_SetActive("agent_flesher_finalchase",false);
	}

	//}------------------------------------------------------
	
