	// Scene 1 - Begin music
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideAreaBeginMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		cLux_AddTodoMessage("SOUND/MUSIC : Enter the survival horror");
		StartAmbientCurieMusic();
		
		return false;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Scene 1 - Open locker, debris comes out
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollisionDebrisLockerOpened(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(cScript_GetGlobalVarBool("2.1LockerSceneOccured") == true) return false; //Locker is in 2.1 transfer area
		
		for (int i = 1; Entity_Exists("LockerDebris_" + i); i++)
		{
			Prop_SetStaticPhysics("LockerDebris_" + i, false);
			cVector3f vImpulse = cVector3f(1.f, cMath_RandRectf(-0.5f, 0.5f), cMath_RandRectf(-0.5f, 0.5f));
			vImpulse.Normalize();
			Entity_AddImpulse("LockerDebris_" + i, vImpulse * 0.3f, false, true);
		}
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void PlayerInteract_EntranceDoor(const tString &in asEntity)
	{
		/////////////////////////////////////
		// Feedback to indicate that the entrance door is locked and player cannot go back
		if(Map_TimeHasPassed("EntranceDoor",2)==false) return;
		
		Sound_CreateAtEntity("JammedDoor", "Entities_Station/doors/electrical_doors/door_heavy_jam", asEntity, 0.1f, false);
	}
	
	
	
