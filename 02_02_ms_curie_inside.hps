	//------------------------------------------------------
	
	bool CollideFlesherEntersPod(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////////////////////////
		// Player needs to be inside the pod for this to happen and the warning must not have been played
		if (Entity_GetCollide("Player","PodArea") == false) return true;
		if (mbFlesherInPodWarningGiven) return false;
			
		//////////////////////////////////////////
		// It is possible that this flesher gets inside the escape pod while Simon is in there
		cLux_AddTodoMessage("SCRIPT/DIALOG: Look out Simon!");
		Voice_Play("2C_FlesherEntersLifeboat");
		
		mbFlesherInPodWarningGiven = true;
		
		return false;
	}
	
	//------------------------------------------------------
	
	bool CollideFlesherPodWarning(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////////////////
		// Flesher must be inside pod and the warning must not have been played
		if (Entity_GetCollide("Agent_Flesher_Ladder","PodArea") == false) return true;
		if (mbFlesherInPodWarningGiven) return false;
		
		/////////////////////////////////////////////////
		// If the flesher is already inside the pod when Simon enters we also play a warning
		Voice_Play("2C_FlesherEntersLifeboat");
		
		mbFlesherInPodWarningGiven = true;
		return false;
	}
	
