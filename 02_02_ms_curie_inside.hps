	//-------------------------------------------------------
	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed)
	{	
		if(abPressed==false) return;
	
		if(alAction == eAction_Test1)
		{
			//Entity_SetActive("Reactor_Flesher_1",true);
			//Map_AddTimer("timer_debugreactorflesher",1.0,"TimerFleshersOpenReactorDoor");
			//Map_AddTimer("timer_seq_drainwater",1.0f,"SequenceDrainWater");
			//Entity_SetActive("Agent_Flesher_Electrics", false);
			
			/*cLux_AddDebugMessage("Activating flesher");
			Entity_SetActive("agent_flesher_finalchase",true);
			Flesher_HuntPlayer("agent_flesher_finalchase");*/
			
			OpenChaseDoors();
		}
		
		if(alAction == eAction_Test2)
		{
			/*mbFinalChaseInProgress = true;
			SetEmergencyLampsActive(true);
			SlideDoor_SetOpenAmount("CargoBayDoor",1.0f,true);
			SlideDoor_SetOpenAmount("StorageRoomDoor",1.0f,true);
			SlideDoor_SetOpenAmount("StorageRoomDoor_1",0.0f,true);*/
			
			//Entity_SetActive("Agent_Flesher_Chase",true);
			//Flesher_HuntPlayer("Agent_Flesher_Chase");
			
			//SetupEscapeSequence();
			
			mbWAURemoved = true;
			CollideAreaEscapeInPod("","",1);
			
			
			//SequenceFallingCylinders("");
			//Prop_SetStaticPhysics("ElectricFallingCylinder*",false);
		}
		
		
		if(alAction == eAction_Test3)
		{
		//SequenceFlesherBreaksGlass("");
		////////////////////////////////////////
		// Hanging cargo box just falls straight down
		Entity_SetActive("block_box_cargocrate",false);
		Prop_SetStaticPhysics("CargoBox_1",false);
		Entity_SetInteractionDisabled("CargoBox_1",true);
		
		Entity_SetActive("AreaChaseHangingCrate_*",false);
		TiltCurieLeft(true);
		}
		
		
		
		if (alAction == eAction_Test4)
		{
			OnChangeLadderWheel("",1);
			//Entity_SetActive("BlockBoxEscapePod",false);
			//SwingDoor_PushOpen("Swingdoor_EscapePod",2.0f,4,0.1f);
			//SwingDoor_SetDisableAutoClose("Swingdoor_EscapePod*",false);
			//SwingDoor_SetClosed("Swingdoor_EscapePod*",false,true);
			//SwingDoor_SetOpenAmount("Swingdoor_EscapePod*",0.1f);
			
			
		}
		if (alAction == eAction_Test5)
		{
			SwingDoor_PushOpen("Swingdoor_EscapePod",-2.0f,6,0.1f);
			Entity_SetActive("BlockBoxEscapePod",true);
			//SwingDoor_SetClosed("Swingdoor_EscapePod*",true,true);
			Entity_SetInteractionDisabled("Swingdoor_EscapePod*",true);
		}
		if (alAction == eAction_Test6)
		{
			Entity_SetInteractionDisabled("Swingdoor_EscapePod*",false);
			//Entity_AddImpulse("SwingDoor_EscapePod",cVector3f_Right*10000.0f,true,false);
			Entity_AddForce("Swingdoor_EscapePod*",cVector3f_Up*50000.0f,true,true);
		}
		
		////////////////////////////
		//Allow leaving level.
		if (alAction == eAction_Test8)
		{
			OnElectricsPuzzleSolved();
		}
	
		if (alAction == eAction_Test9)
		{
			cLux_AddDebugMessage("****************************************************");
			cLux_AddDebugMessage("****** SKIPPING DIALOGUE! USE THIS WISELY!!! *******");
			cLux_AddDebugMessage("****************************************************");
			Voice_SkipCurrentLine("CathMeeting");
		}
	}
	
	void OnPlayerKilled(int alNumberOfRecentDeaths, const tString &in asSource)
	{
		//////////////////////////////////////////
		// Allow message from Catherine when returning to the pod
		mbPlayerWasKilled = true;
		
		if (mbPlayerKilledMessageAllowed)
		{
			Entity_SetActive("AreaActivatePodReturn_*",true);
		}
	}
	
	//-------------------------------------------------------
	
	void TimerFadeIn(const tString &in asTimer)
	{
		Effect_Fade_In(5.0);
		Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldAll);
		Music_FadeVolumeMul(1.0f, 5.0f);
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// MAIN FUNCTIONS
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbFinalChaseInProgress = false;
	bool mbLifeboatAvailable = false;
	bool mbWAURemoved = false;
	bool mbCathPluggedIn = false;
	bool mbFoundPowerRoom = false;
	bool mbPlayerWasKilled = false;
	
	//-------------------------------------------------------
	
	bool mbPreloadDone = false;
	void AttemptPreloadHere()
	{
		if (mbPreloadDone) return;
		
		if(cLux_ScriptDebugOn()==false)
		{
			cLux_AddDebugMessage("Attempt preload issued");
			Map_Preload("02_03_delta.hpm");
			mbPreloadDone = true;
		}
	}
	
	//------------------------------------------------------
	
	void SetEmergencyLampsActive(bool abActive)
	{
		Lamp_SetLit("warning_lamp_*",abActive,abActive);
		
		if (abActive == false)
		{
			Entity_StopAnimation("warning_lamp_*");
		}
		else
		{
			Entity_PlayAnimation("warning_lamp_*","spin",0.1f,true);
			
		}
	}
	
	//------------------------------------------------------

	//////////////////////////////////////////
	// WAU FLOWERS
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	
	void DrainAllWauFlowers()
	{
		EnergySource_SetEnergy("wau_flower*",0.0f);
	}
	
	//------------------------------------------------------
	
	//////////////////////////////////////////
	// Ship Tilting
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void TimerTestTilt(const tString &in asTimer)
	{
		if (asTimer == "timer_tilt_1")
			TiltCurieLeft(true);
		if (asTimer == "timer_tilt_2")
			TiltCurieRight(true);
		if (asTimer == "timer_tilt_3")
			TiltCurieReset(true);
			
		Map_AddTimer("timer_tilt_"+cMath_RandRectl(1,3),5.0f,"TimerTestTilt");
	}
	
	void TiltCurieReset(bool abShake)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/tremor_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 1.5f);
		Map_AddTimer("TiltMixerReturn", 2.5f, "TiltMixerReturn");
		StopEscapeAlarms(1.5f);
		StartAlarmSequence();
		Sound_Fade("BigAlarm", 0.25f, 0.5f);
		Music_FadeVolumeMul(0.55f, 1.5f);
		
		Player_FadeRollTo(0.0f,15.0f,7.0f);
		Effect_Shake_Start(0.1,2.0f,1.0f,1.0f);
	}
	
	void TiltCurieLeft(bool abShake)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/tremor_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 0.5f);
		Map_AddTimer("TiltMixerReturn", 2.5f, "TiltMixerReturn");
		StopEscapeAlarms(1.5f);
		StartAlarmSequence();
		Sound_Fade("BigAlarm", 0.25f, 1.5f);
		Music_FadeVolumeMul(0.55f, 1.5f);
		
		Player_FadeRollTo(-15.0f,5.0f,5.0f);
		Effect_Shake_Start(0.025,2.0f,1.0f,1.0f);
	}
	
	void TiltCurieRight(bool abShake)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/tremor_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 0.5f);
		Map_AddTimer("TiltMixerReturn", 2.5f, "TiltMixerReturn");
		StopEscapeAlarms(1.5f);
		StartAlarmSequence();
		Sound_Fade("BigAlarm", 0.25f, 1.5f);
		Music_FadeVolumeMul(0.55f, 1.5f);
		
		Player_FadeRollTo(15.0f,5.0f,5.0f);
		Effect_Shake_Start(0.025,2.0f,1.0f,1.0f);
	}
	
	void TiltMixerReturn (const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 6.5f);
		Sound_Fade("BigAlarm", 1.0f, 3.0f);
		Music_FadeVolumeMul(1.0f, 3.0f);
		StartEscapeAlarms(2.0f);
		Depth_Audio_Fear_HighIntensity(12.0f, 5.0f, 1, false, true);
	}
		
	//-----------------------------------------------------------------------------------------
	
	bool OnCollideCrateFall(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		cLux_AddDebugMessage("Child = " + asChild);
		
		//Prop_StopMovement(asChild);
		
		Prop_SetStaticPhysics(asChild,false);
		Entity_AddImpulse(asChild,cVector3f(5,0,0),false,true);
		
		return false;
	}
	
	//-----------------------------------------------------------------------------------------
	
	bool OnCollideAreaChaseHangingCrate(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (!mbFinalChaseInProgress) return true;
		
		////////////////////////////////////////
		// Hanging cargo box just falls straight down
		Entity_SetActive("block_box_cargocrate",false);
		Prop_SetStaticPhysics("CargoBox_1",false);
		Entity_SetInteractionDisabled("CargoBox_1",true);
		Entity_SetActive("falling_crate_cable_*",false);
		
		Entity_SetActive("AreaChaseHangingCrate_*",false);
		TiltCurieLeft(true);
		
		///////////////////////////
		// Begin the chase
		
		
		//Map_AddTimer("timer_cratecables",0.75f,"TimerCrateCables");
		
		return false;
	}
	
	void TimerCrateCables(const tString &in asTimer)
	{
		Prop_SetStaticPhysics("falling_crate_cable_*",false);
	}
	
	//-----------------------------------------------------------------------------------------
	
	bool OnCollideAreaTiltCurie(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (!mbFinalChaseInProgress) return true;
		
		// Get uservar from area
		tString sDirection = Entity_GetVarString(asChild,"");
		
		////////////////////////////
		// Tilt left/right, with or without shake
		if (sDirection == "left")
		{
			TiltCurieLeft(true);
		}
		else if (sDirection == "right")
		{
			TiltCurieRight(true);
		}
		else if (sDirection == "leftnoshake")
		{
			TiltCurieRight(false);
		}
		else if (sDirection == "rightnoshake")
		{
			TiltCurieRight(false);
		}
		
		///////////////////////////
		// When in the bridge room (floor 1)
		else if (sDirection == "lockers")
		{
			TiltCurieRight(false);
			SwingDoor_PushOpen("locker_bridge_1",5.0f,4,0.1f);
			SwingDoor_PushOpen("locker_bridge_2",3.0f,4,0.1f);
			SwingDoor_PushOpen("locker_bridge_3",2.0f,4,0.1f);
		}
		
		///////////////////////////
		// Fall through to reset camera to middle
		else
		{
			TiltCurieReset(false);
		}
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollideAreaChaseSlidingCrates(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (!mbFinalChaseInProgress) return true;
		
		TiltCurieRight(true);
		Prop_MoveLinearTo("cargo_crate_19","cargo_crate_19_target",0.75f,0.75f,0.75f,false);
		return false;
	}
	
