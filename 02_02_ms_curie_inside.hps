	void TimerInactivateEntity(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, false);
	}
	
	//-----------------------------------------------------------------------------
	
	void TimerLightLamp(const tString &in asTimer)
	{
		Lamp_SetLit(asTimer, true, true);
	}
	
	//-----------------------------------------------------------------------------
	
	void TimerTurnOffLamp(const tString &in asTimer)
	{
		Lamp_SetLit(asTimer, false, true);
	}
	
