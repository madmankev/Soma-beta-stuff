	// Fish comes out of closet
	///////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollisionFishLeavesCloset(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_AddImpulse("FishLocker", cVector3f_Forward*3, true, true);
		Entity_SetActive("LockerFish", true);
		cLux_AddTodoMessage("Sound: Somewhat loud metal slam sound.");
		Sound_CreateAtEntity("LockerFishEmerge", "physics/metal/hollow/impact", "LockerFish", 0, false);
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollisionLockerFishTarget(const tString &in asParent, const tString &in asChild, int alState)
	{
		// Simple path for locker fish
		
		if (asParent == "LockerFishTarget_1")
			Critter_SetGroupEntity(asChild, "LockerFishTarget_2");
		else if (asParent == "LockerFishTarget_2")
			Critter_SetGroupEntity(asChild, "LockerFishTarget_3");
		else if (asParent == "LockerFishTarget_3")
			Critter_SetGroupEntity(asChild, "LockerFishTarget_4");
		return false;
	}
	
	//-------------------------------------------------------
	
	void LookAtLockerFish(const tString &in asEntity, int alState)
	{
		if (alState == 1)
		{
			Map_RemoveTimer("LockerFishRemoveTimer");
		}
		else
		{
			// Delay removal slightly so player has a chance to turn around as it goes behind him
			Map_AddTimer("LockerFishRemoveTimer", 2.f, "TimerRemoveLockerFish");
		}
		
	}
	
	//-------------------------------------------------------
	
	void TimerRemoveLockerFish(const tString &in asTimer)
	{
		Entity_SetActive("LockerFish", false);
	}
	
