		//-------------------------------------------------------
		//Airlock audio
		void EndAirlockEffectsFillWithWater()
		{
			Depth_Audio_AirlockFillingLeadInAir();
			Depth_Audio_AirlockFillingLoopAir();
			Map_AddTimer("AirlockFillingAirStopTimer", 8.f, "EndAirlockFillingAirStop");
		}

		void EndAirlockFillingAirStop(const tString &in asTimer)
		{
			cLux_AddDebugMessage("Underwater airlock sounds start");
			
			Sound_CreateAtEntity("AirlockFillingLoopUW", "Entities_OceanBottom/airlock/uw/water/filling/loop", "Player", 1.f, false, 1.0f);
			Depth_Audio_AirlockFillingLoopAirStop();
			Depth_Audio_PlayEnterWater();
			
			///////////////////
			//Pump Sounds
			Sound_CreateAtEntity("AirlockFillingPumpLoopUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "AirlockEndPumpSoundSource", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("AirlockPipePourUW", "01_04_transport_station/SFX/airlock/end/water_fill_underwater", "AirlockWaterSoundSource", 0.0f, false, 1.0f);
			Sound_Stop("AirlockAirPump", 0.5f);
			Sound_Stop("AirlockPipePour", 0.5f);
			
			///////////////////
			//Sound area change
			Entity_SetActive("AMB_EndAirlock", false);
			Entity_SetActive("AMB_EndAirlock_Water", true);
			
			Map_AddTimer("AirlockFillingLoopUWStopTimer", 5.0f, "EndAirlockFillingLoopUWStop");
		}
		
		void EndAirlockFillingLoopUWStop(const tString &in asTimer)
		{
			cLux_AddDebugMessage("Underwater airlock sounds stop");
			
			///////////////////
			//Pump Sounds
			Sound_Stop("AirlockFillingLoopUW", 1.25f);			
			Sound_Stop("AirlockFillingPumpLoopUW", 1.25f);
			Sound_CreateAtEntity("AirlockFillingLeadOutUW", "Entities_OceanBottom/airlock/uw/water/filling/end", "Player", 1.f, false, 1.0f);
			Sound_CreateAtEntity("PumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "AirlockEndPumpSoundSource", 0.0f, false, 1.0f);
			Map_AddTimer("PumpChangeUnderwater", 1.5f, "AirlockPumpSoundUnderwater");
		}
		
		void AirlockPumpSoundUnderwater(const tString &in asTimer)
		{
			Sound_Stop("PumpUW", 0.5f);
			Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "AirlockEndPumpSoundSource", 1.0f, false, 1.0f);
			cLux_AddDebugMessage("Underwater airlock pump idle");
		}

