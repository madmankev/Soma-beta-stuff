			Pathfinder_Track_Clear("AmyRobot");
			Pathfinder_Track_Stop("AmyRobot");
			Pathfinder_Track_Add("AmyRobot", "AmyInvestigateVentPos", 8);
			Pathfinder_Track_Add("AmyRobot", "PathNodeArea_44", 8);
			Pathfinder_Track_Start("AmyRobot", false, 1, "EndOfTrackAmyVentInvestigation");
			return false;
		}

