	{
		Sound_CreateAtEntity("Power_Tremor", "01_04_transport_station/Special/Station_PowerOn/PowerOn_Tremor", "Player", 0.0f, false, 1.0f);
		Map_AddTimer("FirstTremorScreenshake", 0.4f, "Audio_PowerSequence_Screenshake");
		Map_AddTimer("SecondTremorScreenshake", 1.35f, "Audio_PowerSequence_Screenshake");
		Sound_FadeGlobalVolume(0.5f, 0.85f);
	}
	
	void Audio_PowerSequence_Screenshake(const tString &in asTimer)
	{
		if(asTimer == "BadExplosion")
		{
			Effect_Shake_Start(0.055f, .85f, 0.01f, 1.2f);
		}
		if(asTimer == "FirstTremorScreenshake")
		{
			Effect_Shake_Start(0.015f, 0.2f, 0.1f, 0.5f);
		}
		if(asTimer == "SecondTremorScreenshake")
		{
			Effect_Shake_Start(0.015f, 0.5, 0.4f, 1.6f);
			Depth_Audio_Fear_LowIntensity(5.f, 10.f, 1, false, true);
			Sound_FadeGlobalVolume(1.f, 3.f);
		}
	}
	
