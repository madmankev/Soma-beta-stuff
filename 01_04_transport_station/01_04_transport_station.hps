		//-----------------------------------------------------------
		
		cSequenceStatesData mSequenceFillAirLock;
		void SequenceFillAirLock(const tString &in asX)
		{
			Sequence_Begin("SequenceFillAirLock", mSequenceFillAirLock);
			
			//Water filling sounds begin
			if(Sequence_DoStepAndWait(1.7))
			{
				MovingButton_SetSwitchedOn("hatch_floor_1", false, true);
				Sound_CreateAtEntity("HatchClose", "01_04_transport_station/SFX/airlock/end/hatch_close", "hatch_floor_1");
				Sound_FadeGlobalVolume(1.0f, 1.0f, eSoundEntryType_WorldClean);
			}
			if(Sequence_DoStepAndWait(1.))
			{
				PreloadDeload();
				
				Sound_CreateAtEntity("AirlockWarning", "Entities_OceanBottom/airlock/alarms/filling_alarm", "EndAirlockAlarmSource");
				Sound_CreateAtEntity("AirlockAirPump", "Entities_OceanBottom/airlock/air/pump/pump_loop", "AirlockEndPumpSoundSource");
			}
			if(Sequence_DoStepAndWait(0.55))
			{
				PreloadSetPrioHigh();
				
				EndAirlockEffectsFillWithWater();
				Sound_CreateAtEntity("ValvesOpen", "01_04_transport_station/SFX/airlock/end/valve_open", "AirlockValveSoundSource");
				Player_SetCrouchDisabled(true);
			}
			if(Sequence_DoStepAndWait(0.5))
			{
				Sound_CreateAtEntity("AirlockPipePour", "01_04_transport_station/SFX/airlock/end/water_fill", "AirlockWaterSoundSource");
				Entity_SetEffectBaseColor("button_reactor_2", cColor(1,1,1,1));
				Entity_SetActive("LadderArea_1", false); //Remove ladder area from first hatch.
			}
			if(Sequence_DoStepAndWait(0.5))
			{
			    ParticleSystem_SetActive("particles_flood_airlock_*", true);
			}
			//Water is activated and begins rising.
			if(Sequence_DoStepAndWait(2.5))
			{
				Music_PlayExt("01_04_airlock.ogg", false, 1, 1, 0.5, 0, eMusicPrio_BigEvent, false);
				Music_Stop(0, eMusicPrio_BgAmb);
				Entity_SetActive("LiquidArea_2", true);
				LiquidArea_MoveLinearTo("LiquidArea_2", "LiquidArea2_EndPos", 0.1, 1, 0.5, false);
			}
			// Comment on the situation
			if(Sequence_DoStepAndWait(4.15))
			{
				Dialog_Begin("SimonComment");
					Dialog_AddBranchAndSubject("SimonOnFloodRoom");
				Dialog_End();
			}
			if(Sequence_DoStepAndWait(0))
			{
				Player_SetCrouchDisabled(false);
				Lamp_SetLit("spotlight_laddershaft", false, false);
				LensFlare_SetVisible("LensFlare_1", false);
				ParticleSystem_Destroy("particles_flood_airlock_*");
				
			}
			//Removing water streaming from ladder passage and the dripping water effects.
			if(Sequence_DoStepAndWait(0.5))
			{
				ParticleSystem_Destroy("ParticleSystem_43");
				Terminal_SetGuiActive("Airlock2GUI",false);
				Entity_SetActive("Airlock2GUI", false);
				
				Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.7f, 0.7f, 0.7f); 
				
				PreloadFadeEffects();
			}
			if (Sequence_DoStepAndWait(3.5f))
			{
				ParticleSystem_CreateAtEntity("bubble_4", "loop_waterbubbles_small_stream.ps", "AreaWaterPipe", false);
				ParticleSystem_CreateAtEntity("bubble_5", "loop_waterbubbles_small_plunge.ps", "hatch_floor_1", false);
				ParticleSystem_CreateAtEntity("bubble_6", "loop_waterbubbles_small_plunge.ps", "BubblePSArea", false);
			}
			
			// End level
			if(Sequence_DoStepAndWait(3.5))
			{
				ParticleSystem_Destroy("bubble_4");
				ParticleSystem_Destroy("bubble_5");
				ParticleSystem_Destroy("bubble_6");
			}
			if(Sequence_DoStepAndWait(0))
			{
				PreloadChangeOfMap();
			}
			Sequence_End();
		}
		
