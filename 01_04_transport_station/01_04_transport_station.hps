	////////////////////////////////
	// ACTIVATE FLASHLIGHT
	////////////////////////////////
	
	//---------------------------------------------
	
	bool CollideActivateFlashlight(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (cScript_GetGlobalVarBool("PlayerActivatedFlashlight") == true) return false;
		if (alState != 1) return true;
		
		Player_SetFlashlightActive(true,false);
		
		return false;
	}
	
