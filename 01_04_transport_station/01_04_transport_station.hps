enum eStatusScreenMsg
{
	eStatusScreenMsg_OK,
	eStatusScreenMsg_DEPART,
	eStatusScreenMsg_JOURNEY,
	eStatusScreenMsg_WARNING,
	eStatusScreenMsg_FAILURE
}

