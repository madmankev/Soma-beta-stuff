		//-------------------------------------------------------

		//If player hasn't interacted with lever - call same function to trigger music and scare event
		bool Audio_TunnelScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbHasSwitchScareTriggered = true;
			Entity_SetActive("Sound_SpookTrigger", false);
			Map_AddTimer("SpookTrigger", cMath_RandRectf(2.5f,4.0f), "Audio_FirstTunnelScare");
			return false;
		}

		//-------------------------------------------------------

		void TimerAmyBreathe(const tString &in asTimer)
		{
			if (asTimer=="AmyBreatheOut")
			{
				cColor targetColor = cColor(0.391,0.871,1,1)*0.6;
				targetColor.a = 0;
				Light_FadeTo("AmyLight_Point_*", targetColor, -1, 3);
				targetColor.a = 1;
				Light_FadeTo("AmyLight_Spot", targetColor, -1, 3);
			}
			else
			{
				cColor targetColor = cColor(0.391,0.871,1,0);
				Light_FadeTo("AmyLight_Point_*", targetColor, -1, 2);
				targetColor.a = 1;
				Light_FadeTo("AmyLight_Spot", targetColor, -1, 2);
			}
		}

		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 2 Event D *Kill Amy and get the power-chip (dialog) (optional)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlTalkToAmyCount_NoPower = 0;
		int mlTalkToAmyCount_BadPower = 0;
		int mlTalkToAmyCount_Final = 0;

		//-------------------------------------------------------
		
		void Interact_AmyCorpse(const tString &in asEntity)
		{
			Dialog_StartConversation("AmyCorpse", asEntity);
			Dialog_Begin();
			if (mPowerState_General == ePowerState_NoPower)
			{
				if (Voice_SubjectExists("TalkToAmy_"+(mlTalkToAmyCount_NoPower+1)))
				{
					mlTalkToAmyCount_NoPower++;
					Dialog_AddBranchAndSubject("TalkToAmy_"+mlTalkToAmyCount_NoPower);
				}
				else
				{
					mlTalkToAmyCount_Final++;
					if (Voice_SubjectExists("TalkToAmy_Final_"+mlTalkToAmyCount_Final)==false)
						mlTalkToAmyCount_Final = cMath_RandRectl(1, 3);
					Dialog_AddBranchAndSubject("TalkToAmy_Final_"+mlTalkToAmyCount_Final);
				}
			}
			else
			{
				if (Voice_SubjectExists("TalkToAmy_CablePulled_"+(mlTalkToAmyCount_BadPower+1)))
				{
					mlTalkToAmyCount_BadPower++;
					Dialog_AddBranchAndSubject("TalkToAmy_CablePulled_"+mlTalkToAmyCount_BadPower);
				}
				else
				{
					mlTalkToAmyCount_Final++;
					if (Voice_SubjectExists("TalkToAmy_CablePulled_Final_"+mlTalkToAmyCount_Final)==false)
						mlTalkToAmyCount_Final = cMath_RandRectl(1, 2);
					Dialog_AddBranchAndSubject("TalkToAmy_CablePulled_Final_"+mlTalkToAmyCount_Final);
				}
			}
			Dialog_End();
		}

		//-------------------------------------------------------
		
		bool Trigger_AmyBackRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("AmyMusicTrigger", false);
			if (alState==1)
			{
				cLux_AddDebugMessage("Amy music look at trigger ACTIVE");
				Entity_SetActive("AmyMusicTrigger", true);
			}
			return true;
		}

		//-------------------------------------------------------
		
		void Detach_AmyCable(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Entity_SetActive(asStickyArea, false);
			
			LightFlash_Add(0, 0.1, 0.1, Map_GetEntity(asStickyArea).GetPosition(), cColor(0.5,0.5,1,1), 1, 5);
			ParticleSystem_CreateAtEntityExt(asStickyArea + "SparkParticles", "ps_impact_metal_high.ps", asStickyArea, false, cColor(0.75,0.75,1,1), 3.f);
			ParticleSystem_CreateAtEntityExt(asStickyArea + "DustParticles", "dust_puff.ps", asStickyArea, false, cColor(0.3f,1));
			Sound_CreateAtEntity(asBodyName+"_Detatch", "01_04_transport_station/SFX/amy/unplug", asStickyArea, 0, false);
			
			////////////////////////////////
			// Weak power on
			if (mPowerState_General == ePowerState_NoPower)
			{
				Terminal_SetImGuiStateFloat("AmyRoomPowerStatus", "Blinking", 1);
				Terminal_FadeImGuiStateFloat("AmyRoomPowerStatus", "Blinking", 0, 3, eEasing_Linear);
				
				Terminal_SetImGuiStateFloat("AmyRoomPowerStatus", "Distortion", 1);
				Terminal_FadeImGuiStateFloat("AmyRoomPowerStatus", "Distortion", 0, 8, eEasing_Linear);
				
				Seq_FirstCable("");
			}
			
			////////////////////////////////
			// Full power on, amy dies
			else
			{
				SetPowerState_General(ePowerState_Good);
				if (mPowerState_Platform == ePowerState_Bad)
					SetPowerState_Platform(ePowerState_Good);
				
				Seq_AmyDeath("");
				
				Entity_SetActive("AmyTalkTrigger", false);
				Entity_SetActive("AmyDeadCheckpoint", true);
			}
		}
		//-------------------------------------------------------

		bool Trigger_AmyDeadCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
		{
			CheckPoint_Setup("");
			AttackMeter_SetAttackerTeleportPosition("MonsterSpawn_AmyTunnel_*");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mFirstCableSequence;
		
		bool mbAmyMusicTriggered = false;
		
		void Seq_FirstCable(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FirstCable", mFirstCableSequence);
					
			if (Sequence_DoStepAndWait(0.5))
			{
				SetPowerState_General(ePowerState_Bad);
				
				//Music
				if(mbAmyMusicTriggered==false)
				{
					Music_Play("01_04_shadow", 0.5f, false, eMusicPrio_BigEvent);
					mbAmyMusicTriggered = true;
				}
				//Bad power sweetener
				Audio_BadPowerSweetenerStart();
			}
			if (Sequence_DoStepAndWait(1))
			{
				Dialog_Begin();
					Dialog_AddBranch("AmyChipPull");
						Dialog_AddSubject("AmyChipPull");
						Dialog_AddPause(0.5);
						Dialog_AddSubject("CantTakeChipComment");
				Dialog_End();
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mAmyDeathSequence;
			
		void Seq_AmyDeath(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AmyDeath", mAmyDeathSequence);
				
			if (Sequence_DoStepAndWait(0.5))
			{
				//Stop bad power sweetener
				Audio_StopBadPowerSweetener();
				
				Entity_SetActive("AmyChipInteract", false);
				Prop_SetStaticPhysics("Amy", false);
				Entity_AddForce("Amy", 1, false, false);
				Entity_SetInteractionDisabled("Amy", false);
				
				//Agent_SetViewRangeMul("AmyRobot", 0.25);
				//Entity_SetEffectsActive("AmyRobot_PowerOff", true, false);
				//Entity_SetActive("ApproachingAmyRobot", true);
				//Entity_SetActive("tunnel_hole_drbris_*", true);
			}
			else if (Sequence_DoStepAndWait(6))
			{
				Voice_StopAll();
				Voice_Play("AmyDeath");
				
				Light_FadeTo("AmyLight_*", cColor(0), -1, 3);
				Map_RemoveTimer("AmyBreatheIn");
				Map_RemoveTimer("AmyBreatheOut");
			}
			else if (Entity_GetCollide("Player", "PowerRoom"))
			{
				cLux_AddTodoMessage("Sound: Amy robot heard booting outside.");
				//Sound_CreateAtEntity("AmyRobotBooting", "Entities_Station/doors/theta_door/unlock_longfalloff", "AmyRobot");
			}
			Sequence_End();
		}

		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 2 Event H *Amy Robot awakens (dialog)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlAmyFallTarget = 0;

		//-------------------------------------------------------
		
		bool Trigger_ApproachingAmyRobot(const tString &in asParent, const tString &in asChild, int alState)
		{
/*			if (alState == 1 || Entity_PlayerIsInFront(asChild)==false)
				return true;
				
			mbAmyRobotActivated = true;
			Seq_AmyRobotAwakens("");*/
			
			return false;
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mAmyRobotAwakensSequence;
			
		void Seq_AmyRobotAwakens(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AmyRobotAwakens", mAmyRobotAwakensSequence);
					
			if (Sequence_DoStepAndWait(0.5))
			{
				cLux_AddTodoMessage("Sound: Amy robot falls to floor.");
				Sound_CreateAtEntity("AmyRobotFallSound", "01_02_upsilon_inside_02/sfx/vent/construct/backtrack", "AmyRobot_PowerOff");
				ParticleSystem_CreateAtEntity("AmyRobotFallPS", "smoke_cloud_oneshot", "AmyRobot_PowerOff", false);
			}
			if (Sequence_DoStepAndPause(0))
			{				
				Prop_MoveLinearTo("AmyRobot_PowerOff", "AmyRobot_Fall_1", 1, 1, 0, true, "MoveTo_AmyRobotFall");
				Prop_AlignRotation("AmyRobot_PowerOff", "AmyRobot_Fall_1", 1, 1.5, 0, true);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Entity_SetActive("AmyRobot_PowerOff", false);
				Entity_SetActive("AmyRobot", true);
				
				Voice_Play("AmyRobotAwakens");
				cScript_RunGlobalFunc("AmyRobot", "cScrAgentConstructCrawler", "SetIdleBarkMachineIdle");

				Map_AddTimer("AmyRobot", 6, "TimerSetAgentSensesActive");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Pathfinder_Track_Clear("AmyRobot");
				Pathfinder_Track_Add("AmyRobot", "PathNodeArea_40", 5, 8);
				Pathfinder_Track_Add("AmyRobot", "PathNodeArea_15", 5, 8);
				Pathfinder_Track_Start("AmyRobot", true);
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void MoveTo_AmyRobotFall(const tString &in asProp)
		{
			mlAmyFallTarget++;
			if (Entity_Exists("AmyRobot_Fall_"+mlAmyFallTarget)==false)
			{
				SequenceStates_Resume("Seq_AmyRobotAwakens");
				return;
			}
			
			Prop_MoveLinearTo(asProp, "AmyRobot_Fall_"+mlAmyFallTarget, 100, 2, 0, false, "MoveTo_AmyRobotFall");
			Prop_AlignRotation(asProp, "AmyRobot_Fall_"+mlAmyFallTarget, 100, 3, 0, true);
		}

