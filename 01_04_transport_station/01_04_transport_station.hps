		//------------------------------------------------------------

		bool mbEscapeLeverPulledOnce = false;
		void StatePulledEscapeLever(const tString &in asEntity, int alState)
		{
			Sound_CreateAtEntity("", "level_01_04/events/metro/door/emergengy_exit_lever", asEntity, 0.0f, false);
			
			if(mbEscapeLeverPulledOnce==false)
			{
				mbEscapeLeverPulledOnce = true;
				
				cLux_GetCurrentMap().GetEntityByName("01_05_transporter_passenger_fronthatch1_1").GetBody(0).SetMass(50);
				Entity_AddImpulse("01_05_transporter_passenger_fronthatch1_1", cVector3f(0.1, 0.5, -6), false, false);
				
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_1", false);
				Entity_SetActive("train_broken_glass_sidehatch", false);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_1_2", true);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_2", false);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_2_2", true);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_3", false);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_3_2", true);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_4", false);
				Entity_SetActive("01_05_transporter_passenger_window_hatch1_4_2", true);
				
				Lamp_SetLit("LightEmergency", false, true);
				
				Entity_SetActive("BloodSplash_1",false);
				Entity_SetActive("BloodSplash_2",false);
				Entity_SetActive("BloodSplash_4",true);
				
				//Swap out train sound area for one that includes tunnel ambience
				Entity_SetActive("AMB_TrainCrashed_Spot", true);
				Entity_SetActive("AMB_TrainCrashed", false);
				
				//Train hatch pop off sounds
				Sound_CreateAtEntity("HatchPop", "01_04_transport_station/SFX/train/hatch_pop", "CrashImpactDustArea");
				Sound_CreateAtEntity("HatchPopLand", "01_04_transport_station/SFX/train/hatch_impact", "CrashImpactDustArea");

				//Stop spark sounds and flesher on train roof sound
				//Sound_Stop("TrainSparks", 0.75f);
				Sound_Stop("TrainAlarm", 0.75f);
				Map_RemoveTimer("TrainAlarmStop");
				Map_RemoveTimer("TrainCartCreepyness");
				Sound_Stop("FlesherTrainLoop", 0.75f);
				cLux_AddDebugMessage("Train cart creepyness timer stopped");
				
				//Quickly fade world during hatch pop to give perception of loudness
				Sound_FadeGlobalVolume(0.5f, 0.1f);
				Map_AddTimer("HatchPopSoundEnd", 2.0f, "HatchPopSoundEnd");	
				
				//Add music timers, one for tunnel welcome piece, one for ambience
				Map_AddTimer("HatchPopSoundMusic", 4.50f, "HatchPopSoundMusic");
				Map_AddTimer("SecondTunnelAmbientMusicStart", cMath_RandRectf(13.f,18.f),"Audio_StartSecondTunnelAmbience");
			}
		}
		
		void HatchPopSoundEnd(const tString &in asTimer)
		{
			PreloadSetPrioNormal();
			
			Sound_FadeGlobalVolume(1.f, 3.f);
			Sound_CreateAtEntity("TunnelAlarm", "01_04_transport_station/Special/Train/post_crash/tunnel_alarm", "Player");
		}
		
		void HatchPopSoundMusic(const tString &in asTimer)
		{
			Music_Play("03_02_emptypack", 0.55f, false, eMusicPrio_BigEvent);
		}
		

