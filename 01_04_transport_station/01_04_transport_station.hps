		//-------------------------------------------------------
	
		/**
		 * Interact on the entrace to the station, only hints about water
		 * */
		void InteractEntranceToStation(const tString &in asEntity)
		{
			cLux_AddTodoMessage("SOUND: Locked door.");
			//TODO MAKE NICE EVENT.
			Entity_SetInteractionDisabled(asEntity, true);
			Map_AddTimer(asEntity, 1, "TimerEnableInteraction");
		}
		
		//------------------------------------------------------------
			
		bool OnTriggerSimonEntryComment(const tString &in asParent, const tString &in asChild, int alState)
		{
			return false;
		}
		
		//------------------------------------------------------------
			
		/**
		 * Pumping out water and opening the entrance to the station
		 **/
		cSequenceStatesData mSequencePumpOutWater;
		void SequencePumpOutWater(const tString &in asX)
		{
			Sequence_Begin("SequencePumpOutWater", mSequencePumpOutWater);

			if(Sequence_DoStepAndWait(2.6))
			{
				////////////////////////////
				////Door begins to open sound
				Map_AddTimer("FadeUp", 6.0f, "LevelAudioFades");
				Sound_CreateAtEntity("airlock_start_open", "01_04_transport_station/SFX/airlock/start/open", "Player", 0.0f, false);
				Sound_CreateAtEntity("airlock_start_wind", "01_04_transport_station/SFX/airlock/start/wind", "Player", 0.0f, false);
				
				///////////////////////////
				////Activate first corridor sound spots
				Entity_SetActive("start_corridor_water_leak", true);
			}
			
			
			else if(Sequence_DoStepAndWait(1))
			{
				Entity_SetActive("StationEntrance", false);
				SlideDoor_SetClosed("StationEntranceDoor", false);
				
				// Light tunnel up a bit
				float fAmb = 0.3f;
				float fFadeTime = 1.25f;
				for(int i=1; i<=13; ++i)
				{
					fFadeTime += 0.25f;
					
					cColor lightColor(fAmb,0);
					
					if(i<=3)
						lightColor.r += 0.2f;
					if(i<=6)
						fAmb -= 0.015f;					
						
					Light_FadeTo("TunnelAmbLight_" + i, lightColor, 5, fFadeTime);
				}
			}
			else
			{
				Entity_SetActive("LiquidArea_1", false);
			}
			
			Sequence_End();
		}
		
		//------------------------------------------------------------
		
		
		bool ExitedAirlock(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Play("01_04_enteringstation", 0.45f, false, eMusicPrio_BigEvent);
			//Lamp_SetLit("lamp_stairs_nopower_*", true, false);
			Lamp_SetFlickerActive("lamp_stairs_nopower_*", true);
			Map_AddTimer("FlickerStairLamps", 1.5f, "TurnOnStairLamps");
			return false;
		}
		
		void TurnOnStairLamps(const tString &in)
        {
		    cLux_AddDebugMessage("lamps should stop flickering");
            Lamp_SetFlickerActive("lamp_stairs_nopower_*", false);
        } 
		
		//-------------------------------------------------------
		//} EVENT
	
	//} END SCENE 1
	
