	//-----------------------------------------------------------
	//Music
	
	void Audio_StationPowerOnMusic(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Station Powered Music Triggered");
		Music_PlayExt("01_04_powerstation", false, 0.75f, 1.0f, 0.0f, 0.0f, eMusicPrio_BigEvent, false);
	}
	
	void Audio_MusicAmbientPart1(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Station Ambient Music Triggered");
		Music_PlayExt("01_04_explorationambience", true, 0.325f, 1.0f, 3.0f, 0.0f, eMusicPrio_BigEvent, false);
	}
	
	bool Audio_StopAmbientMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Stop(3.0f, eMusicPrio_BgAmb);
		return false;
	}
	
	void Trigger_AmySpotMusic(const tString &in asEntity, int alState)
	{
		Music_Play("01_04_discoveringamy", 0.65f, false, eMusicPrio_BigEvent);
	}
	
	//Second tunnel music
	
	bool mbSecondAmbientMusicPlaying = false;
	
	void Audio_StartSecondTunnelAmbience(const tString &in asTimer)
	{
		if (mbSecondAmbientMusicPlaying==false){
		//second ambient music starts here
		mbSecondAmbientMusicPlaying = true;
		Music_PlayExt("01_04_spookytunnel", true, 0.5f, 1.0f, 4.5f, 0.0f, eMusicPrio_BgAmb, true);
		cLux_AddDebugMessage("Second Ambient Music Triggered");
		}
	}
	
	bool FinalAirlockMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		//stop music
		mbSecondAmbientMusicPlaying = false;
		Music_Stop(3.5f, eMusicPrio_BgAmb);
		Map_RemoveTimer("Audio_StartSecondTunnelAmbience");
		cLux_AddDebugMessage("Ambient music stopping");
		
		//if omnitool collected and flesher event is done - spawn restart music trigger incase player wants to do more exploring
		if (Player_ToolIsInInventory("CathTool")==true && mbTrainFlesherEventComplete==true)
		{
			cLux_AddDebugMessage("Resume ambient music trigger enabled");
			Entity_SetActive("Trigger_AmbientMusicResumeEnd", true);
		}
		return true;
	}
	
	bool ResumeAmbientMusicEndTunnel(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbSecondAmbientMusicPlaying==false){
		Entity_SetActive("Trigger_AmbientMusicResumeEnd", false);
		Map_AddTimer("SecondTunnelAmbientMusicStart", cMath_RandRectf(4.f,8.f),"Audio_StartSecondTunnelAmbience");
		}
		return true;
	}
	
	bool ResumeAmbientMusicFlood(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbSecondAmbientMusicPlaying==false){
		Map_AddTimer("SecondTunnelAmbientMusicStart", cMath_RandRectf(8.f,12.f),"Audio_StartSecondTunnelAmbience");
		}
		return false;
	}
	
