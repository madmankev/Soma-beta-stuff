//------------------------------------------------------------

class cScrMap : iScrMap
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ==============
	// VARIABLE CREATION
	// ==============
	//{///////////////////////////////////////

	//------------------------------------------------------------
	
	//AIRLOCK ROOM
	
	//PLAYER
	bool mbPlayerIsSitting;		//True if player is sitting in the train chair.
	
	//TURNING ON LIGHTS/POWER
	bool mbCableConnected;		//True if the power cable is connected to cabinet
	int mlLightValveCount;		//Count at what "power level" the player moved the valve.
	ePowerState mPowerState_General = ePowerState_NoPower; // Keeps track of if the stability of the power.
	ePowerState mPowerState_Platform = ePowerState_NoPower; // Keeps track of if the stability of the power.
	
	//TRAIN DOORS
	tString msCartDoor;			//Which cart door to "animate" when close.
	int mlCartDoorStep;			//Steps through the areas to move the door to during "animation".
	
	//TRAIN CHAIR
	int mlTrainChairRotPos;		//-3, 0 or 3 as rotation speed for chair when sitting down.
	tString msTrainChairCam;	//What of the 3 possible sitting down camera anmations to use (depending on player location relative to chair).
	tString msTrainChairName;	//The name of the chair the player interacted with to sit down.

	//TRAIN POWER
	bool mbTrainIsActivated;	//Checking if train has been activated, if true, the screen rotates down.
	
	//TRAIN SCREEN(s)
	bool mbTrainScreenIsDown;	//Checking if screen is down and should be rotated back up when leaving chair.
	int mlTrainRideMsg;			//Status message to display.
	
	//LEVEL FOG
	cColor mvLevelFogColor;		//Saving the level for color so that it can be set when lights are on.
	
	//} END VARIABLE CREATION
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////
	
	//-------------------------------------------------------
	
	void Setup()
	{
		GetBase().SetDisplayNameEntry("01-04-transport-station");

		///////////////////////////////
		// Setup presets
		{
			// When outside and underwater
			Map_Preset_SetupColorGrading("Outside2.1", "textures/colorgrading/grading_default.dds");
			Map_Preset_SetupFog("Outside2.1", true, 2, 30, 0.4, cColor(2.0 / 255.0, 7.0 / 255.0, 9.0 / 255.0,1), 1.0, true, true);
			Map_Preset_SetupDepthOfField("Outside2.1", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("Outside2.1", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));
			Map_Preset_SetupSecondaryFog("Outside2.1", true, 0, 70, 0.15, cColor(0, 0, 0, 1));
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//------------------------------------------------------------
	
		/////////////////////////////////////////
		// VARIABLE INIT
		/////////////////////////////////////////

		//------------------------------------------------------------
		//AIRLOCK ROOM
		
		//PLAYER
		mbPlayerIsSitting = false;
		
		//TURNING ON LIGHTS/POWER
		mbCableConnected = false;
		mlLightValveCount = 0;
		
		Lamp_SetLit("TrainWarningLamp",false,false);
		
		//TRAIN DOORS
		msCartDoor = "";
		mlCartDoorStep = 1;
		
		//TRAIN CHAIR
		mlTrainChairRotPos = -3;
		msTrainChairCam = "AnimateSitTrainChair";
		msTrainChairName = "";
		
		//TRAIN POWER
		mbTrainIsActivated = false;
		
		//TRAIN SCREEN(S)
		mbTrainScreenIsDown = false;
		mlTrainRideMsg = eStatusScreenMsg_OK;
		
		//LEVEL FOG 
		mvLevelFogColor = cLux_GetCurrentMap().GetWorld().GetFogColor();
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Indoors();
		Tool_PickUp("CathTool", false, false);
		
		PlayerHands_SetHandModel_Diving();
		
		if (cScript_GetGlobalVarBool("PlayerActivatedFlashlight")==false)
			Player_SetFlashlightOnOffCallback("Flashlight_FirstTime");
						
		/////////////////////////////////////////
		// ENTITY INIT
		/////////////////////////////////////////
		
		//Occluder setup
		Entity_SetIsOccluder("technical_occluder_1", true);
		Entity_SetIsOccluder("technical_occluder_2", true);
		Entity_SetIsOccluder("technical_occluder_3", true);
		
		//Button init - turn off pump button at start & end
		Entity_SetEffectBaseColor("button_reactor_2", cColor(0,0,0,0));
		
		//Lamp init - turn off all lights
		Lamp_SetLit("lamp_room_*", false, false);
		Lamp_SetLit("lamp_tunnel_orange_*", false, false);
		Lamp_SetLit("maintenance_hatch_lamp_*", false, false);
		Lamp_SetLit("maintenance_shaft_lamp_*", false, false);
		Lamp_SetLit("lamp_stairs_nopower_*", false, false);
		Lamp_SetLit("amy_room_lamp_*", false, false);
		
		//Light init - turn off warning rotation ligth
		Light_FadeTo("warning_lamp_room_1_rot_SpotLight_*", cColor(-1,-1,-1,-1), 0, 0);
		
		//Liquid init - add particles to the liquid area
		//ParticleSystem_CreateAtEntityExt("underwater_part", "loop_waterdust_liquidarea.ps", "LiquidArea_1", true, cColor(0.104,0.232,0.273,1), 1.f, false, 0, 0, 0, 0);

		
		//Entity init - no interaction until power active in station.
		Entity_SetActive("Area_Transport1_Door*", false);
		Entity_SetInteractionDisabled("hatch_tunnel_maintenance_*", true);
		
		//Entity init - no interaction with level entrance door
		Entity_SetInteractionDisabled("LevelExit", true);
		
		//Entity init - no broken glass on train until crash
		Entity_SetActive("train_broken_glass_*", false);
		
		//No interaction before sitting down in train.
		Entity_SetInteractionDisabled("AreaLeaveChair", true);
		Terminal_SetGuiActive("TrainTerminal", false);
		
		//No panel illumination before power to train.
		Entity_SetEffectsActive("TrainTerminal", false, false);
		Entity_SetEffectsActive("StatusTerminal", false, false);
		Entity_SetEffectsActive("01_05_transporter_passenger_starter_panel_1", false, false);
		Entity_SetEffectsActive("TrainSwitch_1", false, false);
		Entity_SetEffectsActive("TrainSwitch_2", false, false);
		Entity_SetEffectsActive("TrainSwitch_3", false, false);
		
		//No interaction until crash
		Entity_SetInteractionDisabled("LeverEmergency", true);
		
		//Particle init - make these particles invisible
		ParticleSystem_SetVisible("fog_ps_*", false);
		ParticleSystem_SetVisible("steam_ps_*", false);
		ParticleSystem_SetActive("particles_flood_airlock_*", false);
		
		/////////////////////////////////////////
		// AUDIO
		/////////////////////////////////////////

		Sound_PreloadCoreUWSounds();
		Sound_PreloadCoreSounds();
		Sound_PreloadCoreUWInteractions();
		Sound_PreloadCoreInteractions();			
		Sound_PreloadGroup("01_04_transport_station", true);
		Player_SetClothing("default");
		Player_SetFootWear("default");
		
		//Airlock sound
		//Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "Pump_SoundSource", 1.0f, false, 1.0f);
		//Sound_CreateAtEntity("Pump_Idle_Loop_Air", "Entities_OceanBottom/airlock/air/pump/idle_loop", "AirlockEndPumpSoundSource", 1.0f, false, 1.0f);
		
		//Level fade
		//Sound_SetGlobalVolume(0.0f, eSoundEntryType_All);
		//Map_AddTimer("FadeUp", 0.1f, "LevelAudioFades");
		//cLux_AddTodoMessage("SOUND - TEMPORARY FADE HERE FOR NICE INTRO - NEED TO LOOK AT CONSISTENCY WHEN LEVEL STREAMING ACTIVE");
				
		//------------------------------------------------------------
		
		/////////////////////////////////////////
		// EFFECTS INIT
		/////////////////////////////////////////
		
		// No water effects at end tunnel until flower is drained
		ParticleSystem_SetActive("End_tunnel_leak_*", false);
		ParticleSystem_SetActive("End_tunnel_leakimpact_*", false);
		Entity_SetActive("water_tunnel_end_leak_stream_*", false);
		
		//------------------------------------------------------------
		
		//Darken fog color.
		cLux_GetCurrentMap().GetWorld().SetFogColor(cColor(0.034,0.039,0.05,0.196));
		
		//Needed otherwise setting to true later will not work
		Map_SetEnvironmentParticlesActive(false);
		
		/////////////////////////////////////////
		// SCENES
		/////////////////////////////////////////
		
		SetupGetPowerOn();
		SetupCrash();
		
		OnUseCathTool("", "AirlockPanelArea_1"); //Level start with airlock at start drained.
		
		/////////////////////////////////////////
		// DEBUG
		/////////////////////////////////////////
		
		if(cLux_ScriptDebugOn())
		{
			//Preload();
		//Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
			
			LightSwitchLightsOn("*lamp_room*");
			
			mbTrainIsActivated = false;
			
			//To be able to solve power puzzle directly.
			Entity_SetActive("Area_Transport1_Door*", true);
			Prop_SetStaticPhysics("01_05_transporter_passenger_door1", true);
			Entity_SetInteractionDisabled("01_05_transporter_passenger_door1", true);
			PhysicsSlideDoor_SetLocked("01_05_transporter_passenger_door1", false, false);
			
			//To test emergency escape
			//Entity_SetInteractionDisabled("LeverEmergency", false);
			
			//Test radio and status directly from start
			//Terminal_SetGuiActive("01_05_transporter_passenger_radio_1", true);
			
			mlJourneyCrashPoint = 1;
		}
		
		cScript_SetGlobalVarBool("TalkedToCathInLambda", false);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
				
		//Effect_Fade_In(2);
		Map_AddTimer("SimonOnEnterLevel", 3, "Timer_PlayVoice");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		//cLux_AddDebugMessage("Update! "+Voice_SceneInvolvingCharacterIsActive("Player"));
	}

	//-------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;

		if(alAction == eAction_Test1)
		{		
			SetPowerState_General(ePowerState_Bad);
		}
		
		if(alAction == eAction_Test2)
		{		
			SetPowerState_General(ePowerState_Good);
		}
		
		if (alAction == eAction_Test3)
		{
			SetPowerState_Platform(ePowerState_Bad);
		}
		
		if (alAction == eAction_Test4)
		{
			SetPowerState_Platform(ePowerState_Good);
		}
		
		if (alAction == eAction_Test5)
		{
			SetPowerState_Platform(ePowerState_NoPower);
		}
		
		if (alAction == eAction_Test6)
		{
			OnEnterFinalAirlock("", "", 1);
		}
		
		if (alAction == eAction_Test7)
		{
			Terminal_SetGuiActive("Airlock2GUI", true);
			Entity_SetActive("Airlock2GUI", true);
		}
		
		if (alAction == eAction_Test8)
		{
			//Terminal_SetGuiActive("TrainTerminal", true);
			//Terminal_SetOnGuiFunction("TrainTerminal", "OnGUISlideshow");
			msPickedStation="Station08";
			StartSlideshow();
		}
		if (alAction == eAction_Test9)
		{
			Terminal_FadeImGuiStateFloat("TrainTerminal", "SlideFade", 0, 0.3);
			mfSlideTime=0; 
			mCurrentSlide=eSlideShowSlide_Team;
		}
	}
		
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		StationGui_UpdateMouseWheel(alAnalogId, avAmount);
	}
		
	cSequenceStatesData mSequenceTestMonitor;
	void SequenceTestMonitor(const tString &in asX)
	{
		Sequence_Begin("SequenceTestMonitor", mSequenceTestMonitor);

		if(Sequence_DoStepAndWait(1.0f))
		{
			Player_Teleport("Player_StandingInTrain");
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Entity_CallEntityInteract("01_05_transporter_passenger_chair_1");
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			MovingButton_SetSwitchedOn("TrainSwitch_1",true,true);
			MovingButton_SetSwitchedOn("TrainSwitch_2",true,true);
			MovingButton_SetSwitchedOn("TrainSwitch_3",true,true);
			MovingButton_SetSwitchedOn("01_05_transporter_passenger_start_button_1",true,true);
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			msPickedStation="Station03";
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			msPickedStation="Station03";
			mbDeparting=true;
			ImGui_Exit();
			Entity_SetInteractionDisabled("TrainTerminal", true);
			SequenceBeginJourney("");
		}
		
		Sequence_End();
	}
	
	//} END MAIN CALLBACKS
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
		void Flashlight_FirstTime(bool abLit)
		{	
			cLux_AddDebugMessage("You discovered the flashlight!");
			
			/////////////////////////////////////
			// Player discovers their flashlight here... activate!
			//Player_SetFlashlightDisabled(false);
			
			Hint_ShowInfo("Hints","HintFlashlight");
			Timer_PlayFlashlightDiscoveryLine("Timer_PlayFlashlightDiscoveryLine");
			
			cScript_SetGlobalVarBool("PlayerActivatedFlashlight", true);
			
			Player_SetFlashlightOnOffCallback("");
		}
		
		void Timer_PlayFlashlightDiscoveryLine(const tString &in asTimer)
		{
			if (Voice_CharacterIsSpeaking("Player"))
			{
				Map_AddTimer(asTimer, 1, "Timer_PlayFlashlightDiscoveryLine");
				return;
			}
			
			if (Player_GetUnderwater())
			{
				Voice_Play("GetFlashlightUnderwater");
				cLux_AddTodoMessage("SOUND/DIALOG: Underwater flashlight reveal");
			}
			else
			{
				Voice_Play("GetFlashlight");
				cLux_AddTodoMessage("SOUND/DIALOG: Out of water flashlight reveal");
			}
		}
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Generic timers
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void TimerEnableInteraction(const tString &in asTimer)
		{
			Entity_SetInteractionDisabled(asTimer, false);
		}

		//-------------------------------------------------------
		
		//void TimerSwitchMovingButtonOn(const tString &in asTimer)
		//{
		//	MovingButton_SetSwitchedOn(asTimer, true, true);
		//}

		//-------------------------------------------------------
		
		void TimerSwitchMovingButtonOff(const tString &in asTimer)
		{
			MovingButton_SetSwitchedOn(asTimer, false, true);
		}

		//-------------------------------------------------------
		
		void TimerStopPlayerInteraction(const tString &in asTimer)
		{
			if (Entity_IsInteractedWith(asTimer))
			{
				Player_ChangeStateToNormal();
				Player_SetLookSpeedMul(0);
				Player_FadeLookSpeedMulTo(1, 1);
			}
		}

		//-------------------------------------------------------
		
		void TimerSetLampLit(const tString &in asTimer)
		{
			Lamp_SetLit(asTimer, true, true);
		}
		
		//------------------------------------------------------------
		
		void TimerSetLampUnlit(const tString &in asTimer)
		{
			Lamp_SetLit(asTimer, false, true);
		}
		
		//------------------------------------------------------------
		
		void TimerSetLampUnlitNoEffects(const tString &in asTimer)
		{
			Lamp_SetLit(asTimer, false, false);
		}

		//-------------------------------------------------------
		
		void TimerSetTerminalGuiInactive(const tString &in asTimer)
		{
			Terminal_SetGuiActive(asTimer, false, 0.25);
		}

		//-------------------------------------------------------
		
		void Timer_PlayVoice(const tString &in asTimer)
		{
			Voice_Play(asTimer);
		}
		
		//} End Generic timers

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Omnitool
		//{///////////////////////////////////////

		//-------------------------------------------------------
	
		bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			return asEntity=="AirlockPanelArea_1" || asEntity=="AirlockPanelArea_2" ||asEntity=="OmniToolSlot_Area";
		}
		
		//------------------------------------------------------------
		
		bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			// Use omnitool in the first airlock
			if (asEntity=="AirlockPanelArea_1")
			{
				Entity_SetActive("AirlockPanelArea_1", false);
				Entity_SetActive("AirlockToolArea_1", false);
				Button_SetSwitchedOn("AirlockPanel_1", true, true);
				SequencePumpOutWater("pumping_water_not_iron");
				return false;
			}
			
			if (asEntity=="AirlockPanelArea_2")
			{
				Entity_SetActive("AirlockPanelArea_2", false);
				Entity_SetActive("AirlockToolArea_2", false);
				Button_SetSwitchedOn("AirlockPanel_2", true, true);
				StateFillAirLock("AirlockPanel_2", 1);
				return false;
			}
			
			// Use omnitool in the train
			if (asEntity=="OmniToolSlot_Area")
			{
				CathTool_Insert("CathTool", "cath_terminal_landingpad_1");
				Entity_AttachToEntity("CathTool", "01_05_transporter_passenger_1", "", false, false);
				Terminal_SetGuiActive("01_05_transporter_passenger_good_to_go_display_1", true, 1);
				return true;
			}
			return false;
		}
		
		//} End omnitool

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Power states
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void SetPowerState_General(ePowerState aState)
		{
			cLux_AddDebugMessage("General lighting state set: "+aState);
				
			// No power
			if (aState == ePowerState_NoPower)
			{
			    Lamp_SetLit("lamp_tunnel_orange_*", false, false);
			    Lamp_SetLit("lowpower_lamp_*", true, false);
			    Lamp_SetLit("maintenance_shaft_lamp_*", false, false);
				Entity_SetInteractionDisabled("hatch_tunnel_maintenance_*", true);
				//Entity_SetActive("Lamp_PowerState_NoPower_*", true);
				//Entity_SetActive("Lamp_PowerState_Low_*", false);
				//Entity_SetActive("Lamp_PowerState_High_*", false);
				
				//-----------------------------------------------------------
				//Audio
				cLux_AddDebugMessage("Tunnel Ambient Areas switched to NO POWER");
				
				//Turn on Dark Areas
				Entity_SetActive("AMB_StartingTunnel_DARK", true);
				Entity_SetActive("AMB_Station_DARK", true);
				Entity_SetActive("AMB_SideTunnel_DARK", true);
				Entity_SetActive("AMB_VentSpace_Lower_DARK", true);
				Entity_SetActive("AMB_VentSpace_UpperRight_DARK", true);
				Entity_SetActive("AMB_VentSpace_UpperLeft_DARK", true);
				Entity_SetActive("AMB_SideTunnel_Cave_DARK", true);
				
				//Turn off Light Areas
				Entity_SetActive("AMB_StartingTunnel_LIGHT", false);
				Entity_SetActive("AMB_Station_LIGHT", false);
				Entity_SetActive("AMB_SideTunnel_LIGHT", false);
				Entity_SetActive("AMB_VentSpace_Lower_LIGHT", false);
				Entity_SetActive("AMB_VentSpace_UpperRight_LIGHT", false);
				Entity_SetActive("AMB_VentSpace_UpperLeft_LIGHT", false);
				Entity_SetActive("AMB_SideTunnel_Cave_LIGHT", false);
				//-----------------------------------------------------------
			}
			
			// Low power
			else if (aState == ePowerState_Bad)
			{
				
				cLux_AddDebugMessage("Tunnel lights to turn on here - BAD");
				
			    Lamp_SetLit("lamp_tunnel_orange_*", true, false);
				Lamp_SetFlickerActive("lamp_tunnel_orange_*", true);
				Lamp_SetLit("amy_room_lamp_*", true, false);
				Lamp_SetFlickerActive("amy_room_lamp_*", true);
				Lamp_SetLit("lowpower_lamp_*", false, false);
				Lamp_SetLit("lamp_stairs_nopower_*", false, false);
				Entity_PlayAnimation("amy_setpiece", "Fitting", 0.1f, true, false);
				Entity_SetInteractionDisabled("hatch_tunnel_maintenance_*", true);
				//Entity_SetActive("Lamp_PowerState_NoPower_*", false);
				//Entity_SetActive("Lamp_PowerState_Low_*", true);
				//Entity_SetActive("Lamp_PowerState_High_*", false);
			}
			
			// Stable power
			else if (aState == ePowerState_Good)
			{
				cLux_AddDebugMessage("Tunnel lights to turn on here");
				
				Lamp_SetLit("lamp_tunnel_orange_*", true, false);
				Lamp_SetFlickerActive("lamp_tunnel_orange_*", false);
				Lamp_SetLit("lowpower_lamp_*", false, false);
				Lamp_SetLit("maintenance_hatch_lamp_*", true, false);
				Lamp_SetLit("lamp_stairs_nopower_*", false, false);
				Lamp_SetLit("maintenance_shaft_lamp_*", true, false);
				Lamp_SetLit("amy_room_lamp_*", true, false);
				Lamp_SetFlickerActive("amy_room_lamp_*", false);
				Sound_Stop("amy_setpiece_AnimEvent", 1.0f);
				Entity_PlayAnimation("amy_setpiece", "Death", 0.1f, false, false);
				Entity_SetInteractionDisabled("hatch_tunnel_maintenance_*", false);
				//Entity_SetActive("Lamp_PowerState_NoPower_*", false);
				//Entity_SetActive("Lamp_PowerState_Low_*", false);
				//Entity_SetActive("Lamp_PowerState_High_*", true);
			}
			
			mPowerState_General = aState;
		}

		//-------------------------------------------------------
		
		void SetPowerState_Platform(ePowerState aState)
		{
			ePowerState state = aState;
			
			// No power
			if (state == ePowerState_NoPower)
			{
				//Lamps
				Lamp_SetLit("screen_board_1", false, false);
				if (mbPlatformFlowerDrained==false)
					Lamp_SetLit("screen_board_2", false, false);
				Lamp_SetLit("lamp_room_1_*", false, false);
				Lamp_SetLit("lamp_room_2_*", false, false);
				Lamp_SetLit("lamp_room_3_*", false, false);
				Lamp_SetLit("wall_lamp_room_3_*", false, false);
				Lamp_SetLit("cart_lamp_room_3_*", false, false);
				Lamp_SetLit("TrainDoorLamps", false, false);
				Lamp_SetLit("lamp_cargo_train_*", false, false);
				
				Lamp_SetLit("PowerBoxEmergencyLight", true, false);
				
				Lamp_SetFlickerActive("screen_board_*", true);
				Lamp_SetFlickerActive("lamp_room_3_3", false);
				Lamp_SetFlickerActive("lamp_cargo_train_1", false);
				
				//Train ents
				Terminal_SetGuiActive("StatusTerminal", false, 0.5);
				Entity_SetEffectsActive("TrainTerminal", false, false);
				Entity_SetEffectsActive("01_05_transporter_passenger_starter_panel_1", false, false);
				Entity_SetEffectsActive("TrainSwitch_1", false, false);
				Entity_SetEffectsActive("TrainSwitch_2", false, false);
				Entity_SetEffectsActive("TrainSwitch_3", false, false);
				
				Entity_SetActive("Area_Transport1_Door*", false);
				Prop_SetStaticPhysics("01_05_transporter_passenger_door1", false);
				Entity_SetInteractionDisabled("01_05_transporter_passenger_door1", false);
				PhysicsSlideDoor_SetLocked("01_05_transporter_passenger_door1", true, false);
				
				//Effects
				ParticleSystem_SetVisible("fog_ps_*", false);
				ParticleSystem_SetVisible("steam_ps_*", false);
				Map_FadeFogColor(cColor(0.034,0.039,0.05,0.196), 0);
				
				//Audio
				cLux_AddDebugMessage("Platform Ambient Areas switched to NO POWER");
				
				//Turn ON Dark Areas
				Entity_SetActive("AMB_StartingTunnel_DARK", true);
				
				//Turn OFF Light Areas
				Entity_SetActive("AMB_StartingTunnel_LIGHT", false);
			}
			
			// Low power, or if platform flower has been drained
			else if (state == ePowerState_Bad || mbPlatformFlowerDrained)
			{
				state = ePowerState_Bad; // force it to be bad
				
				//Turn buzzing sound for lights in tunnel
				Sound_Play("tunnel_lightbuzz_1", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_2", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_3", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_4", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_5", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_6", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_7", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_8", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_9", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_10", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_11", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_12", 1.0f, false);
				
				//Lamps
				Lamp_SetLit("screen_board_1", false, false);
				if (mbPlatformFlowerDrained==false)
					Lamp_SetLit("screen_board_2", false, false);
				Lamp_SetLit("lamp_room_1_*", false, false);
				Lamp_SetLit("lamp_room_2_*", false, false);
				Lamp_SetLit("lamp_room_3_*", false, false);
				Lamp_SetLit("lamp_room_3_3", true, false);
				Lamp_SetLit("wall_lamp_room_3_*", false, false);
				Lamp_SetLit("cart_lamp_room_3_*", true, false);
				Lamp_SetLit("TrainDoorLamps", true, false);
				Lamp_SetLit("lamp_cargo_train_*", true, false);
				
				Lamp_SetLit("PowerBoxEmergencyLight", false, false);
				
				Lamp_SetFlickerActive("screen_board_*", true);
				Lamp_SetFlickerActive("lamp_room_3_3", true);
				Lamp_SetFlickerActive("lamp_cargo_train_1", true);
				
				//Train ents
				Terminal_SetGuiActive("StatusTerminal", true, 0.5);
				Entity_SetEffectsActive("TrainTerminal", true, false);
				Entity_SetEffectsActive("01_05_transporter_passenger_starter_panel_1", true, false);
				Entity_SetEffectsActive("TrainSwitch_1", true, false);
				Entity_SetEffectsActive("TrainSwitch_2", true, false);
				Entity_SetEffectsActive("TrainSwitch_3", true, false);
				
				Entity_SetActive("Area_Transport1_Door*", true);
				Prop_SetStaticPhysics("01_05_transporter_passenger_door1", true);
				Entity_SetInteractionDisabled("01_05_transporter_passenger_door1", true);
				PhysicsSlideDoor_SetLocked("01_05_transporter_passenger_door1", false, false);
				
				//Effects
				ParticleSystem_SetVisible("fog_ps_*", false);
				ParticleSystem_SetVisible("fog_ps_5", true);
				ParticleSystem_SetVisible("steam_ps_*", false);
				ParticleSystem_SetVisible("steam_ps_1", true);
				ParticleSystem_SetVisible("steam_ps_2", true);
				Map_FadeFogColor(mvLevelFogColor, 0);
			}
			
			// Stable power
			else if (state == ePowerState_Good)
			{
				//Turn buzzing sound for lights in tunnel
				Sound_Play("tunnel_lightbuzz_1", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_2", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_3", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_4", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_5", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_6", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_7", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_8", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_9", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_10", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_11", 1.0f, false);
				Sound_Play("tunnel_lightbuzz_12", 1.0f, false);
				
				//Lamps
				Lamp_SetLit("screen_board_1", true, false);
				if (mbPlatformFlowerDrained==false)
					Lamp_SetLit("screen_board_2", true, false);
				Lamp_SetLit("lamp_room_1_*", true, false);
				Lamp_SetLit("lamp_room_2_*", true, false);
				Lamp_SetLit("lamp_room_3_*", true, false);
				Lamp_SetLit("wall_lamp_room_3_*", true, false);
				Lamp_SetLit("cart_lamp_room_3_*", true, false);
				Lamp_SetLit("TrainDoorLamps", true, false);
				Lamp_SetLit("lamp_cargo_train_*", true, false);
				
				Lamp_SetLit("PowerBoxEmergencyLight", false, false);
				
				Lamp_SetFlickerActive("screen_board_*", false);
				Lamp_SetFlickerActive("lamp_room_3_3", false);
				Lamp_SetFlickerActive("lamp_cargo_train_1", false);
				
				//Train ents
				Terminal_SetGuiActive("StatusTerminal", true, 0.5);
				Entity_SetEffectsActive("TrainTerminal", true, false);
				Entity_SetEffectsActive("01_05_transporter_passenger_starter_panel_1", true, false);
				Entity_SetEffectsActive("TrainSwitch_1", true, false);
				Entity_SetEffectsActive("TrainSwitch_2", true, false);
				Entity_SetEffectsActive("TrainSwitch_3", true, false);
				
				Entity_SetActive("Area_Transport1_Door*", true);
				Prop_SetStaticPhysics("01_05_transporter_passenger_door1", true);
				Entity_SetInteractionDisabled("01_05_transporter_passenger_door1", true);
				PhysicsSlideDoor_SetLocked("01_05_transporter_passenger_door1", false, false);
				
				//Effects
				ParticleSystem_SetVisible("fog_ps_*", true);
				ParticleSystem_SetVisible("steam_ps_*", true);
				Map_FadeFogColor(mvLevelFogColor, 0);
			}
			
			cLux_AddDebugMessage("Platform lighting state set: "+state);
			mPowerState_Platform = state;
		}
		
		//} End power states
	
	//} END MAIN FUNCTIONS
	
