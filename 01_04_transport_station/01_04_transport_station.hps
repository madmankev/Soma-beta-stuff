		//-------------------------------------------------------
	
		/**
		 * The main power switch in the power cabinet.
		 * */
		bool mbHasSwitchScareTriggered = false; 
		void StateLightSwitch(const tString &in asEntity, int alState)
		{
			if(alState != 1) return;
			
			if (mPowerState_General == ePowerState_NoPower)
			{
				Terminal_SetImGuiStateFloat("PlatformPowerTerminal", "Blinking", 8);
				Terminal_FadeImGuiStateFloat("PlatformPowerTerminal", "Blinking", 0, 3, eEasing_Linear);
				Sound_CreateAtEntity("PowerNotReady", "01_04_transport_station/SFX/powerbox/power_notready", "AreaPowerOn_1");
				Sound_CreateAtEntity("SwitchDownSweetener", "01_04_transport_station/SFX/powerbox/switch_downsweet", "electric_switch_1");
				
				if (mbHasSwitchScareTriggered==false)
				{
					//Call scare event and ambient music when player pulls switch
					mbHasSwitchScareTriggered=true;
					Entity_SetActive("Sound_SpookTrigger", false);
					Map_AddTimer("SpookTrigger", cMath_RandRectf(3.5f,5.0f), "Audio_FirstTunnelScare");
				}
				return;
			}
			
			cLux_AddTodoMessage("Script: Make sure the juice for turning on the power state is correct depending on power state.");
			
			Sound_Play("abandoned_train_buzz", 1.0f);
			
			ParticleSystem_CreateAtEntity("spark1", "elec_spark_huge_oneshot.ps", "AreaPowerOn_1", false);
			ParticleSystem_CreateAtEntity("spark2", "elec_spark_huge_oneshot.ps", "AreaPowerOn_2", false);
			
			Lever_SetStuckState("electric_switch_1", 1, false);
			Prop_SetStaticPhysics("tech_pipe_valve_handle_1", true);
			
			Entity_SetInteractionDisabled("electric_switch_1", true);
			
			SlideDoor_SetClosed("StationEntranceDoor", true); //Close entrance door to optimise level.
			
			mlLightValveCount = 5; //!Disabled!: Setting to 5 as disabled activity with setting power level.
			
			if (mPowerState_General == ePowerState_Bad)
			{
				Sound_CreateAtEntity("elec_hum_bad", "01_04_transport_station/AMB/Spot/PowerBox/Bad", "electric_switch_1", 1, true);
				Sound_CreateAtEntity("PowerNotReady", "01_04_transport_station/SFX/powerbox/power_ready", "AreaPowerOn_1");
				Sound_CreateAtEntity("SwitchDownSweetener", "01_04_transport_station/SFX/powerbox/switch_downsweet", "electric_switch_1");
				SequenceTurnOnLights_Bad("");
			}
			else
			{
				Sound_CreateAtEntity("elec_hum_good", "01_04_transport_station/AMB/Spot/PowerBox/Good", "electric_switch_1", 1, true);
				Sound_CreateAtEntity("PowerNotReady", "01_04_transport_station/SFX/powerbox/power_ready", "AreaPowerOn_1");
				Sound_CreateAtEntity("SwitchDownSweetener", "01_04_transport_station/SFX/powerbox/switch_downsweet", "electric_switch_1");
				SequenceTurnOnLights_Good("let_there_be_light_maybe");
			}
		}
		
		//------------------------------------------------------------
		
		void OnGuiPlatformPower(const tString&in asEntityName, float afTimeStep)
		{			
			ImGui_SetTransCategory("01_04_transport_station");
			
			StationGuiBG_BackdropV2();
			StationGuiBG_Scanlines();
			
			tString sText = "PlatformPowerInfo_NoPower";
			if (mPowerState_Platform == ePowerState_Good)
				sText = "PlatformPowerInfo_Good";
			else if (mPowerState_Platform == ePowerState_Bad)
				sText = "PlatformPowerInfo_Bad";
			else if (mPowerState_General != ePowerState_NoPower)
				sText = "PlatformPowerInfo_Ready";
			
			cColor color = mPowerState_Platform == ePowerState_Good ? cColor_Green : cColor_Red;
			bool bBlinking = ImGui_GetStateFloat("Blinking") > 0;
			
			StationGui_BigStatusMessage(sText, gStationGuiColor_Warning, 2, bBlinking);
		}
		
		//------------------------------------------------------------
		/**
		 * Small areas around the valve rotate through another area to count and set "power level".
		 * 
		 * **/
		bool CollideValveCount(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(true) return false; //!Disabled!: Removed this activity part.
			
			if(alState != 1) return true;
			
			tString sLight = "Light_"+asChild;	//Name of light entity to turn on/off.
			int lLightNr = cString_ToInt(cString_Sub(asChild, asChild.length()-1), 1);	//Get the light number from the name.
			mlLightValveCount = lLightNr;	//Update member var used in other methods to check power level setting.
			bool bLit = Lamp_GetLit(sLight) ? false : true;
			
			//Turn lights on.
			if(bLit && mbCableConnected)
			{
				for(int i=1;i<=lLightNr;i++)
					Lamp_SetLit("Light_AreaValve0"+i, bLit, false);
			}	
			
			//Turn lights off.
			else if(!bLit && mbCableConnected)
			{
				mlLightValveCount--;	//Deduct one extra from light count to make it correct with visible lights.
				
				for(int i=8;i>=lLightNr;i--)
					Lamp_SetLit("Light_AreaValve0"+i, bLit, false);
			}
			
			cLux_AddDebugMessage(""+mlLightValveCount);

			if(mbCableConnected)
				Sound_CreateAtEntity("click", "Entities_Urban/lamp/bulb/bedside_off", sLight, 0.05, false);
				
			return true;
		}
		
		/**
		 * Sticky that attaches the power cable to cabinet
		 * */
		bool AttachPowerCable(const tString &in asStickyArea, const tString &in asBodyName)
		{	
			mbCableConnected = true;
			
			//Set lights on according to the valve position, if player moved the valve before connecting cable.
			if(mlLightValveCount > 0)
				CollideValveCount("", "AreaValve0"+mlLightValveCount, 1);
			
			Map_AddTimer("", 3, "TimerSetPCToStatic");	//Delay set static as it won't work while in grab.
			
			return true;
		}
		
		//------------------------------------------------------------
		
		void TimerSetPCToStatic(const tString &in asTimer)
		{
			Prop_SetStaticPhysics("power_cable", true);
		}
		
		//------------------------------------------------------------

		cSequenceStatesData mSequenceTurnOnLights_Good;
		void SequenceTurnOnLights_Good(const tString &in asX)
		{
			Sequence_Begin("SequenceTurnOnLights_Good", mSequenceTurnOnLights_Good);

			//Light in airlock turn on.
			if(Sequence_DoStepAndWait(1))
			{
				mPowerState_Platform = ePowerState_Good;
				
				Music_Stop(2.0f, eMusicPrio_BgAmb);
				Audio_PowerSequence_Good();
				Audio_ScheduleBoardsStart();
				
				Lamp_SetLit("screen_board_1", true, false);
				if (mbPlatformFlowerDrained==false)
					Lamp_SetLit("screen_board_2", true, false);
					
				LightSwitchLightsOn("lamp_room_1");
				Lamp_SetLit("PowerBoxEmergencyLight", false, true);
				
				Map_FadeFogColor(mvLevelFogColor, 6); //Fog color of level is restored to default.
				
				cLux_AddDebugMessage("Ambient Areas switched to LIGHT");
				
				//Turn off Dark Areas
				Entity_SetActive("AMB_StartingTunnel_DARK", false);
				Entity_SetActive("AMB_Station_DARK", false);
				Entity_SetActive("AMB_SideTunnel_DARK", false);
				Entity_SetActive("AMB_VentSpace_Lower_DARK", false);
				Entity_SetActive("AMB_VentSpace_UpperRight_DARK", false);
				Entity_SetActive("AMB_VentSpace_UpperLeft_DARK", false);
				Entity_SetActive("AMB_SideTunnel_Cave_DARK", false);
				
				//Turn on Light Areas
				Entity_SetActive("AMB_StartingTunnel_LIGHT", true);
				Entity_SetActive("AMB_Station_LIGHT", true);
				Entity_SetActive("AMB_SideTunnel_LIGHT", true);
				Entity_SetActive("AMB_VentSpace_Lower_LIGHT", true);
				Entity_SetActive("AMB_VentSpace_UpperRight_LIGHT", true);
				Entity_SetActive("AMB_VentSpace_UpperLeft_LIGHT", true);
				Entity_SetActive("AMB_SideTunnel_Cave_LIGHT", true);
			}
			
			//Lights in corridor down to station goes on.
			if(Sequence_DoStepAndWait(2))
			{
				LightSwitchLightsOn("lamp_room_2");
				ParticleSystem_SetVisible("fog_ps_1", true);
				ParticleSystem_SetVisible("fog_ps_2", true);
				ParticleSystem_SetVisible("fog_ps_3", true);
			}
			
			//Lights at station platform goes on.
			if(Sequence_DoStepAndWait(3))
			{
				LightSwitchLightsOn("lamp_room_3");
				Lamp_SetFlickerActive("screen_board_*", false);
				
				ParticleSystem_SetVisible("fog_ps_4", true);
				ParticleSystem_SetVisible("fog_ps_5", true);
				ParticleSystem_SetVisible("steam_ps_*", true);
			}

			//Lights in the station subway tunnels and cart goes on.
			if(Sequence_DoStepAndWait(0.1f))
			{
				LightSwitchLightsOn("wall_lamp_room_3");
			}
			
			//Lights in the passenger train goes on.
			if(Sequence_DoStepAndWait(1))
			{		
				TrainPowerOn();	
				Lamp_SetLit("lamp_cargo_train_*", true, true);
			}
			
			Sequence_End();
		}
		
		//------------------------------------------------------------
	
		cSequenceStatesData mSequenceTurnOnLights_Bad;
		void SequenceTurnOnLights_Bad(const tString &in asX)
		{
			Sequence_Begin("SequenceTurnOnLights_Bad", mSequenceTurnOnLights_Bad);

			//Light in airlock turn on.
			if(Sequence_DoStepAndWait(1))
			{
				mPowerState_Platform = ePowerState_Bad;
	
				Lamp_SetLit("PowerBoxEmergencyLight", false, true);
				
				Map_FadeFogColor(mvLevelFogColor, 6); //Fog color of level is restored to default.
				
				Music_Stop(2.0f, eMusicPrio_BgAmb);
				Audio_PowerSequence_Bad();
				Audio_ScheduleBoardsStart();
				Entity_SetActive("LightFlickerTrigger", true);
				
				cLux_AddDebugMessage("Ambient Areas switched to LIGHT");
				//Turn off Dark Areas
				Entity_SetActive("AMB_StartingTunnel_DARK", false);
				Entity_SetActive("AMB_Station_DARK", false);
				Entity_SetActive("AMB_SideTunnel_DARK", false);
				Entity_SetActive("AMB_VentSpace_Lower_DARK", false);
				Entity_SetActive("AMB_VentSpace_UpperRight_DARK", false);
				Entity_SetActive("AMB_VentSpace_UpperLeft_DARK", false);
				Entity_SetActive("AMB_SideTunnel_Cave_DARK", false);
				
				//Turn on Light Areas
				Entity_SetActive("AMB_StartingTunnel_LIGHT", true);
				Entity_SetActive("AMB_Station_LIGHT", true);
				Entity_SetActive("AMB_SideTunnel_LIGHT", true);
				Entity_SetActive("AMB_VentSpace_Lower_LIGHT", true);
				Entity_SetActive("AMB_VentSpace_UpperRight_LIGHT", true);
				Entity_SetActive("AMB_VentSpace_UpperLeft_LIGHT", true);
				Entity_SetActive("AMB_SideTunnel_Cave_LIGHT", true);
			}
			
			//Lights in corridor down to station goes on.
			if(Sequence_DoStepAndWait(2))
			{
				Lamp_SetLit("lamp_room_3_3", true, true);
				Lamp_SetFlickerActive("lamp_room_3_3", true);
				
				ParticleSystem_SetVisible("fog_ps_5", true);
				ParticleSystem_SetVisible("steam_ps_1", true);
				ParticleSystem_SetVisible("steam_ps_2", true);
			}
			
			//Lights in the passenger train goes on.
			if(Sequence_DoStepAndWait(1))
			{		
				TrainPowerOn();	
				Lamp_SetLit("lamp_cargo_train_*", true, true);
				Lamp_SetFlickerActive("lamp_cargo_train_1", true);
			}
			
			Sequence_End();
		}
			
		//------------------------------------------------------------
		//turn off light flicker on station when in train to stop sound spamming
		bool StationLightFlicker(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Station Light Flicker Disabled");
				Lamp_SetFlickerActive("lamp_room_3_3", false);	
			}
			else if (alState==-1)
			{
				cLux_AddDebugMessage("Station Light Flicker Enabled");
				Lamp_SetFlickerActive("lamp_room_3_3", true);
			}
			return true;
		}
				
		//------------------------------------------------------------
		
		/**
		 * Create random timers for erratic lights turning on, a small likelyhood to also get a flickering light
		 * */
		void LightSwitchLightsOn(const tString &in asLight, bool abDoRandomActive = true)
		{
			for(int i=1;Entity_Exists(asLight+"_"+i);i++)
			{
				Map_AddTimer(asLight+"_"+i, cMath_RandRectf(0,2), "TimerSetLampLit");
			}
		}
		
		//------------------------------------------------------------
		
		void TrainPowerOn()
		{
			Entity_SetEffectsActive("TrainTerminal", true, true);
			Entity_SetEffectsActive("01_05_transporter_passenger_starter_panel_1", true, true);
			Entity_SetEffectsActive("TrainSwitch_1", true, true);
			Entity_SetEffectsActive("TrainSwitch_2", true, true);
			Entity_SetEffectsActive("TrainSwitch_3", true, true);
				
			Entity_SetActive("Area_Transport1_Door*", true);
			Prop_SetStaticPhysics("01_05_transporter_passenger_door1", true);
			Entity_SetInteractionDisabled("01_05_transporter_passenger_door1", true);
			PhysicsSlideDoor_SetLocked("01_05_transporter_passenger_door1", false, false);
			Lamp_SetLit("TrainDoorLamps", true, true);
			LightSwitchLightsOn("cart_lamp_room_3");
		}

		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 3 Event B *Turn on train & pick station*
		//{///////////////////////////////////////

		//-------------------------------------------------------
	
		/**
		 * The back door is broken and only plays a broken sound and spark particles
		 * */
		bool CollideCartDoorBroken(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState == -1) return true;

			//ADD TODO BROKEN DOOR SOUND AND PARTICLE SPARK
			cLux_AddTodoMessage("SOUND: Sparks and noises from broken door", false);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		/**
		 * Front door to cart auto slides open/close when player is near.
		 **/
		bool CollideCartDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			msCartDoor = "01_05_transporter_passenger_door1";

			//Clear all auto movement timers
			for(int i=1;i<=4;i++) 
				Map_RemoveTimer("door_timer_"+i);
			for(int i=1;i<=4;i++) 
				Map_RemoveTimer("door_timer_"+i+"_action");
			
			//Open door in two steps.
			if(alState == 1)
			{
				mlCartDoorStep = 0;
				TimerCartDoorOpen("door_timer_1");
				cLux_AddDebugMessage("Train Door Open Stage 0");
				Map_AddTimer("door_timer_2", 0.5, "TimerCartDoorOpen");
				Map_AddTimer("door_timer_3", 1.95, "TimerCartDoorOpen");
				Map_AddTimer("door_timer_4", 2.5, "TimerCartDoorOpen");
				
				//Stop close sounds
				Sound_Stop("train_door_close_start", 0.25f);
				Sound_Stop("train_door_close_loop", 0.25f);
				Sound_Stop("train_door_close_stop", 0.5f);
				
				cLux_AddDebugMessage("Open Door Start");		
				Sound_CreateAtEntity("train_door_open_loop", "Entities_Station/object/train/door/open_motion", msCartDoor, 0, false);
				Sound_CreateAtEntity("train_door_open_start", "Entities_Station/object/train/door/open_start", msCartDoor, 0, false);
			} 
			
			//Close door in two steps.
			else 
			{
				mlCartDoorStep = 0;
				TimerCartDoorClose("door_timer_1");
				Map_AddTimer("door_timer_2", 1.5, "TimerCartDoorClose");
				
				//Stop open sounds
				Sound_Stop("train_door_open_loop", 0.25f);
				Sound_Stop("train_door_open_start", 0.25f);
				Sound_Stop("train_door_open_stop", 0.5f);
				
				Sound_CreateAtEntity("train_door_close_start", "Entities_Station/object/train/door/close_start", msCartDoor, 0, false);
				Sound_CreateAtEntity("train_door_close_loop", "Entities_Station/object/train/door/close_motion", msCartDoor, 0, false);
			}
			
			return true;
		}

		//-------------------------------------------------------
		
		void TimerCartDoorOpen(const tString &in asTimer)
		{
			mlCartDoorStep++;
			
			switch (mlCartDoorStep)
			{
				case 1:
				Entity_PlayProcAnimation(msCartDoor, "Open", 0.5, false, 0);
				break;
				
				case 2:
				Prop_SetStaticPhysics(msCartDoor, false);
				PhysicsSlideDoor_AutoMoveToState(msCartDoor, 1);
				break;
				
				case 3:
				Sound_CreateAtEntity("train_door_open_stop", "Entities_Station/object/train/door/open_stop", msCartDoor);
				Sound_Stop("train_door_open_loop", 0.25f);
				break;
				
				case 4:
				cLux_AddDebugMessage("TimerCartDoorOpen");
				Prop_SetStaticPhysics(msCartDoor, true);
				break;
			}
		}

		//-------------------------------------------------------
		
		void TimerCartDoorClose(const tString &in asTimer)
		{
			if (mlCartDoorStep == 1 && PhysicsSlideDoor_GetClosed(msCartDoor)==false)
			{
				Map_AddTimer(asTimer, 0.1, "TimerCartDoorClose");
				return;
			}
				
			///////////////////////////////////
			//Delay added to keep sound in sync
			Map_AddTimer(asTimer+"_action", 0.5, "TimerCartDoorClose_Action");
		}
		
		//------------------------------------------------------------

		void TimerCartDoorClose_Action(const tString &in asTimer)
		{
			mlCartDoorStep++;
			if (mlCartDoorStep==1)
			{
				Prop_SetStaticPhysics(msCartDoor, false);
				PhysicsSlideDoor_AutoMoveToState(msCartDoor, -1);
			}
			else
			{
				cLux_AddDebugMessage("TimerCartDoorClose_Action Set Door Static");
				Prop_SetStaticPhysics(msCartDoor, true);
				Entity_PlayProcAnimation(msCartDoor, "Open", -0.5, false, 0);
				Sound_CreateAtEntity("train_door_close_stop", "Entities_Station/object/train/door/close_stop", msCartDoor, 0, false);
				Sound_Stop("train_door_close_loop", 0.25f);
			}
		}
		
		//------------------------------------------------------------
	
		/**
		 * Areas around the chair to determine how the chair should rotate when sitting down.
		 * */
		bool CollideChairRotPos(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState == -1) return true;
			
			mlTrainChairRotPos = Entity_GetVarInt(asChild, "");
			
			if(asChild == "AreaChairPos_1")
				msTrainChairCam = "AnimateSitTrainChairL";
			else if(asChild == "AreaChairPos_3")
				msTrainChairCam = "AnimateSitTrainChairR";
			else
				msTrainChairCam = "AnimateSitTrainChair";
				
			//cLux_AddDebugMessage("Var is:" +mlTrainChairRotPos);
			return true;
		}
		
		//-----------------------------------------------------------
		
		void InteractTrainChair(const tString &in asEntity)
		{
			mbPlayerIsSitting = true;
			
			msTrainChairName = asEntity;
			
			SequenceSitDownInTrain("");
		}
		
		//-----------------------------------------------------------
		
		cSequenceStatesData mSequenceSitDownInTrain;
		void SequenceSitDownInTrain(const tString &in asX)
		{
			Sequence_Begin("SequenceSitDownInTrain", mSequenceSitDownInTrain);

			//Rotate chair towards player 
			if(Sequence_DoStepAndWait(0.2))
			{
				Entity_SetInteractionDisabled("AreaLeaveChair", false);
				Entity_SetInteractionDisabled(msTrainChairName, true);
				Entity_SetCollideCharacter(msTrainChairName, false);
				
				Sound_CreateAtEntity("player_sit", "01_04_transport_station/SFX/foley/train_sit", msTrainChairName, 0, false);
				Prop_RotateToSpeed(msTrainChairName, 20, mlTrainChairRotPos, cVector3f_Up, true, "AreaChairRot");
			}
			
			//Player begins sitting down
			if(Sequence_DoStepAndWait(0.3))
			{
				CameraAnimation_Begin(msTrainChairCam, "", true);
			}
			
			//Chair rotates back to forward postion as player is sitting.
			if(Sequence_DoStepAndWait(0.5))
			{
				Prop_RotateToSpeed(msTrainChairName, 20, -1.4*mlTrainChairRotPos, cVector3f_Up, false, "AreaChairRot");
			}
			
			//Chair stop in forward direction.
			if(Sequence_DoStepAndWait(0))
			{
				Prop_RotateToSpeed(msTrainChairName, 20, 0, cVector3f_Up, false, "AreaChairRot");
				
				//Rotate screen down.
				if(mbTrainIsActivated)
				{
					RotateScreenDown();
					Terminal_SetGuiActive("TrainTerminal", true, 1);
				}
			}
					
			Sequence_End();
		}
		
		//-----------------------------------------------------------
		
		/**
		 * Triggered by interactive camera when camera reaches last area.
		 * */
		bool TeleportPlayer(const tString &in asEntity, int alDirection)
		{
			Entity_SetActive("train_sitting_block_*", true);
		
			Player_SetMoveSpeedMul(0);
			Player_SetJumpDisabled(true);
			Player_SetStandDisabled(true);
			
			return true;
		}

		//-----------------------------------------------------------
		
		/**
		 * Area by door that can be interacted with to leave the chair
		 * */
		void InteractLeaveChair(const tString &in asEntity)
		{
			mbPlayerIsSitting = false;
			
			Entity_SetInteractionDisabled(asEntity, true);
			Entity_SetInteractionDisabled(msTrainChairName, false);
			
			SequenceGetUpInTrain("");
		}
		
		//------------------------------------------------------------
		
		/**
		 * Animation, setup and config changes to return player to normal walking mode when leaving chair.
		 * */
		cSequenceStatesData mSequenceGetUpInTrain;
		void SequenceGetUpInTrain(const tString &in asX)
		{
			Sequence_Begin("SequenceGetUpInTrain", mSequenceGetUpInTrain);

			//Rotate screen up if it is down.
			if(Sequence_DoStepAndWait(0.3))
			{
				if(mbTrainScreenIsDown)
				{
					RotateScreenUp();
					Terminal_SetGuiActive("TrainTerminal", false, 1);
				}
					
			}
			
			//Disable flashlight as it flickers on teleport later if on.
			if(Sequence_DoStepAndWait(0))
			{
				Sound_CreateAtEntity("player_sit", "Player/foley/default/pose_stand", msTrainChairName, 0, false);
			}
			
			//Player gets up
			if(Sequence_DoStepAndWait(0.2f))
			{
				CameraAnimation_Begin("AnimateGetUpTrainChair", "", true);
			}
			
			//Player is up, reset entities to normal state
			if(Sequence_DoStepAndWait(0.5))
			{
				Entity_RemoveEntityAttachment("Player");
				Entity_SetActive("train_sitting_block_*", false);
				Entity_SetCollideCharacter(msTrainChairName, true);
			}
			
			Sequence_End();
		}
		
		//------------------------------------------------------------
		
		/**
		 * Triggered by interactive camera when camera reaches last area.
		 * */
		bool TeleportStanding(const tString &in asEntity, int alDirection)
		{
			//Player_Teleport("Player_StandingInTrain", true);
			
			Player_SetMoveSpeedMul(1);
			Player_SetJumpDisabled(false);
			Player_SetStandDisabled(false);
			Player_SetCrouching(false);
				
			return true;
		}
		
		//------------------------------------------------------------
	
		/**
		 * Each of the three switches on the left side panel. 
		 * */
		void StateChangeSwitch(const tString &in asEntity, int alState)
		{
			if (CathTool_IsInserted("CathTool")==false)
			{
				if (alState!=1) return;
				
				Map_AddTimer(asEntity, 0.4, "TimerStopPlayerInteraction");
				Map_AddTimer(asEntity, 0.4, "TimerSwitchMovingButtonOff");
				return;
			}
			
			Lamp_SetLit(asEntity+"_Lamp", alState==1, true);
			Entity_SetActive(asEntity+"_Aux", alState!=1);
			Sound_CreateAtEntity("TrainSwitch", "Entities_Station/object/train/console_switch", asEntity, 0.0f, false, 1.0f);
			
			////////////////
			// Sounds
			if (alState==1)
			{
				Sound_CreateAtEntity("TrainConsoleBeep", "Entities_Station/object/train/"+asEntity, asEntity, 0.0f, false, 1.0f);
				PlayTrainSwitchSounds();
			}
			
			Entity_IncVarInt("01_05_transporter_passenger_start_button_1", "", alState);
			int lSwitchCount = Entity_GetVarInt("01_05_transporter_passenger_start_button_1", "");
			
			Lamp_SetLit("passenger_train_headlamp_*", lSwitchCount>=2, true);
			Entity_SetEffectsActive("01_05_transporter_passenger_start_button_1", lSwitchCount == 3, true);
		}
		
		//-----------------------------------------------------------
		
		/**
		 * Poweron button on the left side panel, if all three switches turned, this activates the train.
		 * */
		void StateChangeButton(const tString &in asEntity, int alState)
		{
			//Fail to power up
			if(Entity_GetVarInt(asEntity, "") < 3)
			{
				if(alState==1)
				{
					Sound_CreateAtEntity("TrainSwitch", "Entities_Station/tech/control_board_pplant_button/interact", asEntity, 0.0f, false, 1.0f);
					Sound_CreateAtEntity("TrainSwitchBeepBad", "Entities_Station/tech/terminal_beeps/upsilon_train_map/train_button_negative", asEntity, 0.0f, false, 1.0f);
				}
			}
			
			//Powering up
			else
			{
				//add slight delay to allow sound to play out
				if(mbPlayerIsSitting) Map_AddTimer("ScreenDown", 0.5f, "TrainScreenDown");

				mbTrainIsActivated = true;
				
				Entity_SetInteractionDisabled(asEntity, true);
				Entity_SetInteractionDisabled("TrainSwitch_*", true);
				
				if(alState==1)
				{
					Sound_CreateAtEntity("TrainSwitchBeepComplete", "Entities_Station/object/train/console_phase_complete", asEntity, 0.0f, false, 1.0f);
					Sound_CreateAtEntity("TrainSwitch", "Entities_Station/tech/control_board_pplant_button/interact", asEntity, 0.0f, false, 1.0f);
				}
			}
		}

		void TrainScreenDown(const tString &in asTimer)
		{
			RotateScreenDown();
		} 
		
		bool mbJourneyInProgress = false;
	
		//-----------------------------------------------------------
		
		/**
		 * Station selected in the terminal, train leaves the station.
		 * */
		cSequenceStatesData mSequenceBeginJourney;
		void SequenceBeginJourney(const tString &in asX)
		{
			Sequence_Begin("SequenceBeginJourney", mSequenceBeginJourney);
			
			if(Sequence_DoStepAndWait(0.1f))
			{
				Audio_Train_Start();
				cLux_AddTodoMessage("Train audio starts here");
				mbJourneyInProgress = true;
				// Stop the pipes rattling about
				Prop_SetStaticPhysics("PipeReplace_*",true);
				Prop_SetStaticPhysics("01_04_note_pipes_1", true);
				
				//Make sure the doors follow along
				Prop_SetStaticPhysics("01_05_transporter_passenger_door*", true);
				
				// Activate debris causing the train to crash
				if (mPowerState_Platform == ePowerState_Good)
				{
					Entity_SetActive("TunnelDebris_*", true);
				}
			}
			
			//Screen goes up.
			if(Sequence_DoStepAndWait(2))
			{
				mlTrainRideMsg = eStatusScreenMsg_DEPART;
				RotateScreenUp();
			}
									
			if(Sequence_DoStepAndWait(0.5f))
			{
				Terminal_SetGuiActive("TrainTerminal", false);
			}
			
			//Station door opens.
			if(Sequence_DoStepAndWait(1))
			{
				Entity_AttachToEntity("player", "01_05_transporter_passenger_1", "", false, false);
				Entity_SetActive("technical_occluder_1", false);
				SlideDoor_SetClosed("slidedoor_traintunnel_5", false, false);
				//Lamp_SetLit("cart_lamp_room_3_*", false, true);
				Sound_Stop("train_sound", 0);	//trigger sustain point
			}
			
			//Train leaves station.
			if(Sequence_DoStepAndWait(0.2f))
			{
				Prop_MoveLinearTo("01_05_transporter_passenger_1", "Train_Dest_1", 5, 15, 8, false);
				// Long fade time so it does not start out loud.
			}
			
			if(Sequence_DoStepAndWait(0.0f))
			{
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------

		/**
		 * As train leaves station the walls begin to move and the train is slowly coming to a halt.
		 * */
		bool StartMovingTunnels(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState != 1) return true;
			
			MoveObject_SetStateExt("01_05_tunnel_moving*", 1, 10, 60, 0, false);
			//MoveObject_SetStateExt("01_05_welder_moving*", 1, 10, 60, 0, false);
			
			//Begin preloading crash sounds
			Sound_PreloadGroup("01_04_transport_station/Special/Train", true);
			return false;
		}

		//-------------------------------------------------------
		
		/**
		 * The walls reset to their first position and then move again in a loop for as long as
		 * journey should last. THIS IS THE WHOLE JOURNEY PART.
		 **/
		 
		int mlJourneySlideshowPoint = 1;		// When to show the slideshow
		int mlJourneyCrashPoint = 3;			// When to hit the debris
		
		int mlJourneyRepeats = 0;
		 
		bool mbJourneyReset = true;

		bool TunnelReset(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (!mbJourneyReset)
				return true;
			
			mbJourneyReset = false;
			
			//Status jounrney 1, ETA and depth.
			if(mlJourneyRepeats == 0)
			{	
				mlTrainRideMsg = eStatusScreenMsg_JOURNEY;
			}
			
			if (mlJourneyRepeats == mlJourneySlideshowPoint)
			{
				if (!cLux_ScriptDebugOn())	// Don't show the slideshow in script debug
				{
					if (!mbSlideshowPlaying)
						StartSlideshow();
					else
						mlJourneyRepeats++;	// Stop the film triggering twice!
				}
			}
			
			//The looping journey.
			if(mlJourneyRepeats < mlJourneyCrashPoint)
			{
				MoveObject_SetStateExt("01_05_tunnel_moving*", 0, 1000000, 1000000, 0, true);
				//MoveObject_SetStateExt("01_05_welder_moving*", 0, 1000000, 1000000, 0, true);
				
				Map_AddTimer("", 0.034, "TimerReset");	//.034 as to let tunnel reset before moving again in next update.
			}
			
			//Trigger the event that ends the journey.
			else if(mlJourneyRepeats >= mlJourneyCrashPoint)
			{
				SequenceMoveTrainAndShakeEvent("");
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		/**
		 * Short delay before tunnels move again to make sure they are back to original position first.
		 * */
		void TimerReset(const tString &in asTimer)
		{
			// Don't increment journey when slideshow is playing.
			if (!mbSlideshowPlaying)
			{
				mlJourneyRepeats++;
			}
			
			mbJourneyReset = true;
			
			MoveObject_SetStateExt("01_05_tunnel_moving*", 1, 1000000, 20, 0, true);
			//MoveObject_SetStateExt("01_05_welder_moving*", 1, 1000000, 20, 0, true);
		}

		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 3 Event C *Watch Intro Movie (dialog)*
