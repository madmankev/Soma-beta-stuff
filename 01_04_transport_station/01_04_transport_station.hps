		//------------------------------------------------------------
		
		bool OnCollideCrashArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bInCrashArea = (alState==1);
			if (bInCrashArea!=mbInCrashArea)
			{
				if (!bInCrashArea)
				{
					if (mlFlesherDistortion!=0)
					{
						Effect_VideoDistortion_FadeOut(mlFlesherDistortion,3.0f);
						cLux_AddDebugMessage("Kill distortion");
						mlFlesherDistortion = 0;
					}
				}
				else if (mbFlesherAwake)
				{
					
					if (mbFirstFlesherAttackHappened)
					{
						if (!SequenceStates_IsActive("SequenceSecondBreakThroughDebris"))
						{
							//SequenceSecondBreakThroughDebris("");
						}
					}
					else if (mlFlesherDistortion==0)
					{
						mlFlesherDistortion=Effect_VideoDistortion_Start(0.5f,-1,1.0f,0.0f);
						cLux_AddDebugMessage("Start distortion");
					}
				}
			}
			mbInCrashArea = bInCrashArea;
			return true;
		}

		//------------------------------------------------------------
		
		int mlFlesherDistortion = 0;
		
		cSequenceStatesData mSequenceTrainCartCreepyness;
		void SequenceTrainCartCreepyness(const tString &in asX)
		{
			Sequence_Begin("SequenceTrainCartCreepyness",mSequenceTrainCartCreepyness);
			
			if (Sequence_DoStepAndWait(3.0f))
			{
				Effect_VideoDistortion_Start(0.3f,3.0f,3.0f,0.0f);
				mbFlesherAwake = true;
				//Sound loop starts - finishes when player pops hatch
				Sound_CreateAtEntity("FlesherTrainLoop", "01_04_transport_station/SFX/flesher/train_roof", "TrainCartCreepynessSoundSource");
			}
			else if (Sequence_DoStepAndWait(20.0f))
			{
				if (mbInCrashArea&&mlFlesherDistortion==0)
				{
					cLux_AddDebugMessage("Begin distortion");
					mlFlesherDistortion=Effect_VideoDistortion_Start(0.25f,-1,1.0f,0.0f);
				}
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				mbFirstFlesherAttackHappened = true;
			}

			Sequence_End();
		}

