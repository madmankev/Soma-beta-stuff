	{
		cLux_AddDebugMessage("Sweetener Sound Detached");
		Entity_RemoveEntityAttachment("BadPowerSoundSource");
		Entity_SetActive("Sound_DetachPowerSweetener", false);
		Entity_SetActive("Sound_AttachPowerSweetener", true);
		return true;
	}
	
	bool Audio_AttachPowerSweetener(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Sweetener Sound Attached");
		Entity_AttachToEntity("BadPowerSoundSource", "player", "", false, true);
		Entity_SetActive("Sound_DetachPowerSweetener", true);
		Entity_SetActive("Sound_AttachPowerSweetener", false);
		return true;
	}
	
	void Audio_StopBadPowerSweetener()
	{
		cLux_AddDebugMessage("Sweetener Sound Stopped and Areas disabled");
		Sound_Stop("BadPowerSweetener", 0.25f);
		Sound_Stop("BadPowerBox", 0.05f);
		Entity_RemoveEntityAttachment("BadPowerSoundSource");
		Entity_SetActive("Sound_DetachPowerSweetener", false);
		Entity_SetActive("Sound_AttachPowerSweetener", false);
	}
	
