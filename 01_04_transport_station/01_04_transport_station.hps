		//-------------------------------------------------------
		
		cSequenceStatesData mRemoveTrainFlesherSequence;
		bool mbTrainFlesherEventComplete = false;
	
		void Seq_RemoveTrainFlesher(const tString &in asTimer)
		{					
			Sequence_Begin("Seq_RemoveTrainFlesher", mRemoveTrainFlesherSequence);
				
			if (Sequence_DoStepAndPause(0))
			{
				Entity_SetActive("TriggerRemoveTrainFlesher", false);
				Effect_TimeGlitch_Start(2, 0.5, 0.2, true);
				
				Agent_FaceEntity("TrainFlesher", "Player");
				
				Entity_SetActive("TriggerFlesherFlees", true);
				Map_AddTimer("Timer_FlesherFlees", 1.5, "Timer_FlesherFlees");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Effect_TimeGlitch_Start(1, 0.5, 0.2, true);
				Entity_SetActive("TrainFlesher", false);
				Entity_SetActive("TrainFlesher_Escapee", true);
				Prop_MoveLinearTo("TrainFlesher_Escapee", "TrainFlesher_Escapee_Target", 10, 1.25, 0, true);
				
				Prop_SetStaticPhysics("FlesherEscapeVent", false);
				
				mbTrainFlesherEventComplete = true;
				
				// Hack to place the vent at the correct pos
				iLuxEntity@ pVent = cLux_GetCurrentMap().GetEntityByName("FlesherEscapeVent", eLuxEntityType_Prop);
				iLuxEntity@ pTarget = cLux_GetCurrentMap().GetEntityByName("FlesherEscapeVent_Target", eLuxEntityType_Area);
				pVent.GetMainBody().SetWorldMatrix(pTarget.GetMainBody().GetWorldMatrix());
			
				Entity_AddImpulse("FlesherEscapeVent", cVector3f_Forward, true, true);
				
				//Sound
				Sound_CreateAtEntity("FlesherEscapeSound", "01_04_transport_station/SFX/flesher/vent_event", "TrainFlesher_Escapee");
				Map_AddTimer("FlesherVentSoundEnd", 2.0f, "FlesherVentSoundEnd");
				Sound_FadeGlobalVolume(0.35, 0.1f);
				Depth_Audio_Fear_HighIntensity();
				
				//Music
				Map_AddTimer("SecondTunnelAmbientMusicStart", cMath_RandRectf(22.f,26.f),"Audio_StartSecondTunnelAmbience");
				Music_Play("03_02_flesherspook06", 0.45f, false, eMusicPrio_BigEvent);
				
			}
			Sequence_End();
		}
		
		void FlesherVentSoundEnd(const tString &in asTimer)
		{
			//Fade up world after flesher event
			Sound_FadeGlobalVolume(1.f, 3.f);
		}

		//-------------------------------------------------------
		
		bool Trigger_FlesherFlees(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("Seq_RemoveTrainFlesher");
			Map_RemoveTimer("Timer_FlesherFlees");
			return false;
		}
		
		void Timer_FlesherFlees(const tString &in asTimer)
		{
			Entity_SetActive("TriggerFlesherFlees", false);
			SequenceStates_Resume("Seq_RemoveTrainFlesher");
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event F *Wau flower in tunnel*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void WauFlowerTunnelEnd(const tString &in asEntity)
		{
		    SequenceTunnelEndWater("");
		}
		
		cSequenceStatesData mSequenceTunnelEndWater;
		void SequenceTunnelEndWater(const tString &in asX)
		{
			Sequence_Begin("SequenceTunnelEndWater", mSequenceTunnelEndWater);
			
			if(Sequence_DoStepAndWait(2.5f))
			{
			    cLux_AddDebugMessage("start water leak sequence");
			    Music_Play("01_02_reactorroom_transformers", 0.55f, false, eMusicPrio_BigEvent);
				Effect_Shake_Start(0.01, 2.0f, 2.0f, 0.5f);
				Sound_CreateAtEntity("FloodWater", "01_04_transport_station/SFX/flood_event/leak_event", "tunnelfloodsoundsource", 1.0f, true, 2.0f);
			    if (mbTrainFlesherEventComplete==true)
			    {
				    cLux_AddDebugMessage("Ambient Music Trigger enabled");
				    Entity_SetActive("Trigger_AmbientMusicResumeFlood", true);
			    }
			}
			else if(Sequence_DoStepAndWait(0.05f))
			{
			    cLux_AddDebugMessage("door cracks open");
			    Effect_Shake_Start(0.1f, 0.1f, 0.1f, 0.5f);
				SlideDoor_SetOpenAmount("TunnelEndSlideDoor", 0.1f, true);
			}
			else if(Sequence_DoStepAndWait(0.75f))
			{
				cLux_AddDebugMessage("water begins pouring");
			    ParticleSystem_SetActive("End_tunnel_leak_*", true);
				Sound_CreateAtEntity("FloodWater", "01_04_transport_station/SFX/flood_event/spot", "tunnelfloodsoundsource", 0.5f, true, 1.0f);	
            }		
			else if(Sequence_DoStepAndWait(1))
			{
			    Entity_SetActive("water_effects_tunnel_end_*", true);
				ParticleSystem_SetActive("End_tunnel_leakimpact_*", true);
			}
			else if(Sequence_DoStepAndWait(1))
			{
			    Entity_SetActive("water_tunnel_end_leak_stream_*", true);
				Prop_MoveLinearTo("water_tunnel_end_leak_stream_1", "tunnel_end_stream_target", 5, 15, 8, true);
			}
			Sequence_End();
		}

		//} END EVENT

	//} END SCENE 4
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// PRELOADING
	/////////////////////////////////////////

	//-------------------------------------------------------

	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("02_01_ms_curie_outside.hpm", eWorldStreamPriority_Low);
	}
	
	//-------------------------------------------------------
	
	void PreloadSetPrioNormal()
	{
		if(PreloadDisabled()) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
	
	//-------------------------------------------------------

	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("Transfer1421");
	}
	
	//-------------------------------------------------------
	
	void PreloadSetPrioHigh()
	{
		if(PreloadDisabled()) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_High);
	}
	
	//-------------------------------------------------------	
	
	void PreloadFadeEffects()
	{
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
		Map_AddTimer("FadePreset", 0.15, "PreloadTimer");
		
		Map_SetEnvironmentParticlesActive(true);
		
		cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
		pWorld.SetFogApplyAfterFogAreas(false);
	}

	//-------------------------------------------------------

	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 3, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted) return;

			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.1);
			
			Map_AddTimer("FadeGlobal", 0.3, "PreloadTimer");
		}
		
		if(asTimer == "FadePreset")
		{
			Map_Preset_Fade("Outside2.1", 0.1); 
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
		
		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Entity_SetActive("LiquidArea_2", false);
				Description_SetForceFading(true);
				Map_ChangeMap("02_01_ms_curie_outside.hpm", "", "Transfer1421", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.25f, "PreloadTimer");
		}
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	//Manually load next level if preload fails,  preload disabled.
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("02_01_ms_curie_outside.hpm", "PlayerStartArea_1", "", "");
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// TERMINALS
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Amy Cargo Terminal
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbAudioDucked = false;

		//-------------------------------------------------------
	
		void OnGuiAmyCargoPad(const tString&in asEntityName, float afTimeStep)
		{
			StationGuiBG_Scanlines();
			StationGuiBG_BackdropV2("background_logo_pathosstation");
			
			ImGui_SetTransCategory("01_04_transport_station");
			
			cStationGui_TextReaderSettings readerSettings;
			readerSettings.mvTextFontSize = 30;
			cStationGui_MainMenuSettings mainMenuSettings;
			mainMenuSettings.mfEdgePadding = 0.125;
			mainMenuSettings.mfButtonHeight = 0.125;
			mainMenuSettings.msCustomSound = "Entities_Station/tech/terminal_beeps/datapad/datapad_forward";;
			
			if (mbAudioDucked && Depth_ImGui_PlaybackActive()==false)
				StopVideoAudio();
			
			bool bDrawBackButton = true;
			int lActiveApp = StationGui_GetActiveApp(eCargoTerminalState_MainMenu);
			switch (lActiveApp)
			{	
				case eCargoTerminalState_MainMenu:
				StationGui_AddApp("CargoTerminalApp_Inventory");
				StationGui_AddApp("CargoTerminalApp_CometMemo");
				StationGui_AddApp("CargoTerminalApp_Video");
				StationGui_MainMenu(mainMenuSettings);
				bDrawBackButton = false;
				break;
				
				case eCargoTerminalState_Inventory:
				StationGui_TextReaderSingle("CargoTerminalApp_Inventory", "CargoTerminalInventory", readerSettings);
				break;
				
				case eCargoTerminalState_CometMemo:
				StationGui_TextReaderSingle("CargoTerminalApp_CometMemo", "CargoTerminalCometMemo", readerSettings);
				break;
				
				case eCargoTerminalState_Video:
				OnGuiAmyCargoPad_VideoPlayer();
				break;
			}
			
			if (bDrawBackButton && StationGui_BackButton(true, -1, false))
			{
				Depth_Audio_Datapad_Back(ImGui_GetName());
				if (lActiveApp == eCargoTerminalState_Video)
				{
					Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
				}
			}
		}

			/////////////////////////////////////////
			// APP: Video player
			//{///////////////////////////////////////
			
	
			void OnGuiAmyCargoPad_VideoPlayer()
			{
				Depth_ImGui_CheckAudioFilePlaybackEnd();
				
				ImGui_DoWindowStart("CargoTerminalApp_Video", PathOS_CreateDefaultWindowData(), ImGui_NrmPosGroup(cVector3f(0.05, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.75)));
	
					tString sImage;
					if (Depth_ImGui_PlaybackActive())
					{
						// Static overlay
						int lRotation = ImGui_GetStateInt("AnimationRotation", 0);
						if (ImGui_RepeatTimer("StaticIndex", 0.1))
						{
							lRotation = lRotation==0 ? 1 : 0;
							
							ImGui_SetStateInt("AnimationRotation", lRotation);
						}
						ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(0.8, 1));
						ImGui_SetModRotateAngle(lRotation*180);
						
						sImage = "static_0";
					}
					else
					{
						sImage = "";
						ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(0.2, 1));
						
					}
					ImGui_DoImage(cImGuiGfx(sImage), ImGui_NrmPosGroup(cVector3f(0.025, 0.025, 1)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.75)));
					ImGui_ResetModifiers();
					
					if (StationGui_VoicePlaybackButton("CargoPadRecording", "VoiceOver_VideoPlayerEnd", ImGui_NrmPosGroup(cVector3f(0.35, 0.825, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.125))))
					{
						if (Depth_ImGui_PlaybackActive())
						{
							//Fade out audio for video
							Depth_Audio_Datapad_Play(ImGui_GetName());
							cLux_AddDebugMessage("Start Video");
							Sound_FadeGlobalVolume(0.45f, 2.0f, eSoundEntryType_World);
							Music_FadeVolumeMul(0.1f, 2.0f);
							mbAudioDucked = true;
						}
						else
						{
							//Fade up audio on stop
							Depth_Audio_Datapad_Stop(ImGui_GetName());
							StopVideoAudio();
						}
					}

				ImGui_DoWindowEnd();
			}
			
			void StopVideoAudio()
			{
				cLux_AddDebugMessage("Stop Video");
				Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_World);
				Music_FadeVolumeMul(1.0f, 2.0f);
				mbAudioDucked = false;
			}
			
			//} END APP
		
		//------------------------------------------------------------
			
		bool mbHeardSkyFallingDown = false;
		void Line_SkyFallingDown(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
		{
			if (abStart) return;
			
			mbHeardSkyFallingDown = true;
		}
		
		void VoiceOver_VideoPlayerEnd(const tString&in asScene, const tString&in asSubject)
		{
			if (mbHeardSkyFallingDown==false)
				return;
				
			Map_AddTimer("CargoPadRecording_Comment", 1, "Timer_PlayVoice");
		}
		
		//------------------------------------------------------------
			
		void LeaveAmyCargoPad(const tString&in asEntityName)
		{
			tString sScene = Voice_GetSubjectSceneName("CargoPadRecording");
			
			if (Voice_SceneIsActive(sScene))
			{
				StopVideoAudio();
			}
			
			Voice_Stop(sScene);
		}
		
		//} END TERMINAL
		
		//------------------------------------------------------------
	
		/////////////////////////////////////////
		// TRAIN - STATION SELECTION SCREEN GUI
		//{///////////////////////////////////////
		
		//-----------------------------------------------------------
		
		
		
		bool mbMessageBoxActive = false;
		tString msPickedStation;
		tString msFocusedStation = "Station02";
		int mlPickedETA;
		void OnGUIStationSelection(const tString &in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("01_04_transport_station");
			
			////////////////////
			// Data
			cImGuiLabelData labelData;
			labelData.mFont.SetFile("sansation_large_bold.fnt");
			labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0555);
			cImGuiLabelData youAreHereLabel;
			youAreHereLabel.mFont.SetFile("sansation_medium.fnt");
			youAreHereLabel.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0266);
			youAreHereLabel.mColorText = gStationGuiColor_Disabled+cColor(0.25f,0.25f,0.25f,1);

			//////////////
			//GUI Background setup
			StationGuiBG_Scanlines();
			
			if (mbJourneyInProgress)
				return;
				
			cImGuiGfx bg("trainstation_trainmap", eImGuiGfx_Texture);
			bg.mColor = cColor(0.375, 1);
			ImGui_DoImage(bg, ImGui_NrmPos(cVector3f_Zero), ImGui_GetRatioCorrectSizeByNrmWidth(bg, 1));
			
			StationGuiBG_TaskbarV2("");
			
			/////////////////
			//Title
			ImGui_DoLabelExt("GUIMapTitle",labelData, cVector3f(90.0f, 50.0f, 3));
			
			///////////////////////////////////////////////////////////
			// Draw tracks between stations
			{
				cColor colRedTrack =  gStationGuiColor_Warning;
				cColor colBlueTrack = gStationGuiColor_Normal;
				cColor colYellowTrack = gStationGuiColor_Highlight2;
				float fTrackThickness = 4.0f;
				float fTrackZ = 2.0;
				
				// UpsilonA -> UpsilonB
				ImGui_AddLineStripNrmVertex(cVector2f(0.1f, 0.28f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.1f, 0.37f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.13f, 0.37f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colRedTrack);
				
				// UpsilonB -> Lambda
				ImGui_AddLineStripNrmVertex(cVector2f(0.15f, 0.37f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.1875f, 0.37f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.1875f, 0.53f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.375f, 0.53f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colBlueTrack);

				// Lambda -> Delta
				ImGui_AddLineStripNrmVertex(cVector2f(0.395f, 0.5f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.395f, 0.73f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.5375f, 0.73f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colBlueTrack);

				// Lambda -> Theta
				ImGui_AddLineStripNrmVertex(cVector2f(0.395f, 0.5f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.395f, 0.27f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.7125f, 0.27f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colBlueTrack);
				
				// Theta -> Omicron
				ImGui_AddLineStripNrmVertex(cVector2f(0.7325f, 0.28f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.7325f, 0.405f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.875f, 0.405f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colBlueTrack);
				
				// Delta -> Theta
				ImGui_AddLineStripNrmVertex(cVector2f(0.5575f, 0.73f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.5575f, 0.29f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.7125f, 0.29f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colBlueTrack);
				
				// Omicron -> Tau
				ImGui_AddLineStripNrmVertex(cVector2f(0.895f, 0.405f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.895f, 0.6f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colYellowTrack);
				
				// Tau -> Phi
				ImGui_AddLineStripNrmVertex(cVector2f(0.895f, 0.6f));
				ImGui_AddLineStripNrmVertex(cVector2f(0.895f, 0.75f));
				ImGui_DrawAndClearLineStrip(fTrackZ, fTrackThickness, colYellowTrack);
			}
			
			///////////////////////////////////////////////////////////////////////
			// Station Selector button check
			{										
				// Station UpsilonA (offline)
				ImGui_SetModUISizeVertExpansion(1, 8.75);
				DoStationButton(eStationType_Invalid, "Station01", ImGui_NrmPos(cVector3f(0.08f, 0.25f, 3)), 600);

				// Station UpsilonB (you are here)
				ImGui_SetModUISizeVertExpansion(2.5, 7.25);
				DoStationButton(eStationType_Current, "Station02", ImGui_NrmPos(cVector3f(0.13f, 0.34f, 3)), 0);
				ImGui_DoLabelExt("GUIStationYouAreHere", youAreHereLabel, ImGui_NrmPos(cVector3f(0.18f, 0.37f, 3)), cVector2f(50.0f, 32.0f));
					
				// Station Lambda(online)
				ImGui_SetModUISizeVertExpansion(5, 4.75);
				DoStationButton(eStationType_Valid, "Station03", ImGui_NrmPos(cVector3f(0.375f, 0.5f, 3)), mlLambdaJourneyTime);
				
				// Station Theta(online)
				ImGui_SetModUISizeVertExpansion(1, 8.75);
				DoStationButton(eStationType_Valid, "Station04", ImGui_NrmPos(cVector3f(0.7125f, 0.25, 3)), mlLambdaJourneyTime+400); 
					
				// Station Omicron(online)
				ImGui_SetModUISizeVertExpansion(3, 2.5);
				DoStationButton(eStationType_Valid, "Station05", ImGui_NrmPos(cVector3f(0.875f, 0.375f, 3)), mlLambdaJourneyTime+800);
				
				// Station Delta(online)
				ImGui_SetModUISizeVertExpansion(8.25, 1.5);
				DoStationButton(eStationType_Valid, "Station06", ImGui_NrmPos(cVector3f(0.5375f, 0.7f, 3)), mlLambdaJourneyTime+300);
				
				// Station Tau(online)
				ImGui_SetModUISizeVertExpansion(0, 0);
				DoStationButton(eStationType_Abyssal, "Station07", ImGui_NrmPos(cVector3f(0.875f, 0.6f, 3)), mlLambdaJourneyTime+1800);
				
				// Station Phi(online)
				ImGui_SetModUISizeVertExpansion(0, 0);
				DoStationButton(eStationType_Abyssal, "Station08", ImGui_NrmPos(cVector3f(0.875f, 0.72f, 3)), mlLambdaJourneyTime+1200);
			
				///////////////////////////////////////////////////////
				// Set up message box and station description window
				if(msPickedStation!="")
				{
					mbMessageBoxActive = true;
				}
				
				DoStationDescriptionWindow(msFocusedStation);
			}
			
			////////////////////////////////////////
			// Pop up message box
			if(mbMessageBoxActive) 
			{
				if(msPickedStation=="Station01")
					DoErrorMessageBox(msPickedStation);
				else
					DoDepartMessageBox(msPickedStation);
			}
			
			ImGui_ResetModifiers();
			
			
			///////////////////////////////////////////
			// Departure is confirmed, begin journey
			if(ImGui_TimerOver("DepartureConfirmed") && !mbJourneyInProgress)
			{
				ImGui_Exit();
				Entity_SetInteractionDisabled(asEntityName, true);
				SequenceBeginJourney("");
			}
		}
		
		//------------------------------------------------------------
		
		void DoStationButton(eStationType aType, const tString &in asName, const cVector3f &in avIconPos, int alETA)
		{
			cColor buttonCol;
			cColor focusCol = gStationGuiColor_Highlight;
			switch(aType)
			{
				case eStationType_Invalid: buttonCol = gStationGuiColor_Warning; focusCol = gStationGuiColor_Warning2; break;
				case eStationType_Current: buttonCol = gStationGuiColor_Disabled+cColor(0.25f,0.25f,0.25f,1); focusCol = gStationGuiColor_Disabled; break;
				case eStationType_Valid: buttonCol = gStationGuiColor_Normal;   break;
				case eStationType_Abyssal: buttonCol = gStationGuiColor_Highlight2; focusCol = gStationGuiColor_Warning2; break;
			}
			
			///////////
			// Data
			cImGuiButtonData button;
			button.mGfxBackground.SetFile("station/checkbox/default_fullsize");
			button.mGfxInFocus = button.mGfxTriggered = button.mGfxBackground;
			button.mvDefaultSize = ImGui_NrmSize(cVector2f(0.04f, 0.06f));
			button.mGfxBackground.mColor = buttonCol;
			button.mGfxInFocus.mColor = focusCol;
			button.mGfxTriggered.mColor = buttonCol + cColor(0.5f,0.5f,0.5f,1);
			button.mbUseInFocusGfx = true;
			button.mbUseTriggeredGfx = true;
			
			cImGuiLabelData label;
			label.mFont.SetFile("sansation_medium.fnt");
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0233);
			
			ImGui_DoLabelExt("GUI"+asName+"Name", label, avIconPos+cVector3f(button.mvDefaultSize.x+10.0f,0,0), cVector2f(50.0f, 32.0f));
			
			ImGui_SetModUseInput(mbMessageBoxActive==false);	
			if(ImGui_DoButtonExt(asName, "", button, avIconPos))
			{
				if (aType != eStationType_Current)
				{
					msPickedStation = asName;
					mlPickedETA = alETA;
				}
				
				///////////////////////////////////////
				// Sounds for picking stations
				if (asName == "Station01")
				{
					Sound_CreateAtEntity("StationMap_UpsilonA", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_upsilon_B", "TrainTerminalSoundSource");
				}
				else if (asName == "Station02")
				{
					Sound_CreateAtEntity("StationMap_UpsilonB", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_upsilon_A", "TrainTerminalSoundSource");
				}
				else
				{
					Sound_CreateAtEntity("StationMap_Select", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_select", "TrainTerminalSoundSource");
				}
			}
			if(ImGui_PrevBecameInFocus())
			{
				if (msFocusedStation != asName)
					Sound_CreateAtEntity("StationMap_Hover", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_hover", "TrainTerminalSoundSource");
					
				msFocusedStation = asName;
			}
			ImGui_SetModUseInput(true);	
		}
		
		//------------------------------------------------------------
		
		void DoErrorMessageBox(const tString &in asStationName)
		{
			cColor colorRed = gStationGuiColor_Warning;
			
			float fFadeAlpha = ImGui_GetStateFloat("MessageFadeAlpha",0.0f);
			
			///////////////////////////////////////////////////////
			// Draw background			
			cColor bgCol = colorRed * cColor(0.1f, fFadeAlpha*0.9f);
			ImGui_DrawGfx(cImGuiGfx(""), cVector3f(0,0,9), ImGui_GetSize(), bgCol);
			
			
			/////////////////////////////////////////////
			// Show error window			
			cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
			dialogBox.mWindow.mColorBase = colorRed; 
			dialogBox.mWindow.mColorBase.a = fFadeAlpha;
			dialogBox.mfZ = 9.5;
			dialogBox.mType = eGuiDialogBoxType_OK;
			ImGui_SetModUseInput(ImGui_IsFading("MessageFadeAlpha")==false);
			eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("GUIStationErrorCaption", "GUIStationError", dialogBox);
			ImGui_SetModUseInput(true);
			
			////////////////////////////////////////
			// Sound when getting rid of message
			if (buttonPressed == eGuiDialogCode_OK)
			{
				Sound_CreateAtEntity("StationMap_Upsilon_B_Cancel", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_upsilon_B_cancel", "TrainTerminalSoundSource");
			}
			
			////////////////////////////////////////
			// Start fade in
			if(fFadeAlpha==0.0f && ImGui_IsFading("MessageFadeAlpha")==false)
			{
				ImGui_FadeStateFloat("MessageFadeAlpha", 1.0f, 0.5f);
			}
			
			////////////////////////////////////////////////////////////////////////
			// Dismiss if messagebox is fully faded in and button is pressed. 
			//  Start fade out and set the messagebox active to false when done
			if(fFadeAlpha==1.0f && buttonPressed == eGuiDialogCode_OK)
			{
				ImGui_FadeStateFloat("MessageFadeAlpha", 0.0f, 0.5f);
			}
			
			// Delayed dismiss (MessageBox is fully faded out now)
			if(fFadeAlpha==0.0f && ImGui_FadeOver("MessageFadeAlpha"))
			{
				ExitMessageBox();
			}
		}
		
		//------------------------------------------------------------
		
		bool mbDeparting = false;
		
		void DoDepartMessageBox(const tString &in asStationName)
		{
			cColor colorBlue = gStationGuiColor_Normal;
			
			tString sStationLabel = "GUI"+asStationName+"Name";
			
			float fFadeAlpha = ImGui_GetStateFloat("MessageFadeAlpha",0.0f);
			

			///////////////////////////////////////////////////////
			// Draw background
			cImGuiGfx gfx;
			gfx.mMaterial = eGuiMaterial_Alpha;
			
			cColor bgCol = colorBlue * cColor(0.1f, fFadeAlpha*0.9f);
								
			ImGui_DrawGfx(gfx, cVector3f(0,0,9), ImGui_GetSize(), bgCol);
			
					
			tString sCaption = "GUIStationWarningCaption";
			if(mbDeparting)
				sCaption = "GUIStationInformationCaption";
			
			float fMenuAlpha = ImGui_GetStateFloat("ValidStationMenuAlpha", 1.0f);
			float fMsgDeparting = 1-fMenuAlpha;
			
			/////////////////////////////////////////////
			// Show error window		
			cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
			dialogBox.mWindow.mColorBase.a = fFadeAlpha;
			dialogBox.mfZ = 9.5;
			
			tWString sText;
			if(fMsgDeparting>0.0f)
			{
				dialogBox.mTextFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.06);
				dialogBox.mType = eGuiDialogBoxType_NoButton;
				dialogBox.mTextFrame.mFont.mColor.a = ImGui_FadeOscillateFloat("DepartLabelAlpha", 0.5f, 1.0f, 0.5f, eEasing_CubicIn);
				ImGui_SetModColorMul(cColor(1, fMsgDeparting*fFadeAlpha));
				sText += ImGui_Translate("GUIStatusDisplayDepartCaption") + "\n\n";
				sText += ImGui_Translate("GUI"+msPickedStation+"Name");
				
			}
			else
			{
				dialogBox.mTextFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
				dialogBox.mType = eGuiDialogBoxType_OKCancel;
				ImGui_SetModColorMul(cColor(1, fMenuAlpha*fFadeAlpha));
				sText += ImGui_Translate("GUIStationSettingTo") + "\n\n";
				sText += ImGui_Translate("GUI"+msPickedStation+"Name");
			}
				
			ImGui_SetModUseInput(ImGui_IsFading("MessageFadeAlpha")==false);
			ImGui_SetTextOverride(sText);
			eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox(sCaption, "", dialogBox);
			ImGui_ClearTextOverride();
			ImGui_SetModUseInput(true);
			ImGui_SetModColorMul(cColor_White);
			
			if (buttonPressed == eGuiDialogCode_OK)
			{
				ImGui_FadeStateFloat("ValidStationMenuAlpha", 0.0f, 0.5f);
				mbDeparting = true;	
				Terminal_SetGuiActive("StatusTerminal", true, 0.5f);
				Sound_CreateAtEntity("StationMap_OK", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_OK", "TrainTerminalSoundSource");
				
				Entity_SetInteractionDisabled("AreaLeaveChair", true);
			}
			else if (buttonPressed == eGuiDialogCode_Cancel)
			{
				Sound_CreateAtEntity("StationMap_Cancel", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_cancel", "TrainTerminalSoundSource");
			}
			
			////////////////////////////////////////
			// Start fade in
			if(fFadeAlpha==0.0f && ImGui_IsFading("MessageFadeAlpha")==false)
			{
				ImGui_FadeStateFloat("MessageFadeAlpha", 1.0f, 0.5f);
			}
			
			////////////////////////////////////////////////////////////////////////
			// Dismiss if messagebox is fully faded in and button was pressed. 
			//  Start fade out and set the messagebox active to false when done
			if(fFadeAlpha==1.0f && buttonPressed == eGuiDialogCode_Cancel)
			{
				ImGui_FadeStateFloat("MessageFadeAlpha", 0.0f, 0.5f);
			}
			
			// Delayed dismiss (MessageBox is fully faded out now)
			if(fFadeAlpha==0.0f && ImGui_FadeOver("MessageFadeAlpha"))
			{
				ExitMessageBox();
			}
			
			///////////////////////////////////////////////////////////////////////
			// Depart message is fully faded in, begin journey
			if(fMsgDeparting==1.0f && ImGui_FadeOver("ValidStationMenuAlpha"))
			{
				ImGui_AddTimer("DepartureConfirmed", 1.0f);
			}			
		}
		
		//------------------------------------------------------------
		
		void DoStationDescriptionWindow(const tString &in asFocusedStation)
		{
			tString sStationLabel = "GUI" + asFocusedStation + "Name";
			tString sStationDesc = "GUI" + asFocusedStation + "Desc";
			
			ImGui_ResetModifiers();
			
			ImGui_SetTransCategory("01_04_transport_station");
			
			//////////////////////////////////////////////////////////////////////
			// Station Information Window
			cImGuiWindowData window = PathOS_CreateDefaultWindowData();
			window.SetPadding(10,0,0,10);
					
			StationGui_DoWindowStart(sStationLabel, window, ImGui_NrmPos(cVector3f(0.04f, 0.575f, 3.0f)), ImGui_NrmSize(cVector2f(0.28f, 0.32f)), false);
			{
				cImGuiTextFrameData textFrameData = PathOS_CreateDefaultTextFrameData();
				textFrameData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.03);
				
				////////////////////////////////////////////////////////
				// Show focused station description
				ImGui_DoTextFrameExt(sStationDesc, cVector2f(3,3), 3.0f, 0, textFrameData, cVector3f_Zero, ImGui_GetCurrentGroupSize());
			}
			StationGui_DoWindowEnd();
		}
		
		//------------------------------------------------------------
		
		void ExitMessageBox()
		{
			mbMessageBoxActive = false;
			msPickedStation = "";
			mlPickedETA = 0;
		}
		
		//------------------------------------------------------------
		
		void OnLeaveStationSelection(const tString&in asEntityName)
		{
			if (mbJourneyInProgress || mbDeparting)
				return;
			
			InteractLeaveChair("AreaLeaveChair");
		}
		
		//} END TERMINAL
		
		//------------------------------------------------------------
		
		/////////////////////////////////////////
		// TRAIN - STATUS SCREEN GUI
		//{///////////////////////////////////////
		
		//-----------------------------------------------------------
		
		float mfJourneyElapsedTime = 0.0f;
		int mlLambdaJourneyTime = 100;		// Faked up, just for depth calcs.
		
		void OnGuiPowerScreen(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("");
			
			if (ImGui_IsFirstRun())
			{
				ImGui_AddTimer("Image_1", 1);
				ImGui_AddTimer("Image_2", 1.3);
				ImGui_AddTimer("Image_3", 1.6);
				Sound_CreateAtEntity("TrainConsoleOn", "Entities_Station/tech/terminal_beeps/upsilon_train_map/train_console_on", asEntityName);
			}
			
			if (ImGui_TimerOver("Image_1"))
				ImGui_SetStateBool("ShowImage_1", true);
			if (ImGui_TimerOver("Image_2"))
				ImGui_SetStateBool("ShowImage_2", true);
			if (ImGui_TimerOver("Image_3"))
				ImGui_SetStateBool("ShowImage_3", true);
			
			//////////////////////////////
			//Background
			StationGuiBG_Scanlines();
			
			/////////////////////////////////////////////////////////////////////
			//Draw train schematics and updates as player turns stuff on.
			{
				///////////////////////////////////////////////////////
				// Draw train schematics background
				ImGui_SetModColorMul(ImGui_GetStateColor("GUIColor2", cColor_White));
				
				ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(cVector3f(0.05f, 0.15f, 0)));
					cImGuiGfx TrainBG("station/train/stats_train_rear");
					TrainBG.mColor = gStationGuiColor_Normal;
					ImGui_DoImage(TrainBG, cVector3f_Zero, cVector2f(27,88));
					TrainBG.SetFile("station/train/stats_train_mid");
					ImGui_DoImage(TrainBG, cVector3f_Zero, cVector2f(360,88));
					TrainBG.SetFile("station/train/stats_train_front");
					ImGui_DoImage(TrainBG, cVector3f_Zero, cVector2f(67,88));
				ImGui_LayoutEnd();
				
				/////////////////////////////////////////////////
				// Draw system status icons according to button status
				{
					cImGuiGfx gfxIcon;
					cColor activeCol = gStationGuiColor_Highlight;
					cColor inactiveCol = gStationGuiColor_Warning;
					
					///////////////////////////////////////////
					// Draw tracks icon
					cVector3f vIconPos = cVector3f(62,30,2);
					bool bToolPluggedIn = CathTool_IsInserted("CathTool");
					if (ImGui_GetStateBool("ShowImage_1", false))
					{
						if(bToolPluggedIn && MovingButton_IsSwitchedOn("TrainSwitch_1"))
						{
							DoPowerScreenIcon("station/train/stats_tracks_active", activeCol, vIconPos);

						}
						else
						{
							DoPowerScreenIcon("station/train/stats_tracks_inactive", inactiveCol, vIconPos);
						}
					}
					
					///////////////////////////////////////////
					// Draw comm icon
					vIconPos = cVector3f(186,26,2);
					if (ImGui_GetStateBool("ShowImage_2", false))
					{
						if(bToolPluggedIn && MovingButton_IsSwitchedOn("TrainSwitch_2"))
						{
							DoPowerScreenIcon("station/train/stats_comm_active", activeCol, vIconPos);
						
						}
						else
						{
							DoPowerScreenIcon("station/train/stats_comm_inactive", inactiveCol, vIconPos);
						}
					}
					
					///////////////////////////////////////////
					// Draw door icon
					vIconPos = cVector3f(314,30,2);
					if (ImGui_GetStateBool("ShowImage_3", false))
					{
						if(bToolPluggedIn && MovingButton_IsSwitchedOn("TrainSwitch_3"))
						{
							DoPowerScreenIcon("station/train/stats_door_active", activeCol, vIconPos);
						}
						else
						{
							DoPowerScreenIcon("station/train/stats_door_inactive", inactiveCol, vIconPos);
						}
					}
				}
			}
		}
		
		//------------------------------------------------------------
		
		void PlayTrainSwitchSounds()
		{
	
			int lNumSwitches = 0;
			if (MovingButton_IsSwitchedOn("TrainSwitch_1")) ++lNumSwitches;
			if (MovingButton_IsSwitchedOn("TrainSwitch_2")) ++lNumSwitches;
			if (MovingButton_IsSwitchedOn("TrainSwitch_3")) ++lNumSwitches;
			
			if (lNumSwitches == 1)
			{
				Sound_CreateAtEntity("Train_Power_Stage_1", "Entities_Station/object/train/TrainSwitchPower_1", "TrainPowerTerminalSoundSource");
				cLux_AddDebugMessage("Train switch 1");
			}
			if (lNumSwitches == 2)
			{
				Sound_CreateAtEntity("Train_Power_Stage_2", "Entities_Station/object/train/TrainSwitchPower_2", "TrainPowerTerminalSoundSource");
				cLux_AddDebugMessage("Train switch 2");
			}
			if (lNumSwitches == 3)
			{
				Sound_CreateAtEntity("Train_Power_Stage_3", "Entities_Station/object/train/TrainSwitchPower_3", "TrainPowerTerminalSoundSource");
				cLux_AddDebugMessage("Train switch 3");
			}
		}

		//------------------------------------------------------------
		
		void DoPowerScreenIcon(const tString &in asGfx, const cColor &in aCol ,const cVector3f &in avPos)
		{
			const cVector2f vIconSize = cVector2f(64,64);
			
			cImGuiGfx gfxIcon(asGfx);
			gfxIcon.mColor = aCol;
			ImGui_DoImage(gfxIcon, avPos, vIconSize);
		}
		
		//} END TERMINAL

		//------------------------------------------------------------
		
		/////////////////////////////////////////
		// TRAIN - STATUS GUI
		//{///////////////////////////////////////
		
		//-----------------------------------------------------------
		
		void OnGuiStatus(const tString&in asEntityName, float afTimeStep)
		{
			StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			
			ImGui_SetTransCategory("01_04_transport_station");
			
			tString sStatusText = "";
			bool bWarning = true;
			float fSizeMul = 1.25;
						
			if (mbDeparting==false)
			{
				fSizeMul = 1.75f;
				if (mPowerState_Platform == ePowerState_Good)
				{
					sStatusText = "GUIStatusDisplayActivated01";
					bWarning = false;
				}
				else
				{
					sStatusText = "GUIStatusDisplayLowPower";
				}
			}
			else if(mlTrainRideMsg == eStatusScreenMsg_WARNING)
			{
				if (mPowerState_Platform == ePowerState_Good)
				{
					sStatusText = "GUIStatusDisplayWarning";
				}
				else
				{
					sStatusText = "GUIStatusDisplayLowPower";
					fSizeMul = 1.75f;
				}
			}
			else if(mlTrainRideMsg == eStatusScreenMsg_FAILURE)
			{
				if (mPowerState_Platform == ePowerState_Good)
					sStatusText = "GUIStatusDisplayCrash";
				else
					sStatusText = "GUIStatusDisplayShutdown";
			}
			else if(mlTrainRideMsg==eStatusScreenMsg_JOURNEY)
			{
				cImGuiLabelData labelData;
				labelData.mFont.SetFile("sansation_large_bold.fnt");
				labelData.mFont.mvSize = cVector2f(65, 65);
				labelData.mFontAlign = eFontAlign_Left;
				
				mfJourneyElapsedTime += afTimeStep;
				float fETA = mlPickedETA - cMath_RoundToInt(mfJourneyElapsedTime);
				tString sClockDisplay = String_SecondsToClockDisplay(fETA, false, true, true, false);
				tString sEta = cString_To8Char(cResources_Translate("01_04_transport_station", "GUIDisplayETA")) + " "+ sClockDisplay;
				
				// The two depth numbers here are from Mike's text for Upsilon and Lambda.
				tString sDepthValue =  cMath_Easing(eEasing_QuadIn, mfJourneyElapsedTime / mlLambdaJourneyTime, 107.0f, 96.0f);
				int lDotPos = cString_GetLastCharPos(sDepthValue, '.');
				sDepthValue = cString_Sub(sDepthValue, 0, lDotPos+3);
		
				tString sDepth = cString_To8Char(cResources_Translate("01_04_transport_station", "GUIDisplayDepth")) + " "+sDepthValue + "m";
			
				ImGui_SetTransCategory("");
				ImGui_DoLabelExt(sEta, labelData, cVector3f(0,155,3), ImGui_NrmSizeGroup(1, -1));
				ImGui_DoLabelExt(sDepth, labelData, cVector3f(0,240,3), ImGui_NrmSizeGroup(1, -1));
			}
			else
			{
				sStatusText = "GUIStatusDisplayDepart";
				fSizeMul = 1.5f;
				bWarning = false;
			}
			
			if (sStatusText != "")
			{
				cColor col = bWarning ? gStationGuiColor_Warning : cColor_White;
				StationGui_BigStatusMessage(sStatusText, col, fSizeMul, bWarning);
			}
		}

		//} END TERMINAL
		
		//------------------------------------------------------------
		
		/////////////////////////////////////////
		// TRAIN - STATION SELECTION SCREEN WORLD MOVEMENT
		//{///////////////////////////////////////
		
		//-----------------------------------------------------------
		
		/**
		 * Timer is triggered when screen is rotated down into the correct position.
		 * */
		void TimerEnterStationSelection(const tString &in asTimer)
		{
			Entity_CallEntityInteract("TrainTerminal");
			Terminal_SetGuiActive("TrainTerminal", true);
		}
		
		//-----------------------------------------------------------
		
		/**
		 * Stops the station selection screen when rotating down.
		 * */
		bool CollideScreenDown(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState == -1) return true;
			
			Prop_RotateToSpeed("TrainTerminal", 2, 0, cVector3f_Left, false, "AreaScreenRot");
			
			mbTrainScreenIsDown = true;
			
			if (!mbJourneyInProgress)	// Want slideshow!
				Map_AddTimer("trigger_screen", 0.4, "TimerEnterStationSelection");
			
			return true;
		}
		
		//-----------------------------------------------------------
		
		/**
		 * Stops the station selection screen when rotating up.
		 * */
		bool CollideScreenUp(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState == -1) return true;
			
			Prop_RotateToSpeed("TrainTerminal", 2, 0, cVector3f_Right, false, "AreaScreenRot");
		
			mbTrainScreenIsDown = false;
			
			return true;
		}
		
		//------------------------------------------------------------
		
		void RotateScreenDown()
		{
			if (mbTrainScreenIsDown) return;
			Sound_CreateAtEntity("Screen_Sound_RotateDown", "Entities_Station/object/train/screen/screen_down", "AreaScreenDown", 0, false);
			Prop_RotateToSpeed("TrainTerminal", 1, 1, cVector3f_Left, false, "AreaScreenRot");
		}
		
		//------------------------------------------------------------
		
		void RotateScreenUp()
		{
			if (mbTrainScreenIsDown==false) return;
			Sound_CreateAtEntity("Screen_Sound_RotateUp", "Entities_Station/object/train/screen/screen_up", "AreaScreenDown", 0, false);
			Map_AddTimer("RotateUpComplete", 2.25f, "RotateScreenUpComplete");
			Prop_RotateToSpeed("TrainTerminal", 1, 1, cVector3f_Right, true, "AreaScreenRot");
		}
		
		void RotateScreenUpComplete(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Screen_Sound_RotateUp_Ding", "Entities_Station/object/train/screen/screen_up_ding", "TrainTerminal", 0, false);
		}
		
		//} END TERMINAL
		
		//------------------------------------------------------------
		
		/////////////////////////////////////////
		// TRAIN - SLIDESHOW
		//{///////////////////////////////////////
		
		bool mbSlideshowPlaying = false;
		eSlideShowSlide mCurrentSlide = eSlideShowSlide_None;
				
		float mfSlideTime = 0.0f;
		
		//-----------------------------------------------------------
		
		void StartSlideshow()
		{
			Terminal_SetOnGuiFunction("TrainTerminal", "OnGUISlideshow");
			Voice_SetSource("SlideshowNarrator","Player",1, 10, true, 10);
			cLux_AddDebugMessage("Slideshow Start");

			SequenceSlideshow("");
			mbSlideshowPlaying = true;
			mfSlideTime = 0.0f;
			
			//Slideshow music begin
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Sound_CreateAtEntity("SlideshowMusic", "01_04_transport_station/Special/Train/infomercial/music", "Player", 0.0f, false, 1.0f);
			
			//Fade train engine and world to focus on screen
			Sound_FadeGlobalVolume(0.45f, 3.f, eSoundEntryType_GuiWorld);
		}
		
		//------------------------------------------------------------
		
		void OnGUISlideshow(const tString &in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("");
			//////////////
			StationGuiBG_Scanlines();
			
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
			
			mfSlideTime+=afTimeStep;
			
/*			if (true)
			{
				cImGuiGfx slide("slide3", eImGuiGfx_Texture);
				cVector2f vSize = ImGui_GetRatioCorrectSizeByWidth(slide, 1024);
				ImGui_DoImage(slide, cVector3f(0,0,1.0f), vSize);
				return;
			}*/
			
			ImGui_SetModColorMul(cColor(0,ImGui_GetStateFloat("SlideFade", 1)));
			ImGui_DoImage(cImGuiGfx(""), cVector3f(0,0,9.5f), ImGui_NrmSize(1));
			ImGui_SetModColorMul(cColor_White);
			
			if (mCurrentSlide!=eSlideShowSlide_None)
			{
				tString sSlideName = "slide"+int(mCurrentSlide);
				cImGuiGfx slide(sSlideName, eImGuiGfx_Texture);
				if (mCurrentSlide!=eSlideShowSlide_Pathos2 && mCurrentSlide!=eSlideShowSlide_SelectedStation)
				{
					cVector2f vSize = ImGui_GetRatioCorrectSizeByWidth(slide, 1024);
					ImGui_DoImage(slide, cVector3f(0.0f,0.0f,1.0f), vSize);
				}
				
				if (mCurrentSlide==eSlideShowSlide_Intro)
				{
					float t=cMath_Clamp(mfSlideTime/4.0f, 0.0f, 1.0f);
					
					float fGlobeWidth = cMath_Easing(eEasing_QuadOut,t,400.f,600.f);
					cImGuiGfx globe("trainmovie_globe", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(globe, ImGui_NrmPosGroup(0.5, 0.444, 2), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(globe, fGlobeWidth));
					
					float fLogoWidth = cMath_Easing(eEasing_QuadOut,t,750.f,900.f);
					cImGuiGfx logo("trainmovie_pathossuperlogo", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(logo, ImGui_NrmPosGroup(0.5, 0.444, 3), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(logo, fLogoWidth));
					
					cImGuiGfx phial("trainmovie_picto_phiole", eImGuiGfx_Texture);
					cVector2f vIconSize = ImGui_GetRatioCorrectSizeByNrmWidth(phial,0.15);
					ImGui_DrawAlignedGfx(phial, ImGui_NrmPosGroup(0.35,0.822,3), eImGuiAlign_CenterCenter, vIconSize);
					
					cImGuiGfx rocket("trainmovie_picto_rocket", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(rocket, ImGui_NrmPosGroup(0.5,0.822,3), eImGuiAlign_CenterCenter, vIconSize);
					
					cImGuiGfx gear("trainmovie_picto_gear", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(gear, ImGui_NrmPosGroup(0.65,0.822,3), eImGuiAlign_CenterCenter, vIconSize);
				}
				else if (mCurrentSlide==eSlideShowSlide_Pathos2)
				{
					float t=cMath_Clamp(mfSlideTime/12.0f, 0.0f, 1.0f);
					float fOffsX = cMath_Easing(eEasing_Linear, t, 0, -200);
					float fOffsY = cMath_Easing(eEasing_Linear, t, 0, -150);
					float fZoom = cMath_Easing(eEasing_Linear, t, 1, 1.25);
					cVector2f vSize = ImGui_GetRatioCorrectSizeByWidth(slide, 1024);
					ImGui_DoImage(slide, cVector3f(fOffsX,fOffsY,1.0f), vSize*fZoom );
									
					cImGuiGfx logo("trainmovie_pathosslide2logo", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(logo, cVector3f(20,20,3), eImGuiAlign_TopLeft, ImGui_GetRatioCorrectSizeByWidth(logo,256));
					
					cImGuiGfx map("atlanticmap", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(map, cVector3f(50,512,3), eImGuiAlign_BottomLeft, ImGui_GetRatioCorrectSizeByWidth(map,200));
				}
				else if (mCurrentSlide==eSlideShowSlide_Team)
				{
					cImGuiGfx photo1("trainmovie_foto_diver", eImGuiGfx_Texture);
					cImGuiGfx photo2("trainmovie_foto_lab", eImGuiGfx_Texture);
					cImGuiGfx photo3("trainmovie_foto_shaking", eImGuiGfx_Texture);
					
					float fPhoto1X = cMath_Easing(eEasing_QuadOut, cMath_Min(mfSlideTime-1.0f, 1.5f)/1.5f, 1.25, 0.175);
					float fPhoto2X = cMath_Easing(eEasing_QuadOut, cMath_Min(mfSlideTime-2.0f, 1.5f)/1.5f, 1.25, 0.5);
					float fPhoto3X = cMath_Easing(eEasing_QuadOut, cMath_Min(mfSlideTime-3.0f, 1.5f)/1.5f, 1.25, 0.825);
					cVector2f vPhotoSize = ImGui_GetRatioCorrectSizeByNrmWidth(photo1,0.225);
					ImGui_DrawAlignedGfx(photo1, ImGui_NrmPos(fPhoto1X,0.93,2.0f), eImGuiAlign_CenterCenter, vPhotoSize);
					ImGui_DrawAlignedGfx(photo2, ImGui_NrmPos(fPhoto2X,0.93,2.0f), eImGuiAlign_CenterCenter, vPhotoSize);
					ImGui_DrawAlignedGfx(photo3, ImGui_NrmPos(fPhoto3X,0.93,2.0f), eImGuiAlign_CenterCenter, vPhotoSize);
				}
				else if (mCurrentSlide==eSlideShowSlide_Science_1)
				{
					if (mfSlideTime > gfScienceSlideTime_1)
					{
						mCurrentSlide++;
						mfSlideTime=0.0f;
					}
				}
				else if (mCurrentSlide==eSlideShowSlide_Science_2)
				{
					if (mfSlideTime > gfScienceSlideTime_2)
					{
						mCurrentSlide++;
						mfSlideTime=0.0f;
					}
				}
				else if (mCurrentSlide==eSlideShowSlide_SelectedStation)
				{
					float t=cMath_Clamp(mfSlideTime/8.0f, 0.0f, 1.0f);
					float fOffsX = cMath_Easing(eEasing_Linear, t, 0, -256);
					float fOffsY = cMath_Easing(eEasing_Linear, t, 0, -128);
					float fZoom = cMath_Easing(eEasing_Linear, t, 1.25, 1.5);
					ImGui_DoImage(slide, cVector3f(fOffsX,0.0f,1.0f), cVector2f(1024*fZoom, 512*fZoom) );
									
					cImGuiGfx logo("trainstationlogo_"+msPickedStation, eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(logo, cVector3f(20,20,3), eImGuiAlign_TopLeft, ImGui_GetRatioCorrectSizeByWidth(logo,256));
				}
			}
		}
		
		//------------------------------------------------------------
		
		void ShowSlide(eSlideShowSlide aSlide)
		{
			mCurrentSlide = aSlide;
			mfSlideTime = 0.0f;
		}
		
		//------------------------------------------------------------
		
		void HideSlides()
		{
			mCurrentSlide=eSlideShowSlide_None;
		}
		
		//------------------------------------------------------------
		
		void OnSlideshowNextLine(const tString&in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject)
				return;
			
			Terminal_FadeImGuiStateFloat("TrainTerminal", "SlideFade", 1, 0.3);
			Map_AddTimer("Timer_FadeInSlide", 0.3, "Timer_FadeInSlide");
		}
		
		void Timer_FadeInSlide(const tString &in asTimer)
		{
			Terminal_FadeImGuiStateFloat("TrainTerminal", "SlideFade", 0, 0.3);
			mCurrentSlide++;
			mfSlideTime=0.0f;
		}
		
		//------------------------------------------------------------
		void OnSlideshowLastLine(const tString&in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject)
				return;
			HideSlides();
			SequenceStates_Resume("SequenceSlideshow");
		}
		
		//------------------------------------------------------------
		
		cSequenceStatesData mSequenceSlideshow;
		void SequenceSlideshow(const tString &in asX)
		{
			Sequence_Begin("SequenceSlideshow", mSequenceSlideshow);
			
			if (Sequence_DoStepAndWait(2.0f))
			{
				mCurrentSlide=eSlideShowSlide_None;
				RotateScreenDown();
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Terminal_SetGuiActive("TrainTerminal", true);
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				////////////
				// Start preloading
				Preload();
					
				ShowSlide(eSlideShowSlide_Intro);
				Terminal_SetImGuiStateFloat("TrainTerminal", "SlideFade", 1);
				Terminal_FadeImGuiStateFloat("TrainTerminal", "SlideFade", 0, 0.3);
				Dialog_Begin("Slideshow");
					Dialog_AddBranch("Main");
						Dialog_AddSubject("Slideshow1","OnSlideshowNextLine");
						Dialog_AddSubject("Slideshow2","OnSlideshowNextLine");
						Dialog_AddSubject("Slideshow3","OnSlideshowNextLine");
						Dialog_AddSubject("Slideshow4","OnSlideshowNextLine");
						Dialog_AddSubject("Slideshow5","OnSlideshowNextLine");
						Dialog_AddSubject("Slideshow"+msPickedStation,"OnSlideshowLastLine");
				Dialog_End();
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				RotateScreenUp();
				
				/////Stop slideshow music if still playing
				Sound_Stop("SlideshowMusic", 0.25f);
				////Fade up World audio
				Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_GuiWorld);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Terminal_SetGuiActive("TrainTerminal", false);
				mbSlideshowPlaying = false;
			}
			
			Sequence_End();
		}
		
		//} END TERMINAL
	
	//} END TERMINALS
	
