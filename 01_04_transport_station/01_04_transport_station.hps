		//-------------------------------------------------------
		
		bool mbPlatformFlowerDrained = false;

		//-------------------------------------------------------
		
		void WauFlowerPlatform(const tString &in asEntity)
		{
			mbPlatformFlowerDrained = true;
			Lamp_SetLit("screen_board_2", false, true);
			
			if (mPowerState_Platform != ePowerState_Good)
				return;
			
			SetPowerState_Platform(ePowerState_Bad);
		}

