	/////////////////////////////////////////
	// ==============
	// SCENE 4 *TRAIN CRASHES; ESCAPE TUNNEL*
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event A *Crash*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void SetupCrash()
		{
			// Turn off obstacle debris
			Entity_SetActive("ObstacleDebris*",false);
			
			Entity_SetActive("TriggerCrashArea",false);
			
			// GUI Off
			Terminal_SetGuiActive("Airlock2GUI",false);
			Entity_SetActive("Airlock2GUI", false);
			
			ParticleSystem_SetActive("TunnelEndLeak", false);
		}
		
		//} END GENERAL

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event A *Crash*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbInCrashArea = false;
		bool mbFlesherAwake = false;
		bool mbFirstFlesherAttackHappened = false;
		int mlRadialBlurID = -1;
		
		//-----------------------------------------------------------
		
		/**
		 * There is a electric shock/flash going through the tunnel and train rails off.
		 * */
		cSequenceStatesData mSequenceMoveTrainAndShakeEvent;
		void SequenceMoveTrainAndShakeEvent(const tString &in asX)
		{
			Sequence_Begin("SequenceMoveTrainAndShakeEvent", mSequenceMoveTrainAndShakeEvent);
			
			//Train shakes and begins to move.
			if(Sequence_DoStepAndWait(0.4f))
			{
				Prop_MoveLinearTo("01_05_transporter_passenger_1", "Train_Dest_2", 35, 20, 23, false);
			}
			
			//Tunnels reset and the move loop has been stopped, so they stay put.
			if(Sequence_DoStepAndWait(0.1f))
			{
				MoveObject_SetStateExt("01_05_tunnel_moving*", 0, 1000000, 1000000, 0, true);
				//MoveObject_SetStateExt("01_05_welder_moving*", 0, 1000000, 1000000, 0, true);
			}
			
			//Hide a large plane that has been used to optimize.
			if(Sequence_DoStepAndPause(0.0f))
			{
				Entity_SetActive("technical_occluder_2", false);
			}
			
			//Hit the obstacle
			if(Sequence_DoStepAndWait(6.0f))
			{
				mlTrainRideMsg = eStatusScreenMsg_FAILURE;
				
				mbJourneyInProgress = false;
				
				Effect_Shake_Start(0.2f, 0.25f, 0.1f, 0.7f);
				Effect_Shake_Start(0.1, 2.0f, 0.1, 0.7);
				
				//"Break" the train gear and add some spark effects.
				Lamp_SetLit("TrainSwitch_*", false, true);
				Entity_SetEffectsActive("TrainSwitch_1", false, true);
				Entity_SetEffectsActive("TrainSwitch_2", false, true);
				Entity_SetEffectsActive("TrainSwitch_3", false, true);
				Entity_SetEffectsActive("TrainTerminal", false, true);
				Lamp_SetLit("CrashSparkOutside_*", true, false);
				ParticleSystem_CreateAtEntity("CrashSparks_1", "elec_spark_subway_continuous.ps", "CrashSparkPSArea_1", true);
				ParticleSystem_CreateAtEntity("CrashSparks_2", "elec_spark_subway_continuous.ps", "CrashSparkPSArea_2", true);
			
				Lamp_SetLit("CrashSpark_*", true, false);
				
				Terminal_SetGuiActive("01_05_transporter_passenger_good_to_go_display_1", false, 0.2);
			}
			
			Sequence_End();
		}
		
		//-----------------------------------------------------------
		
		bool Trigger_DebrisWarning(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddTodoMessage("Sound: Warning that the track is blocked or that the power is low");
			Sound_CreateAtEntity("TrackCompromisedWarning", "01_04_transport_station/Special/Train/alarms/console_warning", "TrainConsoleSideSoundSource", 0, false);
			
			if (mPowerState_Platform == ePowerState_Bad)
			{
				cLux_AddTodoMessage("SOUND: Power fails in train!");
			
				Lamp_SetLit("cart_lamp_room_3_1", false, true);
				Lamp_SetFlickerActive("cart_lamp_room_3_2", true);
				Map_AddTimer("cart_lamp_room_3_2", 3, "TimerSetLampUnlitNoEffects");
				Map_AddTimer("StatusTerminal", 2.5, "TimerSetTerminalGuiInactive");
				Map_AddTimer("passenger_train_headlamp_1", 2.85, "TimerSetLampUnlit");
				Map_AddTimer("passenger_train_headlamp_2", 2.95, "TimerSetLampUnlit");
			}
			
			mlTrainRideMsg = eStatusScreenMsg_WARNING;
			return false;
		}
		
		//-----------------------------------------------------------
		
		bool Trigger_TrainCrashStart(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("SequenceMoveTrainAndShakeEvent");
			
			Sound_Stop("TrackCompromisedWarning", 0.5);
			
			// Debris crash
			if (mPowerState_Platform == ePowerState_Good)
			{
				TrainCrashStart_Debris();
			}
			
			// Low Power crash
			else
			{
				TrainCrashStart_PowerOutage();
			}

			return false;
		}
		
		//-----------------------------------------------------------
		
		void TrainCrashStart_Debris()
		{
			Effect_Shake_Start(0.4f, 0.5f, 0.1f, 0.7f);
			Entity_SetActive("TunnelDebris_*", false);
			
			cLux_AddTodoMessage("SOUND: Train hits debris!");
			cLux_AddTodoMessage("SCRIPT: Some neat particle effects.");
			
			Lamp_SetLit("cart_lamp_room_3_1", false, true);
			Lamp_SetFlickerActive("cart_lamp_room_3_2", true);
			Map_AddTimer("cart_lamp_room_3_2", 1, "TimerSetLampUnlitNoEffects");
		}
		
		//-----------------------------------------------------------
		
		void TrainCrashStart_PowerOutage()
		{
			Effect_Shake_Start(0.1f, 0.5f, 0.1f, 0.7f);
			
			cLux_AddTodoMessage("SOUND: Power goes out in tunnel!");
			
			for (int i = 1; Entity_Exists("PreCrashLamp_"+i); i+=2)
			{
				Map_AddTimer("PreCrashLamp_"+i, (i-1)*0.125, "TimerSetLampUnlitNoEffects");
				Map_AddTimer("PreCrashLamp_"+(i+1), (i-1)*0.125, "TimerSetLampUnlitNoEffects");
			}
		}
		
		//-----------------------------------------------------------
		
		bool OnTrainHitObstacle(const tString &in asParent, const tString &in asChild, int alState)
		{
			//SequenceStates_Resume("SequenceMoveTrainAndShakeEvent");
			
			Entity_SetActive("BrokenTunnelPiece",false);
			Entity_SetActive("train_broken_glass_*", true);
			
			Audio_Train_Hit2();
			Map_AddTimer("TrainEventEnd", 14.0f, "TrainEventEnd");
			
			return false;
		}

		//-----------------------------------------------------------
		
		
		
		/**
		 * Trigger opening a door to last part of level
		 * */
		bool CollideOpenLastDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Open last door!");
			
			Audio_Train_Hit1();
			Sound_Stop("TrackCompromisedWarning", 0.1f);
			Sound_CreateAtEntity("TrackCompromisedAlarm", "01_04_transport_station/Special/Train/alarms/console_impact_alarm", "TrainConsoleSideSoundSource");
			
			SlideDoor_SetClosed("slidedoor_traintunnel_6", false, false);
			Entity_SetActive("technical_occluder_3", false);
			
			Effect_Shake_Start(0.02, 1.5, 0.3, 0.5);
			
			Voice_Play("AboutToCrash");
			
			return false;
		}
		
		//-----------------------------------------------------------
		
		/**
		 * Train has railed off and comes to a halt, player falls out of chair and train gear break.
		 * */
		bool Trigger_StopTrain(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_StopTrain("");
			return false;
		}
		
		cSequenceStatesData mStopTrainSequence;
			
		void Seq_StopTrain(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StopTrain", mStopTrainSequence);
			//Small delay to keep everything in sync
			if (Sequence_DoStepAndWait(0.15))
			{				
				// Stop derail effects
				Prop_StopMovement("01_05_transporter_passenger_1");
				Lamp_SetLit("CrashSparkOutside_*", false, false);
				ParticleSystem_Destroy("CrashSparks_1");
				ParticleSystem_Destroy("CrashSparks_2");
				ParticleSystem_SetVisible("CrashSparks_*", false);
				
				SlideDoor_SetClosed("slidedoor_traintunnel_6", true, true);
				Entity_SetActive("technical_occluder_4", true);
				
				Player_SetMoveSpeedMul(1);				
				Effect_Shake_Start(0.04, 1, 0.1, 0.5);
				
				// Knock down pile of pipes.
				Prop_SetStaticPhysics("01_04_note_pipes_1",false);
				Entity_AddImpulse("01_04_note_pipes_1", cVector3f(0.0f, 0.0f, -0.05f), false, false);
				
			}
			else if (Sequence_DoStepAndWait(0.2))
			{		
				cLux_AddDebugMessage("Fall off chair!");
				Entity_RemoveEntityAttachment("Player");				
				CameraAnimation_Begin("CamOffRailFall", "", true);
			}
				
			else if (Sequence_DoStepAndPause())
			{
				Effect_Fade_Out(0.0f);
				Sound_Stop("TrackCompromisedAlarm", 0.0f);
				SetupPostTrainCrashEffects();
				cSound_FadeLowPassFilter(300, 0.0f, 0.5f, eSoundEntryType_World);
				Entity_PlaceAtEntity("01_05_transporter_passenger_1", "TrainCrashTarget", 0, true);
				Lamp_SetFlickerActive("passenger_train_headlamp_*", true);
			}
			
			else if (Sequence_DoStepAndWait(1))
			{
				TimerConfigTrainForAfterCrash("");
				Map_AddTimer("TrainCrashOverMusic", 8.0f, "Timer_Music_TrainCrashFinale");
			}
			
			Sequence_End();
		}
		
		void TrainEventEnd(const tString &in asTimer)
		{
			//Omnitool
			CathTool_AllowDetach("CathTool");
			
			// Hurt player
			Player_GiveDamage(0.3, 0.1, eDamageType_None, "");
			
			//Reenable movement
			Player_SetJumpDisabled(false);
			Player_SetStandDisabled(false);
			
			//Add particle dust
			ParticleSystem_CreateAtEntity("CrashDustPS", "dust_cloud_long", "CrashImpactDustArea", false);
			
			//Fade in picture
			Map_AddTimer("FadePostCrash", 1.0f, "FadeinPostCrash");
			
			//Resume Sequence
			Map_AddTimer("TrainSequenceResume", 4.5f, "TrainSequenceResume");
			
			//Fade in audio
			cSound_FadeLowPassFilter(22000, 0.0f, 8.5f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(1.0f, 3.5f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(1.0f, 3.5f, eSoundEntryType_WorldClean);
			
			//Setup sound areas
			Entity_SetActive("AMB_TrainCrashed", true);
			Sound_CreateAtEntity("TrainAlarm", "01_04_transport_station/Special/Train/post_crash/alarm", "Sound_TrainAlarmSource");
			Map_AddTimer("TrainAlarmStop", 20.0f, "TrainAlarmStop");
			
			Map_AddTimer("Intercom_1", 1, "Timer_FlashIntercomOff");
		}
		
		void TrainAlarmStop(const tString &in asTimer)
		{
			Sound_Stop("TrainAlarm", 0.25f);
		}
		
		void FadeinPostCrash(const tString &in asTimer)
		{
			Effect_Fade_In(2.f);
			Sound_CreateAtEntity("ConsoleAlarm", "01_04_transport_station/Special/Train/post_crash/console_alarm", "TrainConsoleSideSoundSource");
			Sound_CreateAtEntity("TrainSparks", "level_amb_shared_interior/amb/spot/sparks/spark_train_crash", "Sound_TrainSparks");
		}
		
		void TrainSequenceResume(const tString &in asTimer)
		{
			SequenceStates_Resume("Seq_StopTrain");
		}

