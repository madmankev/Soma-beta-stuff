		//-------------------------------------------------------
		
		/**
		 * Change the train and entities in it to fit the crashed state.
		**/ 
		void TimerConfigTrainForAfterCrash(const tString &in asTimer)
		{
			//Turn back collision settings made to smooth the train ride.
			Entity_SetActive("train_sitting_block_*", false);
			Entity_SetCollideCharacter(msTrainChairName, true);
			
			//Activate the emergency exit.
			Entity_SetInteractionDisabled("LeverEmergency", false);
			Lamp_SetLit("LightEmergency", true, true);
			
			//Setup a broken normal door.
			Entity_RemoveCollideCallback("Player", "Area_Transport1_Door1");
			Entity_AddCollideCallback("Player", "Area_Transport1_Door1", "CollideCartDoorBroken");
			
			// Show the debris
			Entity_SetActive("ObstacleDebris*",true);
			
			// Enable area so we can work out when we leave it...
			Entity_SetActive("TriggerCrashArea",true);
			mbInCrashArea = true;
			
			//////////////////////////////////////////
			// Warning light
			Lamp_SetLit("TrainWarningLamp", true, true);
		
			// Clear death meter
			Map_AddTimer("TimerRemoveCrashDeathMeter",2.0f,"TimerRemoveCrashDeathMeter");
			
			// Start making the player want to get out quick
			Map_AddTimer("TrainCartCreepyness", 7, "SequenceTrainCartCreepyness");
			
			//////////////////////////////////////////
			// Setup checkpoint
			CheckPoint_Setup();
		}
		
