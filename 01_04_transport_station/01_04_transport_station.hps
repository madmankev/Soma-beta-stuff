		//-------------------------------------------------------

		void InteractTransmissionLink(const tString &in asEntity)
		{
			cLux_AddTodoMessage("Sound: Player answers the call, rinigng stops");
			if (Sound_Exists("IntercomCall")) Sound_Stop("IntercomCall", 0.1);
			Map_RemoveTimer("Intercom_1");
			Entity_FadeEffectBaseColor("Intercom_1", cColor_White, 0.25);
			
			cScript_SetGlobalVarBool("TalkedToCathInLambda", true);
				
			Dialog_StartConversation("Catherine", asEntity);
			Dialog_Begin("");
				Dialog_AddBranchAndSubject("LambdaTransmissionLink", "", "Subject_TransmissionLinkCut");
			Dialog_End();
		}
		
		void LineOver_InteractTransmissionLink(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
		{
			if (abStart==false) return;
			
			Entity_FadeEffectBaseColor("Intercom_1", 0, 0.1);
		}
		
