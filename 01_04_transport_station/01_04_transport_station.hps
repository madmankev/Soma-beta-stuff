	//-------------------------------------------------------
		
		//Trigger to stop tunnel sparks when in airlock/starting passage as sound leaks through
		bool TunnelSparkFlickerTrigger(const tString &in asParent, const tString &in asChild, int alState)
		{
			Light_SetFlickerActive("TunnelSpark_1", true);
			cLux_AddDebugMessage("tunnel spark light active");
			if (alState==1)
			{
				cLux_AddDebugMessage("tunnel spark light inactive");
				Light_SetFlickerActive("TunnelSpark_1", false);
			}
			return true;
		}
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 2 General
		//{///////////////////////////////////////

		//------------------------------------------------------------
		
		bool mbAmyRobotActivated = false;

		//------------------------------------------------------------
		
		void SetupGetPowerOn()
		{
			StickyArea_AttachBody("AmyStickyArea","AmyCable_Body_11");
			//Map_AddTimer("hatch_tunnel_maintenance_2", 1, "TimerSwitchMovingButtonOn");
			
			Map_AddTimer("AmyBreatheOut", 1, "TimerAmyBreathe");
		}
		
		//------------------------------------------------------------
		
		bool CanUsePowerChip(const tString &in asTool, const tString &in asEntity)
		{
			return asEntity == "PowerChipUseArea";
		}
		
		//------------------------------------------------------------
		
		void OnGui_AmyRoomPowerStatus(const tString&in asEntityName, float afTimeStep)
		{	
			ImGui_SetTransCategory("01_04_transport_station");
			
			//StationGuiBG_BackdropV2();
			StationGuiBG_Scanlines();
			
			if (mPowerState_General != ePowerState_Good)
			{
				float fAlpha = mPowerState_General == ePowerState_Bad ? 0.4 : 0.6;
				float fDistortion = 0.05f + ImGui_GetStateFloat("Distortion", 0);
				Depth_ImGui_WauLeechGibberish(cColor(0.8, fAlpha), fDistortion, 2);
			}
			
			tString sText = "AmyRoomPowerInfo_NoPower";
			if (mPowerState_General == ePowerState_Good)
				sText = "AmyRoomPowerInfo_Good";
			else if (mPowerState_General == ePowerState_Bad)
				sText = "AmyRoomPowerInfo_Bad";
			
			cColor color = mPowerState_General == ePowerState_Good ? gStationGuiColor_Highlight : gStationGuiColor_Warning;
			bool bBlinking = ImGui_GetStateFloat("Blinking") > 0;
			
			StationGui_BigStatusMessage(sText, color, 2, bBlinking);
		}

		//} END GENERAL
	
