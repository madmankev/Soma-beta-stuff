	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 1 EMERGE FROM COMM ROOM
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 1 INTRO
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	cSequenceStatesData mIntroSequence;
	
	void SequenceIntro(const tString &in asTimer)
	{
		Sequence_Begin("SequenceIntro", mIntroSequence);
		
		//SETUP DURING BLACK
		if (Sequence_DoStepAndWait(5.508f))
		{
			Player_SetFlashlightDisabled(true);
			Effect_Fade_Out(0);
			Effect_ImageTrail_Start(1.5, 0.2, 10, 2);
			
			////////////////////
			// Set fog color
			Map_FadeFogColor(gOceanFogColor,0);
			
			Sound_CreateAtEntity("IntroDRONE", "01_03_upsilon_outside/SFX/intro/sequence/drone", "Player");
			Sound_CreateAtEntity("IntroSFX", "01_03_upsilon_outside/SFX/intro/sequence/sfx", "Player");
		}
		
		//BEGIN INTRO DURING BLACK
		if (Sequence_DoStepAndWait(0.5f))
		{
			ParticleSystem_CreateAtEntity("bubblyBubbles", "loop_waterbubbles_large_cloud.ps", "PSCamBubbles", true);
			ParticleSystem_CreateAtEntity("bubblyFlow", "01_03_loop_bubbles_swoosh.ps", "PSIntroFlow", true);
			
			CameraAnimation_Begin("AnimIntro", "", true);
			CameraAnimation_SetAttachedEntity("PSCamBubbles", false, false, false);
			
			////////////////////
			// Play music
			//TODO: Have some other type of music (need to check and work with end of 1.2) 
			//Think it works fine if the music ends and then no music plays until you are closer 
			//to the semi scary bot.
			//Music_Play("01_03_intro", 0.45f, false, eMusicPrio_BigEvent);
		}
		
		//FADE IN SCENE
		else if (Sequence_DoStepAndWait(1.5))
		{		
			//Insta fade
			Effect_Fade_In(0.0f);
			Player_StartLookAt("AreaLookAtIntro", 1, 1, 1);
			Sound_CreateAtEntity("IntroFoley", "01_03_upsilon_outside/SFX/intro/sequence/foley", "Player");
		}
		
		//REMOVE PARTICLES (Not all) FROM INTRO AND STOP SHORT LOOK AT
		else if (Sequence_DoStepAndWait(0.5))
		{	
			ParticleSystem_Destroy("bubblyBubbles");
		}
		else if (Sequence_DoStepAndWait(0.75))
		{	
			ParticleSystem_Destroy("bubblyFlow");
			Player_StopLookAt(1);
		}
	
		//REST OF EVENT DURING INTRO OUR CALLBACKS FROM CAM ANIMATION. FOUND BELOW.
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	//TRIGGERS AS PLAYER IS ON BACK LOOKING UP
	bool IntroEnd(const tString &in asEntity, int alDirection)
	{
		//Fade up audio
		Sound_FadeGlobalVolume(1.0f, 5.0f);
		
		cLux_AddTodoMessage("Sound: Player on ground thud.");
		CameraAnimation_Begin("AnimIntroGettingUp", "", true);
		
		//Needs tweak but particle editor crashing too much at the moment
		ParticleSystem_CreateAtEntity("bubblyBubbles02", "01_03_oneshot_bubbles_player.ps", "PSCamBubbles", true);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	//HALF WAY UP AFTER LYING ON BACK
	bool IntroComment(const tString &in asEntity, int alDirection)
	{
		ParticleSystem_Destroy("bubblyBubbles02");
		
		cLux_AddTodoMessage("Sound: Player getting up.");
		
		Dialog_Begin();
			Dialog_AddBranch("Intro");
				Dialog_AddSubject("Intro_Breath");
				Dialog_AddSubject("LeftCommRoom");
		Dialog_End();

		return true;
	}
	
	void LineOver_ShowPlayerHands(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if(abStartOfLine==false) return;
		
		PlayerHands_SetUseCustomPosition(false);
		PlayerHands_SetUseCustomRotation(false);
		PlayerHands_PlayAnimation("event_look_at_hands_1_3");
	}
	
	
	//-------------------------------------------------------

	//STANDING BUT LOOKING DOWN, SOON AFTER FULLY STANDING AND INTRO OVER.
	bool IntroHands(const tString &in asEntity, int alDirection)
	{
		Music_PlayExt("01_03_wakeupintro", false, 0.45f, 1.0f, 3.0f, 1.0f, eMusicPrio_BigEvent, false);

		return true;
	}

	//-------------------------------------------------------
	
	bool IntroOver(const tString &in asEntity, int alDirection)
	{
		Player_SetFlashlightDisabled(false);
		return true;
	}

	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 1A PLAYER CLIMBS OUT OF WINDOW
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbFirstTimeClimb = false;
	
	void AreaClimbHole_OnPlayerInteract(const tString &in asEntity)
	{
		////////////////////////////////////////////////
		// When player interacts with the hole, climb up
		CameraAnimation_Begin("ExitAnimation", "", true);
		CameraAnimationNode_SetAutoMove("ExitAnimation_10", 1);
		
		// Climb up/out sound
		Sound_CreateAtEntity("ClimbOut", "01_03_upsilon_outside/SFX/intro/player_climbout_building", "Player", 0.0f, false, 1.0f);
		Emotion_PlayEventBreath("01_03_upsilon_outside/SFX/intro/player_climbout_building_vo", 3);
		
		/////////////////////////////////
		// Disable area so player can't climb from outside
		Entity_SetActive(asEntity,false);
		
		//Check if player has already climbed out window before, 
		//if so, don't retrigger music
			if (mbFirstTimeClimb==false)
			{
				cLux_AddDebugMessage("First time climb out - triggering music");
				Music_Stop(6.0f, eMusicPrio_BgAmb);
				Map_AddTimer("FirstExtMusic", 6.f, "ExitingDomeMusic");
				mbFirstTimeClimb = true;
				return;
			}

			if (mbFirstTimeClimb==true)
			{
				cLux_AddDebugMessage("Player has already climbed out - not triggering music");
				return;
			}
	}
		
	//-------------------------------------------------------
	
	bool CollideHoleArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////
		// When near the hole activate the climbable area
		// When leaving it - disable it!
		bool bClimbActive = alState == 1 ? true : false;
		Entity_SetActive("AreaClimbHole",bClimbActive);
		
		///////////////////////////////////
		// Always preserve this trigger in case the player comes back inside
		return true;
	}
	
