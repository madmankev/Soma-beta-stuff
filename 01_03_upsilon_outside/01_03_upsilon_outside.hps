	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 7A EXIT DOOR
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlPowerCableCount = 3;
	bool mbFinalDoorOpened = false;
	
	void SetupExitDoor()
	{
		StickyArea_AttachBody("PowerCableSticky_1", "PowerCable_1_Body_11");
		StickyArea_AttachBody("PowerCableSticky_2", "PowerCable_2_Body_11");
		StickyArea_AttachBody("PowerCableSticky_3", "PowerCable_3_Body_11");
	}
	
	//-------------------------------------------------------
	
	bool OnTriggerMapPreload(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(asChild == "TriggerMapPreload_1") Preload();
		if(asChild == "TriggerMapPreload_2") PreloadSetPrioNormal();
		
		return false;
	}

	//-------------------------------------------------------
	
	void OnPowerCableDetach(const tString &in asStickyArea, const tString &in asBodyName)
	{
		cLux_AddDebugMessage("Detach cable.");
		Sound_CreateAtEntity("DetachCableSound", "01_03_upsilon_outside/SFX/cable_unplug/cable_unplug", asStickyArea, 0, false);
		Entity_SetActive(asStickyArea, false);
		ParticleSystem_CreateAtEntity("PowerCableSpark_"+asStickyArea, "elec_spark_oneshot.ps", asStickyArea, true);
		mlPowerCableCount--;
		if ((mlPowerCableCount==0)&&(!mbFinalDoorOpened))
		{
			Map_AddTimer("delta_ceiling_large_1", 0.3, "TimerTurnOffLamp");
			Map_AddTimer("delta_ceiling_large_2", 0.6, "TimerTurnOffLamp");
			Map_AddTimer("TimerPowerCablesComplete",1.0f,"TimerPowerCablesComplete");
			Entity_SetActive("LaunchSiteEntranceProximity",false);
			
			//Added these as otherwise door will lock if player closes it after using alternate solution.
			SwingDoor_SetBlocked("LaunchSiteDoor", false, false);
			SwingDoor_SetLocked("LaunchSiteDoor", true, false);
		}
		else if(mlPowerCableCount==1)
		{
			//Graceful fade out for ending music
			mbIsAmbientMusicPlaying = false;
			Entity_SetActive("CableAmbientMusicStart", true);
			Entity_SetActive("CableAmbientMusicStop", true);
			Music_Stop(4.0f, eMusicPrio_BgAmb);
		}
		
		tString sCable = Body_GetEntityName(asBodyName);
		Lamp_SetLit(sCable+"_Lamp", false, true);
		Entity_SetActive(sCable+"_Aux", false);
	}
	
	//-------------------------------------------------------
	
	void TimerPowerCablesComplete(const tString &in asTimer)
	{
		mbFinalDoorOpened = true;
		OpenFinalDoor();
		StopKateFollowing();
	}
	
