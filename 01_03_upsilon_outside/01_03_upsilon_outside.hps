	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 4A HEAD POUNDING ROBOT
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollisionHeadBangerTarget(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			// Headbanger hits wall
			Sound_CreateAtEntity("HeadBangImpactSound", "01_03_upsilon_outside/construct_headbang/construct_headbang", "HeadbangerBangArea", 0, true);
			Sound_CreateAtEntity("HeadBangRattleSound", "01_03_upsilon_outside/construct_headbang/headbang_rattle_sweet", "HeadbangerRattleArea", 0, true);
		}
		
		
		return true;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 4B DYING ROBOT
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbDyingRobotFirstLine = true;
	
	//-------------------------------------------------------
	
	bool CollideDyingRobotProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState>0)
		{
			cLux_AddDebugMessage("Near dying robot!");
			
			BarkMachine_SetActive("AttackBot", false);
			Voice_SetSource("DyingRobot", "DyingRobot", 1.5, 15, true, 11);
			Timer_DyingRobotTalking("");
			Map_AddTimer("DyingFlickerOff", 0.1, "Timer_DyingFlickerOff");
		}
		else
		{
			cLux_AddDebugMessage("Away from dying robot.");
			
			Map_RemoveTimer("DyingRobotTalking");
			Map_RemoveTimer("DyingFlickerOn");
			Map_RemoveTimer("DyingFlickerOff");
			
			BarkMachine_SetActive("AttackBot", true);
		}
				
		return true;
	}
	
	//-------------------------------------------------------
	
	void Timer_DyingFlickerOn(const tString&in asTimer)
	{
		Entity_SetEffectsActive("DyingRobot", true, false);
		
		if(cMath_RandRectl(0, 4)==0)		
			Map_AddTimer("DyingFlickerOff", cMath_RandRectf(3, 5), "Timer_DyingFlickerOff");
		else
			Map_AddTimer("DyingFlickerOff", cMath_RandRectf(0.1f, 0.2f), "Timer_DyingFlickerOff");
	}
	
	void Timer_DyingFlickerOff(const tString&in asTimer)
	{
		Entity_SetEffectsActive("DyingRobot", false, false);
		Map_AddTimer("DyingFlickerOn", cMath_RandRectf(0.05f, 0.15f), "Timer_DyingFlickerOn");
	}
	
	//-------------------------------------------------------
	
	void Timer_DyingRobotTalking(const tString&in asTimer)
	{
		if(mbDyingRobotFirstLine)
		{
			Voice_Play("DyingRobot_FirstLine", -1, "SubjectOver_DyingRobot", 1);
			mbDyingRobotFirstLine = false;
		}
		else
		{
			Voice_Play("DyingRobot_RandomLine", -1, "SubjectOver_DyingRobot");
		}
	}
	
	void SubjectOver_DyingRobot(const tString&in asScene, const tString&in asSubject)
	{
		Map_AddTimer("DyingRobotTalking", cMath_RandRectf(3, 7), "Timer_DyingRobotTalking");
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 4C PUMP CRUMBLES
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollisionPumpSinkTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		SequencePumpSinking("");
		return false;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mPumpSinkingSequence;
		
	void SequencePumpSinking(const tString &in asTimer)
	{
		Sequence_Begin("SequencePumpSinking", mPumpSinkingSequence);
	
		if (Sequence_DoStepAndWait(1))
		{
			cLux_AddTodoMessage("SOUND: Pump gets unsteady. @ SinkingPump");
			
			Prop_MoveLinearTo("SinkingPump", "SinkingPump_Target_1", 10, 1, 0, true);
			Prop_AlignRotation("SinkingPump", "SinkingPump_Target_1", 10, 1, 0.00, false);
			
			int lID = Effect_Shake_Start(0.01, 1, 1, 0.1f);
			Effect_Shake_SetSourceEntity(lID, "SinkingPump", 5, 20);
		}
		else if (Sequence_DoStepAndWait(4))
		{
			cLux_AddTodoMessage("SOUND: Pump sinks into the sound, bubbles emerge @ SinkingPump");
			
			Prop_MoveLinearTo("SinkingPump", "SinkingPump_Target_2", 0.5, 0.3, 0.1, true);
			Prop_AlignRotation("SinkingPump", "SinkingPump_Target_2", 0.15, 0.12, 0.00, false);
			ParticleSystem_SetActive("PumpSinkBubbles_*", true);
			ParticleSystem_SetActive("PumpSinkDust_*", true);
			
			int lID = Effect_Shake_Start(0.03, 4, 0.3, 1);
			Effect_Shake_SetSourceEntity(lID, "SinkingPump", 5, 20);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			ParticleSystem_Destroy("PumpSinkDust_*");
		}
	
		Sequence_End();
	}
	
