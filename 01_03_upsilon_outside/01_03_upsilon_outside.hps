	/////////////////////////////////////////
	// 2 C SCAVENGE ROBOT START
	/////////////////////////////////////////
		
	//-------------------------------------------------------
	
	bool Collide_StartScavenge(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Scavenge for a player");
		
		Entity_SetActive("ScavengeRobot", true);
		Entity_SetActive("AreaDetectPlayer", true);
		
		Pathfinder_Track_Add("ScavengeRobot", "PathNodeArea_161");
		Pathfinder_Track_Start("ScavengeRobot", false, 1, "ScavengeScavenges");
		
		CheckPoint_Setup("");
		AttackMeter_SetAttackerTeleportPosition("MonsterSpawn_ScavengeBot_*");
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void ScavengeScavenges(const tString &in asEntity)
	{
		Pathfinder_Track_Clear(asEntity);
		
		ConstructWorker_SetMoodAgressive(asEntity);
		ConstructWorker_SetIdleMode_Stalk(asEntity);
		Agent_RevealPlayerPosition(asEntity, true);
		cLux_AddDebugMessage("Reveal Player to:"+asEntity);
		
		Entity_SetActive("AreaDetectPlayer", false);
	}
	
	//-------------------------------------------------------
	//Area that triggers reaching the patrol node, to make bot react better to a player near.
	bool CollideDetectPlayer(const tString &in asParent, const tString &in asChild, int alState)
	{
		ScavengeScavenges("ScavengeRobot");
		
		return false;
	}
	
