const cColor gCommRoomFogColor = cColor(0.126,0.152,0.146,0.376);
const cColor gOceanFogColor = cColor(0.009,0.028,0.035,1);

const float gfSignalTowerMinStaticVolume = 0.1f;
const float gfSignalTowerReneFreq = 0.25f;
const float gfSignalTowerStation2Freq = 0.8f;



class cScrMap : iScrMap
{
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// MAIN CALLBACKS
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		///////////////////////////////
		// Setup presets
		{
			/////////////////////////////
			//1.4 Map presets to fade to when transition
			Map_Preset_SetupColorGrading("Level1.4", "textures/colorgrading/grading_01_04.dds");
			//Map_Preset_SetupToneMapping("Level1.4", 0.5f, 0.0f, 3.5f);
			//Map_Preset_SetupDirLight("Level1.4", false, cColor(0,0,0,0), 0, cVector3f(0,0,0), cColor(0,0,0,0), cColor(0,0,0,0));
		}
	}
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		
		/////////////////////////////////////////////////
		// Audio setup
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
		Sound_PreloadCoreUWSounds();
		Sound_PreloadGroup("01_03_upsilon_outside", true);
		Sound_PreloadGroup("NPC_Creatures", true);
		Sound_PreloadGroup("NPC_Construct", true);
		Sound_CreateAtEntity("TrapAlarm", "01_03_upsilon_outside/katebot/katebot_help", "InfectedKate_AI", 0.0f, false, 1.0f);

		//--------------------------------------------------------------

		Map_SetUnderwater(true);
		
		SetupTaintedPumpStation();
		SetupSignalTowerArea();
		SetupExitDoor();
		SetupStuckKate();
		
		//SetupEndOfLevelWelding
		{
			Entity_SetEffectsActive("BunkerWeldingFlare", false, false);
			LensFlare_SetVisible("BunkerWeldingFlare_LensFlare_*", false);
		}
		
		bool bDoIntro = true;
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Outdoors();
		
		PlayerHands_SetHandModel_Diving();
		
		Player_SetFlashlightOnOffCallback("Flashlight_FirstTime");
		
		///////////////////////////////////////////////////
		//Airlock sound
		Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "Pump_SoundSource", 1.0f, false, 1.0f);
		
		ParticleSystem_SetActive("airlock_drain_leak_*", false);
		ParticleSystem_SetActive("airlock_drain_droplets_*", false);
		ParticleSystem_SetActive("airlock_drain_droplets2_*", false);
		
		Lamp_SetLit("lamp_room_1_*", false, false);
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
		//	OpenFinalDoor();
			//Preload();
			Entity_SetActive("CathTool", true);
			
			bDoIntro = false;
			Sound_FadeGlobalVolume(1.0f, 1.0f);
			/////////////////////////
			// Debug AI
			//mbPlayerAtCharger = true;
			//KateCopyChargeEvent("", "", 1);
		}
		
		if (bDoIntro)
			SequenceIntro("");
			
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		GetBase().SetDisplayNameEntry("01-03-upsilon-outside");
				
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		
		float fFadeTime = 0.0;
		Effect_Bloom_FadeBrightPass(0.00001, fFadeTime); //sets pixels over 127 (255 * 0.5) to add to bloom
		Effect_Bloom_FadeBloomWidth(160, fFadeTime); //sets 128 pixels in bloom width, looks best within 32 - 512 pixels.
		Effect_Bloom_FadeBloomTint(0.3, 0.3, 0.3, fFadeTime); //sets red tint to bloom
		
		Effect_DoF_Start(0.05, 12, 1.0f, 3);
		
		//iTexture@ pSkybox = cResources_CreateTextureCubeMap("grayscale_gradient_1_4_fog.dds",false);
		cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(null);

		Tool_PickUp("CathTool", false, false); 
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Music_Stop(1.0f, eMusicPrio_BgAmb);
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		bool bHidden = cLux_GetPlayer().GetVisibilityMaxRange()>0 || cLux_GetPlayer().GetVisibilityRangeMul()<1;
		afY = cLux_DrawDebugText("Hidden: "+bHidden, afY);
		return afY;
	}
	
	//-------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{
		if(cLux_ScriptDebugOn()==false) return;	
		
		ImGui_LayoutBegin(eImGuiLayout_XY, cVector3f(500, 0,0), cVector2f(400,0));
		
		ImGui_LayoutEnd();
	}
	
	//-------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;
	}
	
	void Flashlight_FirstTime(bool abLit)
	{	
		cLux_AddDebugMessage("You discovered the flashlight!");
		
		Voice_PlayWhenPossible("GetFlashlightUnderwater", "", 30.0f, 5.0f, "Flashlight_OnCommentOver");
						
		cScript_SetGlobalVarBool("PlayerActivatedFlashlight", true);
		
		Player_SetFlashlightOnOffCallback("");
	}
	
	void Flashlight_OnCommentOver(const tString&in asScene, const tString&in asSubject)
	{
		Map_AddTimer("", 2.0f, "Timer_ShowFlashlightHint");
	}
	
	void Timer_ShowFlashlightHint(const tString &in asTimer)
	{
		Hint_ShowInfo("Hints","HintFlashlight", true);
	}
	
