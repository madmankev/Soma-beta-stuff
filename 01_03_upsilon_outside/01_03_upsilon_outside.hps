	//-------------------------------------------------------

	void InteractDisabledButton(const tString &in asEntity, int alState)
	{
		Sound_CreateAtEntity("InactiveDoorButton", "Entities_OceanBottom/tech/door_buttons/locked", asEntity, 0.1f, false);
		
		TimerKateDoorWelding("");
