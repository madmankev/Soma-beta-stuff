	//-------------------------------------------------------
	
	bool CollisionPistonUp(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		//Breaks sound if speed is set any higher, fmod makes too many calls
		MoveObject_SetStateExt(asChild, 1, 2.5, 0.5, 0, false);
		Sound_CreateAtEntity("PipeDown", "Entities_OceanBottom/tech/pump_machine/action", asChild);
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollisionPistonDown(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		MoveObject_SetStateExt(asChild, 0, 4, 0.95, 0, false);
		return true;
	}
	
