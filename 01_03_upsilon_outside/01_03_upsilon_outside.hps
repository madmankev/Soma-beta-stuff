	//-------------------------------------------------------
	
	void InteractBunkerDoor(const tString &in asEntity)
	{
		TimerKateDoorWelding("");
	}
 
	//-------------------------------------------------------
	bool mbKateRescued = false;
	
	void TimerKateDoorWelding(const tString &in asTimer)
	{
		if (!mbKateRescued || mbWeldingActive) return;
		
		mbFinalDoorOpened = true;
		
		cLux_AddDebugMessage("Welding investigation triggered");
		
		Map_AddTimer("HelpfulSoundTimer", 0.75, "TimerKateHelpfulSound");
		Kate_Investigate("InfectedKate_AI", "BunkerWeldingPos", "BunkerWeldingFlare", -1, "KateAtPanel_LaunchSite");
		
		Map_RemoveTimer("auto_weld");
		Entity_SetActive("LaunchSiteEntranceProximity", false);
		
		Entity_SetInteractionDisabled("TransportStationPanel_Outside", true);
		Entity_SetPlayerInteractCallback("LaunchSiteDoor", "", false);
	}
 
	//-------------------------------------------------------
	
	void TimerKateHelpfulSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("HelpfulKate", "NPC_Kate/talk/katebot_idle_talk", "InfectedKate_AI", 0, false);
	}

	//-------------------------------------------------------

	bool CollideOpenDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (!mbKateRescued) return true;
		
		mbFinalDoorOpened = true;
		
		Map_AddTimer("auto_weld", 5, "TimerKateDoorWelding");
		
		return false;
	}
	
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 3 Event B *Enter Control Bunker; Robot Unlocks*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	void KateAtPanel_LaunchSite(const tString &in asEntity)
	{
		SwingDoor_SetBlocked("LaunchSiteDoor", false, false);
		SwingDoor_SetLocked("LaunchSiteDoor", true, false);
		
		mbWeldingActive = true;
		
		Map_AddTimer("KateWeldsBunker", 0.75, "SequenceKateUnlocksLaunchSite");
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mKateUnlocksLaunchSiteSequence;
	bool mbWeldingActive = false;
	void SequenceKateUnlocksLaunchSite(const tString &in asTimer)
	{
		Sequence_Begin("SequenceKateUnlocksLaunchSite", mKateUnlocksLaunchSiteSequence);
			
		if (Sequence_DoStepAndPause(0))
		{
			//Graceful fadeout of ambience music for door open reveal piece
			Music_Stop(4.0f, eMusicPrio_BgAmb);
			mbIsAmbientMusicPlaying = false;
			
			Sound_CreateAtEntity("KateWelding", "NPC_Kate/tool/torch", "BunkerWeldingFlare", 0.0, true);
			Entity_SetActive("BunkerWeldingFlare", true);
			Entity_SetEffectsActive("BunkerWeldingFlare", true, true);
			LensFlare_SetVisible("BunkerWeldingFlare_LensFlare_*", true);
			Entity_AttachToEntity("InfectedKate_AI", "BunkerWeldingFlare", "", false);
			Prop_MoveLinearTo("BunkerWeldingFlare", "BunkerWeldTarget_1", 2, 0.15, 0.1, true);
			Kate_LookAt("InfectedKate_AI", "BunkerWeldingFlare");
			
			CharMover_SetUseMoveStateAnimations("InfectedKate_AI", false);
			Entity_PlayAnimation("InfectedKate_AI", "welding", 0.1, true);
		}
		for (int i = 2; Entity_Exists("BunkerWeldTarget_"+i); i++)
		{
			if (!Sequence_DoStepAndPause(0)) continue;
			
			Prop_MoveLinearTo("BunkerWeldingFlare", "BunkerWeldTarget_"+i, 10, 0.15, 0.1, true);
			Kate_LookAt("InfectedKate_AI", "BunkerWeldingFlare");
		}
		if (Sequence_DoStepAndWait(0.25))
		{
			Entity_RemoveEntityAttachment("InfectedKate_AI");
			CharMover_SetDirection("InfectedKate_AI", eLuxCharMoveDirection_Backward);
			Pathfinder_MoveToNode("InfectedKate_AI", "BunkerWeldingDonePos", "");
			
			Sound_Stop("KateWelding", 0);
			Entity_SetEffectsActive("BunkerWeldingFlare", false, true);
			LensFlare_SetVisible("BunkerWeldingFlare_LensFlare_*", false);
			
			Entity_StopAnimation("InfectedKate_AI");
			CharMover_SetUseMoveStateAnimations("InfectedKate_AI", true);
		}
		if (Sequence_DoStepAndWait(1.25))
		{
			OpenFinalDoor();
		}
		else if (Sequence_DoStepAndWait(1.25))
		{
			mbWeldingActive = false;
		}
		else if (Sequence_DoStepAndWait(0.75f))
		{
			Entity_SetActive("KateBlocker_2", true);
			CharMover_SetDirection("InfectedKate_AI", eLuxCharMoveDirection_Forward);
			CharMover_TurnToEntity("InfectedKate_AI", "Player");
		}
		else if (Sequence_DoStepAndWait(0))
		{
			//TODO: Kate should stop following the player but no helper for it
			//If not turning off follow player it seems kate can at times ignore
			//the pathfinder below and go back to following the player.
			
			StopKateFollowing();
			
			//Enable ambient music areas if the player wishes to go back and explore
			Entity_SetActive("CableAmbientMusicStart", true);
			Entity_SetActive("CableAmbientMusicStop", true);
			
			Voice_Play("ThankKateBot");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OpenFinalDoor()
	{
		// Trigger spooky reveal music
		Music_Play("01_03_stationhatch.ogg", 0.7f, false, eMusicPrio_BigEvent);
		
		//final music stop for players pulling cables
		Music_Stop(4.0f, eMusicPrio_BgAmb);
		mbIsAmbientMusicPlaying = false;
		
		cLux_AddTodoMessage("Sound: Launch Site Door welded open");
		ParticleSystem_CreateAtEntity("LaunchSiteDoorParticles_1", "oneshot_waterbubbles_big.ps", "LaunchSiteDoorPSArea_1", false);
		ParticleSystem_CreateAtEntity("LaunchSiteDoorParticles_2", "oneshot_waterbubbles_big.ps", "LaunchSiteDoorPSArea_2", false);
		ParticleSystem_CreateAtEntity("LaunchSiteDoorParticles_3", "oneshot_waterbubbles_big.ps", "LaunchSiteDoorPSArea_3", false);
		
		Sound_CreateAtEntity("DoorOpenSweetener", "01_03_upsilon_outside/sweeteners/station_door_sweetener", "LaunchSiteDoor", 0, false);	
		Map_AddTimer("TimerFinishFinalDoor",1.25,"TimerFinishFinalDoor");
	}
	
	//-------------------------------------------------------
	
	void TimerFinishFinalDoor(const tString& in asName)
	{
		TimerOpenDoor("poof");
	}
	
	//-------------------------------------------------------
	
	void StopKateFollowing()
	{
		Agent_SetSensesActive("InfectedKate_AI", false);
			
		Pathfinder_Track_Add("InfectedKate_AI", "PathNodeArea_505");
		Pathfinder_Track_Add("InfectedKate_AI", "PathNodeArea_165");
		Pathfinder_Track_Add("InfectedKate_AI", "PathNodeArea_167");
		Pathfinder_Track_Start("InfectedKate_AI", false, 0.1, "RemoveInfectedKate");
			
		Sound_CreateAtEntity("InfectedKateScared", "01_03_upsilon_outside/katebot/katebot_scared", "InfectedKate_AI", 0, false);
	}
 
	//-------------------------------------------------------
	
	void RemoveInfectedKate(const tString &in asEntity)
	{
		Entity_SetActive(asEntity, false);
	}
	
	//-------------------------------------------------------
	
	bool CollisionBunkerWeldTarget(const tString &in asParent, const tString &in asChild, int alState)
	{
		SequenceStates_Resume("SequenceKateUnlocksLaunchSite");
		return false;
	}
	
	//-------------------------------------------------------
	//Game keeps crashing if trying to have a dynamic cable, temp skiping and only having opening a locker as solution.
	void InteractLocker(const tString &in asEntity)
	{
		if(mbKateRescued) return;
		
		mbWeldingActive = true;
		Map_AddTimer("poof", 3, "TimerOpenDoor");
	}
	
	//-------------------------------------------------------
	
	void TimerOpenDoor(const tString &in asTimer)
	{
		Sound_CreateAtEntity("LaunchDoorUnlocked", "shipwreck/doors/cabin_slide_door/open", "LaunchSiteDoor", 0, true);
		SwingDoor_SetLocked("LaunchSiteDoor", false, true);
		SwingDoor_SetDisableAutoClose("LaunchSiteDoor", true);
		SwingDoor_SetClosed("LaunchSiteDoor", false, true);
		Entity_AddImpulse("LaunchSiteDoor", cVector3f_Back*0.3, true, true);
		Entity_SetInteractionDisabled("LaunchSiteDoor", false);
		Entity_SetActive("BunkerWeldingFlare", false);
	}
		
	//----------------------------------------------------------------------
	
	 //////////////////////////////////////////////////////////////////////////////////////////
	 // ==============
	 // AIR LOCK (FROM 1.4)
	 // ==============
	 //{//////////////////////////////////////////////////////////////////////////////////////
	
	//----------------------------------------------------------------------
	//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event A *Flush Airlock*
		//{///////////////////////////////////////

		//-------------------------------------------------------

		/**
		 * Pumping out water and opening the entrance to the station
		 **/
		cSequenceStatesData mSequencePumpOutWater;
		void SequencePumpOutWater(const tString &in asX)
		{
			Sequence_Begin("SequencePumpOutWater", mSequencePumpOutWater);

			if(Sequence_DoStepAndWait(1.0))
			{
				Map_RemoveTimer("reset_pump");
				Map_RemoveTimer("TimerButtonBlink");
				
				Light_FadeTo("warning_lamp_room_1_rot_SpotLight_*", cColor(-1,-1,-1,-1), 8, 3);
				Sound_CreateAtEntity("AirlockAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "AirlockAlarm_SoundSource");
				Prop_RotateToSpeed("warning_lamp_room_1_rot", 4, 4, cVector3f(1,0,0), false, "");

				//////////////////////////
				///Airlock draining sound
				Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop", "Pump_SoundSource", 0.0f, false, 1.0f);
				Depth_Audio_AirlockDrainLeadInUW();
				Depth_Audio_AirlockDrainLoopUW();
				Sound_Stop("Pump_Idle_Loop_Underwater", 1.0f);
				
				/////////////////////////////
				//Disable player jump during sequence to stop them from clipping through water and breaking sound
				Player_SetJumpDisabled(true);
				Player_SetCrouchDisabled(true);
			}

			if(Sequence_DoStepAndWait(1.0))
			{
				PreloadLightFix();
				
				Sound_CreateAtEntity("LaunchDoorUnlocked", "shipwreck/doors/cabin_slide_door/open", "LaunchSiteDoor", 0, true);
				SwingDoor_SetLocked("LaunchSiteDoor", true, true);
				SwingDoor_SetClosed("LaunchSiteDoor", true, true);
			}
				
				
			//Water begins to drain out of room.
			else if(Sequence_DoStepAndWait(7))
			{
				PreloadDeload();
				
				//Remove more water particles.
				ParticleSystem_Destroy("ParticleSystem_47");
				for(int i=1;i<7;i++) ParticleSystem_Destroy("waterbubbles_"+i);
				ParticleSystem_Destroy("ParticleSystem_1"); //a missing bubbles particle.
				LiquidArea_MoveLinearTo("LiquidArea_1", "LiquidArea_EndPos", 0.1, 1, 0.5, false);
				
				Map_AddTimer("AirlockDrainUWStopTimer", 6.75f, "AirlockDrainUWStop");
			}
			
			else if(Sequence_DoStepAndWait(2))
			{
				PreloadFadePresets();
				PreloadFadeGlobals();
				PreloadChangeLevelEffects();
			
				Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.4f, 0.2f, 0.6f);  
				Effect_Screen_Start("water_drip_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 1, 2, 1);
				ParticleSystem_SetActive("airlock_drain_leak_*", true);
				ParticleSystem_SetActive("airlock_drain_droplets_*", true);
				ParticleSystem_SetActive("airlock_drain_droplets2_*", true);
				
				Player_SetJumpDisabled(false);
				Map_SetUnderwater(false);
			}
			
			//Water gone and entrancer to level opens.
			else if(Sequence_DoStepAndWait(2.85))
			{
				Player_SetCrouchDisabled(false);
				
				ParticleSystem_Destroy("airlock_drain_leak_*");
				ParticleSystem_Destroy("airlock_drain_droplets2_*");
				Prop_RotateToSpeed("warning_lamp_room_1_rot", 1, 0, cVector3f(1,0,0), false, "");
				Light_FadeTo("warning_lamp_room_1_rot_SpotLight_*", cColor(-1,-1,-1,-1), 0, 4);
				ParticleSystem_CreateAtEntityExt("drops1", "drops_med_continuous_short.ps", "AreaDrops_1", true, cColor(1,1,1,1), 1.f, true, 1, 4, 10, 15);
				ParticleSystem_CreateAtEntityExt("drops2", "drops_med_continuous_short.ps", "AreaDrops_2", true, cColor(1,1,1,1), 1.f, true, 1, 4, 10, 15);
			}
			
			else if(Sequence_DoStepAndWait(0.15f))
			{
				Sound_FadeGlobalVolume(0.5f, 1.25f, eSoundEntryType_WorldAll);
				Sound_Stop("AirlockAlarm", .05f);
			}
			
			else if(Sequence_DoStepAndWait(0.0f))
			{
				ParticleSystem_Destroy("airlock_drain_droplets_*");
				
				PreloadChangeOfMap();
			}
			
			Sequence_End();
		}
		
		//------------------------------------------------------------
		
		void AirlockDrainUWStop(const tString &in asTimer)
		{
			////////////////////////////////////
			//Switch sound areas from uw to air and stop scuba sounds
			Entity_SetActive("AMB_Airlock_Water", false);
			Entity_SetActive("AMB_Airlock_Air", true);
			
			Depth_Audio_PlayLeaveWater();
			Sound_Stop("PumpUW", 0.55f);
			Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "Pump_SoundSource", 0.55f, false, 1.0f);
			
			Depth_Audio_AirlockDrainLoopUWStop();
			Depth_Audio_AirlockDrainLoopAir();
			Map_AddTimer("AirlockDrainingAirStopTimer", 3.0f, "AirlockDrainingAirStop");
		}

		void AirlockDrainingAirStop(const tString &in asTimer)
		{
			Depth_Audio_AirlockDrainLoopAirStop();
			Depth_Audio_AirlockDrainLeadOutAir();
			Sound_Stop("PumpingAirLoop", 0.25f);
			Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "Pump_SoundSource", 0.0f, false, 1.0f);
		}
		
		//-------------------------------------------------------
		//} EVENT
	
	//} END SCENE 1
	
	//-------------------------------------------------------

		/////////////////////////////////////////
		// Omnitool
		//{///////////////////////////////////////

		//-------------------------------------------------------
	
		bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			return asEntity=="AirlockPanelArea_1";
		}
		
		//------------------------------------------------------------
		
		bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			// Use omnitool in the first airlock
			if (asEntity=="AirlockPanelArea_1")
			{
				Entity_SetActive("AirlockPanelArea_1", false);
				Entity_SetActive("AirlockToolArea_1", false);
				
				Button_SetSwitchedOn("AirlockPanel_1", true, true);
				
				SequencePumpOutWater("pumping_water_not_iron");

				Entity_AddImpulse("LaunchSiteDoor", cVector3f_Forward*2, true, true);
		
				return false;
			}
			
			return false;
		}
		
		//} End omnitool
		
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// PRELOADING
	/////////////////////////////////////////

	//-------------------------------------------------------

	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("01_04_transport_station.hpm", eWorldStreamPriority_Low);
	}
	
	//-------------------------------------------------------
	
	void PreloadSetPrioNormal()
	{
		if(PreloadDisabled()) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////
	//pointlights bleeding through walls.
	void PreloadLightFix()
	{
		Light_FadeTo("PointLight_35", cColor(0), 0, 0.05);
		Light_FadeTo("PointLight_20", cColor(0), 0, 0.05);
		Light_FadeTo("PointLight_36", cColor(0), 0, 0.05);
		Light_FadeTo("PointLight_28", cColor(0), 0, 0.05);
		Light_FadeTo("PointLight_27", cColor(0), 0, 0.05);
		Light_FadeTo("SpotLight_23", cColor(0), 0, 0.05);
		Light_FadeTo("SpotLight_16", cColor(0), 0, 0.05);
		
		/////////////////////
		//Also added disable some objects that otherwise will teleport to 1.4
		Entity_SetActive("PowerBox", false);
		Entity_SetActive("PowerBox_Lamp", false);
		Entity_SetActive("01_03_power_box__door_1", false);
		Entity_SetActive("PowerCable_*", false);
	}
	
	//-------------------------------------------------------

	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("Transfer0304");
	}
	
	//-------------------------------------------------------
	
	void PreloadFadePresets()
	{
		Map_Preset_Fade("Level1.4", 1);
	}
	
	//-------------------------------------------------------
	
	void PreloadFadeGlobals()
	{
		if(PreloadDisabled()) return;
		
		Map_AddTimer("FadeGlobal", 1.1, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeLevelEffects()
	{
		Map_SetEnvironmentParticlesActive(false);
		
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(false);
		
		float fFadeTime = 0.1;
		Effect_Bloom_FadeBrightPass(0.75f, fFadeTime);
		Effect_Bloom_FadeBloomWidth(128.0f, fFadeTime);
		Effect_Bloom_FadeBloomTint(1, 1, 1, fFadeTime);
	}
	
	//-------------------------------------------------------

	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_SetPreloadPriority(eWorldStreamPriority_High);

		Map_AddTimer("ChangeMap", 0.25, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 3, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted) return;
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 1);
			
			Map_AddTimer("FadeGlobal", 1.1, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
		
		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Description_SetForceFading(true);
				Map_ChangeMap("01_04_transport_station.hpm", "", "Transfer0304", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.25f, "PreloadTimer");
		}
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	//Manually load next level if preload fails,  preload disabled.
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("01_04_transport_station.hpm", "PlayerStartArea_1", "", "");
	}
	
	//----------------------------------------------------------------------
	
	 //////////////////////////////////////////////////////////////////////////////////////////
	 // ==============
	 // AUDIO
	 // ==============
	 //{//////////////////////////////////////////////////////////////////////////////////////
	
	//----------------------------------------------------------------------
	
	//MUSIC
	//Player leaves dome for the first time
	void ExitingDomeMusic(const tString &in asTimer)
	{
		Music_PlayExt("02_06_exitvents", false, 0.75f, 1.0f, 0.0f, 0.0f, eMusicPrio_BigEvent, false);
		Sound_FadeGlobalVolume(0.65f, 8.0f, eSoundEntryType_WorldClean);
		Map_AddTimer("AmbientMusicFirst", cMath_RandRectf(45.f, 50.f), "AmbientMusic");
		Map_AddTimer("FadeUpMusic", 20.0f, "FadeUpWorldClean");
	}
	
	bool mbIsAmbientMusicPlaying = false;
	
	void AmbientMusic(const tString &in asTimer)
	{
		if(asTimer=="AmbientMusicFirst" && mbIsAmbientMusicPlaying==false && mbStopFirstAmbienceFromPlaying==false)
		{
			mbIsAmbientMusicPlaying = true;
			Music_PlayExt("01_03_introambient", true, 0.35f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, true);
			cLux_AddDebugMessage("First Ambient Music Triggered");
		}
		
		if(asTimer=="AmbientMusicSecond" && mbIsAmbientMusicPlaying==false)
		{
			mbIsAmbientMusicPlaying = true;
			Music_PlayExt("01_03_extendedambience", true, 0.35f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, true);
			cLux_AddDebugMessage("Second Ambient Music Triggered");
		}
		if(asTimer=="AmbientMusicStop" && mbIsAmbientMusicPlaying==true)
		{
			mbIsAmbientMusicPlaying = false;
			Music_Stop(7.0f, eMusicPrio_BgAmb);
			cLux_AddDebugMessage("Ambient music stopping");
		}
	}
	
	bool mbStopFirstAmbienceFromPlaying = false;
	
	bool StopAmbientMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbStopFirstAmbienceFromPlaying = true;
		Map_AddTimer("AmbientMusicStop", 1.0f, "AmbientMusic");
		return false;
	}
	
	//---------------------------------------------------
	
	bool EncounterMusicTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("Audio_StartEncounter", 0.5f, "Audio_Encounters");
		return false;
	}
		
	void Audio_Encounters(const tString &in asTimer)
	{
		if(asTimer=="Audio_StartEncounter")
		{
			if(mbIsAmbientMusicPlaying==true)
			{
				mbIsAmbientMusicPlaying = false;
				Music_Stop(5.0f, eMusicPrio_BgAmb);
			}
		//Encounter music tense here
		cLux_AddDebugMessage("Encounter Music Triggered");
		Music_PlayExt("NPC_construct_short3", false, 0.55f, 1.f, 0.0f, 0.0f, eMusicPrio_MinorEvent, false);
		}
		
		else if(asTimer=="Audio_EndEncounter")
		{
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Map_AddTimer("AmbientMusicSecond", 3.0f, "AmbientMusic");
			cLux_AddDebugMessage("End Encounter Music");
		}
	}
	
	//---------------------------------------------------
	
	bool HeadbangerMusicTriggerSpawn(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1){
			Entity_SetActive("HeadbangerMusicLookAt", true);
			cLux_AddDebugMessage("Headbanger look at area enabled");
		}
		else{
			Entity_SetActive("HeadbangerMusicLookAt", false);
			cLux_AddDebugMessage("Headbanger look at area disabled");
		}
		return true;
	}
	
	void HeadBangerMusic(const tString &in asEntity, int alState)
	{
		Music_PlayExt("NPC_construct_react3", false, 0.55f, 1.0f, 0.0f, 0.0f, eMusicPrio_MinorEvent, false);
		Sound_FadeGlobalVolume(0.55f, 5.0f, eSoundEntryType_WorldClean);
		Map_AddTimer("HeadbangerMusicFadeUp", 8.f, "FadeUpWorldClean");
		cLux_AddDebugMessage("Headbanger music triggered & fading down worldclean");
	}
	
	void FadeUpWorldClean(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Fading up worldclean");
		Sound_FadeGlobalVolume(1.f, 5.0f, eSoundEntryType_WorldClean);
	}
	
	bool Cables_StopAmbientMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Stop Amb Music");
		mbIsAmbientMusicPlaying = false;
		Music_Stop(4.0f, eMusicPrio_BgAmb);
		return true;
	}
	
	bool Cables_StartAmbientMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Restart Amb Music");
		Map_AddTimer("AmbientMusicSecond", 3.0f, "AmbientMusic");
		return true;
	}
		
	//----------------------------------------------------------------------
	
	//} END AUDIO
}