	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollisionLeaveUpsilon(const tString &in asParent, const tString &in asChild, int alState)
	{		
		if (alState == -1) return true;
		
		// Make fishes swim away
		Entity_PlaceAtEntity("AweFishTarget", "AweFishTarget_2");
