 <Subjects>
  <Subject Name="1_PhoneCall" UseSingleRandomLine="False" SceneId="0" EffectId="-1">
   <Line CharacterId="0" Direction="(shocked)" Prio="0">
    <Sound Text="I'm up." VoiceOffset="1" Volume="0.6" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="1" Prio="0">
    <Sound Text="Hi, Simon Jarret?" EndPadding="-0.1" Volume="0.8" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="0" Prio="0">
    <Sound Text="Yeah, that's me." Volume="0.55" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="1" Prio="0">
    <Sound Text="My name is David Munshi. We spoke earlier -" EndPadding="0.25" Volume="0.7" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="0" Prio="0">
    <Sound Text="The brain scan, I remember." EndPadding="0.17" Volume="0.6" Timestamp="2014-10-15 05:07" />
   </Line>
   <Line CharacterId="1" Prio="0">
    <Sound Text="Are you all right?" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="0" Prio="0">
    <Sound Text="Just a bad dream. Are we still on for today?" Volume="0.65" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="1" Prio="0">
    <Sound Text="Yeah, that's why I'm calling. I wanted to remind you to drink the tracer fluid I sent you. It will help me capture a better image of the damages." Volume="0.75" Timestamp="2015-03-09 10:37" />
   </Line>
   <Line CharacterId="0" Prio="0">
    <Sound Text="Don't worry, I got it somewhere." Volume="0.8" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="1" Prio="0">
    <Sound Text="Okay, great. See you in a couple of hours then." Volume="0.75" Timestamp="2014-10-15 01:00" />
   </Line>
   <Line CharacterId="0" Prio="0">
    <Sound Text="See you soon." Volume="0.65" Timestamp="2014-10-15 01:00" />
   </Line>
  </Subject>
  <Subject Name="5_FoundTracer" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="There it is." Volume="0.7" Timestamp="2014-02-06 03:25" />
   </Line>
  </Subject>
  <Subject Name="6_DrinkTracer" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Feels like milk, but the taste - like sucking on a penny." Volume="0.85" Timestamp="2015-03-09 10:37" />
   </Line>
  </Subject>
  <Subject Name="7_BrokenShower" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Don't want to keep the doctor waiting. I'll shower when I get back." Volume="0.85" Timestamp="2014-02-06 03:25" />
   </Line>
  </Subject>
  <Subject Name="8_OpenDrapes" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Summer's coming. Hope it's a good one." Volume="0.8" Timestamp="2015-03-09 10:37" />
   </Line>
  </Subject>
  <Subject Name="9_InspectFridge" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Nothing but fast food. Should buy something healthier on my way home." VoiceOffset="1" Volume="0.7" Timestamp="2015-03-09 10:37" />
   </Line>
  </Subject>
  <Subject Name="10_AnswerMachine" UseSingleRandomLine="False" SceneId="1" EffectId="-1">
   <Line CharacterId="2" Direction="talking into answering machine" Prio="0" Callback="LineOver_AnswerPhoneBeepSound" EntitySource="Simon_Phone" MinDist="1" MaxDist="11" MaxFreq="1000" MaxListeningDist="11">
    <Sound Text="Hey, Simon. It's Jesse! Are you working this weekend or what?" VoiceOffset="0.75" EndPadding="-0.4" Volume="0.65" Timestamp="2014-10-14 05:29" />
    <Sound Text="I know there was some thing you were doing - was it this weekend or next?" EndPadding="-0.8" Volume="0.65" Timestamp="2015-03-09 10:37" />
    <Sound Text="Anywho, just shoot me a mail or something. Loveyoumissyoumeanit!" EndPadding="-0.8" Volume="0.65" Timestamp="2015-03-09 10:37" />
   </Line>
   <Line CharacterId="3" Prio="0" EntitySource="AnsMachSource" MaxDist="11" MaxFreq="1000" MaxListeningDist="11">
    <Sound Text="End of messages." VoiceOffset="0.25" Volume="0.45" Timestamp="2015-01-19 01:14" />
   </Line>
   <Line CharacterId="0" Prio="0">
    <Sound Text="I swear that guy has the memory of a gold fish." Volume="0.8" Timestamp="2014-10-14 05:29" />
   </Line>
  </Subject>
  <Subject Name="11_UseTV" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Right, watching TV gives me headaches now. Thank you, brain." Timestamp="2014-10-15 05:07" />
   </Line>
  </Subject>
  <Subject Name="12_TryToExit" UseSingleRandomLine="False" SceneId="0" EffectId="-1">
   <Line CharacterId="0" Prio="0" PlayOnce="True">
    <Sound Text="I really should drink the tracer fluid before I go and see Dr Munshi." Volume="0.7" Timestamp="2014-02-11 06:34" />
   </Line>
  </Subject>
  <Subject Name="13_TracerReminder" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Where did I put the tracer fluid?" Volume="0.7" Timestamp="2013-11-05 12:49" />
   </Line>
  </Subject>
  <Subject Name="13_TracerReminderB" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Come on, radioactive tracer fluid. Where are you?" Volume="0.7" Timestamp="2015-03-09 10:37" />
   </Line>
  </Subject>
  <Subject Name="13_NoNewMessages" UseSingleRandomLine="False" SceneId="1" EffectId="-1">
   <Line CharacterId="3" Prio="0" Callback="LineOver_AnswerPhoneBeepSound" EntitySource="Simon_Phone" MaxDist="11" MaxFreq="1000" MaxListeningDist="11">
    <Sound Text="You have no new messages." VoiceOffset="0.25" Volume="0.45" Timestamp="2014-06-24 05:33" />
   </Line>
  </Subject>
  <Subject Name="1_PhoneCallOver" UseSingleRandomLine="False" SceneId="0" EffectId="-1">
   <Line CharacterId="0" Direction="(under his breath)" Prio="0">
    <Sound Text="...christ... " Volume="0.65" Timestamp="2015-01-19 04:34" />
   </Line>
  </Subject>
  <Subject Name="2_UnsentMailReaction" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Direction="surprised" Prio="0">
    <Sound Text="Huh, I forgot to hit send. Does it matter? I already told him about it." Timestamp="2015-03-13 02:18" />
   </Line>
  </Subject>
  <Subject Name="2_SentMailReaction" UseSingleRandomLine="False" SceneId="2" EffectId="-1">
   <Line CharacterId="0" Prio="0">
    <Sound Text="Better late then never." Timestamp="2015-03-13 02:18" />
   </Line>
  </Subject>
 </Subjects>
