	//-------------------------------------------------------

	/////////////////////////////////////////
	// HOLDING HANDLES
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	float mfMaxHandleForce;
	bool mbTrainHasStopped;
	bool mbTrainIsAccelerating;
	bool mbTrainIsStopping;
	array<iLuxEntity@> mvHandles; 

	//-------------------------------------------------------
	
	void IncrementHandleForces(float alMultiplier)
	{
		mfMaxHandleForce += 0.02*alMultiplier;
		if (mfMaxHandleForce > 0.3)
		{
			mfMaxHandleForce = 0.3;
		}
		if (mfMaxHandleForce < 0)
		{
			mfMaxHandleForce = 0;
		}
	}
	
	//-------------------------------------------------------
	
	void ApplyHandleForces(float afAmountX, float afAmountZ)
	{
		cVector3f vImpulse;
		
		for(uint i=0; i<mvHandles.length(); ++i)
		{
			cLuxProp@ pProp = cLux_ToProp(mvHandles[i]);
			cVector3f vPropVelocity = pProp.GetBodyFromName("Body_bottom").GetAngularVelocity();
			
			vImpulse = cMath_RandRectVector3f(cVector3f(-afAmountX,0,-afAmountZ), cVector3f(afAmountX,0,afAmountZ)); 
			pProp.GetBodyFromName("Body_bottom").AddImpulse(vImpulse);
		}
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// MOVE DEBRIS 
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	float fAccumulatedForce = 0;
	float fDebrisForceDirection = 0;
	
	//-------------------------------------------------------
	
	void RollBottle(float afDirection)
	{
		//afDirection should be either 1 or -1
		fAccumulatedForce = 0;
		fDebrisForceDirection = afDirection;
		SequenceMoveDebris("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqMoveDebris;
	void SequenceMoveDebris(const tString &in asX)
	{
		Sequence_Begin("SequenceMoveDebris", mSeqMoveDebris);
		
		for (uint i=0;i<5;++i)
		{
			if (Sequence_DoStepAndWait(0.1))
			{
				ApplyForcesToDebris(fDebrisForceDirection * 0.1);
			}
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void ApplyForcesToDebris(float afAmount)
	{	
		fAccumulatedForce += afAmount;
		
		float fX = fAccumulatedForce;
		float fY = 0;
		float fZ = 0;
			
		// Apply it
		cVector3f vImpulse = cVector3f(fX,fY,fZ); 
		Entity_AddImpulse("debris_*",vImpulse,false,true);
		
	}
	
	//----------------------------------------------------
	
	///////////////////////////////////////
	// TRAIN CONTROLS
	///////////////////////////////////////
	
	//-----------------------------------------------------
	
	tID m_idFrontCarriage;
	tID m_idRearCarriage; 
	bool mbTrainMoving = false;
	int mlID_CrashShakeEffect = 0;
	int mlID_CrashTrailEffect = 0;
	
	cVector3f mvRearCarriageStart = cVector3f_Zero;
	cVector3f mvFrontCarriageStart = cVector3f_Zero;
	float mfCarriageBobCycle = 0;
	float mfCarriageSwayDistance = 0.1;
	float mfCarriageBounceCycle = 0;
	float mfCarriageBounceDistance = 0.1;
	
	bool mbLooping = false;
	bool mbStopLooping = false;
	
	//-----------------------------------------------------
	
	void ConstructTunnelAndTrainRig()
	{
		///////////////////////////////////////////
		//Turn off station 01 start, station 02 and 03 start/end and regular wall end.
		//Using Mesh visible to simply be able to move all of the meshes, which if using active would not be possible.
		for(int i=1;i<=3;i++)
		{
			mBaseObj.GetEntityByName("00_02_station_01_s_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
			mBaseObj.GetEntityByName("00_02_station_02_s_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
			mBaseObj.GetEntityByName("00_02_station_03_s_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
			
			mBaseObj.GetEntityByName("00_02_station_01_e_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
			mBaseObj.GetEntityByName("00_02_station_02_e_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
			mBaseObj.GetEntityByName("00_02_station_03_e_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
		}
		
		///////////////////////////////////////////
		//Turn off station wall in the beginning.
		for(int i=1;i<=5;i++)
		{
			mBaseObj.GetEntityByName("00_02_outside_sp"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
			mBaseObj.GetEntityByName("00_02_outside_spw"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
		}

		///////////////////////////////////////////
		// Attach all the entities to the moving area.
		Entity_AttachToEntity("00_02_outside_*","TrainMoveArea","",false,false);
		Entity_AttachToEntity("00_02_station_*","TrainMoveArea","",false,false);
		Entity_AttachToEntity("subway_lamp*","TrainMoveArea","",false,false);
		
		////////////////////////////////////////////////////////
		// Remember starting positions of front & rear carriages and get IDs
		iLuxEntity@ pRearCarriage = mBaseObj.GetEntityByName(gsCarriageName+"1");
		mvRearCarriageStart = pRearCarriage.GetPosition();
		cLux_AddDebugMessage("Vec: " + mvRearCarriageStart.x + "," + mvRearCarriageStart.y + "," + mvRearCarriageStart.z);
		m_idRearCarriage = pRearCarriage.GetID();
		
		iLuxEntity@ pFrontCarriage = mBaseObj.GetEntityByName(gsCarriageName+"2");
		mvFrontCarriageStart = pFrontCarriage.GetPosition();
		cLux_AddDebugMessage("Vec: " + mvFrontCarriageStart.x + "," + mvFrontCarriageStart.y + "," + mvFrontCarriageStart.z);
		m_idFrontCarriage = pFrontCarriage.GetID();
	}
	
	//-----------------------------------------------------

	void Timer_TrainBounce(const tString &in asTimer)
	{	
		////////////////////////
		// This timer should repeat!
		Map_AddTimer("TrainBounce",cMath_RandRectf(1.0,3.0),"Timer_TrainBounce");	
		
		///////////////////////////
		// But if train is not moving, do not run effects
		if (mbTrainMoving == false || mbTrainHasStopped == true) return;
		
		
		///////////////////////////////////////////////
		// Periodically cause a subtle shake effect for the train
		Effect_Shake_Start(0.03,0.1,0.21,0.21,cVector3f(0,1,0),3);
		
		///////////////////////////////////////////////
		// Move handles
		ApplyHandleForces(mfMaxHandleForce,mfMaxHandleForce);
	}
	
	//-----------------------------------------------------
	
	void Open_Train_Doors()
	{
		Map_AddTimer("open_door", 8, "TimerDoorOpen");
		Map_AddTimer("close_door", 19, "TimerDoorClose");
	}
	
	//-----------------------------------------------------
	bool mbFirstTimeTrainMovement = true;
	void Move_Train(float afAccMul, float afSpeedMul)
	{
		float fAccel = gfTrainBaseAcc * afAccMul;
		float fSpeed = gfTrainBaseSpeed * afSpeedMul;
		
		mbTrainMoving = true;
		mbTrainHasStopped = false;
		mbTrainIsAccelerating = true;

		///////////////////////////////////
		// Move debris around
		RollBottle(1.0);
		
		///////////////////////////////////
		// Move the train
		Area_MoveLinearTo("TrainMoveArea","TrainEndPoint",fAccel, fSpeed, 50, false);	// Begin moving the wall
		
		if (mbFirstTimeTrainMovement==true)
		{
			Sound_CreateAtEntity("TrainLoop", "00_01_subway/SFX/train_loop", "train_door_source", 0.0f, false, 1.0f);
			cLux_AddDebugMessage("SOUND: Train is moving for the first time");
			mbFirstTimeTrainMovement = false;
		}
		else
		{
			Sound_CreateAtEntity("TrainDepart", "00_01_subway/SFX/train_depart", "train_door_source");
			Sound_CreateAtEntity("TrainLoop", "00_01_subway/SFX/train_loop", "train_door_source", 8.0f, false, 1.0f);
			cLux_AddDebugMessage("SOUND: Train is Moving");
		}

	}
	
	//-----------------------------------------------------
	
	void Reset_Train()
	{
		// just a little polish 
		Effect_Shake_Start(0.01,0.1,0,0.1,cVector3f(1,0,0),1);		// mask it with a slight mechanical jault as train starts if necessary
		
		Entity_PlaceAtEntity("TrainMoveArea","TrainBeginPoint",cVector3f_Zero,false);
		mfMaxHandleForce = 0;
	}

	//-------------------------------------------------------
	
	bool Trigger_LoopTrain(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1)
			return true;
			
		if (mbStopLooping)
		{
			mbLooping = false;
			return true;
		}
		
		mbLooping = true;
		
		cLux_AddDebugMessage("Loop");
		// just a little polish 
		Effect_Shake_Start(0.01,0.1,0,0.1,cVector3f(1,0,0),1);		// mask it with a slight mechanical jault as train starts if necessary
		
		Entity_PlaceAtEntity("TrainMoveArea","TrainLoopPoint_Start",cVector3f_Zero,false);
		
		return true;
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// TRAIN MOVEMENT
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	////////////////////
	// When the walls have moved so they are close to the end of how many there are, the area triggers a timer to reset wall and 
	// start moving the wall again from the beginning.
	bool mbIsTrainSlowDownPlaying = false;
	bool CollideCheckPos(const tString &in asParent,const tString &in asChild, int alState)
	{
		if(alState == -1) return true;
		
		if (mbLooping) return true;
		
		mlTrainDistance++;
		
		// When train starts moving again, let the handles start swinging
		// otherwise reduce the impulse we give it back towards zero
		if (mlTrainDistance < 34)
		{
			IncrementHandleForces(1);
		}
		else
		{
			IncrementHandleForces(-1);
		}
		
		//////////////////////////////////////////////
		//Fade platform lights as we leave the station
		if (mlTrainDistance == 11)
		{
			Light_FadeTo("tunnel_Light*",cColor(0.0,0.0,0.0),0.0,0.75); // off
		}
		if (mlTrainDistance == 38)
		{
			Light_FadeTo("tunnel_Light*",cColor(0.27,0.82,1.0),0.25,0.75); // on
		}
		
		/////////////////////////////////
		//A bit before destination, update the end station graphics.
		if(mlTrainDistance == 30)
		{
			Train_SetDestination();
		}
		
		/////////////////////////////////	
		//Trigger the train stopping sound.
		if(mlTrainDistance == 34)
		{
			if(mbIsTrainSlowDownPlaying==false)
			{
				cLux_AddTodoMessage("SOUND: Train is Stopping");
				Sound_CreateAtEntity("TrainArrive", "00_01_subway/SFX/train_arriving", "train_door_source");
				Sound_Stop("TrainLoop", 11.0f);
				
				//Failsafe to stop arrive sound from retriggering again and again
				Map_AddTimer("Timer_TrainSoundBoolean", 15.0f, "TrainArriveSoundFinished");				
				mbIsTrainSlowDownPlaying = true;
			}
			
			mbTrainIsStopping = true;
			RollBottle(-1.0);
		}
		
		/////////////////////////////////
		//As train is almost at end, trigger the start station switch and soon thereafter teleport walls back.
		if(mlTrainDistance == 46)
		{
			/////////////////////////////
			// Set variables for train journey
			mlTrainDistance = 0;
			mbTrainIsStopping = false;
			mbTrainHasStopped = true;
			
			/////////////////////////////
			// Update textures
			Train_SetCorrectStationWalls();
			
			/////////////////////////////
			//Open the train doors at each stop
			Open_Train_Doors();
			
			/////////////////////////////
			//Handle any events for each station
			Handle_Station_Events();
			
			/////////////////////////////
			//Reset train
			Map_AddTimer("reset_train", 20, "TimerResetTrain");
			Map_AddTimer("continue_train_"+mlTrainStopCount, 21.01f, "TimerResetTrain");
			Map_AddTimer("reset_train_accelerating", 23.01f, "TimerResetTrain");
		}

		//cLux_AddDebugMessage("Location: "+mlTrainDistance);
		return true;
	}
		
	//-------------------------------------------------------
	
	void TrainArriveSoundFinished(const tString &in asTimer)
	{
		//Failsafe to stop train sound from retriggering
		mbIsTrainSlowDownPlaying = false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Events for each stop
	void Handle_Station_Events()
	{
		if(mlTrainStopCount==1)
		{
			//////////////////////////////
			// Girl enters train at stop 1
			Girl_EnterTrain(); 		
		}
	}
	void Train_SetCorrectStationWalls()
	{
		//////////////////////////////////////////////////////////
		//Make all stop walls invisible before enabling the others
		for(int p=1;p<=3;p++)
		{
			for(int i=1;i<=3;i++)
				mBaseObj.GetEntityByName("00_02_station_0"+p+"_s_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
		}
			
		//Turn on the station at the start matching the station the train ended on.
		for(int i=1;i<=3;i++)
			mBaseObj.GetEntityByName("00_02_station_0"+mlTrainStopCount+"_s_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(true);
				
		for(int i=1;i<=5;i++)
		{
			mBaseObj.GetEntityByName("00_02_outside_sp"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(true);
			mBaseObj.GetEntityByName("00_02_outside_spw"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(true);
			mBaseObj.GetEntityByName("00_02_outside_sb"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
		}
	}
	
	//-------------------------------------------------------
	
	void Train_SetDestination()
	{
		Sound_CreateAtEntity("ann_ping", "00_01_subway/ambience/inside/announcer_ping", "Player", 0, false);
			
			SetStationScreenText("station_screen", gvScreenMaterials[mlTrainStopCount]);
			SetStationScreenText("station_screen_1", gvScreenMaterials[mlTrainStopCount]);
			
			//////////////////////////////////////////////
			//Add timer that plays animation for Biz man
			Map_AddTimer("Check", cMath_RandRectf(4.0f, 7.0f), "Biz_TimerCheckStation");
			
			Voice_Play(gvStationAnnouncements[mlTrainStopCount]);
			cLux_AddDebugMessage("Annoucer says: "+gvStationAnnouncements[mlTrainStopCount]);
			
			mlTrainStopCount++;
						
			/////////////////////////////////
			//Set stop walls visible.			
			for(int i=1;i<=3;i++)
				mBaseObj.GetEntityByName("00_02_station_0"+mlTrainStopCount+"_e_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(true);
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	// Moves the wall back and add a new continue_train_x to add additional trips.
	void TimerResetTrain(const tString &in asTimer)
	{
		if(asTimer == "reset_train")
		{
			Reset_Train();
			
			//Turn off station at end when train back at start.
			for(int i=1;i<=3;i++)
				mBaseObj.GetEntityByName("00_02_station_0"+mlTrainStopCount+"_e_"+i, eLuxEntityType_Prop, "").GetMeshEntity().SetVisible(false);
		}	
		
		//Different movements for a "varied" trip.
		else if(asTimer == "continue_train_1")
		{
			Move_Train(0.9, 1.1);
			
			SetStationScreenText("station_screen","00_02_next_station_st_patrick.mat");
			SetStationScreenText("station_screen_1","00_02_next_station_st_patrick.mat");
			
		}
		else if(asTimer == "continue_train_2")
		{
			Move_Train(2, 2);
			
			SetStationScreenText("station_screen","00_02_next_station_queens_park.mat");
			SetStationScreenText("station_screen_1","00_02_next_station_queens_park.mat");
			
			if (mbAnsweredPhone)
				Entity_SetActive("TrainLoopPoint_End", true);
		}
		else if(asTimer == "continue_train_3")
		{
			Move_Train(2, 2);
		}
		
		else if(asTimer == "reset_train_accelerating")
		{
			mbTrainIsAccelerating = false;
		}
		
		//Each time the walls begin to move again, restart train sounds.
		if(cString_GetFirstStringPos(asTimer, "continue_train") >= 0)
		{
			mlTrainDistance = 0;
			
		}
		
		cLux_AddDebugMessage("Timer: "+asTimer);
	}
	
	//-----------------------------------------------------
	
	void Move_Outer_Carriages(float afTimeStep)
	{

		/////////////////////////////////////////////////////////////////////
		// Sway the end carriages using basic trig and a cumulative value
		mfCarriageBobCycle += afTimeStep;
		float fZoffset = cMath_Sin(mfCarriageBobCycle);
		float fYoffset = cMath_Cos(mfCarriageBobCycle);
		
		///////////////////////////////////////////
		// Get carriage entities
		iLuxEntity@ pRearCarriage = cLux_ID_Entity(m_idRearCarriage);
		iLuxEntity@ pFrontCarriage = cLux_ID_Entity(m_idFrontCarriage);
		
		cVector3f vRearPos = mvRearCarriageStart;
		cVector3f vFrontPos = mvFrontCarriageStart;
		
		vRearPos.z += fZoffset * mfCarriageSwayDistance;
		vFrontPos.z += -fZoffset * mfCarriageSwayDistance;
		vRearPos.y += fYoffset * mfCarriageSwayDistance;
		vFrontPos.y += -fYoffset * mfCarriageSwayDistance;
		
		pRearCarriage.SetPosition(vRearPos);
		pFrontCarriage.SetPosition(vFrontPos);
	}
	
	//-------------------------------------------------------
	
	void TimerDoorOpen(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Train doors open");
		SlideDoor_SetClosed("slidedoor_subway_exit_3", false);
		Sound_CreateAtEntity("train_door_open_close", "00_01_subway/SFX/train_doors_sequence", "train_door_source", 0, false);
	}
	 
	//-------------------------------------------------------
	
	void TimerDoorClose(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Train doors close");
		SlideDoor_SetClosed("slidedoor_subway_exit_3", true);
	}
	
	//----------------------------------------------------
	
	void SetStationScreenError()
	{
		SetStationScreenText("station_screen","00_02_signal_error.mat");
		SetStationScreenText("station_screen_1","00_02_signal_error.mat");
	}
	
	//-------------------------------------------------------
	
	void SetStationScreenText(const tString &in asEntity, const tString &in asMaterial)
	{
		iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_LastEnum, "");
		cMaterial@ pMaterial = cResources_CreateMaterial(asMaterial);

		pEntity.GetMeshEntity().GetSubMeshEntity(0).SetCustomMaterial(pMaterial, true);
	}
	
	//----------------------------------------------------
	
	///////////////////////////////////////
	// ON SCREEN IMAGES
	///////////////////////////////////////
	
	//-----------------------------------------------------
	cSequenceStatesData mSeqOnScreenImages;
	void SequenceOnScreenImages(const tString &in asX)
	{
	
		Sequence_Begin("SequenceOnScreenImages", mSeqOnScreenImages);
		
		if (Sequence_DoStepAndWait(5.0))
		{
			//FRICTIONAL GAMES LOGO
			mlScreenImage = 0;
			mbImageFadeIn = true;
		}
		else if (Sequence_DoStepAndWait(15.0))
		{
			mbImageFadeIn = false;
		}
		else if (Sequence_DoStepAndWait(5.0))
		{
			//SOMA LOGO
			mlScreenImage = 1;
			mbImageFadeIn = true;
		}
		else if (Sequence_DoStepAndWait(15.0))
		{
			mbImageFadeIn = false;
		}
		
	
		
		Sequence_End();
	}

	
	//----------------------------------------------------
	
	///////////////////////////////////////
	// TRAIN CRASH SEQUENCE
	///////////////////////////////////////
	
	//-----------------------------------------------------
	
	float mfLightRandom = 0.1f;
	bool mbCrashStarted = false;
	
	//-----------------------------------------------------
	
	////////////////////////////////
	// Flicker the lights leading up to crash
	cSequenceStatesData mSeqLightFlicker;
	void SequenceLightFlicker(const tString &in asX)
	{
	
		Sequence_Begin("SequenceLightFlicker", mSeqLightFlicker);
		
		if (Sequence_DoStepAndWait(5.0))
		{
			// pause before flickering lights
		}
		if (Sequence_DoStepAndWait(0.01))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(true);	// on
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(true);	// on
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(5))
		{
			ToggleAllLightsLit(true);	// on
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(true);	// on
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(true);	// on
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(true);	// on
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(false);	// off
		}
		if (Sequence_DoStepAndWait(0.1))
		{
			ToggleAllLightsLit(true);	// on
		}

		Sequence_End();
	}
	
	//---------------------------------------------------------
	
	bool mbLightsOn = true;
	void ToggleAllLightsLit(bool abOn)
	{
		// Only flicker the lights up until the point of the crash
		if (mbCrashStarted) return;
		
		/////////////////////////////
		// Change the lights
		mbLightsOn = abOn;
		Light_SetVisible("PointLight_Train_*",mbLightsOn);
		Light_SetVisible("Train_Spotlight_*",mbLightsOn);
		Light_SetVisible("BoxLight_5",mbLightsOn);
		
		///////////////////////
		// Turn off all lamps
		for(uint i=1; i<24; ++i)
		{
			Lamp_SetLit("fluorescent_subway_ceiling_"+i,mbLightsOn,false);
		}
		
		if (mbLightsOn == false)
		{			
			mfLightRandom *= 0.3f;	// always shorter time when lights are off
			CreateTrackSpark();
		}
	}
	
	//---------------------------------------------------------
	
	void CreateTrackSpark()
	{
		//////////////////////////////////
		// Sparks at randomly chosen areas
		int lChosenArea = cMath_RandRectl(1,3);
		ParticleSystem_CreateAtEntity("elec_spark","elec_spark_oneshot.ps","SparkParticlePoint_"+lChosenArea,false);
		
		lChosenArea = cMath_RandRectl(1,8);
		ParticleSystem_CreateAtEntity("elec_spark","elec_spark_oneshot.ps","LightSparkParticlePoint_"+lChosenArea,true);
		
	}
	//---------------------------------------------------------
	
	////////////////////////////////
	// Actually crash the train
	void Crash_Start()
	{
		mbCrashStarted = true;
		
		/////////////////////////
		// Impact smoke particles
		ParticleSystem_CreateAtEntity("particle_smoke_explosion","smoke_cloud_oneshot.ps","SmokeParticleArea",true);
		
		
		/////////////////////////
		// Stop the walls moving
		Area_StopMovement("TrainMoveArea");
		
		/////////////////////////
		// Stop previous Cam Anim
		CameraAnimation_End();

		/////////////////////////
		// Screen and Camera effects
		mlID_CrashShakeEffect = Effect_Shake_Start(0.25,0.5,0.1,0.2);
		CameraAnimationNode_SetAutoMove("Crash_CamAnim",2.7f);
		CameraAnimation_Begin("Crash_CamAnim","",true); //Set to true to fix running feet sound.
		Player_EnableCameraLock(0,0,0,0);
		mlID_CrashTrailEffect = Effect_ImageTrail_Start(0.8,0,30,2.0);
		
		//////////////////////////
		// Stop the people talking
		Voice_StopAll();
		Dialog_StopAll();
		Voice_FadeSceneVolumeTo("Bum", 0.0f, 0.1);
		Voice_FadeSceneVolumeTo("Girl", 0.0f, 0.1);
		Sound_Stop("girl_jabber", 0.1); //TEMP
		
		///////////////////////
		// Fade lights
		Light_FadeTo("PointLight_Train_*",cColor(0,0,0,1),0,0.5);
		Light_FadeTo("BoxLight_5",cColor(0,0,0,1),0,0.5);
		Light_FadeTo("Train_Spotlight_*",cColor(0,0,0,1),0,0.5);
		
		///////////////////////
		// Turn off all lamps
		for(uint i=1; i<24; ++i)
		{
			Lamp_SetLit("fluorescent_subway_ceiling_"+i,false,false);
		}
		
		//todo: convert to sequence
		Map_AddTimer("FadeCrash", 9.0, "TimerEndLevel");
	}
	
	//-------------------------------------------------------
	
	bool CrashShake(const tString &in asEntity, int alDirection)
	{
		////////////////////////////////////
		// Shake and blood effect
		Effect_Shake_Start(0.3,0.5,0,0.05);
		Effect_Screen_Start("damage_steam_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0, 0.25f, 3.f); // simulate damage
		
		////////////////////////////////
		// Disable the NPCs
		Entity_SetActive("subway_businessman_1",false);
		Entity_SetActive("subway_girl_1",false);
		Entity_SetActive("subway_bum_1",false);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CrashCamAnimFade(const tString &in asEntity, int alDirection)
	{
		Effect_Fade_Out(1.5f);
		return true;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// GUI								   //
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbImageFadeIn = false;
	int mlScreenImage = 0;
	float mfImageAlpha = 0;
	float mfImageAlphaTarget = 0;
	
	//-------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{
		mfImageAlphaTarget = 0.0f;
		if (mbImageFadeIn)
		{
			mfImageAlphaTarget = 1.0f;
			if(mfImageAlpha != mfImageAlphaTarget) mfImageAlpha = cMath_InterpolateLinear(mfImageAlpha,mfImageAlphaTarget,afTimeStep*0.5f);	
		}
		else
		{
			mfImageAlpha = cMath_InterpolateLinear(mfImageAlpha,mfImageAlphaTarget,afTimeStep);	
		}
		
		float fSize;
		cVector3f vDist;
		cVector3f vCentre(0.1f,0.2f,0.0f);
		
		cVector3f vPos;
		vPos.x = -cLux_GetHudVirtualOffset().x;
		vPos.y = -cLux_GetHudVirtualOffset().y;
		ImGui_GroupBegin(vPos, ImGui_GetSize());
		
		//cImGuiGfx imageFG("credits/fg_logo_splash.dds", eImGuiGfx_Texture);
		cImGuiGfx imageSOMA("credits/soma_logo_splash_static.dds", eImGuiGfx_Texture);
		//imageFG.mvOffset = cVector3f(1.0f,1.0f,0);

		cImGuiLabelData labelData;
		//labelData.mColorText = cColor(1,1,1,mfImageAlpha);
		labelData.mFont.mColor.a = mfImageAlpha;
		labelData.mFontAlign = eFontAlign_Center;
 
		// Determine which image to use
		switch (mlScreenImage)
		{
			case 0:
				//cLux_AddDebugMessage("Alpha: "+mfImageAlpha);
				ImGui_SetTransCategory("00_02_subway");
				ImGui_DoLabelExt("GUIFGLogo",labelData,ImGui_NrmPos(cVector3f(0.25f,0.22f,0.0f)),ImGui_NrmSizeKeepRatio(cVector2f(1.0f, 0.5625f)),2.0f);
				
				/*imageSOMA.mColor.a = 0;
				imageFG.mColor.a = mfImageAlpha;
				ImGui_DrawGfx(imageFG, ImGui_NrmPos(vCentre), ImGui_NrmSizeKeepRatio(cVector2f(1.0f, 0.5625f)));*/
			break;
			
			case 1:
				//imageFG.mColor.a = 0;
				imageSOMA.mColor.a = mfImageAlpha;
				ImGui_DrawGfx(imageSOMA, ImGui_NrmPos(vCentre), ImGui_NrmSizeKeepRatio(cVector2f(1.0f, 0.5625f)));
			break;
		}
		
		ImGui_GroupEnd();
	}

