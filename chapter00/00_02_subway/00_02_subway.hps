	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//////////////////////////////////
		// INIT VARIABLES
		mlTrainDistance = 0;
		mlTrainStopCount = 0;
		mfMaxHandleForce = 0;
		mbTrainHasStopped = true;
		mbTrainIsAccelerating = false;
		mbTrainIsStopping = false;		
		mfTrainBounce = 0;
		mfNextTrainBounce = 0;
		mfDebrisForces = 0;
		mlNumUpdates = 0;
		
		
		/////////////////////////
		//SOUND AND MUSIC
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
		
		/////////////////////////////////////////
		// DEBUG, PLAYER GLOBAL VARS
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
		}
		
		/////////////////////////
		//INIT VISUALS
		Effect_Fade_Out(0);
		
		////////////////////////////
		// Start level
		Move_Train(10, 1.1);
		CameraAnimation_Begin("SittingAnim", "", false);
		Map_AddTimer("level_begin", 1, "TimerFadeInLevel");
		Map_AddTimer("TimerStartPhoneCall",20.5,"Seq_PhoneCall");
		
		/////////////////
		//INIT PLAYER
		Player_SetFlashlightDisabled(true);		
		Player_StartLookAt("AreaStartLookAt", 4, 4, 4);
		Player_SetMoveSpeedMul(0);
		Player_SetLookSpeedMul(0.35);
		Player_SetStandDisabled(true);
		Player_SetJumpDisabled(true);
		Player_SetFootWear("sneaker");
		Player_SetClothing("dressed");
		//Player_SetCrouching(true,true);
		Player_SetCrossHairState(eCrossHairState_None);
		
		PlayerHands_SetHandModel_Human();
		
		cLux_GetPlayer().GetCamera().SetPitchLimits(-0.9,0.7);		

		////////////////////////////////////////
		// Setup Sound
		Sound_PreloadCoreSounds();
		Sound_PreloadProject("Entities_subway");
		Sound_PreloadProject("00_01_subway");
		Sound_PreloadGroup("Entities_urban/desk", true);
		
		Sound_CreateAtEntity("BumRambling", "00_01_subway/ambience/spot/subway_bum_ramble", "subway_bum_1");
		
		/////////////////////////////////////
		// Entity Setup
		mBaseObj.GetEntityByName("debris_emptybottle").GetBody(0).SetAngularDamping(200);
		Entity_PlayAnimation("subway_girl_2", "Phone_Talk", 0.1f, true);
		Entity_SetActive("simon_body", false);
		
		////////////////////////////////////////
		// SETUP NPCs
		Entity_AttachToSocket("tablet", "subway_businessman_1", "pad", true);
		
	}
	
	//-----------------------------------------------------
	
	///////////////////////////////////////////
	// Map Update
	void Update(float afTimeStep)
	{	
		if (mbIntroStarted == false) return;
		
		///////////////////////////////////////////////////////////////////
		// Make train carriages move for realism
		if (mbTrainHasStopped == false)
		{
			Move_Outer_Carriages(afTimeStep);
		}
		
		
		///////////////////////////////////////////
		// Restrict players ability to look around
		/*iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		float fYaw = pCharBody.GetYaw();
		fYaw = cMath_Clamp(fYaw, gfMinYaw, gfMaxYaw);
		pCharBody.SetYaw(fYaw);*/
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		GetBase().SetDisplayNameEntry("00-02-subway");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		cLux_GetPlayer().GetCamera().SetPitchLimits(gfMinPitch,gfMaxPitch);
		cLux_GetPlayer().GetCamera().SetYawLimits(0,0);
		
		Player_SetMoveSpeedMul(1);
		Player_SetLookSpeedMul(1);
		Player_SetStandDisabled(false);
		Player_SetJumpDisabled(false);
		
		Player_SetCrouching(false);
		Player_ChangeStateToNormal();
	}

	//-------------------------------------------------------

	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;
		
		if (alAction == eAction_Test1)
		{
			Girl_TimerEnterTrain("");
		}
	}

