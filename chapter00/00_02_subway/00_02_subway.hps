	// SCENE 2 - FADE IN/OUT LEVEL
	/////////////////////////////////////////

	//-------------------------------------------------------

	void TimerFadeInLevel(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Fade start");
		
		//////////////////////////
		// Sound
		Sound_FadeGlobalVolume(1.0f, 7.0f, eSoundEntryType_WorldAll);
		Music_PlayExt("00_00_subway", false, 0.65f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, false);
		
		///////////////
		//INIT LEVEL - TRAIN/WALLS
		ConstructTunnelAndTrainRig();
		cLux_GetCurrentMap().GetEntityArray("holding_handle_*", eLuxEntityType_LastEnum, "", mvHandles);	// populate handle array
		Entity_SetInteractionDisabled("debris_*",false);
		Light_FadeTo("tunnel_Light*",cColor(0.27,0.82,1.0),0.25,0.75); // off
		
		//Train_SetCorrectStationWalls();
		
		//////////////////////////
		// Fade in - visuals on timer to sync with music
		Map_AddTimer("VisualsFadeIn", 3.5f, "VisualsFadeIn");
		Player_StopLookAt(0);
		Entity_SetActive("simon_body", true);
		
		
		//////////////////////////
		// Start camera animation journey
		//CameraAnimationNode_SetAutoMove("JourneyAnimation_1",1.0);
		
		////////////////////
		// NPCs
		NPC_StartBehaviour();
		
		///////////////////////
		// Start train bounce
		Map_AddTimer("TrainBounce",1.0,"Timer_TrainBounce");	
		
		mbIntroStarted = true;
	}
	
