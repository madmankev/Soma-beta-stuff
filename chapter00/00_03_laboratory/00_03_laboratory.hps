	/////////////////////////////////////////
	// SCENE 3 | Meet David and get Scanned
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbDavidEventTriggered = false;
	bool mbPlayerIsInsideRoom = false;
	int mlCurrentDavidSubjectIndex = 0;
	int mlLeaveRoomWarnings = 0;
	bool mbDavidGreetingDone = false;
	bool mbDavidIsSitting;
	tString msDavidServerAnim;
	bool mbDavidRepairingServer = false;
	
	void SetupDavid()
	{
		mbDavidIsSitting = false;
		
		cLux_AddTodoMessage("HACK: Scaling David's mesh on the fly!");
		iLuxEntity@ pDavid = Map_GetEntity("David");
		pDavid.SetMeshScaleMul(gvDavidTempScale);
		
		StartDavidRepairServer();
	}
	
	//-------------------------------------------------------
	
	void StartDavidRepairServer()
	{
		cLux_AddDebugMessage("Start David Repair Server");
		CharMover_SetWallAvoidanceActive("David",false);
		NPC_MoveToNode("David","PathNodeArea_44","OnDavidReachedServer");
		HeadTracker_SetActive("David",false);
		mbDavidRepairingServer = true;
	}
	
	//-------------------------------------------------------
	
	void StopDavidRepairServer()
	{
		cLux_AddDebugMessage("Stop David Repair Server");
		Map_RemoveTimer("TimerPlayDavidAnimation");
		CharMover_SetUseMoveStateAnimations("David",true);
		HeadTracker_SetActive("David",true);
		mbDavidRepairingServer = false;
	}
	
	//-------------------------------------------------------
	
	void OnDavidReachedServer(const tString& in asEntityName="", bool abReachedEnd=true)
	{
		cLux_AddDebugMessage("Reached server.");
		if (!mbDavidRepairingServer)
			return;
		Agent_TeleportFeetToEntity("David","ServerDavidRepair", false);
		CharMover_TurnToEntity("David","ServerDavidLookAt", "OnDavidLookingAtServer");
	}
	
	//-------------------------------------------------------
	
	void OnDavidLookingAtServer(const tString& in asEntityName)
	{
		if (!mbDavidRepairingServer)
			return;
		CharMover_SetWallAvoidanceActive("David",true);
		msDavidServerAnim="";
		Map_AddTimer("TimerPlayDavidAnimation", 0.2f, "TimerPlayDavidAnimation");
	}
	
	//-------------------------------------------------------
	
	void TimerPlayDavidAnimation(const tString &in asName="")
	{
		if (!mbDavidRepairingServer)
			return;
			
		if (msDavidServerAnim=="")
		{
			msDavidServerAnim = "left_server_stand";
		}
		else if (msDavidServerAnim=="left_server_stand")
		{
			msDavidServerAnim = "left_server_kneel";
		}
		else if (msDavidServerAnim=="left_server_kneel")
		{
			tString[] vsAnims = {"left_server_stand", "right_server_stand"};
			msDavidServerAnim = vsAnims[cMath_RandRectl(0,1)];
		}
		else if (msDavidServerAnim=="right_server_stand")
		{
			msDavidServerAnim = "left_server_stand";
		}
		
		cLux_AddDebugMessage("Playing David anim:"+msDavidServerAnim);
		CharMover_PlayAnimation("David",msDavidServerAnim,0.3f,true,true);
		Map_RemoveTimer("TimerPlayDavidAnimation");
		Map_AddTimer("TimerPlayDavidAnimation", cMath_RandRectf(4.0f,11.0f), "TimerPlayDavidAnimation");
	}
	
	//-------------------------------------------------------
	
	bool TriggerPlayerLeaveScanRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////
		// If conversation done and player leaves room - David nags
		if (alState == 1 && mbDavidGreetingDone && mbPlayerIsInsideRoom)
		{
			CharMover_TurnToEntity("David","Player");
			StopDavidRepairServer();
			
			Dialog_Begin();
				Dialog_AddBranchAndSubject("14_LeaveRoom_"+mlLeaveRoomWarnings%3,"","EnableDavid");
			Dialog_End();
				
			//Entity_SetInteractionDisabled("David", true);
			mlLeaveRoomWarnings++;
		}
		
		///////////////////////////////////////
		// Now flag simon as having left
		if (alState == 1)
		{
			cLux_AddDebugMessage("Player left room");
			mbPlayerIsInsideRoom = false;
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	bool TriggerPlayerEnterScanRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		///////////////////////////////////////
		// Flag player as being inside the room
		if (alState == 1)
		{
			mbPlayerIsInsideRoom = true;
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	bool TriggerOpenDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		///////////////////////////////////////////////
		// When the door is opened, stop David mumbling
		if (alState == 1)
		{
			Music_Stop(5.0f, eMusicPrio_BgAmb);
			cLux_AddDebugMessage("DEBUG: The door is opened... it begins");
			Sound_CreateAtEntity("ScanRoomSweetener", "00_06_lab/sfx/lab_sweetener", "ScanSweetenerSource");
			Sound_Stop("behind_door_spot", 0.1f);
			Sound_Play("lab_room_server_1", 0.5);
			
			PreloadPriorityLow();
			
			return false;
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////////////////
	// SCENE 3 - EVENT 1 - Talk to David
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlDavidReminders = 0;
	int mlPowerSwitchMessage = 0;
	bool mbSkipSimonIntroduction = false;
	
	//-------------------------------------------------------
	
	bool Trigger_ForceTalking(const tString &in asParent, const tString &in asChild, int alState)
	{
		// Greet Simon for the first time and activate the chair
		if (mbDavidGreetingDone == false)
		{
			cLux_AddDebugMessage("Greeting");
			/////////////////////////////////
			// Stop any current dialog
			Dialog_StopAll();
			
			////////////////////////////////
			// Walk to player
			Entity_SetActive("ServerBlockDavid",true);
			NPC_MoveToNode("David","PathNodeArea_50","");
			CharMover_TurnToEntity("David","Player");

			DavidGreetPlayer();	
		}
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void Line_DavidAnim_RubNeck(const tString& in asScene, const tString& in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if (!abStartOfLine)
			return;
		// Don't want to be dead on the start of the line, let's put in a bit of delay
		Map_AddTimer("idle_extra02", cMath_RandRectf(0.25f,2.0f), "TimerDavidPlayExtraAnim");
	}
	
		//-------------------------------------------------------
	
	void Line_DavidAnim_RubWrist(const tString& in asScene, const tString& in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if (!abStartOfLine)
			return;
		// Don't want to be dead on the start of the line, let's put in a bit of delay
		Map_AddTimer("idle_extra01", cMath_RandRectf(0.25f,2.0f), "TimerDavidPlayExtraAnim");
	}
	
	//-------------------------------------------------------
	
	void TimerDavidPlayExtraAnim(const tString& in asAnim)
	{
		CharMover_PlayAnimation("David",asAnim);
	}
	
	//-------------------------------------------------------
	
	void DavidGreetPlayer()
	{
		/////////////////////////////////
		// Force Conversation State
		mbSkipSimonIntroduction = true;

		StopDavidRepairServer();
			
		/* For this sequence, if Simon speaks to David first - he will say the first word.
		 * Otherwise if he has triggered the conversation by sneaking in the room, David will
		 * be the first to speak */
		 
		Dialog_StartConversation("David","David", 0.5f, gvDavidHeadOffset);
		cLux_GetPlayer().FadeCameraFOVMulTo(gfDavidFOV, 2);
		Dialog_Begin();
			Dialog_AddBranch("7_GreetDavid","");
				if (mbSkipSimonIntroduction == false)
				{
					Dialog_AddSubject("7_GreetDavidFirst","");
				}
				Dialog_AddSubject("7_GreetDavid","EndDavidDialogue");
		Dialog_End();
		
		Entity_SetInteractionDisabled("ScanChair", false);
		Entity_SetInteractionDisabled("David",true);
		
		mbDavidGreetingDone = true;
	}
	
	//-------------------------------------------------------

	void InteractDavid(const tString &in asEntity)
	{
		/////////////////////////////////////////////////////////
		// Face Simon
		StopDavidRepairServer();
		CharMover_SetUseMoveStateAnimations("David",true);
		CharMover_TurnToEntity("David", "Player", "");
		
		////////////////////////////////////////////
		// Next David Subject
		mlCurrentDavidSubjectIndex++;
		
		////////////////////////////////////////////
		// Disable interaction on third conversation
		if (mlCurrentDavidSubjectIndex==4)
			Entity_SetInteractionDisabled("David",true);
		
		Dialog_StartConversation("David","David",0.5f,gvDavidHeadOffset);
		cLux_GetPlayer().FadeCameraFOVMulTo(gfDavidFOV, 2);
		Dialog_Begin();
			Dialog_AddBranchAndSubject("8_InteractDavid"+mlCurrentDavidSubjectIndex,"","EndDavidDialogue");
		Dialog_End();
	}
	
	//-------------------------------------------------
	
	void Timer_DavidRemindsPlayer(const tString &in asName)
	{
		///////////////////////////////////////////////////////
		// David periodically reminds the player to take a seat
		if (mbPlayerIsInsideRoom)
		{
			int lDavidLine = mlDavidReminders % 2;
			
			//CharMover_TurnToEntity("David","Player");
			Dialog_Begin();
				Dialog_AddBranchAndSubject("13_DavidReminder_"+lDavidLine, "", "EnableDavid");
			Dialog_End();
				
			mlDavidReminders++;
			Map_AddTimer("timer_reminder",cMath_RandRectf(gvDavidReminderTimeSpan.x,gvDavidReminderTimeSpan.y),"Timer_DavidRemindsPlayer");
			
			Entity_SetInteractionDisabled("David", true);
		}
		else
		{
			//////////////////////////////////////////////////////////////////////////////
			// If player leaves the room, David will remind the player to sit upon reentry
			Map_AddTimer("timer_reminder",2.0,"Timer_DavidRemindsPlayer");
		}
	}
	
	//-------------------------------------------------
	
	///////////////////////////////////////////////////////////////////////////////////////////
	// Method used to prevent player getting locked in dialogue state during David's reminders
	void EnableDavid(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		cLux_AddDebugMessage("enabledavid");
		StartDavidRepairServer();
		
		if (mlCurrentDavidSubjectIndex >= 5) return; // No need once he's run out of things to say
		
		Entity_SetInteractionDisabled("David", false);
	}
	
	//-------------------------------------------------
	
	void EndDavidDialogue(const tString &in asSubject, bool abStartOfSubject)
	{
		///////////////////////////////////////////////////
		// Nothing to do for the beginning of conversation
		if(abStartOfSubject) return;

		//////////////////////////////////////////////////
		// Player can interact with David 3 times only
		if(mlCurrentDavidSubjectIndex < 4)
		{
			Entity_SetInteractionDisabled("David",false);
		}
		
		Map_AddTimer("timer_reminder",cMath_RandRectf(gvDavidReminderTimeSpan.x,gvDavidReminderTimeSpan.y),"Timer_DavidRemindsPlayer");
		Map_AddTimer("david_server_timer",1.0,"Timer_DavidGotoServer");
	}
	//-------------------------------------------------------
	
	void Timer_DavidGotoServer(const tString &in asName)
	{
		////////////////////////////////////////////////////////////////////////////////
		// Stops David walking away if he's in the middle of talking (Was really weird)
		if (Dialog_CharacterIsActive("David"))
		{
			Map_AddTimer("david_server_timer",1.0,"Timer_DavidGotoServer");
			return;
		}
		
		cLux_AddDebugMessage("Timerdavidgotoserver");
		StartDavidRepairServer();
	}

