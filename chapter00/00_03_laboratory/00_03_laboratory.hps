	//-------------------------------------------------------
	
	void DavidTakeSeat(const tString& in asEntityName)
	{
		mbDavidIsSitting = true;
		HeadTracker_SetActive("David", false);
		NPC_SetMainAnimation("David", "tapping_keyboard", true,"",1.0f, true);
		Map_AddTimer("StarDavidTypingSound", 3.0f, "DavidTypingSound");
		
		// Reset scaling
		cLux_AddTodoMessage("HACK: Scaling David's mesh on the fly!");
		iLuxEntity@ pDavid = Map_GetEntity("David");
		pDavid.SetMeshScaleMul(cVector3f_One);
		
		Map_AddTimer("Timer_PrepScan",4.0f,"Timer_PrepScan");
	}
	
