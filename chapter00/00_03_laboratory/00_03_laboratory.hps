	//-------------------------------------------------------
	
	[nosave] cGuiGfxElement @mpTunnelVisionGfx;
	[nosave] float mfBackRotation;
	
	void OnDraw(float afTimeStep)
	{
		
		if (mbScanningEffectsActivated)
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			
			////////////////////////////////////////////
			// Render tunnel vision hud object
			cVector3f vDrawingPos = cLux_GetHudVirtualStartPos();
			cVector2f vDrawingSize = cLux_GetHudVirtualSize();
			cLux_GetGameHudSet().DrawGfx(mpTunnelVisionGfx, vDrawingPos, vDrawingSize, cColor(1));
		
			///////////////////////////////////////////////////////
			// Calculate orientation and scale of the effect planes
			
			//Size, not really accurate
			float fNearX = 2*pCam.GetNearClipPlane()*cMath_Tan(pCam.GetFOV());
			//float fNearY = fNearX/pCam.GetAspect();
			
			//Orientation
			cVector3f vPlaneFwd = pCam.GetForward()*-1.0f;
			cVector3f vPlaneUp = pCam.GetUp();
			cVector3f vPlaneRight = cMath_Vector3Cross(vPlaneUp, vPlaneFwd);
			vPlaneUp = vPlaneUp*fNearX;
			vPlaneRight = vPlaneRight*fNearX;
			cMatrixf mtxPlaneRot = cMath_MatrixUnitVectors(vPlaneRight, vPlaneUp, vPlaneFwd, cVector3f(0));
			
			///////////////////////////////////////////////
			// Set the matrix and position of the planes
			cLuxProp@ pNoisePlane = Map_GetProp("NoisePlane");
			pNoisePlane.SetMatrix(mtxPlaneRot);
			pNoisePlane.SetPosition(pCam.GetPosition() + pCam.GetForward()*(pCam.GetNearClipPlane()+0.01));
			
			cLuxProp@ pGlitchPlane1 = Map_GetProp("GlitchPlane_1_1");
			if (!pGlitchPlane1.IsActive()) @pGlitchPlane1 = Map_GetProp("GlitchPlane_2_1");
			pGlitchPlane1.SetMatrix(cMath_MatrixMul(mtxPlaneRot, cMath_MatrixRotateZ(-mfBackRotation)));
			pGlitchPlane1.SetPosition(pCam.GetPosition() + pCam.GetForward()*(pCam.GetNearClipPlane()+0.009));
			
			cLuxProp@ pGlitchPlane2 = Map_GetProp("GlitchPlane_1_2");
			if (!pGlitchPlane2.IsActive()) @pGlitchPlane2 = Map_GetProp("GlitchPlane_2_2");
			pGlitchPlane2.SetMatrix(cMath_MatrixMul(mtxPlaneRot, cMath_MatrixRotateZ(mfBackRotation)));
			mfBackRotation += afTimeStep;
			pGlitchPlane2.SetPosition(pCam.GetPosition() + pCam.GetForward()*(pCam.GetNearClipPlane()+0.008));
		}
			
		if (!mbDisplayLeaveText)
			return;
		
		/////////////////////////////////
		// Handle drawing of leave text
		mfAlpha += cMath_Min(1-mfAlpha, afTimeStep*0.5f);
		tWString sExitText = cLux_Translate("00_03_laboratory", "GameOver");
		
		cLux_GetGameHudSet().DrawFontEx(sExitText, mpFont, cVector3f(cLux_GetHudVirtualCenterSize().x/2, cLux_GetHudVirtualCenterSize().y/2, 10), cVector2f(30), cColor(1, mfAlpha), eFontAlign_Center, eGuiMaterial_FontNormal);
	}

