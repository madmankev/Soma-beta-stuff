	 //////////////////////////////////////////////////////////////////////////////////////////
	 // ==============
	 // AUDIO
	 // ==============
	 //{//////////////////////////////////////////////////////////////////////////////////////
	
	//Airlocks
	
	void AirlockEffectsTurnOnPumps()
	{
		if (mbAirlockedFilled==false)
		{
				//airlock not full, play non-underwater idle sound
				Sound_CreateAtEntity("Pump_Idle_Loop_Air", "Entities_OceanBottom/airlock/air/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f); 
		}
		else if (mbAirlockedFilled==true)
		{
				//airlock is full play underwater idle sound
				Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f);
		}
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsTurnOffPumps()
	{
		if (mbAirlockedFilled==false)
		{
				//Airlock not full, play air idle sound
				Sound_Stop("Pump_Idle_Loop_Air", 1.0f);
		}
		else if (mbAirlockedFilled==true)
		{
				//Airlock is full play underwater idle sound
				Sound_Stop("Pump_Idle_Loop_Underwater", 1.0f);
		}
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 6.5f, "AirlockDrainUWStop");
	}
 
    //-------------------------------------------------------
	
	void AirlockDrainUWStop(const tString &in asTimer)
	{
		SetPlayerIsUnderwater(false, 1, false);
		AirlockSoundLogic();
		Depth_Audio_PlayLeaveWater();
		Sound_Stop("PumpUW", 0.55f);
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "PumpsSource", 0.55f, false, 1.0f);
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("AirlockDrainingAirStopTimer", 3.0f, "AirlockDrainingAirStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("PumpingAirLoop", 0.25f);
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		AirlockEffectsTurnOnPumps();
	}
	 
    //-------------------------------------------------------
	
	void AirlockEffectsFillWithWater()
	{
		Depth_Audio_AirlockFillingLeadInAir();
		Depth_Audio_AirlockFillingLoopAir();
		Map_AddTimer("AirlockFillingAirStopTimer", 8.5f, "AirlockFillingAirStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockFillingAirStop(const tString &in asTimer)
	{
		AirlockSoundLogic();
		SetPlayerIsUnderwater(true, 1, false);
		Depth_Audio_PlayEnterWater();
		Depth_Audio_AirlockFillingLoopAirStop();
		Depth_Audio_AirlockFillingLoopUW();
		
		///////////////////
		//Pump Sounds
		Sound_Stop("PumpingAirLoop", 0.5f);
		Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "PumpsSource", 0.0f, false, 1.0f);
		Map_AddTimer("AirlockFillingLoopUWStopTimer", 5.0f, "AirlockFillingLoopUWStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockFillingLoopUWStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockFillingLoopUWStop();
		Depth_Audio_AirlockFillingLeadOutUW();
		
		///////////////////
		//Pump Sounds
		Sound_CreateAtEntity("PumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		Sound_Stop("PumpUW", 1.f);
		AirlockEffectsTurnOnPumps();
	}
	 
    //-------------------------------------------------------
	
	bool mbIsAirlockEmptySound = false;
	
	void AirlockSoundLogic()
	{
		if (mbIsAirlockEmptySound==false)
		{
			cLux_AddDebugMessage("Air Sound Areas Active");
			Entity_SetActive("AMB_INT_*", true);
			Entity_SetActive("AMB_EXT_*", false);
			
			mbIsAirlockEmptySound = true;
		}
		
		else if (mbIsAirlockEmptySound==true)
		{
			cLux_AddDebugMessage("Air Sound Areas Disabled");
			Entity_SetActive("AMB_INT_*", false);
			Entity_SetActive("AMB_EXT_*", true);
			
			mbIsAirlockEmptySound = false;
		}
	}
	
	//Music
	bool mbExteriorAmbientMusicPlaying = false;
	
	bool Trigger_RevealMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(10.f, 15.f), "AmbientExplorationMusic");
		return false;
	}
	
	void AmbientExplorationMusic(const tString &in asTimer)
	{
		Music_PlayExt("02_01_exploration", true, 0.15f, 1, 10, 0.0f, eMusicPrio_BgAmb , true);
		mbExteriorAmbientMusicPlaying = true;
	}
	
	//-------------------------------------------------------------------
	
	//Stop music during angry bot encounter
	bool AmbientMusicStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbOmniToolLoadingDone==false && alState==1)
		{
			cLux_AddDebugMessage("Enter music stop area");
			Music_Stop(5.0, eMusicPrio_BgAmb);
			mbExteriorAmbientMusicPlaying = false;
		}
		else if (mbOmniToolLoadingDone==false && alState==-1)
		{
			cLux_AddDebugMessage("Exit music stop area");
			Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(9.f, 15.f), "AmbientExplorationMusic");
		}
		return true;
	}
	
	void StopAmbientMusic(float afFadeTime=5.0f)
	{
		if (mbOmniToolLoadingDone==false)
		{
			Music_Stop(afFadeTime, eMusicPrio_BgAmb);
			mbExteriorAmbientMusicPlaying = false;
		}
	}
	
	//-------------------------------------------------------------------
	
	bool LamdaMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		StopAmbientMusic(3.0f);
		Map_AddTimer("LambdaMusic", 3.5f, "LambdaSightingMusic");
		return false;
	}
	
	void LambdaSightingMusic(const tString &in asTimer)
	{
		Music_Play("02_01_lambdasight", 0.45f, false, eMusicPrio_BigEvent);
		Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(6.f, 10.f), "AmbientExplorationMusic");
	}
	
	//enable cath music in lambda
	bool CathLookAtMusicEnable(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive("CathMusicTrigger", true);
		return false;
	}
	
	//-------------------------------------------------------------------
	
	//Second half of level ambient music	
	bool OnLifeboatDoorway(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==-1) // Leave
		{
			Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(3.f, 6.f), "AmbientExplorationMusic");
			mbExteriorAmbientMusicPlaying = true;
			return false;
		}
		else	// Enter
		{
			mbEnteredLifeboat = true;
			return true;
		}
	}
	
	bool SmallCurieAmbientMusicStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Stop(5.0f, eMusicPrio_BgAmb);
		mbExteriorAmbientMusicPlaying = false;
		return false;
	}
		
	//-------------------------------------------------------------------
	
	void CathRobotMusic(const tString &in asEntity, int alState)
	{
		Music_Play("02_01_deadconstruct", 0.25f, false, eMusicPrio_BigEvent);
	}
	
	void PickupCathMusic(const tString &in asTimer)
	{
		Music_Play("02_01_pickupcath", 0.65f, false, eMusicPrio_BigEvent);
	}
		
	//-------------------------------------------------------------------
	
	//Reveal curie
	bool CurieRevealMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_FadeGlobalVolume(0.65f, 7.0f, eSoundEntryType_WorldClean);
		Music_Play("02_01_curiereveal", 0.95f, false, eMusicPrio_BigEvent);
		Map_AddTimer("ReturntoNormal", 12.0f, "CurieRevealMusicFadeUp");
		Map_AddTimer("TimerSeeCurie",1.0f,"TimerSeeCurie");
		
		return false;
	}
	
	//-------------------------------------------------------------------
	
	void TimerSeeCurie(const tString &in asTimer)
	{
		if (Entity_IsInPlayerFOV("Trigger_FindCurie"))
		{
			cLux_AddDebugMessage("See Curie");
			Voice_Play("3_Comment_SeeCurie");
		}
	}

	//-------------------------------------------------------------------
	
	void CurieRevealMusicFadeUp(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 7.0f, eSoundEntryType_WorldClean);		
	}
	
	//-------------------------------------------------------------------
	
	//Curie exterior stairwell creaks
	
	bool Trigger_CurieStairwellCreak(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("CurieEXTStairwellCreak", "level_amb_shared_underwater/amb/spots/metal/curie/EXT/stairwell_2D", "Player");
		Sound_FadeGlobalVolume(0.5f, 3.0f, eSoundEntryType_WorldClean);
		cLux_AddDebugMessage("Stairwell creak triggered - stairwell areas inactive");
		Entity_SetActive("AreaStairwellCreak_*", false);
		Map_AddTimer("CurieStairwellCreakAreaActive", cMath_RandRectf(8.f, 12.f), "Timer_CurieStairwellCreakAreaActive");
		Map_AddTimer("CurieStairwellCreakMixerFadeUp", 3.0f, "Timer_CurieExteriorCreakFadeUp");
		return true;
	}
	
	void Timer_CurieStairwellCreakAreaActive(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Stairwell creak areas active");
		Entity_SetActive("AreaStairwellCreak_*", true);
	}
	
	void Timer_CurieExteriorCreakFadeUp(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Stairwell creak over - world clean fading back up");
		Sound_FadeGlobalVolume(1.0f, 2.5f, eSoundEntryType_WorldClean);
	}
	
	//-------------------------------------------------------------------
	
	void MidSectionCreakAreas(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Creak areas enabled");
		Entity_SetActive("MidSectionCreak_*", true);
	}
	
	bool MidSectionCreaks(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive("MidSectionCreak_*", false);
		cLux_AddDebugMessage("Midsection creak triggered - areas inactive");
		Map_AddTimer("MidsectionCreakAreaActive", cMath_RandRectf(12.f, 12.f), "Timer_MidsectionCreakAreaActive");
		Effect_Shake_Start(0.0075, 1.0f, 1.5f, 2.0f);
		
		//SFX		
		Sound_CreateAtEntity("MidsectionCreak", "02_01_ms_curie_outside/SFX/midsection_creaks/groan", "Player");
		Sound_FadeGlobalVolume(0.5f, 1.0f, eSoundEntryType_WorldClean);
		Map_AddTimer("CurieStairwellCreakMixerFadeUp", 1.0f, "Timer_CurieExteriorCreakFadeUp");
		return false;
	}
	
	void Timer_MidsectionCreakAreaActive(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Midsection creak areas active");
		Entity_SetActive("MidSectionCreak_*", true);
	}
	
	//} END AUDIO
}