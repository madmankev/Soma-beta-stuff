		/////////////////////////////////////////
		// Event - Midsection Flesher
		//{//////////////////////////////////////

		//-------------------------------------------------------

		bool CollideAreaMidSectionFleser(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceMidFlesher("");
			return false;
		}
		
		//-------------------------------------------------------

		cSequenceStatesData mSequenceMidFlesher;
			
		void SequenceMidFlesher(const tString &in asX)
		{
			Sequence_Begin("SequenceMidFlesher", mSequenceMidFlesher);
		
			if (Sequence_DoStepAndPause())
			{
				cLux_AddDebugMessage("Flesher mid moving");
				
				//Start dragging loop sound and slightly duck amb
				Sound_CreateAtEntity("FlesherDragLoop", "02_01_ms_curie_outside/SFX/flesher_sub_spot/flesher_sub_scrape", "FlesherMid");
				Sound_FadeGlobalVolume(0.75, 3.0f, eSoundEntryType_WorldClean);
				
				Entity_SetActive("FlesherMid", true);
				
				Pathfinder_Track_Clear("FlesherMid");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_1");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_2");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_3");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_4");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_5");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_6");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_7");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_8");
				Pathfinder_Track_Add("FlesherMid", "FlesherMidPath_9");
				Pathfinder_Track_Start("FlesherMid", false, 1, "FlesherMidEndOfTrack");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				//Stop loop sound and fade back up amb
				Sound_Stop("FlesherDragLoop", 0.25f);
				Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldClean);
				
				Entity_SetActive("FlesherMid", false);
				Effect_TimeGlitch_Start(1, 1, 0.1, true);
				
				cLux_AddDebugMessage("END OF MID FLESHER");
				
				Map_AddTimer("Audio_SetUpMidSectionCreaks", 1.0f, "MidSectionCreakAreas");
			}
			else if (Sequence_DoStepAndWait(0.0))
			{
				Sound_CreateAtEntity("MidSectionFlesherEnd", "02_01_ms_curie_outside/SFX/flesher_sub_spot/flesher_sub_scrape_end", "MidSectionFlesherEndSoundSource");
			}
			
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void FlesherMidEndOfTrack(const tString &in asEntity)
		{
			SequenceStates_Resume("SequenceMidFlesher");
		}
		
		//-------------------------------------------------------
		
		//} END Event Midsection Flesher
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Engine - Flesher by engine
		//{///////////////////////////////////////////////////////////////////////////////

		//-------------------------------------------------------
		
		bool CollideAreaActivateFlesherEngine(const tString &in asParent, const tString &in aschild, int alState)
		{
			if(alState != 1) return true;
			
			cLux_AddDebugMessage("Sound: Distant flesher howl @FlesherEngine");
			
			Entity_SetActive("FlesherEngine", true);
			
			Effect_VideoDistortion_Start(0.3, 2, 2, 2);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool CollideAreaActivateFlesherAwayFromEngine(const tString &in asParent, const tString &in aschild, int alState)
		{
			if(alState != 1) return true;
			
			cLux_AddDebugMessage("Flesher moving away from engine.");
			
			SequenceFlesherAwayFromEngine("");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mFlesherAwayFromEngine;
			
		void SequenceFlesherAwayFromEngine(const tString &in asX)
		{
			Sequence_Begin("SequenceFlesherAwayFromEngine", mFlesherAwayFromEngine);
			
			if (Sequence_DoStepAndWait(1)){}
			if (Sequence_DoStepAndWait(2))
			{
				Pathfinder_Track_Clear("FlesherEngine");
				Pathfinder_Track_Add("FlesherEngine", "FlesherEngineNode_19");
				Pathfinder_Track_Start("FlesherEngine", false, 1, "");
				
				Music_Play("NPC_flesher_distant3", 0.35, false, eMusicPrio_BigEvent);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool CollideAreaFlesherEngineRemove(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("FlesherEngine", false);
			
			cLux_AddDebugMessage("FlesherEngine Disabled");
		
			return false;
		}
		
	
		//} END Event Engine Flesher
	
