class cScrMap : iScrMap
{
	//-------------------------------------------------------

	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////	
	
	//-------------------------------------------------------
	
	void Setup()
	{
		GetBase().SetDisplayNameEntry("02-01-ms-curie-outside");

		///////////////////////////////
		// Setup presets
		{
			// When outside and underwater
			Map_Preset_SetupFog("Outside", true, 2, 30, 0.4, cColor(2.0 / 255.0, 7.0 / 255.0, 9.0 / 255.0,1), 1.0, true, true);
			Map_Preset_SetupDepthOfField("Outside", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("Outside", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));
			Map_Preset_SetupSecondaryFog("Outside", true, 0, 70, 0.15, cColor(0, 0, 0, 1));

			// Inside and not underwater
			Map_Preset_SetupFog("Inside", true, 2, 60, 0.9, cColor(0, 0, 0, 1), 1.0, false, false);
			Map_Preset_SetupDepthOfField("Inside", false);
			Map_Preset_SetupBloom("Inside", 128, 0.75, 0.5, cColor(1.0, 1.0));
			Map_Preset_SetupSecondaryFog("Inside", false, 0, 70, 0.15, cColor(0, 0, 0, 1));

			// Liquid area
			Map_Preset_SetupFog("LiquidArea", false); //the luquid area has its own fog
			Map_Preset_SetupDepthOfField("LiquidArea", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("LiquidArea", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));
			Map_Preset_SetupSecondaryFog("LiquidArea", true, 0, 70, 0.15, cColor(0, 0, 0, 1));

			// Temp: Set this here until level editor support
			cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
			pWorld.SetFogApplyAfterFogAreas(false);
			
			////////////////////
			//PRESET FOR TRANSITION TO LEVEL 2.2
			Map_Preset_SetupBloom("Inside2.2", 160, 0.00001, 0, cColor(0.3, 0.3, 0.3, 0));
			Map_Preset_SetupDepthOfField("Inside2.2", true, 0, 6, 0.5);
			Map_Preset_SetupColorGrading("Inside2.2", "textures/colorgrading/grading_02_02.dds");
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{	
		//////////////////////////////////
		//Disabled
		Entity_SetActive("PipeBreak_*", false);
		
		//////////////////////////////////
		// Map setup
		Map_AddTimer("", 1, "TimerOpenAirLock");
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Outdoors();
		Tool_PickUp("CathTool_NoChip", false, false);
			
				
		/////////////////////////////////////////
		// Load Sounds
		Sound_PreloadCoreUWInteractions();
		Sound_PreloadCoreInteractions();
		Sound_PreloadCoreSounds();
		Sound_PreloadCoreUWSounds();
		//Level Sounds
		Sound_PreloadGroup("02_01_ms_curie_outside", true);
		Player_SetClothing("default");
		Player_SetFootWear("default");
		
		//Airlock
		AirlockEffectsTurnOnPumps();
		
		/////////////////////////////////////
		// LEVEL SETUP		
		Light_SetVisible("RobotFlesherScrappedLight", false);
		
		SetPlayerIsUnderwater(true, 0.001f, true);
		
		PlayerHands_SetHandModel_Diving();

		///////////////////////////////////////////
		// THIS IS NOT A GOOD SOLUTION
		// Set some debris to not collide with character
		array<iLuxEntity@> vAnnoyingDebrisObjects;
		cLux_GetCurrentMap().GetEntityArray("annoying_*", eLuxEntityType_LastEnum, "", vAnnoyingDebrisObjects);
		for(int i=0; i<vAnnoyingDebrisObjects.size(); ++i)
		{
			iLuxEntity@ pEnt = vAnnoyingDebrisObjects[i];
			pEnt.GetBody(0).SetCollideCharacter(false);
		}
		
		//-------------------------------------------------------
		
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
			
			//SetPlayerIsUnderwater(false,0.01f, true);
			//Entity_SetActive("AreaCathSaysHide", false);
			//Entity_SetActive("AreaFlesherGlimpse", false);
			//mbCortexChipInserted = true;
			//mbOmniToolHasCurieCodes = true;
			//mbInteractedWithCatherineMachine = false;
			//mbCatherineOmniToolChatOver = true;
		}
		else
		{
			Effect_Fade_In(1.0);
		}
	}
	
	void OnEnter()
	{	
		if(cLux_ScriptDebugOn()==false)
			Game_AutoSave();
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		
	}
	
	//-------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;

		if(alAction == eAction_Test1)
		{		
			//SetPlayerIsUnderwater(!mbPlayerIsUnderwater, 1.0f, true);
			
			//Seq_LifeBoatFailedStartUp("");
			//Seq_FlesherFootSteps("");
			//Entity_SetActive("Area_FlesherFootStepsHeard", true);
			
			//Timer_CatherineTalksAndPopChip("");
			
			Pathfinder_Track_Clear("flesher_female_1");
			Pathfinder_Track_Add("flesher_female_1", "PathNodeArea_8", 1,2);
						
			Entity_SetActive("flesher_female_1", true);
			
			Pathfinder_Track_Start("flesher_female_1", false ,1, "FirstFlesherPathOver");
		}
		if(alAction == eAction_Test2)
		{
			Entity_SetActive("flesher_female_1", false);
		}
		if(alAction == eAction_Test3)
		{
			Tool_PickUp("CortexChipTool", true, false);
		}
		
		if (alAction==eAction_Test4)
		{
			AnimOver_CathMachineDies("","");
		}
		
		if (alAction==eAction_Test5)
		{
			SetPlayerIsUnderwater(false,0.0f,true);
		}
		
		if (alAction == eAction_Test6)
		{
			Timer_CatherineTalksAndPopChip("");
		}
		
		if (alAction == eAction_Test7)
		{
			CollideAreaNearCathAfterTrackingDone("","",1);
		}
		
		if (alAction == eAction_Test8)
		{
			LineOver_Anim_SimonLooksAtOmniTool("","",1,true);
		}
		
		if (alAction == eAction_Test9)
		{
			mbOmniToolHasCurieCodes = true;
		}
	}
	
	//-------------------------------------------------------
	
	//} END MAIN CALLBACKS
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	bool mbPlayerWasHurt=false;
	bool mbCathMachineActive=true;
	bool mbCathCanTalk = false;
 
 	//-------------------------------------------------------
 
	bool mbPlayerIsUnderwater=true;
 
	//-------------------------------------------------------
 
	void SetPlayerIsUnderwater(bool abX, float afFadeTime, bool abAffectEffecs)
	{
		mbPlayerIsUnderwater = abX;
		
		//////////////////////////////
		//Underwater
		if(mbPlayerIsUnderwater)
		{
			Map_SetUnderwater(true);
			Player_SetAmbientLight_Outdoors(true);
			cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(true);
			Map_Preset_Fade("Outside", afFadeTime);
		}
		//////////////////////////////
		//In Air
		else
		{
			Map_SetUnderwater(false);
			Player_SetAmbientLight_Indoors(true);
			cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(false);
			Map_Preset_Fade("Inside", afFadeTime);
		}
	}
	
	//-------------------------------------------------------
	
	bool CathTool_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		if(asEntity == "airlockpanel") return CathTool_CanUse(asTool, asEntity);
		if(asEntity == "OmniToolSlot") return OmniToolSlot_CanUseOmniTool();
		if(asEntity == "MidsectionPanel") return CathTool_CanUse(asTool, asEntity);
		if(asEntity == "OmniToolSlotLifeBoat") return OmniToolSlotLifeBoat_CanUseOmniTool();
		
		return false;
	}
 
	bool CathTool_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		if(asEntity == "airlockpanel") 	CathTool_UseOnPanel(asTool, asEntity);
		if(asEntity == "OmniToolSlot") 	return OmniToolSlot_UseOmniTool();
		if(asEntity == "MidsectionPanel") return MidsectionPanel_UseOmniTool(asTool, asEntity);
		if(asEntity == "OmniToolSlotLifeBoat") return OmniToolSlotLifeBoat_UseOmniTool();
			
		return false;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 - EMERGE AND GET TO LAMBDA
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
	
		//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Event - GETTING OUT OF START AIRLOCK
		/////////////////////////////////////////

		//-------------------------------------------------------
		
		bool CollideAreaDisableTerrain(const tString &in asParent, const tString &in asChild, int alState)
		{
			Body_SetCollideFlags("Terrain", "-player");
			Visibility_SetTerrainActive(false);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void TimerOpenAirLock(const tString &in asTimer)
		{
			MovingButton_SetSwitchedOn("ExitHatch_1", true, true);
			Sound_CreateAtEntity("CloseHatch1", "02_01_ms_curie_outside/SFX/hatch/close", "ExitHatch_1");
		}
		
		//-------------------------------------------------------
		
		bool CollideAreaAirlockPassage(const tString &in asParent, const tString &in asChild, int alState)
		{
			MovingButton_SetSwitchedOn("ExitHatch_1", false, true);
			MovingButton_SetLocked("ExitHatch_1", true);
			
			Sound_CreateAtEntity("CloseHatch1", "02_01_ms_curie_outside/SFX/hatch/close", "ExitHatch_1");
			
			Map_AddTimer("terrain", 1, "TimerDelayTerrainActivate");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void TimerDelayTerrainActivate(const tString &in asTimer)
		{
			Body_SetCollideFlags("Terrain", "+player");
			Visibility_SetTerrainActive(true);
		}
		
		//-------------------------------------------------------
		
		bool CollideLeavingStart(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("CloseHatch", "02_01_ms_curie_outside/SFX/hatch/close", "ExitHatch");
			MovingButton_SetSwitchedOn("ExitHatch", false, true);
			MovingButton_SetLocked("ExitHatch", true);
			Entity_SetActive("Start_Ladder", false);
			Entity_SetActive("StartHatchBlocker", true);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerMissionLine(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
			{
				Voice_Play("3_RestateMission");
				return false;
			}
			return true;
		}

		//-------------------------------------------------------
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Angry Robot
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbAngryRobotActive=false;
		bool mbAngryRobotPlayerInside=false;
		bool mbAngryRobotRetreating=false;
		
		//-------------------------------------------------------
		
		bool CollideAreaAngryRobot(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState == 1)
			{
				mbAngryRobotPlayerInside = true;
				
				Pathfinder_Stop("RobotAngry");
				Agent_SetSensesActive("RobotAngry", true);
				ConstructWorker_SetMoodAgressive("RobotAngry");
				
				if(mbAngryRobotActive == false)
				{
					Entity_SetActive("RobotAngry", true);
					mbAngryRobotActive = true;
					
					CheckPoint_Setup("");
					AttackMeter_SetAttackerTeleportPosition("MonsterSpawn_AngryBot_*");
				}
			}
			else
			{
				mbAngryRobotPlayerInside = false;
				
				if(mbAngryRobotRetreating== false)
				{
					mbAngryRobotRetreating = true;
				
					ConstructWorker_SetMoodDocile("RobotAngry");
					Agent_SetSensesActive("RobotAngry", false);
					Pathfinder_Stop("RobotAngry");
					Pathfinder_MoveToNode("RobotAngry", "PathNodeArea_321", "EndOfMoveTo_AngryRobotReturn",1);
				}
			}
			return true;
		}
		
		void EndOfMoveTo_AngryRobotReturn(const tString& in asEntityName, bool abReachedEnd)
		{
			if(mbAngryRobotPlayerInside==false)
			{
				Entity_SetActive("RobotAngry", false);
				mbAngryRobotActive = false;
			}
		}
		
		//-------------------------------------------------------
	
		//} END Event Angry Robot
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Cute  Robot
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool CollideAreaCuteSwarm(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("CuteBot", alState==1);
			CuteBot_SetSwarmPoint("CuteBot", "AreaCuteSwarmPoint");
			
			return true;
		}
			
		
		
		//-------------------------------------------------------
		
		//} END Cute Robot
		
	//} END SCENE 1
	
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 - ENTER LAMBDA AND AVOID FLESHER
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Event Airlock Enter/Leave
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbAirlockedFilled=true;
		
		//-------------------------------------------------------
		
		void SetOuterAirlockDoorOpen(bool abX)
		{
			SlideDoor_SetClosed("AirlockDoor_Outer_Down", !abX);
			SlideDoor_SetClosed("AirlockDoor_Outer_Up", !abX);
		}
		
		void SetInnerAirlockDoorOpen(bool abX)
		{
			SlideDoor_SetClosed("AirlockDoor_Inner_Down", !abX);
			SlideDoor_SetClosed("AirlockDoor_Inner_Up", !abX);
		}
		
		//-------------------------------------------------------
		
		void OnChange_AirlockPanel(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			
			if(mbAirlockedFilled)
				SequenceAirlockEmpty("");
			else
				SequenceAirlockFill("");
		}
		
		//-------------------------------------------------------
		
		bool mbSaidLifeboatPiece = false;
		
		bool OnLambdaDoorway(const tString &in asArea, const tString &in asEntity, int alState)
		{
			cLux_AddDebugMessage("Lambda Doorway:"+alState);
			if (alState==1)	// Enter
			{
				Voice_Play("3_Comment_EnterLambda");
			}
			else // Exit
			{
				if (!mbSaidLifeboatPiece)
				{
					if (mbCathChipInOmnitool)
					{
						if (mbEnteredLifeboat)
							Voice_Play("3_Comment_LeaveLambda_VisitedLifeboat");
						else
							Voice_Play("3_Comment_LeaveLambda_NotVisitedLifeboat");
						mbSaidLifeboatPiece = true;
					}
				}
			}
			
			Entity_SetActive("CuteBot", (alState==-1));
			SetCathInLambda(alState==1);
			return true;
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mAirlockEmptySequence;
		
		void SequenceAirlockEmpty(const tString &in asTimer)
		{
			Sequence_Begin("SequenceAirlockEmpty", mAirlockEmptySequence);
				
			if(Sequence_DoStepAndWait(2.5))
			{
				if(mbPlayerWasHurt)
					SequenceStates_Resume("Seq_CathComeSeeMe_Hurt");
				else
					SequenceStates_Resume("Seq_CatherineAllClear_Extra_Unhurt");
				
				SetOuterAirlockDoorOpen(false);
				
				Entity_SetActive("ToolArea_CathToolAirlock", false);
				Player_SetCrouchDisabled(true);
			}
			else if(Sequence_DoStepAndWait(1.0))
			{
				/////////////////////////
				//Pump Sounds
				Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop", "PumpsSource", 0.0f, false, 1.0f);
			}
			else if (Sequence_DoStepAndWait(10))
			{
				StopAmbientMusic();
				Map_RemoveTimer("AmbientExplorationMusic");
				AirlockEffectsFlushWater();
				AirlockEffectsTurnOffPumps();		
				mbAirlockedFilled = false;
				Entity_SetActive("AirLockWaterLiquid", true);
				Map_AddEnvironmentParticleClipArea("*", "AirLockWaterLiquid");
				LiquidArea_MoveLinearTo("AirLockWaterLiquid","AirLockWaterLiquid_Down",0.1, 1, 0.5, false);
				
				Entity_SetInteractionDisabled("airlockpanel", true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				//Button_SetSwitchedOn("AkersBuildingInnerPanel_Inside", true, false);
			}
			else if (Sequence_DoStepAndWait(4))
			{
				Entity_SetActive("AirLockWaterLiquid", false);
				Map_SetEnvironmentParticlesActive(false);
				Player_SetCrouchDisabled(false);
				SetInnerAirlockDoorOpen(true);
				
				Entity_SetActive("LambdaCheckpoint", true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_SetActive("ToolArea_CathToolAirlock", true);
				Button_SetSwitchedOn("airlockpanel", false, true);
			}
			
			Sequence_End();
		}
	 
		//-------------------------------------------------------
		
		cSequenceStatesData mAirlockFillSequence;
			
		void SequenceAirlockFill(const tString &in asTimer)
		{
			Sequence_Begin("SequenceAirlockFill", mAirlockFillSequence);
				
			if(Sequence_DoStepAndWait(2.5)) 
			{
				if(mbPlayerWasHurt)
					SequenceStates_Pause("Seq_CathComeSeeMe_Hurt");
				else
					SequenceStates_Pause("Seq_CatherineAllClear_Extra_Unhurt");
				
				SetInnerAirlockDoorOpen(false);
				
				Entity_SetActive("ToolArea_CathToolAirlock", false);
			}
			else if(Sequence_DoStepAndWait(0.66))
			{
				////////////////////
				//Audio - Pump non underwater triggered
				Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop", "PumpsSource", 0.0f, false, 1.0f);
				AirlockEffectsTurnOffPumps();
				Player_SetCrouchDisabled(true);

			}
			else if(Sequence_DoStepAndWait(2.5))
			{
				AirlockEffectsFillWithWater();
			}
			else if(Sequence_DoStepAndWait(10))
			{
				mbAirlockedFilled = true;
				Entity_SetActive("AirLockWaterLiquid", true);
				Map_SetEnvironmentParticlesActive(true);
				Map_AddEnvironmentParticleClipArea("*", "AirLockWaterLiquid");
				
				LiquidArea_MoveLinearTo("AirLockWaterLiquid","AirLockWaterLiquid_Up",0.1, 1, 0.5, false);
			}
			else if(Sequence_DoStepAndWait(1))
			{
				Player_SetCrouchDisabled(false);
			}
			else if(Sequence_DoStepAndWait(4))
			{
				Entity_SetActive("AirLockWaterLiquid", false);
				Map_RemoveEnvironmentParticleClipArea("*", "AirLockWaterLiquid");
			}
			else if(Sequence_DoStepAndWait(0))
			{
				Entity_SetActive("ToolArea_CathToolAirlock", true);
				SetOuterAirlockDoorOpen(true);
				
				Button_SetSwitchedOn("airlockpanel", false, true);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool Doorway_LambdaCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
		{
			CheckPoint_Setup("CheckpointLambda");
			AttackMeter_SetAttackerTeleportPosition("MonsterLambdaSpawn_*");

			Achievement_Unlock(eAchievement_ChasedCath);
			return false;
		}
		
		//-------------------------------------------------------
		
		void CheckpointLambda(int alRecentDeaths, const tString& in asSource)
		{
			Entity_SetActive(asSource, false);
		}
		
		//-------------------------------------------------------
				
		//} END Event Airlock Enter/Leave
		
		//////////////////////////////////////////////////////////////////////////////////
		// Cath Setup
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msCurrentCathSource;
		
		//-------------------------------------------------------
		
		void SetCathInLambda(bool bInLambda)
		{
			if (bInLambda)
			{
				Voice_AddCharacterSpeakingCallback("CatherineOmniTool", "OnCathTalking");
			}
			else
			{
				Voice_RemoveCharacterSpeakingCallback("CatherineOmniTool");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollideCathSourceArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
				return true;
				
			tString sSourceEntity = Entity_GetVarString(asChild,"");
			if (sSourceEntity=="")
			{
				Error("CathSourceArea: No entity specified in UserVar");
				return true;
			}
			if (!Entity_Exists(sSourceEntity))
			{
				Error("CathSourceArea: Can't find entity:"+sSourceEntity);
				return true;
			}
			//cLux_AddDebugMessage("CathSourceArea changed to '"+sSourceEntity+"'");
		
			if (msCurrentCathSource!=sSourceEntity)
			{
				if (mbCathCanTalk)
				{
					Voice_SetSource("CatherineOmniTool", sSourceEntity, 2, 30, true, 30);
					if (msCurrentCathSource!="")
						 OnCathTalking("CatherineOmniTool", false);
				}

				msCurrentCathSource = sSourceEntity;
				
				if (mbCathCanTalk)
				{
					if (Voice_CharacterIsSpeaking("CatherineOmniTool"))
						OnCathTalking("CatherineOmniTool", true);
				}
			}

			return true;
		}
		
		//-------------------------------------------------------
		
		 bool OnCathTalking(const tString &in asCharacter, bool abStartedTalking)
		 {
			 Lamp_SetLit(msCurrentCathSource, abStartedTalking, true);
			 Lamp_SetFlickerActive(msCurrentCathSource, abStartedTalking);
			 return true;
		 }
		
		//-------------------------------------------------------
		
		//} END Cath Setup
	
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Flesher glimpse at start.
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbFlesherGlimpseOver=false;
		
		//-------------------------------------------------------
		
		bool CollideAreaFlesherGlimpse(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Flesher Glimpse!");
			Sound_CreateAtEntity("FlesherLambdaPart01","02_01_ms_curie_outside/SFX/lambda_flesher/intro/part_01","Player");
			Sound_CreateAtEntity("FlesherLambdaPart02","02_01_ms_curie_outside/SFX/lambda_flesher/intro/part_02","FlesherAttackCathSoundSource");
			Sound_FadeGlobalVolume(0.65f, 3.0f);
			
			Seq_FlesherGlimpse("");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqFlesherGlimpse;
		void Seq_FlesherGlimpse(const tString &in asX)
		{
			Sequence_Begin("Seq_FlesherGlimpse", mSeqFlesherGlimpse);
			
			if (Sequence_DoStepAndWait(0.35))
			{
				DistortionEffect_SetAmount(0.15, 0.6f);
				Lamp_SetFlickerActive("ceiling_large_2", true);
				Lamp_SetFlickerActive("ceiling_theta_large_2", true);
				Lamp_SetFlickerActive("ceiling_theta_large_8", true);
				
			}
			if (Sequence_DoStepAndWait(0.5))
			{
				Effect_TimeGlitch_Start(0.5, 0.5f, 0.05f, false);
				Music_Play("03_02_voices03", 0.25f, false, eMusicPrio_BigEvent);
				Entity_SetActive("flesher_glimpse", true);
				Pathfinder_MoveToNode("flesher_glimpse", "PathNodeArea_191", "");
			}
			if (Sequence_DoStepAndWait(0.95))
			{
				Voice_Play("2_Simon_EnterLambda", -1, "SubjectOver_EnterLambda");
			
				DistortionEffect_SetAmount(0.3, 0.3f);
			}
			if (Sequence_DoStepAndWait(0.7))
			{
				Effect_TimeGlitch_Start(0.5, 0.5f, 0.05f, false);
				Entity_SetActive("flesher_glimpse", false);
			}
			if (Sequence_DoStepAndWait(3.0))
			{
				Lamp_SetFlickerActive("ceiling_large_2", false);
				Lamp_SetFlickerActive("ceiling_theta_large_2", false);
				Lamp_SetFlickerActive("ceiling_theta_large_8", false);
			}
			if (Sequence_DoStepAndWait(0.0))
			{
				DistortionEffect_SetAmount(0, 2);
				Sound_FadeGlobalVolume(1.0f, 3.0f);
			}
			
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void SubjectOver_EnterLambda(const tString&in asScene, const tString&in asSubject)
		{
			mbFlesherGlimpseOver = true;
		}
				
		void LineOver_CathGetsZapped(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine) return;
			
			cLux_AddTodoMessage("Catherine gets zapped and ripped apart by flesher.");
			Sound_CreateAtEntity("FlesherLambdaPart03","02_01_ms_curie_outside/SFX/lambda_flesher/intro/part_03","FlesherAttackCathSoundSource");
			
			Light_SetBrightness("CathHurtFlash", 40);
			Light_FadeTo("CathHurtFlash", cColor(0.495,0.841,0.961,1), -1, 0.2f);
			Map_AddTimer("CathGetsZappedLightFade", 1, "Timer_CathGetsZappedLightFade");
			DistortionEffect_SetAmount(0.3, 1);
		}
		
		void Timer_CathGetsZappedLightFade(const tString&in asTimer)
		{
			Light_FadeTo("CathHurtFlash", cColor(0,0,0,1), -1, 0.3);
			DistortionEffect_SetAmount(0, 1);
		}
		
		//-------------------------------------------------------
		
		//} END Flesher glimpse at start.
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Hide from flesher
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbFlesherIsInstaDeathDisabled=false;
		
		//-------------------------------------------------------
		
		//////////////////////////////////
		// Cath says player should hide!
		bool CollideAreaCathSaysHide(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("CathSaysHide", 1, "Timer_CathSaysHide");
			
			Map_AddTimer("FlesherHideEncounter", 1.35f, "Timer_FlesherHideEncounter");
			
			//Areas that kill the player directly.
			Entity_SetActive("Area_InstaKill_*", true);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Timer_CathSaysHide(const tString&in asTimer)
		{
			if(mbFlesherGlimpseOver==false)
			{
				Map_RestartCurrentTimer(1);
				return;
			}
			
			Voice_Play("2_Cath_WarnsPlayer_1");
		}
		
		//-------------------------------------------------------
		
		//////////////////////////////////
		// The flesher pops out
		void Timer_FlesherHideEncounter(const tString&in asTimer)
		{
			Pathfinder_Track_Add("flesher_female_1", "PathNodeArea_191", 1,4);
			Pathfinder_Track_Add("flesher_female_1", "PathNodeArea_185", 1,4);
			Pathfinder_Track_Add("flesher_female_1", "PathNodeArea_213", 1,3);
			Pathfinder_Track_Add("flesher_female_1", "PathNodeArea_8", 1,2);
						
			Entity_SetActive("flesher_female_1", true);
			
			Pathfinder_Track_Start("flesher_female_1", false ,1, "FirstFlesherPathOver");
			
			AttackMeter_SetAfterDamageCallback("PlayerDiesByFlesher");
		}
		
		bool Area_FlesherOpensDoor(const tString&in asParent, const tString&in asChild, int alState)
		{
			if(alState == 1)
				SlideDoor_SetClosed("PersRoom_Door_1", false);
			else
				SlideDoor_SetClosed("PersRoom_Door_1", true);
			
			return true;
		}
		
		void FirstFlesherPathOver(const tString& in asEntityName)
		{
			Agent_SetAutoDisableWhenOutOfSightActive("flesher_female_1",true, 4);
			Agent_SetAutoDisableCallback("flesher_female_1","FirstFlesherOutOfSight");
		}
		
		void FirstFlesherOutOfSight(const tString& in asEntity)
		{
			if(mbFlesherIsInstaDeathDisabled) return;
			
			Map_AddTimer("CathSaysAllClear", 5, "Timer_CathSaysAllClear");
			
			Entity_SetActive("Area_InstaKill_*", false);
		}
		
		//-------------------------------------------------------
		
		//////////////////////////////////
		// The flesher threat is now over! Catherine wants Simon to come to her
		void Timer_CathSaysAllClear(const tString&in asTimer)
		{
			Entity_SetActive("CathLookAtMusicEnable", true);
			Voice_Play("2_Cath_AllClear_1");
			
			Entity_SetActive("Area_TalkToMachineCath", true);
			
			Seq_CatherineAllClear_Extra_Unhurt("");
		}
		
		cSequenceStatesData mSeqCatherineAllClear_Extra_Unhurt;
		void Seq_CatherineAllClear_Extra_Unhurt(const tString &in asX)
		{
			Sequence_Begin("Seq_CatherineAllClear_Extra_Unhurt", mSeqCatherineAllClear_Extra_Unhurt);
			
			if (Sequence_DoStepAndWait(15.01)){}
			if (Sequence_DoStepAndWait(30.01)) {
				Voice_Play("2_Cath_AllClear_Extra_1");
			}
			if (Sequence_DoStepAndWait(30.01)) {
				Voice_Play("2_Cath_AllClear_Extra_1");
			}
			if (Sequence_DoStepAndWait(35.01)) {
				Voice_Play("2_Cath_AllClear_Extra_1");
			}
			if (Sequence_DoStepAndWait(45.01)) {
				Voice_Play("2_Cath_AllClear_Extra_1");
			}
			if (Sequence_DoStepAndWait(0.01)) {
				Voice_Play("2_Cath_AllClear_Extra_1");
			}
			
			Sequence_End();
		}

		
		//-------------------------------------------------------
		
		bool CollideAreaInstaKill(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(Flesher_IsHunting("flesher_female_1"))
			{
				Map_AddTimer("InstaKillFlesherAppear", 0.4f, "Timer_InstaKillFlesherAppear");
				Map_SetTimerUserVarString("InstaKillFlesherAppear", Entity_GetVarString(asChild,""));
				
				Effect_VideoDistortion_Start(0.45, 0.6f, 0.1f, 0.3f);
				Effect_TimeGlitch_Start(0.5, 0.5f, 0.4f, true, 1.0f);
			}
			else
			{
				Effect_VideoDistortion_Start(0.25, 0.6f, 0.1f, 0.3f);
				Effect_TimeGlitch_Start(0.5, 0.5f, 0.2f, true, 0.4f);
								
				//Area in the other rooms
				if(asChild != "Area_InstaKill_1")
				{
					Map_AddTimer("CathSaysAllClear", 5, "Timer_CathSaysAllClear");
				}
				//Area in cath room
				else
				{
					Entity_SetActive("CathLookAtMusicEnable", true);
					Entity_SetActive("Area_TalkToMachineCath", true);
					Map_RemoveTimer("CathSaysHide");
					//Skipping her repeated "are you there?" messages, as it sound weird.
				}
			}
			
			Entity_SetActive("Area_InstaKill_*", false);
			
			mbFlesherIsInstaDeathDisabled = true;
			Entity_SetActive("flesher_female_1", false);
									
			return false;
		}
		
		void Timer_InstaKillFlesherAppear(const tString&in asTimer)
		{
			Entity_SetActive(Map_GetTimerUserVarString("InstaKillFlesherAppear"), true);
			Flesher_HuntPlayer(Map_GetTimerUserVarString("InstaKillFlesherAppear"));
		}
		
		//-------------------------------------------------------
		
		void PlayerDiesByFlesher(const tString& in asSource)
		{
			cLux_AddDebugMessage("INSIDE PlayerDiesByFlesher!");
			
			Map_RemoveTimer("RevealPlayerPos");
			Map_RemoveTimer("FlesherCheckIfPlayerDetected");
			Map_RemoveTimer("InstaKillFlesherAppear");
			Map_RemoveTimer("FlesherAutoKill");
			Map_RemoveTimer("CathSaysHide");
			
			Entity_SetActive("flesher_female_1", false);
			Entity_SetActive("flesher_instakill_*", false);
			
			Button_SetLocked("HideRoomDoor_1_Button_1", false, false);
			
			Entity_SetActive("Area_InstaKill_*", false);
			
			Music_Stop(4, eMusicPrio_BgAmb);
			
			Map_AddTimer("CathAfterDeathComments", 1, "Timer_CathAfterDeathComments");
			
			Entity_SetActive("Area_TalkToMachineCath", true);
						
			//TODO: THis changes how Cath acts later on!
		}
		
		//-------------------------------------------------------
		
		void Timer_CathAfterDeathComments(const tString&in asTimer)
		{
			Voice_Play("2_Cath_ScreamsAfterPlayerDie", -1, "", 1);
			
			mbPlayerWasHurt = true;
			
			ParticleSystem_CreateAtEntity("CathSmoke","smoke_bright_med_slow_loop.ps", "Area_CathMachineSmoke", true);
			
			Seq_CathComeSeeMe_Hurt("");
		}
		
		cSequenceStatesData mSeqCathComeSeeMe_Hurt;
		void Seq_CathComeSeeMe_Hurt(const tString &in asX)
		{
			Sequence_Begin("Seq_CathComeSeeMe_Hurt", mSeqCathComeSeeMe_Hurt);
			
			if (Sequence_DoStepAndWait(15.01)) {
			}
			if (Sequence_DoStepAndWait(30.01)) {
				Voice_Play("2_Cath_ComeSeeMeHurt");
			}
			if (Sequence_DoStepAndWait(30.01)) {
				Voice_Play("2_Cath_ComeSeeMeHurt");
			}
			if (Sequence_DoStepAndWait(30.01)) {
				Voice_Play("2_Cath_ComeSeeMeHurt");
			}
			if (Sequence_DoStepAndWait(40.01)) {
				Voice_Play("2_Cath_ComeSeeMeHurt");
			}
			if (Sequence_DoStepAndWait(50.01)) {
				Voice_Play("2_Cath_ComeSeeMeHurt");
			}
			if (Sequence_DoStepAndWait(0.01)) {
				Voice_Play("2_Cath_ComeSeeMeHurt");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		
		//} END Hide from flesher
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Talk To Machine Catherine
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbCatherineOmniToolChatOver = false;
		bool mbOmniToolWasNotInWhenTalkingToCath=false;
		bool mbInteractedWithCatherineMachine = false;
		
		//-------------------------------------------------------
		
		bool CollideAreaCathRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				if(mbCathMachineActive)
					Voice_AddCharacterSpeakingCallback("CatherineRobot", "CharSpeaking_CathMachine");
			}
			else
			{
				if(mbCathMachineActive)
				{
					Voice_RemoveCharacterSpeakingCallback("CatherineRobot");
					Lamp_SetLit("CathMachineLamp", false, true);
				}
			}
			
			return true;
		}
		
		bool CharSpeaking_CathMachine(const tString &in asCharacter, bool abStartedTalking)
		{
			if(abStartedTalking)
			{
				Map_AddTimer("CathLampFlicker",0.1f, "Timer_CathLampFlicker");
			}
			else
			{
				Map_RemoveTimer("CathLampFlicker");
				Entity_SetEffectsActive("catherine_worker_lambda_1", false, true);
			}
			
			return true;	
		}
		
		bool mbCathFlickerOn=true;
		void Timer_CathLampFlicker(const tString&in asTimer)
		{
			Entity_SetEffectsActive("catherine_worker_lambda_1", mbCathFlickerOn, false);
			mbCathFlickerOn = !mbCathFlickerOn;
			
			Map_RestartCurrentTimer(cMath_RandRectf(0.05, 0.2f));
			//Map_AddTimer("CathLampFlicker",, "Timer_CathLampFlicker");
		}

		//-------------------------------------------------------
		
		bool CollideAreaPlayerCloseToCathFirstTime(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(Map_TimeHasPassed("PlayerCloseToCathFirstTime", 8)==false) return true;
			
			if(mbPlayerWasHurt)
				Voice_PlayWhenPossible("2_Cath_PlayerNearCathFirstTime_Hurt", "", 6, 2);
			else
				Voice_PlayWhenPossible("2_Cath_PlayerNearCathFirstTime_Unhurt", "", 6, 2);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void Interact_TalkToMachineCath(const tString &in asEntity)
		{
			Voice_Stop("CathAndSimon");
			
			Map_RemoveTimer("CathSaysAllClear");			
						
			Entity_SetActive("Area_PlayerCloseToCathFirstTime", false);
			Entity_SetActive("Area_TalkToMachineCath", false);
			
			SequenceStates_Stop("Seq_CathComeSeeMe_Hurt");
			SequenceStates_Stop("Seq_CatherineAllClear_Extra_Unhurt");
			
			Dialog_StartConversation("CatherineRobot", "Area_TalkToMachineCath");
			Dialog_Begin("MachineCath");
				Dialog_AddBranch("Base");
					Dialog_AddSubject("2_Cath_InteractTalk_1");
					if(mbOmniToolInserted) {
						Dialog_AddSubject("2_Cath_InteractTalk_2_OmniToolIn", "VoiceOver_CathInteractTalk");
					}
					else {
						Dialog_AddSubject("2_Cath_InteractTalk_2_OmniToolOut", "VoiceOver_CathInteractTalk");
						mbOmniToolWasNotInWhenTalkingToCath = true;
					}	
			Dialog_End();
			
			mbInteractedWithCatherineMachine = true;
		}
		
		//-------------------------------------------------------
		
		void LineOver_Anim_SimonLooksAtHands(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine==false) return;
			
			PlayerHands_SetUseCustomPosition(false);
			PlayerHands_SetUseCustomRotation(false);
			PlayerHands_PlayAnimation("event_look_at_hands_2_1");
		}
		
		void LineOver_Anim_CathTriesToRiseUp(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine) return;
			
			CharMover_PlayAnimation("catherine_worker_lambda_1", "Struggle");
		}
		
		//-------------------------------------------------------
		
		void LineOver_Anim_SimonLooksAtOmniTool(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine)	
				Player_EquipTool("CathTool_NoChip");
			else
				Player_UnequipTool();
		}
		
		//-------------------------------------------------------
				
		void VoiceOver_CathInteractTalk(const tString&in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			Map_AddTimer("CathTalkAfterFirstInteraction", mbOmniToolInserted? 0.1f : 3, "Timer_CathTalkAfterFirstInteraction");
		}
		
		
		void Timer_CathTalkAfterFirstInteraction(const tString&in asTimer)
		{
			if(mbOmniToolInserted==false)
			{
				Voice_Play("3_Cath_WhileOmnitToolIsPutIn", -1, "SubjectOver_CatherineOmniToolChat");
			}
			else
			{
				cLux_AddDebugMessage("OMNITOOL LOADING DONE!!");
				
				Map_AddTimer("CatherineTalksAndPopChip", 0.5f, "Timer_CatherineTalksAndPopChip");	
			}
		}
		
		void SubjectOver_CatherineOmniToolChat(const tString&in asScene, const tString&in asSubject)
		{
			cLux_AddDebugMessage("CatherineOmniToolChat is over!");
			
			mbCatherineOmniToolChatOver = true;

			Entity_SetActive("Area_TalkToMachineCath", true);
			Entity_SetPlayerInteractCallback("Area_TalkToMachineCath","Interact_TalkToCathBeforeOmnitool",false);
			
			
			if(mbOmniToolInserted==false)
				Map_AddTimer("CathRemindOfOmniTool", 15.0f, "Timer_CathRemindOfOmniTool");
		}
		
		//-------------------------------------------------------
		
		bool mbPlayedFirstBeforeOmniReminder = false;
		
		void Interact_TalkToCathBeforeOmnitool(const tString &in asEntity)
		{
			if (Voice_CharacterIsSpeaking("CatherineRobot"))
				return;
				
			if (!mbPlayedFirstBeforeOmniReminder)
			{
				Voice_Play("2_InteractCathBeforeOmnitoolFirst");
				mbPlayedFirstBeforeOmniReminder = true;
			}
			else
			{
				Voice_Play("2_InteractCathBeforeOmnitoolRepeat");
			}
		}
		
		//-------------------------------------------------------
		
		void Timer_CathRemindOfOmniTool(const tString&in asTimer)
		{
			if(mbOmniToolInserted) return; //Just in case check...
			
			Voice_Play("2_Cath_RemindOfOmniTool",-1,"", -2);
			
			Map_RestartCurrentTimer(cMath_RandRectf(10.0f, 15.0f));
		}
		
		//-------------------------------------------------------
		
		//} END Talk To Machine Catherine
	
	//-------------------------------------------------------
	
	//} END SCENE 2
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 - PUT CATH IN OMNITOOL AND FIND ARK
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbOmniToolInserted=false;
	bool mbCortexChipInserted=false;
	
	//-------------------------------------------------------
	
	
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Put Omni Tool in Slot
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
	
		bool OmniToolSlot_CanUseOmniTool()
		{
			return mbCortexChipInserted==false;
		}
		
		bool OmniToolSlot_UseOmniTool()
		{
			CathTool_Insert("CathTool_NoChip", "OmniToolSlot");

			mbOmniToolInserted = true;

			OmniToolComputer_StartOmniToolLoading();

			if(mbCatherineOmniToolChatOver) Map_RemoveTimer("CathRemindOfOmniTool");
			 
			if(mbInteractedWithCatherineMachine==false)
			{
				Voice_Play("3_Cath_PutInOmnitToolBeforeTalk", -1, "", -1);
			}
			else
			{
				Entity_SetActive("Area_TalkToMachineCath", false);
			}

			Entity_SetActive("Area_PutCortexOnOmniTool", true);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OmniToolLoadingIsDone()
		{
			if(mbCatherineOmniToolChatOver)
			{
				Map_AddTimer("CatherineTalksAndPopChip", 1, "Timer_CatherineTalksAndPopChip");	
			}
		}
		
		//} END Event Put Omni Tool in Slot
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Cath Hints
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString GiveCathHints(const tString& in asEntityName)
		{
			if(mbCloudComputerFound==false) return "3_CathHint_NotFoundComputer";
			if(mbTrackingFirstUsage)		return "3_CathHint_NotUsedTracker";
			if(mbTrackingFirstUsage==false && mbTrackingDone==false) return "3_CathHint_UsedTrackerNotFoundARK";
			
			return "";
		}
		
		//-------------------------------------------------------
		
		//} END Event Put Omni Tool in Slot
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Pop The Cortex Chip and Put in OmniTool
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		bool mbCathChipPopped = false;
		bool mbCathChipPickedUp = false;
		bool mbCathChipInOmnitool = false;
		
		//-------------------------------------------------------
		
		void Timer_CatherineTalksAndPopChip(const tString&in asTimer)
		{
			Dialog_Begin();
				Dialog_AddBranch("Main");
					if(mbOmniToolWasNotInWhenTalkingToCath)
						Dialog_AddSubject("3_Cath_BeforePopChip_1A");
					else
						Dialog_AddSubject("3_Cath_BeforePopChip_1B");
					Dialog_AddSubject("3_Cath_BeforePopChip_2");
			Dialog_End();
		}
		
		void LineOver_CatherinePopChip(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine) return;
			
			CharMover_PlayAnimation("catherine_worker_lambda_1", "Collapse", 0.3, false, true, "AnimOver_CathMachineDies");
			HeadTracker_SetActive("catherine_worker_lambda_1",false);
					
			cLux_AddTodoMessage("Sound: The chip pops out @CortexChipTool");
			
			mbCathMachineActive = false;
			mbCathChipPopped = true;
			Voice_RemoveCharacterSpeakingCallback("CatherineRobot");
			Lamp_SetLit("CathMachineLamp", false, true);
			
			Entity_SetActive("CortexChipTool", true);
			Entity_SetInteractionDisabled("CortexChipTool",true);
			
			Entity_SetActive("CharRoboExtraCollider", false);
			
			Map_AddTimer("Timer_CathToolSpark", 5.0f, "Timer_CathToolSpark");
		}
		
		void Timer_CathToolSpark(const tString& in asName)
		{
			ParticleSystem_CreateAtEntity("CortexChipSparksPS", "elec_spark_oneshot.ps", "CortexChipTool", false);
			Sound_CreateAtEntity("SparkTrigger", "02_05_theta/amb/spots/small_spark", "CortexChipTool");
			LightFlash_Add(0.25f,0.1f,0.2f,"CortexChipTool", cColor_White, 0.15f, 2.0f);
		}
		
		void AnimOver_CathMachineDies(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetInteractionDisabled("CortexChipTool",false);

			Entity_SetActive("InteractCortexChip",true);
			
			CharMover_PlayAnimation("catherine_worker_lambda_1", "Dead", 0.3, true);
			
		}
		
		//-------------------------------------------------------
		
		bool CortexChip_PickedUp(const tString &in asTool)
		{
			mbCathChipPickedUp = true;
			Entity_SetActive("InteractCortexChip",false);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnDoorwayCathRoom(const tString &in asArea, const tString &in asEntity, int alState)
		{
			// Enter Room
			if (alState==1)
			{
				if (Map_TimerExists("TimerRemindUseCathChip"))
					Map_RemoveTimer("TimerRemindUseCathChip");
				return true;
			}
			
			// Exit room
			if (mbCathChipPopped&&!mbCathChipInOmnitool)
			{
				Map_AddTimer("TimerRemindUseCathChip",cMath_RandRectf(3.0f,5.0f),"TimerRemindUseCathChip");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		int mlVoiceLineUseCathChip = 0;
		int mlVoiceLineGetCathChip = 0;
		
		void TimerRemindUseCathChip(const tString& in asName)
		{
			tString sSubject = "";
			if (mbCathChipPickedUp)
			{
				// Remind Simon what to do with the chip he's holding
				mlVoiceLineUseCathChip++;
				sSubject = "3_Comment_UseCathChip_"+mlVoiceLineUseCathChip;
			}
			else
			{
				// Remind Simon to pick up the chip
				mlVoiceLineGetCathChip++;
				sSubject = "3_Comment_GetCathChip_"+mlVoiceLineGetCathChip;
			}
			
			if (Voice_SubjectExists(sSubject))
			{
				Voice_Play(sSubject);
				Map_AddTimer("TimerRemindUseCathChip",cMath_RandRectf(10.0f,15.0f),"TimerRemindUseCathChip");
			}
		}
		
		//-------------------------------------------------------
		
		bool CortexChip_CanBeUsed(const tString &in asTool, const tString &in asEntity)
		{
			if(asEntity == "Area_PutCortexOnOmniTool") return true;
			
			return false;
		}
		
		bool CortexChip_Use(const tString &in asTool, const tString &in asEntity)
		{
			//Entity_PlaceAtEntity("CathTool_WithChip","CathTool_NoChip");
			Entity_SetActive("CathTool_WithChip",true);
			Entity_SetActive("CathTool_NoChip",false);
			CathTool_Insert("CathTool_WithChip", "OmniToolSlot");

			Map_AddTimer("CortexChipInConv",2, "Timer_CortexChipInConv");
			
			Entity_SetActive("Area_PutCortexOnOmniTool", false);
			
			cLux_AddTodoMessage("Sound: The Cortex Tool Boots up @Area_PutCortexOnOmniTool");
			
			CathTool_SetHintsCallback("CathTool_WithChip", "GiveCathHints");
			CathTool_SetHintsEnabled("CathTool_WithChip", false);
			CathTool_SetVoiceCharacter("CathTool_WithChip","CatherineOmniTool");
			
			Map_AddTimer("EnableCathHints", 10, "Timer_EnableCathHints");
			
			mbCathChipInOmnitool = true;
			mbCathCanTalk = true;
			Voice_SetSource("CatherineOmniTool", msCurrentCathSource, 2, 30, true, 30);
			
			return true;
		}
		
		void Timer_EnableCathHints(const tString&in asTimer)
		{
			CathTool_SetHintsEnabled("CathTool_WithChip", true);
		}
		
		void Timer_CortexChipInConv(const tString&in asTimer)
		{
			mbCortexChipInserted = true;
					
			Dialog_StartConversation("CatherineOmniTool", "Area_TalkToOmniToolCath");
				Dialog_Begin("OmniToolCath");
					Dialog_AddBranchAndSubject("3_Cath_WakeUpInOmniTool", "", "Subject_WakeUpInOmniTool");
				Dialog_End();
		}
		
		void Subject_WakeUpInOmniTool(const tString&in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			Seq_CathSimonBanter("");
			
			Entity_SetActive("Area_FlesherFootStepsHeard", true);
			
			//This is used so that banter is not shown when not proper.
			Map_AddTimer("CathSimonBanterController", 1, "Timer_CathSimonBanterController");
		}
		
		//-------------------------------------------------------
		
		//} END Event Pop The Cortex Chip and Put in OmniTool
		
		
		
