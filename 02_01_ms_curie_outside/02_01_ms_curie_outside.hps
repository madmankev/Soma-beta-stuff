		//////////////////////////////////////////////////////////////////////////////////
		// Event - Propeller Flesher
		//{//////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------
		
		bool CollideAreaPropellerFlesher(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState!=1) return true;
			if(mbCortexChipInserted==false) return true;
						
			Entity_SetActive("FlesherPropeller", true);	
			Pathfinder_Track_Add("FlesherPropeller", "PathNodeArea_419", 3);
			Pathfinder_Track_Add("FlesherPropeller", "PathNodeArea_427");
			Pathfinder_Track_Start("FlesherPropeller", false, 1, "EndOfTrack_PropellerFlesher");
			
			Entity_SetActive("AreaNearPropellerFlesher", true);
			
			DistortionEffect_SetAmount(0.2, 1);
			
			return false;
		}
		
		void EndOfTrack_PropellerFlesher(const tString& in asEntityName)
		{
			Entity_SetActive("FlesherPropeller", false);	
			Effect_TimeGlitch_Start(1, 1, 0.1, false);
			DistortionEffect_SetAmount(0, 3);
		}
		
		bool CollideAreaNearPropellerFlesher(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(Entity_IsActive("FlesherPropeller"))
			{
				Entity_SetActive("FlesherPropeller", false);	
				Effect_TimeGlitch_Start(1, 1, 0.1, true);
				
				DistortionEffect_SetAmount(0, 1);
					
				Seq_PropellerFlesherScare("");
			}
			
			return false;
		}
		
		//-------------------------------------------------
		
		cSequenceStatesData mSeqPropellerFlesherScare;
		void Seq_PropellerFlesherScare(const tString &in asX)
		{
			Sequence_Begin("Seq_PropellerFlesherScare", mSeqPropellerFlesherScare);
			
			if (Sequence_DoStepAndWait(5))
			{
				Music_PlayExt("NPC_flesher_distant2", false, 0.35f, 1, 0.0f, 0, eMusicPrio_BigEvent, false);
			}
			if (Sequence_DoStepAndWait(3.5f)){
				DistortionEffect_SetAmount(0.3, 1);
			}
			if (Sequence_DoStepAndWait(3.0f)){
				DistortionEffect_SetAmount(0.5, 1);
			}
			if (Sequence_DoStepAndWait(1.5f)){
				DistortionEffect_SetAmount(0.75, 0.5);
			}
			if (Sequence_DoStepAndWait(2.0f)){
				DistortionEffect_SetAmount(1.0, 0.1);
			}
			if (Sequence_DoStepAndWait(0.4f)){
			}
			if (Sequence_DoStepAndWait(0.0f)){
				DistortionEffect_SetAmount(0, 3);
			}
					
			Sequence_End();
		}

		//-------------------------------------------------
		
		//} END event  Propellor Flesher
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Open Midsection Door
		//{//////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbOmniToolHasCurieCodes=false;
		
		//-------------------------------------------------------
		
		bool MidsectionPanel_UseOmniTool(const tString &in asTool, const tString &in asEntity)
		{
			if(mbOmniToolHasCurieCodes==false)
			{				
				OmniPanel_AccessDenied("MidsectionPanel");
			}
			CathTool_UseOnPanel(asTool, asEntity);
			
			return false;
		}
				
		//-------------------------------------------------------
		
		void OnChange_MidsectionPanel(const tString &in asEntity, int alState)
		{
			if (alState==-1) return;
			
			cLux_AddTodoMessage("Sound: 2 secs of the door unlocking  @ship_entrance_swing_1");
				
			Entity_SetActive("ToolArea_Midsection", false);
				
			Map_AddTimer("MidsectionDoorOpen", 2, "Timer_MidsectionDoorOpen");
		}
		
		void Timer_MidsectionDoorOpen(const tString&in asTimer)
